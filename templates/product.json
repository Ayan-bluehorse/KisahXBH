n  display: none;\n}\n\n.image-slider-nav .nav-left {\n  left: 10px;\n}\n\n.image-slider-nav .nav-right {\n  right: 10px;\n}\n\n.image-slider-nav svg {\n  width: 5px !important;\n  height: 10px !important;\n}\n\n.trust-icons_container> :nth-child(1) span {\n  width: 100%;\n}\n\n.quickbuy-container .main-image a.rating {\n  display: none !important;\n}\n  body .product-block .product-block__title {\n    font-weight: 500 !important;\n}\n    .CP-ratings svg, .CP-ratings svg path {\n    stroke: rgb(254 162 2);\n    width: 8px;\n    fill: rgb(254 162 2);\n    height: 8px;\n}\n`;\n    const style = document.createElement(\"style\");\n    style.textContent = css;\n    document.head.appendChild(style);\n  })();\n\n  /* ========== tiny delegate helper (no theme dependency needed) ========== */\n  function onDelegate(root, type, selector, handler) {\n    root.addEventListener(type, function (e) {\n      const el = e.target.closest(selector);\n      if (el && root.contains(el)) handler(e, el);\n    });\n  }\n\n  /* ========== element-ready via MutationObserver (no rAF/interval) ========== */\n  (function (win) {\n    var listeners = [], doc = win.document, MutationObserver = win.MutationObserver || win.WebKitMutationObserver, observer;\n    function ready(selector, fn) {\n      listeners.push({ selector, fn });\n      if (!observer) {\n        observer = new MutationObserver(check);\n        observer.observe(doc.documentElement, { childList: true, subtree: true });\n      }\n      check();\n    }\n    function check() {\n      for (var i = 0; i < listeners.length; i++) {\n        var listener = listeners[i];\n        var elements = doc.querySelectorAll(listener.selector);\n        for (var j = 0; j < elements.length; j++) {\n          var el = elements[j];\n          if (!el._eleReadyCalled) {\n            el._eleReadyCalled = true;\n            listener.fn.call(el, el);\n          }\n        }\n      }\n    }\n    win.eleReady = ready;\n  })(this);\n\n  /* ---------------- Product tile enhancements ---------------- */\n  function initTile(productBlock) {\n    const detail = productBlock.querySelector(\".product-block__detail\");\n    if (detail) detail.style.position = \"inherit\";\n\n    const ratings = productBlock.querySelector(\".rating span\");\n    const svg = `<svg width=\"10\" height=\"11\" viewBox=\"0 0 7 7\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path d=\"M1.33875 7L1.9075 4.41184L0 2.67105L2.52 2.44079L3.5 0L4.48 2.44079L7 2.67105L5.0925 4.41184L5.66125 7L3.5 5.62763L1.33875 7Z\" fill=\"white\"></path>\n</svg>`;\n    if (ratings) {\n      ratings.classList.add(\"CP-ratings\");\n      const existingSvg = ratings.querySelector(\"svg\");\n      if (existingSvg) existingSvg.outerHTML = svg;\n    }\n\n    const dots = productBlock.querySelector(\".product-block__image-dots\");\n    if (dots) {\n      dots.classList.add(\"CP-PLP-swiper-dots\");\n      dots.querySelectorAll(\"div\").forEach((d) => d.classList.remove(\"product-block__image-dot--more\"));\n    }\n\n    const imageWrap = productBlock.querySelector(\".image-label-wrap\");\n    const images = imageWrap ? imageWrap.querySelectorAll(\".product-block__image\") : [];\n    let currentIndex = 0;\n    images.forEach((img, idx) => img.classList.toggle(\"product-block__image--active\", idx === 0));\n\n    const wrapper = document.createElement(\"div\");\n    wrapper.className = \"image-slider-nav\";\n    wrapper.innerHTML = `\n      <button class=\"nav-left\" aria-label=\"Previous\">\n        <svg width=\"2\" height=\"4\" viewBox=\"0 0 4 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M0.583338 3L3.08334 0.5L3.66667 1.08333L1.75001 3L3.66667 4.91667L3.08334 5.5L0.583338 3Z\" fill=\"white\"></path>\n        </svg>\n      </button>\n      <button class=\"nav-right\" aria-label=\"Next\">\n        <svg width=\"2\" height=\"4\" viewBox=\"0 0 4 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M3.41668 3L0.916677 0.5L0.333344 1.08333L2.25001 3L0.333344 4.91667L0.916677 5.5L3.41668 3Z\" fill=\"white\"></path>\n        </svg>\n      </button>`;\n    const imageContainer = productBlock.querySelector(\".image-cont\");\n    if (imageContainer) imageContainer.appendChild(wrapper);\n\n    function showImage(idx) {\n      images.forEach((img, i) => img.classList.toggle(\"product-block__image--active\", i === idx));\n    }\n    wrapper.querySelector(\".nav-left\")?.addEventListener(\"pointerdown\", () => {\n      if (!images.length) return;\n      currentIndex = (currentIndex - 1 + images.length) % images.length;\n      showImage(currentIndex);\n    });\n    wrapper.querySelector(\".nav-right\")?.addEventListener(\"pointerdown\", () => {\n      if (!images.length) return;\n      currentIndex = (currentIndex + 1) % images.length;\n      showImage(currentIndex);\n    });\n\n    const wishlistButton = productBlock.querySelector(\".wishlist-hero-custom-button\");\n    if (wishlistButton) {\n      wishlistButton.style.top = \"8px\";\n      wishlistButton.style.padding = \"2px\";\n      wishlistButton.style.background = \"#FFFFFF\";\n      wishlistButton.style.setProperty(\"right\", \"8px\", \"important\");\n    }\n\n    const actionButtons = `\n      <div class=\"CP-action-btn\"> \n        <button class=\"CP-quick-view-btn\"><svg xmlns=\"http://www.w3.org/2000/svg\" height=\"48px\" viewBox=\"0 -960 960 960\" width=\"48px\" fill=\"#000000\"><path d=\"M440.39-440.39H185.87v-79.22h254.52V-774.7h79.22v255.09H774.7v79.22H519.61v254.52h-79.22v-254.52Z\"/></svg></button>\n      </div>`;\n    const priceBlock = productBlock.querySelector(\".product-price\");\n    const productTitle = productBlock.querySelector(\".product-block__title\");\n    if (priceBlock && productTitle) {\n      const clonePriceBlock = priceBlock.cloneNode(true);\n      clonePriceBlock.querySelector(\".price__default\")?.classList.add(\"CP-default-price\");\n      const currentPrice = clonePriceBlock.querySelector(\".price__current\");\n      if (currentPrice) {\n        currentPrice.classList.add(\"CP-current-price\");\n      }\n      const saleLabel = clonePriceBlock.querySelector(\".product-label--sale span\") || clonePriceBlock.querySelector(\".product-label--sale\");\n      if (saleLabel) saleLabel.classList.add(\"CP-discount\");\n      productTitle.insertAdjacentElement(\"beforebegin\", clonePriceBlock);\n      priceBlock.style.display = \"none\";\n      productTitle.style.padding = \"0px 4px\";\n      clonePriceBlock.style.padding = \"0px 4px\";\n    }\n\n    const snapList = productBlock.querySelector(\".image-cont\");\n    if (snapList) {\n      snapList.insertAdjacentHTML(\"beforeend\", actionButtons);\n    }\n  }\n\n\n  /* ---------------- Quick View + ATC open (delegate; no DOMContentLoaded) ---------------- */\n  const hasThemeDelegate = typeof window.theme === \"object\" && typeof theme.addDelegateEventListener === \"function\";\n  const delegate = hasThemeDelegate\n    ? (sel, handler) => theme.addDelegateEventListener(document, \"click\", sel, handler)\n    : (sel, handler) => onDelegate(document, \"click\", sel, (evt, el) => handler(evt, el));\n\n  function attachQuickHandler(selector) {\n    delegate(selector, (evt, delEl) => {\n      evt.preventDefault();\n      const block = delEl.closest(\".product-block\");\n      const productUrl = block?.querySelector(\"a\")?.getAttribute(\"href\");\n      if (!productUrl) return;\n\n      // If theme.quickbuy not ready, just go to PDP\n      if (!window.theme || !theme.quickbuy) {\n        location.href = productUrl;\n        return;\n      }\n\n      const slider = delEl.closest(\".collection-slider\");\n      let quickbuyCont, detailCont;\n\n      if (slider) {\n        const sliderRow = slider.closest(\".collection-slider-row\");\n        if (!sliderRow || !sliderRow.querySelector(\".quickbuy-container\")) return;\n        quickbuyCont = sliderRow.querySelector(\".quickbuy-container\");\n      } else {\n        theme.quickbuy