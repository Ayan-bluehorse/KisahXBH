)\n        .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))\n        .then((html) => {\n          const tmpl = document.createElement(\"template\");\n          tmpl.innerHTML = html;\n          const newDetail = tmpl.content.querySelector(\".quickbuy-content\")?.cloneNode(true);\n          if (!newDetail) return;\n\n          newDetail.querySelectorAll(\".more\").forEach((el) => (el.href = productUrl));\n          newDetail.querySelectorAll(\".product-title\").forEach((el) => {\n            el.innerHTML = `<a href=\"\">${el.innerHTML}</a>`;\n            el.firstElementChild.href = productUrl;\n          });\n          newDetail.querySelectorAll(\".show-gallery\").forEach((el) => { el.classList.remove(\"show-gallery\"); el.href = productUrl; });\n          newDetail.querySelectorAll(\".not-in-quickbuy\").forEach((el) => el.remove());\n          newDetail.querySelectorAll(\".only-in-quickbuy\").forEach((el) => el.classList.remove(\"only-in-quickbuy\"));\n          newDetail.querySelectorAll(\".sticky-content-container\").forEach((el) => el.classList.remove(\"sticky-content-container\"));\n          newDetail.querySelectorAll(\"pickup-availability\").forEach((el) => el.remove());\n          newDetail.querySelectorAll('variant-picker[data-update-url=\"true\"]').forEach((el) => { el.dataset.updateUrl = false; });\n          newDetail.querySelectorAll(\"noscript\").forEach((el) => el.remove());\n          newDetail.querySelectorAll(\".media-gallery .main-image carousel-slider\").forEach((el) => el.classList.remove(\"mobile-only\"));\n          newDetail.querySelectorAll(\".product-media-collage\").forEach((el) => el.remove());\n          newDetail.querySelectorAll(\".media-gallery .thumbnails\").forEach((el) => el.classList.remove(\"mobile-only\"));\n          [\n            \"media-gallery--layout-carousel-beside\",\n            \"media-gallery--layout-columns-1\",\n            \"media-gallery--layout-columns-2\",\n            \"media-gallery--layout-collage-1\",\n            \"media-gallery--layout-collage-2\",\n          ].forEach((cl) => {\n            newDetail.querySelectorAll(`.${cl}`).forEach((el) => {\n              el.classList.remove(cl);\n              el.classList.add(\"media-gallery--layout-carousel-under\");\n            });\n          });\n\n          // external resources\n          tmpl.content.querySelectorAll('.section-main-product link[rel=\"stylesheet\"]').forEach((el) => {\n            const href = el.getAttribute(\"href\");\n            if (href && !document.querySelector(`link[rel=\"stylesheet\"][href=\"${href}\"]`)) {\n              document.head.insertAdjacentHTML(\"beforeend\", el.outerHTML);\n            }\n          });\n          tmpl.content.querySelectorAll(\".section-main-product script[src]\").forEach((el) => {\n            const src = el.getAttribute(\"src\");\n            if (src && !document.querySelector(`script[src=\"${src}\"]`)) {\n              const s = document.createElement(\"script\");\n              s.src = src; s.defer = true; document.head.appendChild(s);\n            }\n          });\n\n          if (detailCont) {\n            detailCont.innerHTML = \"\";\n            detailCont.appendChild(newDetail);\n          }\n\n          quickbuyCont.dispatchEvent(new CustomEvent(\"on:quickbuy:after-open\", { bubbles: true }));\n\n          // share handlers\n          const mobBtn = document.querySelector(\".mob-share-product-button\");\n          if (mobBtn) {\n            mobBtn.addEventListener(\"click\", function mobShare() {\n              this.classList.toggle(\"active\");\n              document.querySelector(\".title_share_button\")?.classList.toggle(\"active\");\n            });\n          }\n          document.querySelectorAll(\".svg-container-class .native-share-img\").forEach((btn) => {\n            btn.addEventListener(\"click\", function () {\n              if (navigator.share) {\n                navigator.share({ title: document.title, text: \"Check out this link\", url: location.href })\n                  .catch((e) => console.log(\"Error sharing\", e));\n              }\n            });\n          });\n\n          // sticky containers\n          const sizeContainer  = document.querySelector(\".product-block .quickbuy-container .variant-size-chart\");\n          const atcContainer   = document.querySelector(\".product-block .quickbuy-container buy-buttons.buy-buttons-row.block\");\n          const priceContainer = document.querySelector(\".product-block .quickbuy-container .price-container\");\n\n          const stickyClass = selector === \".CP-quick-view-btn\" ? \"CP-qv-sticky-container\" : \"CP-atc-sticky-container\";\n          if (!quickbuyCont.querySelector(`.${stickyClass}`)) {\n            const sticky = document.createElement(\"div\");\n            sticky.className = stickyClass;\n            if (sizeContainer) sticky.appendChild(sizeContainer);\n            if (atcContainer)  sticky.appendChild(atcContainer);\n            if (priceContainer && sticky.children.length > 0) {\n              priceContainer.parentElement.insertBefore(sticky, priceContainer.nextSibling);\n            }\n          }\n\n          // Hide extras for ATC flow\n          if (selector === \".CP-atc-btn\") {\n            const trust = document.querySelector(\".quickbuy-container .trust-icons_container\");\n            if (trust) trust.style.display = \"none\";\n            const linkText = document.querySelector(\".quickbuy-container .link-text\");\n            if (linkText) linkText.style.display = \"none\";\n            const viewDetails = document.querySelector(\".quickbuy-container .lightish-spaced-row-above\");\n            if (viewDetails) viewDetails.style.display = \"none\";\n          }\n        });\n\n      // close button\n      const closeButton = quickbuyCont.querySelector(\".close-detail\");\n      if (closeButton) {\n        closeButton.removeAttribute(\"tabindex\");\n        // Ensure we don't stack listeners\n        closeButton.onclick = function () {\n          quickbuyCont.classList.remove(\"CP-quickbuy-open\");\n          // Move back after a short delay to allow for any closing animations\n          setTimeout(() => {\n             if (quickbuyCont._originalParent) {\n                 quickbuyCont._originalParent.appendChild(quickbuyCont);\n             }\n          }, 300);\n        };\n      }\n\n      // scroll position\n      const offsetFn = (theme && typeof theme.stickyHeaderHeight === \"function\") ? theme.stickyHeaderHeight() : 0;\n      const scrollOffset = -120 - offsetFn;\n      // If moved to body, we might not need this scroll adjustment the same way, or use 0\n      const top = (quickbuyCont.getBoundingClientRect().top + window.scrollY + scrollOffset);\n      // For fixed modal, we might not need to scroll body, but if we do:\n      // window.scrollTo({ top, behavior: \"smooth\" });\n    });\n  }\n\n  // Monitor for new product-lists as requested\n  eleReady(\".product-list\", function (list) {\n      list.querySelectorAll(\".product-block\").forEach(initTile);\n      new MutationObserver((mutations) => {\n          for (const m of mutations) {\n              for (const n of m.addedNodes) {\n                  if (n.nodeType === 1) {\n                      if (n.classList.contains(\"product-block\")) {\n                          initTile(n);\n                      }\n                      if (n.querySelectorAll) {\n                          n.querySelectorAll(\".product-block\").forEach(initTile);\n                      }\n                  }\n              }\n          }\n      }).observe(list, { childList: true });\n  });\n\n  attachQuickHandler(\".CP-quick-view-btn\");\n  attachQuickHandler(\".CP-atc-btn\");\n\n})();\n\n(function () {\n  const s = document.createElement('style');\n  s.textContent = `html.has-qv-open,html.has-qv-open body{overflow:hidden !important;touch-action:none}`;\n  document.head.appendChild(s);\n\n  const toggle = () => {\n    const open = !!document.querySelector('.quickbuy-container.CP-quickbuy-open');\n    document.documentElement.classList.toggle('has-qv-open', open);\n  };\n  new MutationObserver(toggle).observe(document.body, {\n    childList: true, subtree: true, attributes: true, attributeFilter: ['class']\n  });\n  document.addEventListener('pointerdown', (e) => {\n    if (e.target.closest('.quickbuy-container .close-detail')) { setTimeout(toggle, 0); }\n    const qb = e.target.closest('.quickbuy-container');\n    if (qb && !e.target.closest('.quickbuy-container .inner')) { setTimeout(toggle, 0); }\n  });\n  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setTimeout(toggle, 0); });\n  window.addEventListener('popstate', toggle);\n  window.addEventListener('pageshow', toggle);\n})();\n\n\n</script>\n<style>\n.helium-pulse  .desktop-whishlist , .helium-pulse  .mobile_wishlist {\nvisibility:hidden;\n}\n@media screen and (min-width: 768px){\n.quickbuy-toggle {\ndisplay:none !important;\n}\n}\n\n@media screen and (max-width: 768px){\n[data-helium-name=\"product-item\"]{\n--h-card-width: 35vw !important;\n}\n}\nproduct-form .rebuy-widget-container{\ndisplay:none;\n}\n.container{\npadding-left:8px;\npadding-right:8px;\n}\n\n</style>"
