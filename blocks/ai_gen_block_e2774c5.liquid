{% doc %}
  @prompt
    create a section this will be banner section and the banner image will be collection featured image give option to upload in the customizer in fallback and if both i mean custimizer and collection images not there then remove the entire section at all 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign custom_image = block.settings.custom_banner_image
  assign collection_image = collection.image
  
  if custom_image != blank
    assign banner_image = custom_image
  elsif collection_image != blank
    assign banner_image = collection_image
  else
    assign banner_image = blank
  endif
%}

{% if banner_image != blank %}
  {% style %}
    .ai-collection-banner-{{ ai_gen_id }} {
      display: block;
      position: relative;
      width: 100%;
      overflow: hidden;
      background-color: {{ block.settings.overlay_color }};
    }

    .ai-collection-banner__image-wrapper-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      height: {{ block.settings.banner_height_desktop }}px;
    }

    .ai-collection-banner__image-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ block.settings.image_position }};
      display: block;
    }

    .ai-collection-banner__overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      pointer-events: none;
    }

    .ai-collection-banner__content-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: {{ block.settings.content_vertical_alignment }};
      align-items: {{ block.settings.content_horizontal_alignment }};
      padding: 40px 20px;
      text-align: {{ block.settings.text_alignment }};
      z-index: 1;
    }

    .ai-collection-banner__title-{{ ai_gen_id }} {
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.title_size }}px;
      margin: 0 0 12px;
      text-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
      max-width: 800px;
    }

    .ai-collection-banner__description-{{ ai_gen_id }} {
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.description_size }}px;
      margin: 0;
      text-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
      max-width: 600px;
    }

    @media screen and (max-width: 749px) {
      .ai-collection-banner__image-wrapper-{{ ai_gen_id }} {
        height: auto;
      }

      .ai-collection-banner__title-{{ ai_gen_id }} {
        font-size: {{ block.settings.title_size | times: 0.7 }}px;
      }

      .ai-collection-banner__description-{{ ai_gen_id }} {
        font-size: {{ block.settings.description_size | times: 0.85 }}px;
      }

      .ai-collection-banner__content-{{ ai_gen_id }} {
        padding: 20px 16px;
      }
    }
  {% endstyle %}

  <collection-banner-{{ ai_gen_id }}
    class="ai-collection-banner-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-collection-banner__image-wrapper-{{ ai_gen_id }}">
      <img
        src="{{ banner_image | image_url: width: 2400 }}"
        alt="{{ banner_image.alt | escape }}"
        loading="lazy"
        width="{{ banner_image.width }}"
        height="{{ banner_image.height }}"
        class="ai-collection-banner__image-{{ ai_gen_id }}"
      >
      
      {% if block.settings.show_overlay %}
        <div class="ai-collection-banner__overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.show_content %}
        <div class="ai-collection-banner__content-{{ ai_gen_id }}">
          {% if block.settings.show_title and collection.title != blank %}
            <h1 class="ai-collection-banner__title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h1>
          {% endif %}

          {% if block.settings.show_description and collection.description != blank %}
            <div class="ai-collection-banner__description-{{ ai_gen_id }}">
              {{ collection.description }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </collection-banner-{{ ai_gen_id }}>
{% endif %}

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "paragraph",
      "content": "Uses collection featured image by default. Upload a custom image to override."
    },
    {
      "type": "image_picker",
      "id": "custom_banner_image",
      "label": "Custom banner image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "banner_height_desktop",
      "label": "Height on desktop",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Height on mobile",
      "min": 150,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show content",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_shadow_opacity",
      "label": "Text shadow opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_horizontal_alignment",
      "label": "Horizontal position",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Vertical position",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
