      function triggerAppDelay() {
        if (loaded) return;
        loaded = true;
        window.dispatchEvent(new Event('kisah:delayed-apps-trigger'));
      }
      ['touchstart', 'mouseover', 'scroll', 'keydown'].forEach(function(evt) {
