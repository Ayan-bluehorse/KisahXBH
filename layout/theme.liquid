<script>
document.addEventListener("DOMContentLoaded", function () {

  const autoHideEnabled = document.querySelector('.filters[data-auto-apply-hide-unavailable="true"]');
  if (!autoHideEnabled) return;

  const hideRadio = document.querySelector('input[name="filter.v.availability"][value="1"]');
  const filterForm = document.querySelector('#CollectionFilterForm');
  if (!hideRadio || !filterForm) return;

  // Was hide already active?
  const params = new URLSearchParams(location.search);
  const alreadyHidden = params.get('filter.v.availability') === '1';

  if (!alreadyHidden) {
    // Set radio to hide unavailable
    hideRadio.checked = true;

    // Trigger Dawn filter AJAX
    filterForm.dispatchEvent(new Event("input", { bubbles: true }));
    filterForm.dispatchEvent(new Event("change", { bubbles: true }));

    // Update URL so pagination inherits it
    params.set('filter.v.availability', '1');
    history.replaceState({}, "", location.pathname + "?" + params.toString());
  }

  // Ensure all pagination links include the filter parameter
  function fixPaginationLinks() {
    document.querySelectorAll(".pagination a").forEach(function(link) {
      if (!link.href.includes("filter.v.availability=1")) {
        if (link.href.includes("?")) {
          link.href += "&filter.v.availability=1";
        } else {
          link.href += "?filter.v.availability=1";
        }
      }
    });
  }

  fixPaginationLinks();
  document.addEventListener("shopify:section:load", fixPaginationLinks);

});
</script>

