<script>
document.addEventListener("DOMContentLoaded", function () {
  // If collection has infinite scroll manager, let infinite scroll manage the collection grid
  if (document.querySelector('[data-infinite-scroll]')) return;

  const grid = document.querySelector('.product-grid');
  if(!grid) return;

  function processProducts() {

    const cards = Array.from(grid.querySelectorAll('.product-block'));

    let normalProducts = [];
    let lowStockProducts = [];

    cards.forEach(card => {

      // 👉 skip if already processed (performance boost)
      if(card.dataset.processed === "true") return;

      let total = parseInt(card.dataset.total) || 0;
      let available = parseInt(card.dataset.available) || 0;

      // mark processed
      card.dataset.processed = "true";

      if(total <= 0){
        card.classList.add('out-of-stock');
        card.style.display = "none";
        return;
      }

      let unavailablePercent = ((total - available) / total) * 100;

      if(unavailablePercent > 50){
        card.classList.add('low-stock');
        lowStockProducts.push(card);
      } else {
        normalProducts.push(card);
      }

    });

    // reorder only if new items found
    if(lowStockProducts.length){
      lowStockProducts.forEach(card => {
        grid.appendChild(card);
      });
    }

  }

  processProducts();
  
  // Re-run if Shopify section load events trigger (e.g. pagination or filtering)
  document.addEventListener("shopify:section:load", processProducts);

});
</script>





