  <script>
    (function () {
      var ticking = false;
      var isVisible = false;
      function checkScroll() {
        var el = document.getElementById('bottom-top');
        if (!el) { ticking = false; return; }
        var scrolled = window.pageYOffset || document.documentElement.scrollTop;
        if (scrolled > 800 && !isVisible) {
          el.style.display = 'block';
          el.style.opacity = '1';
          isVisible = true;
        } else if (scrolled <= 800 && isVisible) {
          el.style.opacity = '0';
          setTimeout(function () { if (!isVisible) el.style.display = 'none'; }, 200);
          isVisible = false;
        }
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(checkScroll);
          ticking = true;
        }
      }, { passive: true });

      document.addEventListener('click', function (e) {
        if (e.target && e.target.closest('#bottom-top')) {
          e.preventDefault();
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'back_to_top_click', { event_category: 'navigation' });
            }
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'back_to_top_click', event_category: 'navigation' });
          } catch(err) {}
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      document.addEventListener('keydown', function (e) {
        if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.closest('#bottom-top')) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    })();
  </script>

  
