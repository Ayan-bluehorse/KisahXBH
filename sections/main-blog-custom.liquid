<style>
.template-blog{
  background:#F3F3F3;
}
.template-blog .page-header{
  padding:0;
}
.utility-bar {
  display: none !important;
}
 .template-blog .page-section-spacing{
   margin-top:8px;
 }

.template-blog .majortitle{
    font-family: var(--heading-font-family);
    font-style: normal;
    font-weight: 400;
    font-size: 30px;
    line-height: 32px;
    text-align: center;
    color: #000000;
    text-transform: uppercase;
    margin-bottom:10px;
}
 .article-list.article-layout--columns{
   justify-content:space-between;
    margin-right:0;
    margin-left:0;
 }
 .article-list.article-layout--columns .article{
    position:relative;
 }
  .article-list.article-layout--columns .article .article__inner .rte{
    margin:0;
    flex-grow:0;
  }
 .article-list.article-layout--columns .article .article__inner .rte span{ 
    font-family: var(--base-font-family);
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 18px;
    color: #000000;
    display: block
 }
 .article-list.article-layout--columns .article .article__inner .meta{
    display: flex;
    justify-content: space-between;
    align-items: center;
 }
 .article-list.article-layout--columns .article .article__inner .meta .iconmeta.time{
    font-family: var(--base-font-family);
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 18px;
    color: #000000;
   }
  .article-list.article-layout--columns .article .blog-share{
    background:#201747;
    border-radius:50px;
    padding:10px 8px;
    position:absolute;
    bottom:64px;
    right:15px;
    opacity:0;
    visibility:hidden;
  }
   .article-list.article-layout--columns .article.active .blog-share{
    opacity:1;
    visibility:visible;
   }
  .article-list.article-layout--columns .article .article__inner .meta svg{
    width:25px;
  }
@media screen and (max-width:768px){
.template-blog .majortitle{
    font-size: 26px;
    line-height: 28px;
}
 .article-list.article-layout--columns .article{
   width:100%;
 }
 .article-list.article-layout--columns .article .article__inner h2{
    font-size: 16px;
    line-height: 16px;
 }
 .article-list.article-layout--columns .article .article__inner .rte span{ 
    font-size: 14px;
    line-height: 16px;
 }
 .article-list.article-layout--columns .article .article__inner .meta .iconmeta.time{
    font-size: 14px;
    line-height: 16px;
   }
}
</style>

{% paginate blog.articles by 12 %}
<div class="container">
  
  {% if section.settings.show_page_title %}
    <div class="page-header" data-cc-animate>
      <h1 class="majortitle">{{ blog.title }}</h1>
    </div>
  {% endif %}

  <div class="utility-bar" data-cc-animate>
    <div class="utility-bar__left">
      {% if blog.all_tags.size > 0 %}
        <div class="utility-bar__item">
          <link-dropdown class="link-dropdown link-dropdown--left-aligned link-dropdown--with-icon">
            <div class="visually-hidden" id="filter-dropdown-heading">{{ 'blogs.filtering.filter_by' | t | escape }}</div>
            <button class="link-dropdown__button has-motion" aria-expanded="false" aria-controls="filter-dropdown-options" aria-describedby="filter-dropdown-heading">
              <span class="link-dropdown__button-text">
                <span class="link-dropdown__button-prefix-icon">{% render 'icon-filter', stroke_width: 1.3 %}</span>
                {%- if current_tags -%}
                  {{- current_tags | join: ', ' -}}
                {%- else -%}
                  {{- 'blogs.filtering.filter_by' | t -}}
                {%- endif -%}
              </span>
              <span class="link-dropdown__button-icon has-motion">{% render 'icon-chevron-down', stroke_width: 1.3 %}</span>
            </button>
            <div class="link-dropdown__options" id="filter-dropdown-options">
              {% if current_tags %}
                <a href="{{ blog.url }}" class="link-dropdown__link">
                  {{- 'blogs.filtering.all' | t -}}
                </a>
              {% endif %}

              {% for tag in blog.all_tags %}
                <a href="{{ tag | link_to_tag: tag | split: 'href="' | last | split: '"' | first }}"
                  class="link-dropdown__link{% if current_tags contains tag %} link-dropdown__link--active{% endif %}">
                  {{- tag -}}
                </a>
              {% endfor %}
            </div>
          </link-dropdown>
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_twitter or section.settings.show_facebook or section.settings.show_rss_icon %}
      <div class="utility-bar__right" data-cc-animate>
        {% if section.settings.show_twitter or section.settings.show_facebook %}
          <span class="utility-bar__item desktop-only">
            <div class="social-share flex items-center">
              <p class="social-share__heading">{{ 'general.social.share_heading' | t }}</p>
              {% render 'social-share',
                  share_twitter: section.settings.show_twitter,
                  share_facebook: section.settings.show_facebook,
                  share_title: blog.title,
                  share_url: blog.url %}
            </div>
          </span>
        {% endif %}
        {% if section.settings.show_rss_icon %}
          <a class="rsslink utility-bar__item" href="{{ blog.url }}.atom" title="{{ blog.title | escape }} RSS">{% render 'icon-rss' %}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% if section.settings.layout == 'columns' %}<div class="container">{% endif %}
<div class="article__flex_container">  
  <div class="article__list_customz_container">
    <div class="article__list_customz article-list article-layout--{{ section.settings.layout }}">
    
      {% for article in blog.articles %}
      <div class="article modern-blog-card" data-cc-animate>
        <div class="article__inner">
          {% if article.image %}
            <div class="article-image">
              <a href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                <img src="{{ article.image | image_url: width: 800 }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}" alt="{{ article.image.alt | default: article.title | escape }}">
              </a>
            </div>
          {% endif %}

          <div class="article-content-wrap">
            {%- assign article_category = '' -%}
            {%- for tag in article.tags -%}
              {%- unless tag contains '_' -%}
                {%- assign article_category = tag -%}
                {%- break -%}
              {%- endunless -%}
            {%- endfor -%}

            {%- if article_category != blank -%}
            <div class="article-category-badge">
              <a href="{{ blog.url }}/tagged/{{ article_category | handle }}" class="article-category-pill">{{ article_category }}</a>
            </div>
            {%- endif -%}

            <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>

            {% if section.settings.show_date %}
              <div class="article-card__date">
                {{ article.published_at | date: "%B %d, %Y" }}
              </div>
            {% endif %}

            {%- if section.settings.show_excerpts -%}
              <div class="article-card__excerpt">
                {%- if article.excerpt.size > 0 -%}
                  {{ article.excerpt | strip_html | truncatewords: 24 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 24 }}
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="article-card__footer">
              <a href="{{ article.url }}" class="article-card__read-more">View Post</a>
              {% if section.settings.show_share_icon %}
                {% render 'blog-social-share',
                  share_title: article.title,
                  share_url: article.url,
                  share_image: article.image
                %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    
      {% else %}
    
      <div class="container"><h5 class="align-centre fully-spaced-row">{{ 'blogs.article.no_matches' | t }}</h5></div>
    
      {% endfor %}
    </div>
                      
    <div class="custom__pagination-control container pagination-row">{% render 'pagination-control', paginate: paginate %}</div>
                      
  </div>
                      
  <div class="article__right_container">

    {% comment %} Our Categories Widget (Slide 2) {% endcomment %}
    <div class="sidebar-widget sidebar-categories-widget">
      <div class="sidebar-widget__header">
        <h3 class="sidebar-widget__title">{{ section.settings.categories_title | default: 'Our Categories' }}</h3>
        <span class="sidebar-widget__line"></span>
      </div>
      <ul class="sidebar-categories__list">
        {% if section.settings.categories_menu != blank and linklists[section.settings.categories_menu].links.size > 0 %}
          {% for link in linklists[section.settings.categories_menu].links %}
            <li class="sidebar-categories__item{% if link.active %} is-active{% endif %}">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        {% else %}
          <li class="sidebar-categories__item{% unless current_tags %} is-active{% endunless %}">
            <a href="{{ blog.url }}">All Categories</a>
          </li>
          {% for tag in blog.all_tags %}
            {% unless tag contains '_' %}
              <li class="sidebar-categories__item{% if current_tags contains tag %} is-active{% endif %}">
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
              </li>
            {% endunless %}
          {% endfor %}
        {% endif %}
      </ul>
    </div>

    {% comment %} Popular Posts Widget (Slide 2) {% endcomment %}
    <div class="sidebar-widget sidebar-popular-widget">
      <div class="sidebar-widget__header">
        <h3 class="sidebar-widget__title">{{ section.settings.popular_title | default: 'Popular Posts' }}</h3>
        <span class="sidebar-widget__line"></span>
      </div>
      <div class="sidebar-popular-posts">
        {%- if blog.metafields.custom.top_posts != blank -%}
          {%- for article_custom in blog.metafields.custom.top_posts.value limit: 5 -%}
            {%- assign pop_article = articles[article_custom] -%}
            {%- if pop_article != blank -%}
              <div class="sidebar-popular-item">
                <a href="{{ pop_article.url }}" class="sidebar-popular-item__title">{{ pop_article.title | escape }}</a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign pop_blog = blogs[section.settings.blog] | default: blog -%}
          {%- for pop_article in pop_blog.articles limit: 5 -%}
            <div class="sidebar-popular-item">
              <a href="{{ pop_article.url }}" class="sidebar-popular-item__title">{{ pop_article.title | escape }}</a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {% if blog.metafields.custom.article_list != blank %}
    <div class="custom__article_slider">
      <div class="article-list custom__article_slick">
        {% for article_custom in blog.metafields.custom.article_list.value %}
          {% assign article = articles[article_custom] %}
          <div class="article slick-slide" data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.15 }}s">
            <div class="article__inner">
              {% if article.image %}
                <div class="article-image">
                  <a href="{{ article.url }}">
                     <img src="{{ article.image | image_url: width: 600 }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}" alt="{{ article.title | escape }}">
                  </a>
                </div>
              {% endif %}
              <div class="article__title_container">
               <h3 class="slider__article_title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              </div>
            </div>
          </div> 
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </div>
</div>

{% if section.settings.layout == 'columns' %}</div>{% endif %}
{% endpaginate %}


