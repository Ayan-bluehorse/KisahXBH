<script>
 let clickSvg = document.querySelectorAll('.blog_share_svg svg');
   let article = document.querySelectorAll('.article');
   clickSvg.forEach( function(clickBtn, index){
   clickBtn.addEventListener('click',()=>{
      article[index].classList.toggle('active');
   }); 
 });


// Custom script Start

window.kisahWhenJQueryReady(function($) {
  
$('#shopify-section-{{ section.id }} .custom__article_slick').slick({
  dots: false,
  infinite: false,
  arrow: true,
  speed: 300,
  slidesToShow: 1,
  slidesToScroll: 1,
  infinite: true,
  autoplay: false,
  autoplaySpeed: 2000,
    responsive: [
        {
          breakpoint: 767,
          settings: {
              arrow: false,
          }
        }
    ]
});

});
</script>
                    
                    
