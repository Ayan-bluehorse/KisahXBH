<style>
#shopify-section-{{section.id}} {
  padding-top: {{ section.settings.desk-padding-top }}px;
  padding-bottom: {{ section.settings.desk-padding-bottom }}px;
} 
#shopify-section-{{section.id}} .founders-section .founder-heading-part h2{
    font-style: normal;
    font-weight: 600;
    font-size: 24px;
    line-height: 27px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    font-family: var(--base-font-family);
    margin: 0 0 20px 0;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part{
    display:flex;
    /* gap:7%; */
    flex-wrap:wrap;
    justify-content:space-between;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid{
    display:flex;
    flex-direction:column;
    align-items:center;
    width:27%; 
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .header-part h3{
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 20px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    font-family: var(--base-font-family);
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details .image-detail img{
    max-width:150px;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details{
     position:relative;
     margin-bottom:25px;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details::after{
     background:#ffffff;
     content:" ";
     height:80%;
     display:block;
     box-shadow: 0px 2px 5px 1px rgba(0, 0, 0, 0.15);
     position:absolute;
     top:20%;
     bottom:0;
     right:0;
     left:0;
     border-radius:10px;
     z-index:-99; 
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details .about-founder{
    text-align:center;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details .about-founder .founder-name{
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 20px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    font-family: var(--base-font-family);
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details .about-founder p{
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 18px;
    text-align: center;
    color: #000000;
    padding: 10px;
    margin-bottom: 10px;
}
@media screen and (max-width:1024px){
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid{
    width:43%; 
}  
}
@media screen and (max-width:768px){
#shopify-section-{{section.id}}{
  padding-top:{{section.settings.mob-padding-top}}px;
  padding-bottom:{{section.settings.mob-padding-bottom}}px;
}
#shopify-section-{{section.id}} .founders-section .founder-heading-part h2{
   text-align:left;
   font-size:20px;
   line-height:22px;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .header-part h3{
    font-size: 16px;
    line-height:18px;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details .about-founder .founder-name{
    font-size: 16px;
    line-height: 18px;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid .founder-details .about-founder p{
   font-size: 14px;
   line-height:16px;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part{
   flex-direction:column;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid{
   width:100%;
}
#shopify-section-{{section.id}} .founders-section .founder-grid-part .founders-grid.first-grid{
     margin:0; 
}
</style>




<div class="container">
<div class="founders-section">
  <div class="founder-heading-part">
   <h2>{{ section.settings.head }}</h2> 
  </div>
  <div class="founder-grid-part">
    {% for block in section.blocks %}
    <div class="founders-grid {% if forloop.first %}first-grid{% endif %}">
      <div class="header-part">
        <h3>{{ block.settings.found-head }}</h3>
      </div>
      <div class="founder-details">
        <div class="image-detail">
         {% render 'image',
           image:block.settings.image,
           widths: '960'
         %}
        </div>
        <div class="about-founder">
          <h4 class="founder-name">{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
</div>



{% schema %}
{
  "name": "About founders",
  "settings": [
    {
      "type": "text",
      "id": "head",
      "label": "head"
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR DESKTOP"
    },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "founder-grid",
      "name": "Founder Grid",
      "settings": [
        {
          "type": "text",
          "id": "found-head",
          "label": "heading"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About founders"
    }
  ]
}
{% endschema %}