<section 
  id="shopify-section-{{ section.id }}" 
  class="shop-occasion-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="container">

    {% if section.settings.heading != blank %}
      <h2 class="oc-heading">{{ section.settings.heading }}
         <svg xmlns="http://www.w3.org/2000/svg" width="22" height="27" viewBox="0 0 22 27" fill="none">
        <path d="M4.31041 1.00024C4.03731 2.09682 3.2097 5.1217 2.65726 8.02453C2.10485 10.6501 1.69105 12.4418 1.41588 13.7494C1.27726 14.3743 1.1407 14.9205 1 16.3109" stroke="#D5B54D" stroke-width="2" stroke-linecap="round"/>
        <path d="M5.96484 17.5523C6.92488 17.2792 10.2187 15.0861 13.0594 13.3502C15.6147 11.7632 17.2699 10.5218 18.3706 9.76457C18.9251 9.41698 19.4713 9.14387 20.8617 8.03491" stroke="#D5B54D" stroke-width="2" stroke-linecap="round"/>
        <path d="M6.37891 25.4145C6.65199 25.4145 8.97754 25.4145 12.5611 25.3462C13.9597 25.2779 14.5059 25.1414 15.6749 25.071C16.8439 25.0007 18.6191 25.0007 20.4481 25.0007" stroke="#D5B54D" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </h2>
     
{% endif %}

    {% if section.settings.subheading != blank %}
      <p class="oc-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="oc-grid">

      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="oc-card">

  {% if block.settings.mobile_image %}
    <img 
      width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}" loading="lazy" src="{{ block.settings.mobile_image | image_url: width: 800 }}"
      alt="occasion image mobile"
      class="oc-img mobile-img"
    >
  {% else %}
   {{ 'image' | placeholder_svg_tag: 'oc-img desktop-img' }}
  {% endif %}

  {% if block.settings.image %}
    <img 
      width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" src="{{ block.settings.image | image_url: width: 1200 }}"
      alt="occasion image"
      class="oc-img desktop-img"
    >
  {% else %}
     <img 
      width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}" loading="lazy" src="{{ block.settings.mobile_image | image_url: width: 800 }}"
      alt="occasion image mobile"
      class="oc-img mobile-img"
    >
  {% endif %}

</a>

      {% endfor %}

    </div>

  </div>
</section>

<style>
.shop-occasion-section {
  width: 100%;
}

.shop-occasion-section .container {
max-width: 1351px;
    text-align: center;
}

.oc-heading svg {
    position: absolute;
    top: 12px;
}



.oc-heading {
text-align: center;
    font-size: 56px;
    line-height: 1 !important;
    margin-bottom: 0;
    font-weight: 400;
    color: #B50E24;
    font-family: Playfair Display;
    position: relative;
    line-height: normal !important;
}

.oc-subheading {
    text-align: center;
    margin-bottom: 26.4px;
    font-size: 20px;
    color: #00000099;
    font-family: 'Manrope' !important;
    line-height: 150%;
}

.oc-grid {
display: flex !important;
    flex-wrap: wrap !important;
    gap: 17px;
}

.oc-card {
  position: relative;
  display: block;
  width: 100%;
  overflow: hidden;
}

.oc-img {
  width: 100%;
  display: block;
  border-radius: 4px;
}

.oc-grid > a.oc-card > img {
    width: 100%;
    height: 100%;
    max-width: 100%;
}

.mobile-img { display: none; }
.desktop-img { display: block; }

@media (max-width: 768px) {
     .oc-grid {
        grid-template-columns: repeat(2, 2fr);
        gap: 14.46px;
        display:grid !important;
    }

.shop-occasion-section {
    padding-top: 28px !important;
    padding-bottom: 28px !important;
}

.oc-heading {
    font-size: 32px;
    line-height: 48px;
}

.oc-heading svg {
    width: 20px;
    height: 24px;
    top: 0;
}

.oc-subheading {
    font-size: 14px;
    line-height: 21px;
    margin-bottom: 24px;
}

    .oc-card:nth-child(5) {
    grid-column: unset;
    width: 100%;
}

  .mobile-img { display: block; }
  .desktop-img { display: none; }
}


@media (min-width:769px) {

.oc-grid > .oc-card{
    width: 25%;
    max-width: calc(calc(100% - 51px) / 4);
}

.oc-grid > a.oc-card:nth-last-child(2) {
width: 60% !important;
    max-width: calc(60% - 12px);
    transform: none !important;
}

.oc-grid > a.oc-card:last-child {
    width: 40%;
    max-width: calc(40% - 5px);

}
}

</style>


{% schema %}
{
  "name": "Shop by Occasion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by occasion"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the perfect attire for every celebration"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Shop by Occasion"
    }
  ]
}
{% endschema %}
