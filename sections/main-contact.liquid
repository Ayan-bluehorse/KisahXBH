
<style>
#shopify-section-{{section.id}}.page-section-spacing{
  margin-top:20px;
}
#shopify-section-{{section.id}} .account-form{
   display:flex;
   align-items:center;
   gap:10%;
}
#shopify-section-{{section.id}} .account-form form{
   width:50%;
} 
#shopify-section-{{section.id}} .account-form .map-container{
   width: 50%;
}
#shopify-section-{{section.id}} .account-form .map-container iframe {
    max-width:90%;
    width: 100%;
}
#shopify-section-{{section.id}} h2{
    font-style: normal;
    font-weight: 600;
    font-size: 24px;
    line-height: 27px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    font-family: "Generis Sans W01 Bold";
}
#shopify-section-{{section.id}} .account-form label{
    font-family: 'Generis Sans W01 Regular';
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    line-height: 22px;
    color: rgba(0, 0, 0, 0.83)
}
#shopify-section-{{section.id}} .account-form input{
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 15px;
    color: #8C8C8C;
    font-family: Generis Sans W01 Regular;
    background: #FFFFFF;
    border: 0.5px solid #000000;
    border-radius: 5px;
    padding: 18px 12px;
    box-sizing: border-box;
}
#shopify-section-{{section.id}} .account-form textarea{
    background: #FFFFFF;
    border: 0.5px solid #000000;
    border-radius: 5px;
}
#shopify-section-{{section.id}} .account-form .btn{
  background: #201747;
  box-shadow: 0px 4px 8px 3px rgba(0, 0, 0, 0.15), 0px 1px 3px rgba(0, 0, 0, 0.3);
  border-radius: 50px;
  padding: 10px 40px;
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  text-align: center;
  text-transform: uppercase;
  color: #FFFFFF;
  font-family: 'Generis Sans W01 Bold';
  letter-spacing: 0;
  display:block;
  margin:0 auto;
} 
@media screen and (max-width:786px){
  #shopify-section-{{section.id}}  h2{
    font-size: 22px;
    line-height: 24px;
  }
#shopify-section-{{section.id}} .account-form label{
    font-size: 18px;
    line-height: 20px;
}
#shopify-section-{{section.id}} .account-form input{
    padding: 13px 12px;
}
#shopify-section-{{section.id}} .account-form{
   flex-direction:column;
}
#shopify-section-{{section.id}} .account-form form{
   width:100%;
} 
#shopify-section-{{section.id}} .account-form .map-container{
   width: 100%;
}
#shopify-section-{{section.id}} .account-form .map-container iframe {
    max-width:100%;
}
}
</style>

<div class="container" data-cc-animate>
  {% if section.settings.show_page_title %}
    <div class="page-header">
      <h1 class="majortitle">{{ page.title }}</h1>
    </div>
  {% endif %}

  {% comment %} <div class="spaced-row {% if section.settings.use_columns %}slim-column-left-layout{% else %}reading-width{% endif %}">{% endcomment %}
  <div class="spaced-row">
    {% if page.content != blank %}
      <div class="{% if section.settings.use_columns %}column{% endif %} rte spaced-row">
        {{ page.content }}
      </div>
       
    {% endif %}
     {% if section.settings.contact_title != blank %}
          <h2>{{ section.settings.contact_title | escape }}</h2>
      {% endif %}
   {% comment %} <div class="account-form {% if page.content != blank and section.settings.use_columns %}column righty-form{% else %}reading-width{% endif %}">{% endcomment %}
    <div class="account-form">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p><strong>{{ 'contact.form.post_success' | t }}</strong></p>
        {% else %}

          {% if section.settings.contact_title != blank or section.settings.contact_text != blank %}
            <div class="lightish-spaced-row">
              

              {% if section.settings.contact_text != blank %}
                <div class="rte">{{ section.settings.contact_text }}</div>
              {% endif %}
            </div>
          {% endif %}

          {% if form.errors %}
            <ul class="errors">
              {% for field in form.errors %}
                <li>{{ field | replace: 'body', 'Message' | capitalize }} - {{ form.errors.messages[field] }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          {%- if request.design_mode -%}
            {%- liquid
              assign email_exists = false
              for block in section.blocks
                if block.type == 'email_input'
                  assign email_exists = true
                endif
              endfor
            -%}
            {%- if email_exists == false -%}
              <div class="errors">You must include the 'Email input' block for the form to work correctly.</div>
            {%- endif -%}
          {%- endif -%}

          <div class="flexible-layout flexible-layout--form">
            {% for block in section.blocks %}
              <div class="column column--{% if block.settings.half_width %}half{% else %}full{% endif %}" {{ block.shopify_attributes }}>
                {% case block.type %}
                  {% when 'name_input' %}
                    <label for="contact_name">{{ 'contact.form.name' | t }}</label>
                    <input
                      type="text"
                      autocomplete="name"
                      required
                      id="contact_name"
                      name="contact[name]"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }} {% else %} Enter your name {% endif %}" />

                  {% when 'email_input' %}
                    <label for="contact_email">{{ 'contact.form.email' | t }}</label>
                    <input
                      type="email"
                      required
                      id="contact_email"
                      class="email"
                      name="contact[email]"
                      autocomplete="email"
                      spellcheck="false"
                      autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }} {% else %} Enter email address {% endif %}" />

                  {% when 'message_input' %}
                    <label for="message">{{ 'contact.form.message' | t }}</label>
                    <textarea id="message" required name="contact[body]">{{ form.body }}</textarea>

                  {% when 'phone_input' %}
                    <label for="contact_phone">{{ 'contact.form.phone' | t }}</label>
                    <input
                      type="tel"
                      id="contact_phone"
                      autocomplete="tel"
                      name="contact[{{ 'contact.form.phone' | t }}]"
                      {% if block.settings.required %}required{% endif %}
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }} {% endif %}" />

                  {% when 'custom_input' %}
                    {% if block.settings.title != blank %}
                      {%- assign title_handle = block.settings.title | handle -%}
                      {%- if request.design_mode -%}
                        {%- if title_handle == 'email' or title_handle == 'name' or title_handle == 'body' -%}
                          <div class="errors">The label "{{ block.settings.title }}" is reserved. Please use the dedicated block for this input instead.</div>
                        {%- endif -%}
                      {%- endif -%}
                      <label for="contact_{{ title_handle }}">{{ block.settings.title | escape }}</label>
                      {% if block.settings.type == 'textarea' %}
                        <textarea
                          id="contact_{{ title_handle }}"
                          name="contact[{{ title_handle }}]"
                          {% if block.settings.required %}required{% endif %}>
                          {{- form[title_handle] -}}
                        </textarea>
                      {% else %}
                        <input
                          type="{{ block.settings.type }}"
                          id="contact_{{ title_handle }}"
                          name="contact[{{ title_handle }}]"
                          value="{{ form[title_handle] }}"
                          {% if block.settings.required %}required{% endif %}/>
                      {% endif %}
                    {% endif %}

                  {% when 'custom_dropdown' %}
                    {% if block.settings.title != blank %}
                      {%- liquid
                        assign title_handle = block.settings.title | handle
                        assign custom_options = block.settings.multiple_options | newline_to_br | strip_newlines | split: '<br />'
                        assign input_id = title_handle | prepend: 'contact_'
                        assign input_name = title_handle | prepend: 'contact[' | append: ']'
                      -%}
                      {%- if request.design_mode -%}
                        {%- if title_handle == 'email' or title_handle == 'name' or title_handle == 'body' -%}
                          <div class="errors">The label "{{ block.settings.title }}" is reserved. Please use the dedicated block for this input instead.</div>
                        {%- endif -%}
                      {%- endif -%}
                      <div class="option-selector" data-selector-type="dropdown">
                        <script src="{{ 'custom-select.js' | asset_url }}" defer></script>
                        {% render 'custom-select',
                          id: input_id,
                          label: block.settings.title,
                          option_values: custom_options,
                          selected_value: custom_options.first,
                          include_native: true,
                          native_name: input_name
                        %}
                      </div>
                    {% endif %}

                  {% when 'custom_checkbox' %}
                    {% if block.settings.title != blank %}
                      {%- assign title_handle = block.settings.title | handle -%}
                      {%- if request.design_mode -%}
                        {%- if title_handle == 'email' or title_handle == 'name' or title_handle == 'body' -%}
                          <div class="errors">The label "{{ block.settings.title }}" is reserved. Please use the dedicated block for this input instead.</div>
                        {%- endif -%}
                      {%- endif -%}
                      <input
                        type="hidden"
                        name="contact[{{ title_handle }}]"
                        value="{{ block.settings.value_no | escape }}" />
                      <label class="checkbox-label">
                        <input
                          type="checkbox"
                          id="contact_{{ title_handle }}"
                          name="contact[{{ title_handle }}]"
                          value="{{ block.settings.value_yes | escape }}"
                          {%- if block.settings.required %} required{% endif %}
                          {% if form[title_handle] == block.settings.value_yes %} checked{% endif %} />
                        {{ block.settings.title | escape }}
                      </label>
                    {% endif %}

                  {% when 'text' %}
                    <div class="rte">{{ block.settings.text }}</div>

                {% endcase %}
              </div>
            {% endfor %}
          </div>

          <div class="lightly-spaced-row">
            {% comment %}<button class="btn" type="submit">{{ 'contact.form.send' | t }}</button> {% endcomment %}
            <button class="btn" type="submit">Send Message</button>
          </div>
        {% endif %}
      {% endform %}
      <div class="map-container"><iframe loading="lazy" style="border: 0;" height="450" width="600" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3684.444823913862!2d88.37950887512632!3d22.562460579498804!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a0276f535055143%3A0x5f62dd42e855a8ae!2sKisah%20Apparels%20Private%20Limited!5e0!3m2!1sen!2sin!4v1723635615178!5m2!1sen!2sin" referrerpolicy="no-referrer-when-downgrade" allowfullscreen=""></iframe></div>
    </div>   
  </div>
</div>


{% schema %}
{
  "name": "Contact page",
  "class": "page-section-spacing",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_columns",
      "label": "Two column layout",
      "info": "The left column shows content from the current page. Edit this in Admin > Online Store > Pages",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact form heading",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Contact form introduction"
    }
  ],
  "blocks": [
    {
      "type": "name_input",
      "name": "Name input",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "The label can be changed in the translation editor."
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "email_input",
      "name": "Email input",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "REQUIRED - Contact form will not work if this block is removed."
        },
        {
          "type": "paragraph",
          "content": "The label can be changed in the translation editor."
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "message_input",
      "name": "Message input",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "The label can be changed in the translation editor."
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "phone_input",
      "name": "Phone input",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "custom_input",
      "name": "Custom text input",
      "settings": [
        {
          "type": "paragraph",
          "content": "Custom inputs require a label, and that label may only be used once in the form."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Custom input"
        },
        {
          "type": "select",
          "id": "type",
          "label": "Type",
          "default": "text",
          "options": [
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Number",
              "value": "number"
            },
            {
              "label": "Email",
              "value": "email"
            },
            {
              "label": "Text area",
              "value": "textarea"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "custom_dropdown",
      "name": "Custom dropdown",
      "settings": [
        {
          "type": "paragraph",
          "content": "Custom dropdowns require a label, and that label may only be used once in the form."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Custom dropdown"
        },
        {
          "type": "textarea",
          "id": "multiple_options",
          "label": "Options",
          "default": "Option 1\nOption 2\nOption 3",
          "info": "One option on each line"
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "custom_checkbox",
      "name": "Custom checkbox",
      "settings": [
        {
          "type": "paragraph",
          "content": "Custom checkboxes require a label, and that label may only be used once in the form."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Custom checkbox"
        },
        {
          "type": "text",
          "id": "value_no",
          "label": "Deselected value",
          "default": "No"
        },
        {
          "type": "text",
          "id": "value_yes",
          "label": "Selected value",
          "default": "Yes"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "half_width",
          "label": "Half width",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text content</p>"
        }
      ]
    }
  ]
}
{% endschema %}

