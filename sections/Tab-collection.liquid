<div class="tab-collection container">
  <div class="categories-collec-name">
     <div class="head-part">
       {% if section.settings.head != blank %}
          <h2>{{ section.settings.head }}</h2>
         {% endif %}
       {% if section.settings.sub-head != blank %}
        <p>{{ section.settings.sub-head }}</p>
        {% endif %}
       </div>
     <div class="categories-list">
       <ul>
       {% for block in section.blocks %}
        {% if block.settings.categories != blank %}
        <li>
          <a href="#" class="categories-menus" collection-id="{{ block.id }}">
            <span>
              {{ block.settings.categories }}
            </span>
           </a>
         </li>
        {% endif %}
      {% endfor %}
       </ul>
     </div>
   </div>
  
 {% for block in section.blocks %}
   <div class="collection-con" select-id="{{ block.id }}">
     <div class="collection-products collection-products-slider">
       {%- assign collection = block.settings.collection -%}
        {% for product in collection.products limit: section.settings.grid %}
           <div class="products-img-details slick-slide">
              <product-form class="js-product">
          <div class="pdpform-crt">
           <a href="{{ product.url }}">
               {% assign media = product.featured_image %}
               {%- render 'image' with product.featured_image, loading: 'eager', fetchpriority: 'high' -%}
              {% comment %} <img src="{{ media | image_url  }}" width="{{ media.width }}" height="{{ media.height }}" alt="{{ media.title }}">{% endcomment %}
               <p class="product-title">{{ product.title }}</p> 
                <div class="product-price">
                {%- render 'price', product: product, use_variant: true, for_variant_picker: true, show_badges: true, price_class: 'price--large' -%}
                </div>
               {% render 'wishlisthero-collection-product' with product, product: product %}
            </a>

             {%- assign product_form_id = 'product-form-' | append: product.id -%} 
         {% liquid 
          assign current_variant = product.selected_or_first_available_variant
           unless product.has_only_default_variant
            for block in section.blocks
              if block.type == 'variant-picker' and block.settings.select_first_variant == false and product.variants.size > 1
                assign current_variant = product.selected_variant | default: false
              endif
            endfor
          endunless %} 
             {% form 'product', product, id: product_form_id, class: 'form js-product-form', data-product-id: product.id %}
                <input type="hidden" name="id" value="{{ current_variant.id }}" disabled>
                {% if product.available %}
                  {%- liquid
                    assign gift_card_recipient_feature_active = false
                    if block.settings.show_gift_card_recipient and product.gift_card?
                      assign gift_card_recipient_feature_active = true
                    endif

                    assign enable_dynamic_payment_button = false
                    if block.settings.enable_payment_button and product.selling_plan_groups == empty and gift_card_recipient_feature_active == false
                      unless product.template_suffix contains 'preorder'
                        assign enable_dynamic_payment_button = true
                      endunless
                    endif
                  -%}

                  {% if gift_card_recipient_feature_active %}
                    {% render 'gift-card-recipient', section: section %}
                  {% endif %}

                  <div class="quantity-submit-row  {% if enable_dynamic_payment_button %}has-spb{% endif %}">
                    {% if block.settings.show_quantity_selector %}
                      <label class="label" for="quantity">{{ 'products.product.quantity' | t }}</label>
                      <quantity-wrapper class="quantity-wrapper">
                        <a href="#" data-quantity="down" aria-label="{{ 'cart.items.decrease_quantity' | t }}">{% render 'icon-minus' %}</a>
                        <input aria-label="{{ 'products.product.quantity' | t }}" id="quantity" type="number" name="quantity" value="1" />
                        <a href="#" data-quantity="up" aria-label="{{ 'cart.items.increase_quantity' | t }}">{% render 'icon-plus' %}</a>
                      </quantity-wrapper>
                    {% endif %}

                    <div class="quantity-submit-row__submit ">
                      <div class="js-form-error" role="alert" hidden></div>

                      {%- capture add_to_cart_text -%}
                        {%- if product.template_suffix contains 'preorder' -%}
                          {{- 'products.product.preorder' | t -}}
                        {%- else -%}
                          {{- 'products.product.add_to_cart' | t -}}
                        {%- endif -%}
                      {%- endcapture -%}
                      <button class="btn btn--large add-to-cart" type="submit" name="add" data-add-to-cart-text="{{ add_to_cart_text | escape }}"{% if product.available == false %} disabled{% endif %}>
                        {%- if product.selected_or_first_available_variant.available or product.selected_or_first_available_variant == false -%}
                          {{- add_to_cart_text -}}
                          {% render 'cart-bag' %}
                        {%- else -%}
                          {{- 'products.variant.no_stock' | t -}}
                        {%- endif -%}
                      </button>
                    </div>
                    {% if enable_dynamic_payment_button %}
                      <script class="dynamic-payment-button-template" type="text/template">
                        {{ form | payment_button }}
                      </script>
                    {% endif %}

                    {% if block.settings.show_backorder_text %}
                      {% render 'backorder', product: product, variant: product.selected_or_first_available_variant %}
                    {% endif %}
                  </div>

                {% else %}
                  <div class="quantity-submit-row">
                    <div class="quantity-submit-row__submit">
                      <button class="btn btn--large" name="add" type="submit" disabled>
                        {{- 'products.variant.no_stock' | t -}}
                      </button>
                    </div>
                  </div>
                {% endif %}
              {% endform %}
              
           </div>
          </product-form> 
            </div> 
          {% endfor %}
        <div class="last-slide-button">
           <a href="{{ collection.url }}" class="collection-link">Shop All</a>
         </div>
      </div>
     {% if section.settings.btn-name != blank %}
      <a href="{{ collection.url }}" class="collection-link">{{ section.settings.btn-name }}</a>
      {% endif %}
   </div>
{% endfor %}
</div>

