<script defer>
window.kisahWhenJQueryReady(function($) {
 $('#shopify-section-{{ section.id }} .collection-products').slick({
    dots: {{ section.settings.show-dots }},
    infinite: false,
    speed: 300,
    slidesToShow: 4,
    slidesToScroll: 2,
    arrows:{{section.settings.show-arrows}},
    onComplete:function(){
     $('#shopify-section-{{ section.id }} .collection-products').slick("refresh");
    },
    responsive: [
        {

          breakpoint: 1100,
          settings: {
              slidesToShow: 3.4,
              slidesToScroll: 2,
              infinite: true,
            
          }
        },
        {

          breakpoint: 768,
          settings: {
              slidesToShow: 2.4,
              slidesToScroll: 2,
              infinite: true,
            
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2
          }
        },
       
    ]
  });

  setTimeout(function () {
    $('#shopify-section-{{ section.id }} .categories-collec-name li:first-child a.categories-menus').trigger('click');
  }, 200);

  $( "#shopify-section-{{ section.id }} .categories-collec-name .categories-menus" ).click(function(e) {
    e.preventDefault();
    $('.collection-products-slider').slick('refresh');
    $( '#shopify-section-{{ section.id }} .categories-collec-name .categories-menus').removeClass('active');
    $( this ).addClass('active');
    var currentProduct = $( this ).attr('collection-id');
    var selectProduct = '[select-id="'+ currentProduct +'"]';
    $("#shopify-section-{{ section.id }} .collection-con").hide();
    $(selectProduct).fadeIn('fast');
    $(selectProduct).find('.collection-products-slider').slick('refresh');
    
  });
    
  });
</script>




