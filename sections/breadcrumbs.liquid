<style>
 #shopify-section-{{section.id}}{
   padding-top:{{section.settings.desk-padding-top}}px;
   padding-bottom:{{section.settings.desk-padding-bottom}}px;
 }
#shopify-section-{{section.id}} .breadcrumb a{
    font-family: 'Generis Sans W01 Regular';
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 15px;
    color: #000000;
    opacity: 0.8;
}  
#shopify-section-{{section.id}} .breadcrumb span{
    font-family: 'Generis Sans W01 Regular';
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 15px;
    color: #000000;
    opacity: 0.8;
}
@media screen and (max-width:768px){
#shopify-section-{{section.id}}{
  padding-top:{{section.settings.mob-padding-top}}px;
  padding-bottom:{{section.settings.mob-padding-bottom}}px;
  }
}
</style>
<div class="breadcrumbs__wrapper">
  <div class="container">
    {% unless template == 'index' or settings.breadcrumbs == false %}
    <nav class="breadcrumb breadcrumbs--default inherit" role="navigation" aria-label="breadcrumbs">
      <a href="/" title="Home">Home</a>
      {% if template contains 'page' %}
        <span aria-hidden="true">/</span>
        <span>{{ page.title }}</span>
      {% elsif template == 'list-collections' %}
        <span aria-hidden="true">/</span>
        <span>Collections</span>
      {% elsif template == 'cart' %}
        <span aria-hidden="true">/</span>
        <span>Cart</span>
      {% elsif template contains 'product' %}
        {% if collection.url %}
          <span aria-hidden="true">/</span>
          {{ collection.title | link_to: collection.url }}
        {% endif %}
        <span aria-hidden="true">/</span>
        <span>{{ product.title }}</span>
      {% elsif template contains 'collection' and collection.handle %}
        <span aria-hidden="true">/</span>
        {% if current_tags %}
          {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
          {{ collection.title | link_to: url }}
          <span aria-hidden="true">/</span>
          <span>{{ current_tags | join: " + " }}</span>
        {% else %}
          <span>{{ collection.title }}</span>
        {% endif %}
      {% elsif template == 'blog' %}
        <span aria-hidden="true">/</span>
        {% if current_tags %}
          {{ blog.title | link_to: blog.url }}
          <span aria-hidden="true">/</span>
          <span>{{ current_tags | join: " + " }}</span>
        {% else %}
        <span>{{ blog.title }}</span>
        {% endif %}
      {% elsif template == 'article' %}
        <span aria-hidden="true">/</span>
        {{ blog.title | link_to: blog.url }}
        <span aria-hidden="true">/</span>
        <span>{{ article.title }}</span>
      {% else %}
       <span aria-hidden="true">/</span>
       <span>{{ page_title }}</span>
      {% endif %}
    </nav>
    {% endunless %}
  </div>
</div>


{% schema %}
  {
    "name": "Breadcrumbs",
    "settings": [
       {
         "type": "header",
        "content": "SECTION PADDING FOR DESKTOP"
      },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
    ],
    "presets": [
      {
        "name": "Breadcrumbs"
      }
    ]
  }
{% endschema %}