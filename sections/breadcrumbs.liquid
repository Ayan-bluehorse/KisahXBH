<style>
  #shopify-section-{{section.id}}{
    background-color: #ffffff !important;
    padding-top: {{ section.settings.desk-padding-top }}px;
    padding-bottom: {{ section.settings.desk-padding-bottom }}px;
    border-bottom: 1px solid #f0f0f0;
  }
  #shopify-section-{{section.id}} .breadcrumbs__wrapper {
    width: 100%;
  }
  #shopify-section-{{section.id}} .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{section.id}} .breadcrumb a {
    font-family: 'Generis Sans W01 Regular', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    color: #000000;
    opacity: 0.8;
    text-decoration: none;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  #shopify-section-{{section.id}} .breadcrumb a:hover {
    opacity: 1;
    color: #000000;
    text-decoration: underline;
  }
  #shopify-section-{{section.id}} .breadcrumb span {
    font-family: 'Generis Sans W01 Regular', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    color: #000000;
    opacity: 0.8;
  }
  #shopify-section-{{section.id}} .breadcrumb span.breadcrumb__current {
    font-weight: 500;
    opacity: 0.9;
  }
  #shopify-section-{{section.id}} .breadcrumb .divider {
    margin: 0 8px;
    color: #888888;
    opacity: 0.6;
    font-size: 13px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{section.id}} {
      padding-top: {{ section.settings.mob-padding-top }}px;
      padding-bottom: {{ section.settings.mob-padding-bottom }}px;
    }
    #shopify-section-{{section.id}} .breadcrumb a,
    #shopify-section-{{section.id}} .breadcrumb span {
      font-size: 12px;
      line-height: 16px;
    }
    #shopify-section-{{section.id}} .breadcrumb .divider {
      margin: 0 5px;
      font-size: 11px;
    }
  }
</style>

<div class="breadcrumbs__wrapper">
  <div class="container">
    {% unless template == 'index' or settings.breadcrumbs == false %}
    <nav class="breadcrumb breadcrumbs--default inherit" role="navigation" aria-label="breadcrumbs">
      <a href="{{ routes.root_url }}" title="Home">Home</a>

      {% if template contains 'page' %}
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">{{ page.title }}</span>

      {% elsif template == 'list-collections' %}
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">Collections</span>

      {% elsif template == 'cart' %}
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">Cart</span>

      {% elsif template contains 'product' %}
        {%- liquid
          assign product_collection = collection
          if product_collection == blank
            for c in product.collections
              unless c.handle == 'all' or c.handle == 'frontpage'
                assign product_collection = c
                break
              endunless
            endfor
            if product_collection == blank
              assign product_collection = product.collections.first
            endif
          endif
        -%}
        {% if product_collection %}
          <span class="divider" aria-hidden="true">/</span>
          <a href="{{ product_collection.url }}" title="{{ product_collection.title | escape }}">{{ product_collection.title | escape }}</a>
        {% endif %}
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">{{ product.title }}</span>

      {% elsif template contains 'collection' and collection.handle %}
        <span class="divider" aria-hidden="true">/</span>
        {% if current_tags %}
          <a href="{{ routes.collections_url }}/{{ collection.handle }}">{{ collection.title | escape }}</a>
          <span class="divider" aria-hidden="true">/</span>
          <span class="breadcrumb__current" aria-current="page">{{ current_tags | join: " + " }}</span>
        {% else %}
          <span class="breadcrumb__current" aria-current="page">{{ collection.title | escape }}</span>
        {% endif %}

      {% elsif template == 'blog' %}
        <span class="divider" aria-hidden="true">/</span>
        {% if current_tags %}
          <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
          <span class="divider" aria-hidden="true">/</span>
          <span class="breadcrumb__current" aria-current="page">{{ current_tags | join: " + " }}</span>
        {% else %}
          <span class="breadcrumb__current" aria-current="page">{{ blog.title | escape }}</span>
        {% endif %}

      {% elsif template == 'article' %}
        <span class="divider" aria-hidden="true">/</span>
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">{{ article.title }}</span>

      {% elsif template contains 'search' %}
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">Search</span>

      {% elsif template.directory == 'customers' %}
        <span class="divider" aria-hidden="true">/</span>
        {% if template.name == 'account' %}
          <span class="breadcrumb__current" aria-current="page">My Account</span>
        {% elsif template.name == 'login' %}
          <span class="breadcrumb__current" aria-current="page">Login</span>
        {% elsif template.name == 'register' %}
          <span class="breadcrumb__current" aria-current="page">Register</span>
        {% elsif template.name == 'addresses' %}
          <a href="{{ routes.account_url }}">My Account</a>
          <span class="divider" aria-hidden="true">/</span>
          <span class="breadcrumb__current" aria-current="page">Addresses</span>
        {% elsif template.name == 'order' %}
          <a href="{{ routes.account_url }}">My Account</a>
          <span class="divider" aria-hidden="true">/</span>
          <span class="breadcrumb__current" aria-current="page">Order {{ order.name }}</span>
        {% else %}
          <span class="breadcrumb__current" aria-current="page">{{ page_title }}</span>
        {% endif %}

      {% else %}
        <span class="divider" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">{{ page_title }}</span>
      {% endif %}
    </nav>
    {% endunless %}
  </div>
</div>

{% unless template == 'index' or settings.breadcrumbs == false %}
<script>
(function() {
  try {
    var KEY_LANDING_PAGE = 'kisah_landing_page';
    var KEY_CLICKED_FROM_PAGE = 'kisah_clicked_from_page';
    var KEY_CLICKED_FROM_HEADER = 'kisah_clicked_from_header';
    var KEY_ACTIVE_COLLECTION = 'kisah_active_collection';

    var currentPath = window.location.pathname;
    var isHome = currentPath === '/' || currentPath === '';
    var pageType = '{{ template.name }}';
    var pageTitle = {{ page_title | default: '' | json }};

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // On homepage, reset all contextual navigation state
    if (isHome || pageType === 'index') {
      sessionStorage.removeItem(KEY_LANDING_PAGE);
      sessionStorage.removeItem(KEY_CLICKED_FROM_PAGE);
      sessionStorage.removeItem(KEY_CLICKED_FROM_HEADER);
      sessionStorage.removeItem(KEY_ACTIVE_COLLECTION);
      return;
    }

    // Check if user came from a header menu click
    var cameFromHeader = sessionStorage.getItem(KEY_CLICKED_FROM_HEADER) === 'true';
    if (cameFromHeader) {
      sessionStorage.removeItem(KEY_CLICKED_FROM_HEADER);
      sessionStorage.removeItem(KEY_LANDING_PAGE);
      sessionStorage.removeItem(KEY_CLICKED_FROM_PAGE);
    }

    // Referrer analysis
    var referrerPath = '';
    var isSameOriginReferrer = false;
    try {
      if (document.referrer) {
        var refObj = new URL(document.referrer);
        if (refObj.origin === window.location.origin) {
          isSameOriginReferrer = true;
          referrerPath = refObj.pathname;
        }
      }
    } catch(e) {}

    // If arriving directly or from an external site, reset any contextual landing page
    if (!isSameOriginReferrer) {
      sessionStorage.removeItem(KEY_LANDING_PAGE);
      sessionStorage.removeItem(KEY_CLICKED_FROM_PAGE);
      sessionStorage.removeItem(KEY_CLICKED_FROM_HEADER);
      sessionStorage.removeItem(KEY_ACTIVE_COLLECTION);
    }

    // Global listener to track link clicks (Capture Phase)
    if (!window.__kisahBreadcrumbListenerAdded) {
      window.__kisahBreadcrumbListenerAdded = true;
      document.addEventListener('click', function(e) {
        try {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

          var isBreadcrumb = !!link.closest('.breadcrumb');
          if (isBreadcrumb) return;

          var isInMainContent = !!link.closest('main, #content');
          var isHeader = !isInMainContent && !!link.closest('.section-header, .pageheader, #pageheader, header, [id*="header-group"], [id*="__header"], .site-header, .mobile-navigation-drawer, nav.navigation');

          if (isHeader) {
            // Clicked in site header navigation -> reset landing page flow
            sessionStorage.setItem(KEY_CLICKED_FROM_HEADER, 'true');
            sessionStorage.removeItem(KEY_LANDING_PAGE);
            sessionStorage.removeItem(KEY_CLICKED_FROM_PAGE);
            sessionStorage.removeItem(KEY_ACTIVE_COLLECTION);
          } else if (isInMainContent) {
            // Clicked inside main page body
            if (window.location.pathname.indexOf('/pages/') !== -1) {
              sessionStorage.setItem(KEY_CLICKED_FROM_PAGE, 'true');
              sessionStorage.removeItem(KEY_CLICKED_FROM_HEADER);
            }
          }
        } catch(err) {}
      }, true);
    }

    var trail = [{ title: 'Home', url: '/' }];

    {% if template contains 'page' %}
      var currentPage = {
        title: {{ page.title | json }},
        url: {{ page.url | json }}
      };
      sessionStorage.setItem(KEY_LANDING_PAGE, JSON.stringify(currentPage));
      sessionStorage.removeItem(KEY_ACTIVE_COLLECTION);
      sessionStorage.removeItem(KEY_CLICKED_FROM_PAGE);

      trail.push({ title: currentPage.title, url: currentPage.url });

    {% elsif template contains 'collection' and collection.handle %}
      var currentCollection = {
        title: {{ collection.title | json }},
        url: {{ collection.url | json }}
      };

      var clickedFromPage = sessionStorage.getItem(KEY_CLICKED_FROM_PAGE) === 'true';
      var refIsPage = referrerPath.indexOf('/pages/') !== -1;
      var landingPage = null;

      try {
        var rawLanding = sessionStorage.getItem(KEY_LANDING_PAGE);
        if (rawLanding) {
          landingPage = JSON.parse(rawLanding);
        }
      } catch(e) {}

      // Retain landing page ONLY if navigation originated from that landing page or within same flow
      var isSameCollection = referrerPath.indexOf(currentCollection.url) !== -1 || referrerPath === currentPath;
      var isFromProduct = referrerPath.indexOf('/products/') !== -1;
      var cameFromLandingPage = !cameFromHeader && landingPage && (clickedFromPage || refIsPage || isSameCollection || isFromProduct);

      if (cameFromLandingPage) {
        trail.push({ title: landingPage.title, url: landingPage.url });
      } else {
        landingPage = null;
        sessionStorage.removeItem(KEY_LANDING_PAGE);
      }
      sessionStorage.removeItem(KEY_CLICKED_FROM_PAGE);

      trail.push({ title: currentCollection.title, url: currentCollection.url });
      sessionStorage.setItem(KEY_ACTIVE_COLLECTION, JSON.stringify(currentCollection));

    {% elsif template contains 'product' %}
      var currentProduct = {
        title: {{ product.title | json }},
        url: {{ product.url | json }}
      };

      {%- liquid
        assign prod_col = collection
        if prod_col == blank
          for c in product.collections
            unless c.handle == 'all' or c.handle == 'frontpage'
              assign prod_col = c
              break
            endunless
          endfor
          if prod_col == blank
            assign prod_col = product.collections.first
          endif
        endif
      -%}

      var defaultCollection = {
        title: {{ prod_col.title | default: '' | json }},
        url: {{ prod_col.url | default: '' | json }}
      };

      var landingPage = null;
      try {
        var rawLanding = sessionStorage.getItem(KEY_LANDING_PAGE);
        if (rawLanding) {
          landingPage = JSON.parse(rawLanding);
        }
      } catch(e) {}

      var activeCol = null;
      try {
        var rawCol = sessionStorage.getItem(KEY_ACTIVE_COLLECTION);
        if (rawCol) {
          activeCol = JSON.parse(rawCol);
        }
      } catch(e) {}

      var chosenCol = activeCol || (defaultCollection.title ? defaultCollection : null);

      if (landingPage) {
        trail.push({ title: landingPage.title, url: landingPage.url });
      }

      if (chosenCol && chosenCol.title) {
        trail.push({ title: chosenCol.title, url: chosenCol.url });
      }

      trail.push({ title: currentProduct.title, url: currentProduct.url });

    {% elsif template contains 'blog' %}
      trail.push({ title: {{ blog.title | json }}, url: {{ blog.url | json }} });

    {% elsif template contains 'article' %}
      trail.push({ title: {{ blog.title | json }}, url: {{ blog.url | json }} });
      trail.push({ title: {{ article.title | json }}, url: {{ article.url | json }} });

    {% elsif template contains 'cart' %}
      trail.push({ title: 'Cart', url: '/cart' });

    {% elsif template contains 'search' %}
      trail.push({ title: 'Search', url: '/search' });

    {% elsif template.directory == 'customers' %}
      {% if template.name == 'account' %}
        trail.push({ title: 'My Account', url: '{{ routes.account_url }}' });
      {% elsif template.name == 'login' %}
        trail.push({ title: 'Login', url: '{{ routes.account_login_url }}' });
      {% elsif template.name == 'register' %}
        trail.push({ title: 'Register', url: '{{ routes.account_register_url }}' });
      {% elsif template.name == 'addresses' %}
        trail.push({ title: 'My Account', url: '{{ routes.account_url }}' });
        trail.push({ title: 'Addresses', url: '{{ routes.account_addresses_url }}' });
      {% elsif template.name == 'order' %}
        trail.push({ title: 'My Account', url: '{{ routes.account_url }}' });
        trail.push({ title: 'Order {{ order.name }}', url: '' });
      {% else %}
        trail.push({ title: pageTitle, url: currentPath });
      {% endif %}

    {% else %}
      trail.push({ title: pageTitle, url: currentPath });
    {% endif %}

    // Render breadcrumb HTML
    var nav = document.querySelector('#shopify-section-{{ section.id }} .breadcrumb');
    if (nav && trail.length > 1) {
      var html = '';
      for (var n = 0; n < trail.length; n++) {
        var crumb = trail[n];
        var isLast = (n === trail.length - 1);
        if (n > 0) {
          html += '<span class="divider" aria-hidden="true">/</span>';
        }
        if (isLast) {
          html += '<span class="breadcrumb__current" aria-current="page">' + escapeHtml(crumb.title) + '</span>';
        } else {
          html += '<a href="' + crumb.url + '" title="' + escapeHtml(crumb.title) + '">' + escapeHtml(crumb.title) + '</a>';
        }
      }
      nav.innerHTML = html;
    }
  } catch (err) {
    console.warn('Breadcrumb trail error:', err);
  }
})();
</script>
{% endunless %}

{% schema %}
  {
    "name": "Breadcrumbs",
    "settings": [
       {
         "type": "header",
        "content": "SECTION PADDING FOR DESKTOP"
      },
      {
        "type": "range",
        "id": "desk-padding-top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding Top",
        "default": 12
      },
      {
        "type": "range",
        "id": "desk-padding-bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 12
      },
      {
        "type": "header",
        "content": "SECTION PADDING FOR MOBILE"
      },
      {
        "type": "range",
        "id": "mob-padding-top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding Top",
        "default": 8
      },
      {
        "type": "range",
        "id": "mob-padding-bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 8
      }
    ],
    "presets": [
      {
        "name": "Breadcrumbs"
      }
    ]
  }
{% endschema %}