{% style %}
  body.template-page.template-suffix-landing-page-denim.swatch-method-variant-images.swatch-style-icon_circle.smart-cart--enabled {
    background: white;
  }
  #shopify-section-{{ section.id }} .responsive-banner-wrapper {
    width: 100%;
    display: block;
    position: relative;
    {% unless section.settings.full_width %}
    max-width: 1320px;
    margin: 0 auto;
    {% endunless %}
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    line-height: 0;
    font-size: 0;
  }
  #shopify-section-{{ section.id }} .responsive-banner-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .responsive-banner-wrapper .desktop-banner {
      display: none;
    }
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .responsive-banner-wrapper .mobile-banner {
      display: none;
    }
  }
{% endstyle %}

<div class="responsive-banner-wrapper">
  {% if section.settings.desktop_image %}
    <img
      width="{{ section.settings.desktop_image.width }}"
      height="{{ section.settings.desktop_image.height }}"
      loading="lazy"
      src="{{ section.settings.desktop_image | image_url: width: 2000 }}"
      alt="{{ section.settings.alt_text }}"
      class="desktop-banner"
      loading="lazy"
    >
  {% endif %}

  {% if section.settings.mobile_image %}
    <img
      width="{{ section.settings.mobile_image.width }}"
      height="{{ section.settings.mobile_image.height }}"
      loading="lazy"
      src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
      alt="{{ section.settings.alt_text }}"
      class="mobile-banner"
      loading="lazy"
    >
  {% endif %}
</div>

{% schema %}
{
  "name": "Responsive Banner Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text",
      "default": "Banner"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Responsive Banner Image"
    }
  ]
}
{% endschema %}
