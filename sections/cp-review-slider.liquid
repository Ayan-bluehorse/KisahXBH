{% comment %}
CP Review Slider
{% endcomment %}

<section class="cp-review-slider" id="cp-review-slider--{{ section.id }}">
  <div class="cp-review-slider__container">
    {% if section.settings.heading != blank %}
      <div class="cp-review-slider__heading">{{ section.settings.heading }}</div>
    {% endif %}

    <div class="cp-review-slider__track">
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image -%}
        <div class="cp-review-slider__card" {{ block.shopify_attributes }}>
          {% if img != blank %}
            <img
              src="{{ img | image_url: width: 800 }}"
              width="{{ img.width }}"
              height="{{ img.height }}"
              alt="{{ block.settings.alt | escape }}"
              loading="lazy"
            >
          {% endif %}

          {% if block.settings.link != blank %}
            <img class="cp-review-slider__new-tab"
                 width="400" height="400" loading="lazy" src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/new_tab_icon_8c265152-5fc3-4f3f-8e15-acf2c82c3699.png"
                 alt="Open link"
                 data-link="{{ block.settings.link }}">
          {% endif %}

          {% if block.settings.text != blank %}
            <span class="cp-review-slider__text">{{ block.settings.text }}</span>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>

    <div class="cp-review-slider__dots"></div>
  </div>

  <style>

    .cp-review-slider .cp-review-slider__text{
      position:absolute;bottom:20px;text-align:center;left:50%;font-weight:400;font-size:14px;border-radius:6px;
      font-family:"Generis Sans W01 Regular";transform:translateX(-50%);padding:10px;width:90%;color:#fff;background:#00000066;
    }

    .cp-review-slider .cp-review-slider__container{width:100%;max-width:600px;margin-block:20px;margin-inline:auto;overflow:hidden;position:relative}
    .cp-review-slider .cp-review-slider__heading{font-size:22px;font-weight:400;color:#333333;font-family:"Generis Sans W01 Bold"!important;display:flex;justify-content:center;align-items:center;margin-bottom:20px}
    .cp-review-slider .cp-review-slider__track{display:flex;transition:transform .4s ease;gap:8px;align-items:center;will-change:transform}
    .cp-review-slider .cp-review-slider__card{width:241px;height:294px;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 6px 16px rgba(0,0,0,.2);position:relative;flex-shrink:0;transition:transform .4s ease,opacity .4s ease}
    .cp-review-slider .cp-review-slider__card.is-active{height:323px}
    .cp-review-slider .cp-review-slider__card img{width:100%;height:100%}
    .cp-review-slider .cp-review-slider__card img.cp-review-slider__new-tab{width:18px;height:18px;position:absolute;top:15px;right:15px;cursor:pointer}
    .cp-review-slider .cp-review-slider__content{position:absolute;bottom:0;background:linear-gradient(to top,rgba(0,0,0,.6),transparent);color:#fff;padding:12px;width:100%;box-sizing:border-box}
    .cp-review-slider .cp-review-slider__card.active{transform:scale(1.1) translateY(0) rotateY(0deg);z-index:2;opacity:1}
    .cp-review-slider .cp-review-slider__card.inactive-left{transform:scale(.9) rotateY(20deg) translateX(-10px);opacity:1;z-index:1}
    .cp-review-slider .cp-review-slider__card.inactive-right{transform:scale(.9) rotateY(20deg) translateX(-10px);opacity:1;z-index:1}
    .cp-review-slider .cp-review-slider__dots{display:flex;justify-content:center;margin-top:12px;gap:8px}
    .cp-review-slider .cp-review-slider__dot{width:10px;height:10px;border-radius:50%;background:#ccc;cursor:pointer;transition:background .3s}
    .cp-review-slider .cp-review-slider__dot.active{background:#000}
@media (min-width: 769px) {
.cp-review-slider .cp-review-slider__container {
    width: 100%;
    max-width: 750px;
}
.cp-review-slider .cp-review-slider__track {
    display: flex;
    transition: transform .4s ease;
    gap: 10px;
    align-items: center;
    will-change: transform;
}
}
  </style>

  <script>
    (function(){
      const root = document.getElementById('cp-review-slider--{{ section.id }}');
      if(!root) return;

      const track = root.querySelector('.cp-review-slider__track');
      const dotsContainer = root.querySelector('.cp-review-slider__dots');
      if(!track) return;

      const originalCards = Array.from(track.children);
      if(originalCards.length === 0) return;

      originalCards.forEach((_, i) => {
        const dot = document.createElement('span');
        dot.className = 'cp-review-slider__dot' + (i===0?' active':'');
        dot.dataset.index = (i+1).toString();
        dotsContainer.appendChild(dot);
      });

      const firstClone = originalCards[0].cloneNode(true);
      const lastClone  = originalCards[originalCards.length-1].cloneNode(true);
      track.appendChild(firstClone);
      track.insertBefore(lastClone, track.firstElementChild);

      const totalCards = originalCards.length + 2;
      let currentIndex = 1;

      function updateCarousel(smooth=true){
        const cards = track.querySelectorAll('.cp-review-slider__card');
        if(cards.length === 0) return;

        const cardWidth = cards[0].offsetWidth + 8; 
        const container = root.querySelector('.cp-review-slider__container');
        const containerWidth = container ? container.offsetWidth : cardWidth;
        const offset = (containerWidth - cardWidth) / 2;
        const translateX = -currentIndex * cardWidth + offset;

        track.style.transition = smooth ? 'transform 0.4s ease' : 'none';
        track.style.transform = `translateX(${translateX}px)`;

        cards.forEach((card, idx) => {
          card.classList.toggle('is-active', idx === currentIndex);
        });

        const realIndex = (currentIndex === 0) ? originalCards.length
                         : (currentIndex === totalCards - 1) ? 1
                         : currentIndex;

        dotsContainer.querySelectorAll('.cp-review-slider__dot').forEach((dot, i) => {
          dot.classList.toggle('active', (i+1) === realIndex);
        });
      }

      track.addEventListener('transitionend', () => {
        if (currentIndex === 0) {
          currentIndex = originalCards.length;
          updateCarousel(false);
        } else if (currentIndex === totalCards - 1) {
          currentIndex = 1;
          updateCarousel(false);
        }
      });

      // Swipe
      let startX = 0;
      track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, {passive:true});
      track.addEventListener('touchend', (e) => {
        const endX = e.changedTouches[0].clientX;
        if (endX - startX > 50) { currentIndex--; updateCarousel(); }
        else if (startX - endX > 50) { currentIndex++; updateCarousel(); }
      });

      // Dots click
      dotsContainer.addEventListener('click', (e) => {
        const t = e.target;
        if (t && t.classList && t.classList.contains('cp-review-slider__dot')) {
          const targetIndex = Number(t.dataset.index);
          currentIndex = targetIndex;
          updateCarousel();
        }
      });

      function bindNewTabClicks(scope){
        scope.querySelectorAll('img.cp-review-slider__new-tab[data-link]').forEach(el=>{
          el.addEventListener('click', ()=> {
            const url = el.getAttribute('data-link');
            if (url) window.location.href = url;
          });
        });
      }
      bindNewTabClicks(track);

      const recalc = ()=> updateCarousel(false);
      if('ResizeObserver' in window){
        const ro = new ResizeObserver(recalc);
        ro.observe(root.querySelector('.cp-review-slider__container'));
      } else {
        window.addEventListener('resize', recalc);
      }

      updateCarousel(false);
    })();
  </script>
</section>

{% schema %}
{
  "name": "CP Review Slider (clean)",
  "tag": "section",
  "class": "section cp-review-slider-section",
  "settings": [
    { "type": "header", "content": "Developed by Convert Polo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "#SpottedInKisah" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Product/link (icon opens this)" },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Review text" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "CP Review Slider",
      "category": "Custom",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
