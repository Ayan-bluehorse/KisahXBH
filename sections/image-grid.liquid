<div class="container">
  <div class="mx-container">
  <div class="grid-head-part">
  {%- if section.settings.head != blank -%}
  <h2>{{ section.settings.head }}</h2>
  {% endif %}
  </div>
<div class="image-grid-collection">
  {% for block in section.blocks %}
    <div class="imagegrid-container">
      {% if  block.settings.link != blank  %}
       <a href="{{ block.settings.link }}">
      {% endif %}
      {% if block.settings.img != blank %}
        <img src="{{ block.settings.img | image_url}}" width="auto" height="auto" class="grid-images">
        {% endif %}
      {% if  block.settings.link != blank  %}
       </a>
        <div class="day-text">
          <p>{{ block.settings.text }}</p>
        </div>
      {% endif %}  
    </div>
  {% endfor %}
   <div class="shop-all-coll-btn">
    {% if section.settings.link != blank %}
    <a href="{{ section.settings.link}}">{{ section.settings.btn }}</a>
    {% endif %}
  </div>
</div>
</div>
</div>

<style>
#shopify-section-{{section.id}} {
      padding-top: {{ section.settings.desk-padding-top }}px;
      padding-bottom: {{ section.settings.desk-padding-bottom }}px;
      background:{{section.settings.bg-color}};
}
#shopify-section-{{section.id}} .mx-container {
      max-width:1000px;
      margin:0 auto;
}
#shopify-section-{{ section.id }} .grid-head-part h2{
    font-family: var(--base-font-family);
    font-size: 48px;
    font-weight: 700;
    line-height: 57.6px;
    text-align: center;
    color:{{ section.settings.head-color | default:"#201747" }};
    text-transform: uppercase;
}
#shopify-section-{{section.id}} .image-grid-collection{
    display:flex;
    flex-wrap:wrap;
    gap:20px;
    width:100%;
    /* justify-content:center; */
}
#shopify-section-{{section.id}} .imagegrid-container{
   max-width:31.9%;
   box-sizing: border-box;
}
#shopify-section-{{section.id}} .imagegrid-container a{
    display:block;
}
#shopify-section-{{section.id}} .imagegrid-container .grid-images{
   width:100%;
}
#shopify-section-{{section.id}} .imagegrid-container .day-text p{
    text-align: center;
    margin: 0;
    font-size: 16px;
    line-height: 18px;
    color: #000000;
}
#shopify-section-{{section.id}} .image-grid-collection .shop-all-coll-btn{
    margin: 0 auto;
    padding-top: 10px;
}
#shopify-section-{{section.id}} .image-grid-collection .shop-all-coll-btn a{
    color: #fff;
    background: #201747;
    box-shadow: 0px 4px 8px 3px #00000026;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 16px;
    line-height: 17.74px;
    width: fit-content;
    display: block;
    margin:0 auto;
}
