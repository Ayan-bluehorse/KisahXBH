{% schema %}
  {
    "name": "image grid",
    "settings": [
    {
      "type": "text",
      "id": "head",
       "label": "Heading"
      },
     {
        "type": "text",
        "id": "btn",
        "label": "Button Name"
      },
      {
        "type": "url",
        "id":"link",
         "label": "Button Link"
      },
    {
        "type": "header",
        "content": "SECTION PADDING FOR DESKTOP"
    },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
      
    ],
    "blocks": [
      {
        "type": "image-grid",
         "name": "Image grid",
        "settings": [
          {
            "type": "image_picker",
             "id":"img",
              "label": "image"
          },
          {
            "type": "url",
            "id": "link",
             "label": "Image link"
          },
          {
            "type": "text",
            "id": "text",
             "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "image grid"
      }
    ]
  }
{% endschema %}