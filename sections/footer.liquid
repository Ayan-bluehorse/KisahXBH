                {% for link in linklists[block.settings.menu-1].links %}
                  <li>
                    <a href="{{ link.url }}" {% if link.title.size < 25 %}class="no-wrap"{% endif %}>
                      {{- link.title -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}  

             {% if block.settings.menu-2 != blank %}
              <ul class="category-menu-list-links" {{ block.shopify_attributes }}>
                {% for link in linklists[block.settings.menu-2].links %}
