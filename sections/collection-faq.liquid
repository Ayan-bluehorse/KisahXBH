{%- comment -%}
  Collection FAQ Section (Standalone Section)
  Renders FAQs from collection.metafields.custom.collection_faq (Type: JSON)
{%- endcomment -%}

{%- liquid
  assign faq_raw = collection.metafields.custom.collection_faq
  assign faq_val = faq_raw.value | default: faq_raw
-%}

{%- if faq_val != blank -%}
  <section class="container collection-faq-standalone-section" id="collectionFaqStandalone-{{ section.id }}" aria-label="Collection FAQ">
    {% render 'collection-faq-accordion', heading: section.settings.heading %}
  </section>

  <style>
    .collection-faq-standalone-section {
      padding-top: {{ section.settings.padding_top | default: 20 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Collection FAQ",
  "class": "section-collection-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Collection FAQ"
    }
  ]
}
{% endschema %}

