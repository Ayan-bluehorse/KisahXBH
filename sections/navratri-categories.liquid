{%- style -%}
  /* Dynamic colour overrides — driven by theme editor settings */
  #navratri-categories-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#faf6f0' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__title {
    color: {{ section.settings.text_color | default: '#111111' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__subtitle,
  #navratri-categories-{{ section.id }} .cp-navratri-categories__kicker {
    color: {{ section.settings.sub_color | default: '#c9a96e' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__item {
    border: 1px solid {{ section.settings.border_color | default: '#ded2ca' }};
    background: {{ section.settings.card_bg_color | default: '#EDE8DF' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__footer {
    border-top-color: {{ section.settings.border_color | default: '#ded2ca' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__name {
    color: {{ section.settings.label_color | default: '#18120f' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__arrow-icon {
    color: {{ section.settings.label_color | default: '#18120f' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__nav-arrow {
    border-color: {{ section.settings.border_color | default: '#ded2ca' }};
    color: {{ section.settings.label_color | default: '#18120f' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__nav-arrow:hover {
    background: {{ section.settings.label_color | default: '#18120f' }};
    color: #fff;
    border-color: {{ section.settings.label_color | default: '#18120f' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__dot {
    background: {{ section.settings.border_color | default: '#ded2ca' }};
  }
  #navratri-categories-{{ section.id }} .cp-navratri-categories__dot.is-active {
    background: {{ section.settings.label_color | default: '#18120f' }};
  }
{%- endstyle -%}

<section class="cp-navratri-categories" id="navratri-categories-{{ section.id }}">
  <div class="cp-navratri-container">
    <div class="cp-navratri-categories__header">
      <div class="cp-navratri-categories__title-wrap">
        {%- if section.settings.kicker != blank -%}
          <span class="cp-navratri-categories__kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="cp-navratri-categories__title">{{ section.settings.title | default: 'SHOP BY CATEGORY' }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="cp-navratri-categories__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_colour_filter -%}
        <div class="cp-navratri-colour-chip-group" data-colour-dropdown>
          <span class="cp-navratri-colour-label">COLOUR</span>
          <div class="cp-navratri-colour-dots-row">
            <button type="button" class="cp-navratri-quick-dot" style="background-color: #8E2424;" data-colour-val="wine-maroon-purple" title="Wine &amp; Maroon"></button>
            <button type="button" class="cp-navratri-quick-dot" style="background-color: #0F3B36;" data-colour-val="green" title="Green &amp; Emerald"></button>
            <button type="button" class="cp-navratri-quick-dot" style="background-color: #0F1D33;" data-colour-val="navy-brown-black" title="Navy &amp; Black"></button>
            <button type="button" class="cp-navratri-quick-dot" style="background-color: #C2A676;" data-colour-val="yellow-orange" title="Mustard &amp; Gold"></button>
            <button type="button" class="cp-navratri-quick-dot" style="background-color: #EAE5D9;" data-colour-val="white-cream" title="Ivory &amp; Cream"></button>
          </div>
          <div class="cp-navratri-colour-select-wrap">
            <button type="button" class="cp-navratri-colour-select-btn" data-colour-trigger aria-expanded="false">
              <span data-colour-label>All</span>
              <svg class="cp-dropdown-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="cp-navratri-colour-chip-menu" data-colour-menu>
              <button type="button" class="cp-navratri-colour-option" data-colour-val="navy-brown-black">Navy, Brown &amp; Black</button>
              <button type="button" class="cp-navratri-colour-option" data-colour-val="wine-maroon-purple">Wine, Maroon &amp; Purple</button>
              <button type="button" class="cp-navratri-colour-option" data-colour-val="white-cream">White &amp; Cream</button>
              <button type="button" class="cp-navratri-colour-option" data-colour-val="yellow-orange">Yellow &amp; Orange</button>
              <button type="button" class="cp-navratri-colour-option" data-colour-val="pastels">Pastels</button>
              <button type="button" class="cp-navratri-colour-clear" data-colour-clear>Clear filter</button>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Slider Track with Arrows & Dots — same pattern as Navratri Gateway -->
    <div class="cp-navratri-categories__track-wrap">

      <!-- Prev Arrow -->
      <button type="button" class="cp-navratri-categories__nav-arrow cp-navratri-categories__nav-arrow--prev is-hidden" id="categories-prev-{{ section.id }}" aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Scrollable Track -->
      <div class="cp-navratri-categories__track" id="categories-track-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="cp-navratri-categories__item" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: '/collections/all' }}" class="cp-navratri-categories__link">
                <div class="cp-navratri-categories__media">
                  {%- if block.settings.image != blank -%}
                    <img 
                      src="{{ block.settings.image | image_url: width: 800 }}" 
                      alt="{{ block.settings.title | escape }}" 
                      loading="lazy"
                      class="cp-navratri-categories__img">
                  {%- else -%}
                    <div class="cp-navratri-categories__placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'cp-navratri-placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
                <div class="cp-navratri-categories__footer">
                  <span class="cp-navratri-categories__name">{{ block.settings.title }}</span>
                  <svg class="cp-navratri-categories__arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback 4 Categories -->
          {%- assign cat_titles = "MIRRORWORK,PRINTS,JACQUARD & TEXTURED,KURTA SETS" | split: "," -%}
          {%- assign cat_links = "/collections/kurta-sets,/collections/indowestern-sets,/collections/short-kurta,/collections/kurta-sets" | split: "," -%}
          {%- for title in cat_titles -%}
            {%- assign cat_idx = forloop.index | minus: 1 -%}
            <div class="cp-navratri-categories__item">
              <a href="{{ cat_links[cat_idx] }}" class="cp-navratri-categories__link">
                <div class="cp-navratri-categories__media">
                  <div class="cp-navratri-categories__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'cp-navratri-placeholder-svg' }}
                  </div>
                </div>
                <div class="cp-navratri-categories__footer">
                  <span class="cp-navratri-categories__name">{{ title }}</span>
                  <svg class="cp-navratri-categories__arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- Next Arrow -->
      <button type="button" class="cp-navratri-categories__nav-arrow cp-navratri-categories__nav-arrow--next" id="categories-next-{{ section.id }}" aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Dots -->
      {%- assign block_count = section.blocks.size -%}
      {%- if block_count == 0 -%}{%- assign block_count = 4 -%}{%- endif -%}
      {%- if block_count > 1 -%}
        <div class="cp-navratri-categories__dots cp-navratri-categories__dots--{{ section.id }}" aria-label="Slide indicators">
          {%- for i in (1..block_count) -%}
            <button type="button" class="cp-navratri-categories__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
  (function() {
    function initCategorySlider() {
      var track = document.getElementById('categories-track-{{ section.id }}');
      if (!track) return;
      var wrap = track.closest('.cp-navratri-categories__track-wrap');
      if (!wrap) return;

      var prevBtn = document.getElementById('categories-prev-{{ section.id }}');
      var nextBtn = document.getElementById('categories-next-{{ section.id }}');
      var dotsWrap = wrap.querySelector('.cp-navratri-categories__dots--{{ section.id }}');
      var dots = dotsWrap ? dotsWrap.querySelectorAll('.cp-navratri-categories__dot') : [];
      var cards = track.querySelectorAll('.cp-navratri-categories__item');

      if (!cards.length) return;

      function updateNavState() {
        var scrollLeft = track.scrollLeft;
        var maxScroll = track.scrollWidth - track.clientWidth;

        if (prevBtn) {
          prevBtn.classList.toggle('is-hidden', scrollLeft <= 4);
        }
        if (nextBtn) {
          nextBtn.classList.toggle('is-hidden', scrollLeft >= maxScroll - 4);
        }

        // Dot: highlight the card closest to the left edge of the track
        if (dots.length) {
          var trackLeft = track.getBoundingClientRect().left;
          var closestIdx = 0;
          var minDist = Infinity;
          cards.forEach(function(card, idx) {
            var dist = Math.abs(card.getBoundingClientRect().left - trackLeft);
            if (dist < minDist) {
              minDist = dist;
              closestIdx = idx;
            }
          });
          dots.forEach(function(d, i) {
            d.classList.toggle('is-active', i === closestIdx);
          });
        }
      }

      function getScrollStep() {
        var card = cards[0];
        if (!card) return 300;
        var gap = parseFloat(window.getComputedStyle(track).gap) || 20;
        return card.offsetWidth + gap;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        });
      }

      dots.forEach(function(dot, idx) {
        dot.addEventListener('click', function() {
          if (cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            setTimeout(updateNavState, 350);
          }
        });
      });

      var ticking = false;
      track.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(function() {
            updateNavState();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener('resize', updateNavState);
      updateNavState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategorySlider);
    } else {
      initCategorySlider();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && e.target.querySelector('#navratri-categories-{{ section.id }}')) {
        initCategorySlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Navratri Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (Optional)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Explore our signature styles for every celebration."
    },
    {
      "type": "checkbox",
      "id": "show_colour_filter",
      "label": "Show Colour Filter Dropdown",
      "default": false
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheading Color",
      "default": "#c9a96e"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#EDE8DF"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Category Label Color",
      "default": "#18120f"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card Border Color",
      "default": "#ded2ca"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "KURTA"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Navratri Categories",
      "blocks": [
        { "type": "category_item", "settings": { "title": "KURTA" } },
        { "type": "category_item", "settings": { "title": "KURTA SETS" } },
        { "type": "category_item", "settings": { "title": "SHORT KURTA" } },
        { "type": "category_item", "settings": { "title": "BOTTOMWEAR" } },
        { "type": "category_item", "settings": { "title": "FATHER/SON" } },
        { "type": "category_item", "settings": { "title": "KIDS/PLUS" } }
      ]
    }
  ]
}
{% endschema %}
