{% comment %}
  ==========================================================================
  KISAH FESTIVE STYLE STORY / THE KISAH JOURNAL
  - 4-chapter interactive tabbed editorial story
  - Uses Global Theme Fonts: var(--heading-font-family), var(--base-font-family)
  - Full desktop & mobile responsiveness with luxury magazine layout
  - High contrast readability: white text on dark panels (#1b1722 / After Dark)
  - Zero external dependencies: pure performance & instant loading
  ==========================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

<section 
  id="v5-kj-section-{{ sid }}" 
  class="v5-kj-section"
  style="
    background-color: {{ section.settings.bg_color | default: '#f5f0e8' }};
    padding-top: {{ section.settings.mob_padding_top | default: 28 }}px;
    padding-bottom: {{ section.settings.mob_padding_bottom | default: 32 }}px;
  "
>
  <div class="v5-kj-container">
    <div class="kj-wrapper" id="kj-wrapper-{{ sid }}" aria-labelledby="kj-title-{{ sid }}">
      
      <!-- Section Header -->
      <header class="kj-intro">
        {%- if section.settings.kicker != blank -%}
          <p class="kj-kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="kj-title" id="kj-title-{{ sid }}">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="kj-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.link_text != blank -%}
          <a class="kj-maximalism-link" href="{{ section.settings.link_url | default: '/collections/festive-collection' }}">
            {{ section.settings.link_text }}
          </a>
        {%- endif -%}
      </header>

      {%- assign ch_count = section.blocks.size -%}
      {%- if ch_count == 0 -%}
        {%- assign ch_count = 4 -%}
      {%- endif -%}

      <!-- Chapter Tabs -->
      <div class="kj-nav" role="tablist" aria-label="Choose festive style chapter">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign tab_num = forloop.index -%}
            <button class="kj-tab" type="button" role="tab" id="kj-tab-{{ tab_num }}-{{ sid }}" aria-controls="kj-panel-{{ tab_num }}-{{ sid }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>
              <span class="kj-tab-number">{% if tab_num < 10 %}0{% endif %}{{ tab_num }}</span>
              <span class="kj-tab-label">{{ block.settings.tab_title | default: 'Chapter' }}</span>
            </button>
          {%- endfor -%}
        {%- else -%}
          <button class="kj-tab" type="button" role="tab" id="kj-tab-1-{{ sid }}" aria-controls="kj-panel-1-{{ sid }}" aria-selected="true" tabindex="0">
            <span class="kj-tab-number">01</span>
            <span class="kj-tab-label">{{ section.settings.tab_1_title | default: 'Puja & Ritual' }}</span>
          </button>
          <button class="kj-tab" type="button" role="tab" id="kj-tab-2-{{ sid }}" aria-controls="kj-panel-2-{{ sid }}" aria-selected="false" tabindex="-1">
            <span class="kj-tab-number">02</span>
            <span class="kj-tab-label">{{ section.settings.tab_2_title | default: 'Art & Print' }}</span>
          </button>
          <button class="kj-tab" type="button" role="tab" id="kj-tab-3-{{ sid }}" aria-controls="kj-panel-3-{{ sid }}" aria-selected="false" tabindex="-1">
            <span class="kj-tab-number">03</span>
            <span class="kj-tab-label">{{ section.settings.tab_3_title | default: 'Modern Form' }}</span>
          </button>
          <button class="kj-tab" type="button" role="tab" id="kj-tab-4-{{ sid }}" aria-controls="kj-panel-4-{{ sid }}" aria-selected="false" tabindex="-1">
            <span class="kj-tab-number">04</span>
            <span class="kj-tab-label">{{ section.settings.tab_4_title | default: 'After Dark' }}</span>
          </button>
        {%- endif -%}
      </div>

      <p class="kj-status kj-sr" aria-live="polite" aria-atomic="true">Chapter 1 of {{ ch_count }}</p>

      <!-- Chapter Panels Track -->
      <div class="kj-track" id="kj-track-{{ sid }}" tabindex="0" aria-label="Swipe through festive style chapters">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign ch_num = forloop.index -%}
            {%- assign ch_idx = forloop.index0 -%}
            {%- assign next_ch_idx = ch_idx | plus: 1 -%}
            {%- if next_ch_idx >= section.blocks.size -%}{%- assign next_ch_idx = 0 -%}{%- endif -%}
            {%- assign next_block = section.blocks[next_ch_idx] -%}

            {%- assign is_dark = block.settings.is_dark -%}
            {%- assign bg_color = block.settings.bg_color | default: '#eee4d9' -%}
            {%- assign text_color = block.settings.text_color | default: '#2b2222' -%}
            {%- if is_dark -%}
              {%- assign bg_color = block.settings.bg_color | default: '#191522' -%}
              {%- assign text_color = block.settings.text_color | default: '#ffffff' -%}
            {%- endif -%}

            {%- comment -%} Dynamically determine which looks are active (2, 3, or 4) {%- endcomment -%}
            {%- assign show_look1 = false -%}
            {%- assign show_look2 = false -%}
            {%- assign show_look3 = false -%}
            {%- assign show_look4 = false -%}

            {%- if block.settings.images_count == '2' -%}
              {%- assign show_look1 = true -%}
              {%- assign show_look2 = true -%}
              {%- assign active_count = 2 -%}
            {%- elsif block.settings.images_count == '3' -%}
              {%- assign show_look1 = true -%}
              {%- assign show_look2 = true -%}
              {%- assign show_look3 = true -%}
              {%- assign active_count = 3 -%}
            {%- elsif block.settings.images_count == '4' -%}
              {%- assign show_look1 = true -%}
              {%- assign show_look2 = true -%}
              {%- assign show_look3 = true -%}
              {%- assign show_look4 = true -%}
              {%- assign active_count = 4 -%}
            {%- else -%}
              {%- comment -%} Auto detect: 4 if look4 present, 3 if look3 present, 2 if look2 present {%- endcomment -%}
              {%- if block.settings.look4_img != blank or block.settings.look4_fallback != blank -%}
                {%- assign show_look1 = true -%}
                {%- assign show_look2 = true -%}
                {%- assign show_look3 = true -%}
                {%- assign show_look4 = true -%}
                {%- assign active_count = 4 -%}
              {%- elsif block.settings.look3_img != blank or block.settings.look3_fallback != blank or block.settings.look3_name != blank -%}
                {%- assign show_look1 = true -%}
                {%- assign show_look2 = true -%}
                {%- assign show_look3 = true -%}
                {%- assign active_count = 3 -%}
              {%- elsif block.settings.look2_img != blank or block.settings.look2_fallback != blank -%}
                {%- assign show_look1 = true -%}
                {%- assign show_look2 = true -%}
                {%- assign active_count = 2 -%}
              {%- else -%}
                {%- assign show_look1 = true -%}
                {%- assign show_look2 = true -%}
                {%- assign show_look3 = true -%}
                {%- assign active_count = 3 -%}
              {%- endif -%}
            {%- endif -%}

            <article 
              class="kj-panel{% if is_dark %} kj-panel--dark{% else %} kj-panel--light{% endif %}" 
              id="kj-panel-{{ ch_num }}-{{ sid }}" 
              role="tabpanel" 
              aria-labelledby="kj-tab-{{ ch_num }}-{{ sid }}" 
              data-theme="{{ block.settings.tab_title | default: 'Chapter' }}" 
              style="--scene: {{ bg_color }}; --tone: {{ text_color }};"
              {% unless forloop.first %}inert aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              <div class="kj-panel-inner">
                <div class="kj-eyebrow">
                  <span>{% if ch_num < 10 %}0{% endif %}{{ ch_num }} / {{ block.settings.tab_title | default: 'CHAPTER' | upcase }}</span>
                  <small>SWIPE →</small>
                </div>
                <h3 class="kj-headline">{{ block.settings.headline | default: 'Same rituals.\nYour signature.' | newline_to_br }}</h3>

                <div class="kj-looks" data-count="{{ active_count }}">
                  {%- if show_look1 -%}
                    <a class="kj-look" href="{{ block.settings.look1_link | default: '#' }}" aria-label="{{ block.settings.look1_name | default: 'Look 1' }}">
                      <figure>
                        <div class="kj-photo">
                          {%- if block.settings.look1_img != blank -%}
                            <img src="{{ block.settings.look1_img | image_url: width: 600 }}" alt="{{ block.settings.look1_name | escape }}" width="300" height="400" loading="lazy">
                          {%- elsif block.settings.look1_fallback != blank -%}
                            <img src="{{ block.settings.look1_fallback }}" alt="{{ block.settings.look1_name | escape }}" width="300" height="400" loading="lazy">
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag }}
                          {%- endif -%}
                          <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                        </div>
                        <figcaption>{{ block.settings.look1_name | default: 'Look 1' }}</figcaption>
                      </figure>
                    </a>
                  {%- endif -%}

                  {%- if show_look2 -%}
                    <a class="kj-look" href="{{ block.settings.look2_link | default: '#' }}" aria-label="{{ block.settings.look2_name | default: 'Look 2' }}">
                      <figure>
                        <div class="kj-photo">
                          {%- if block.settings.look2_img != blank -%}
                            <img src="{{ block.settings.look2_img | image_url: width: 600 }}" alt="{{ block.settings.look2_name | escape }}" width="300" height="400" loading="lazy">
                          {%- elsif block.settings.look2_fallback != blank -%}
                            <img src="{{ block.settings.look2_fallback }}" alt="{{ block.settings.look2_name | escape }}" width="300" height="400" loading="lazy">
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag }}
                          {%- endif -%}
                          <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                        </div>
                        <figcaption>{{ block.settings.look2_name | default: 'Look 2' }}</figcaption>
                      </figure>
                    </a>
                  {%- endif -%}

                  {%- if show_look3 -%}
                    <a class="kj-look" href="{{ block.settings.look3_link | default: '#' }}" aria-label="{{ block.settings.look3_name | default: 'Look 3' }}">
                      <figure>
                        <div class="kj-photo">
                          {%- if block.settings.look3_img != blank -%}
                            <img src="{{ block.settings.look3_img | image_url: width: 600 }}" alt="{{ block.settings.look3_name | escape }}" width="300" height="400" loading="lazy">
                          {%- elsif block.settings.look3_fallback != blank -%}
                            <img src="{{ block.settings.look3_fallback }}" alt="{{ block.settings.look3_name | escape }}" width="300" height="400" loading="lazy">
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag }}
                          {%- endif -%}
                          <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                        </div>
                        <figcaption>{{ block.settings.look3_name | default: 'Look 3' }}</figcaption>
                      </figure>
                    </a>
                  {%- endif -%}

                  {%- if show_look4 -%}
                    <a class="kj-look" href="{{ block.settings.look4_link | default: '#' }}" aria-label="{{ block.settings.look4_name | default: 'Look 4' }}">
                      <figure>
                        <div class="kj-photo">
                          {%- if block.settings.look4_img != blank -%}
                            <img src="{{ block.settings.look4_img | image_url: width: 600 }}" alt="{{ block.settings.look4_name | escape }}" width="300" height="400" loading="lazy">
                          {%- elsif block.settings.look4_fallback != blank -%}
                            <img src="{{ block.settings.look4_fallback }}" alt="{{ block.settings.look4_name | escape }}" width="300" height="400" loading="lazy">
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag }}
                          {%- endif -%}
                          <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                        </div>
                        <figcaption>{{ block.settings.look4_name | default: 'Look 4' }}</figcaption>
                      </figure>
                    </a>
                  {%- endif -%}
                </div>

                {%- if block.settings.story != blank -%}
                  <p class="kj-story">{{ block.settings.story }}</p>
                {%- endif -%}
                {%- if block.settings.expression != blank -%}
                  <p class="kj-expression"><strong>The new expression</strong>{{ block.settings.expression }}</p>
                {%- endif -%}
                {%- if block.settings.cta_text != blank -%}
                  <a class="kj-cta" href="{{ block.settings.cta_link | default: '#' }}">
                    {{ block.settings.cta_text }}
                  </a>
                {%- endif -%}

                <div class="kj-next-row">
                  <span class="kj-step">{% if ch_num < 10 %}0{% endif %}{{ ch_num }} / {% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</span>
                  <button class="kj-next" type="button" data-next-target="{{ next_ch_idx }}">Next: {{ next_block.settings.tab_title | default: 'Next Chapter' }}<span aria-hidden="true">→</span></button>
                </div>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          <!-- CHAPTER 1: PUJA & RITUAL -->
        <article 
          class="kj-panel kj-panel--light" 
          id="kj-panel-1-{{ sid }}" 
          role="tabpanel" 
          aria-labelledby="kj-tab-1-{{ sid }}" 
          data-theme="{{ section.settings.tab_1_title | default: 'Puja & Ritual' }}" 
          style="--scene: {{ section.settings.ch1_bg | default: '#eee4d9' }}; --tone: {{ section.settings.ch1_text | default: '#2b2222' }};"
        >
          <div class="kj-panel-inner">
            <div class="kj-eyebrow">
              <span>01 / {{ section.settings.tab_1_title | default: 'PUJA & RITUAL' | upcase }}</span>
              <small>SWIPE →</small>
            </div>
            <h3 class="kj-headline">{{ section.settings.ch1_headline | default: 'Same rituals.\nYour signature.' | newline_to_br }}</h3>

            <div class="kj-looks" data-count="3">
              <a class="kj-look" href="{{ section.settings.ch1_look1_link | default: '/collections/floral-kurta-for-men' }}" aria-label="{{ section.settings.ch1_look1_name | default: 'Floral expression' }}">
                <figure>
                  <div class="kj-photo">
                    {%- if section.settings.ch1_look1_img != blank -%}
                      <img src="{{ section.settings.ch1_look1_img | image_url: width: 600 }}" alt="{{ section.settings.ch1_look1_name }}" width="300" height="400" loading="lazy">
                    {%- else -%}
                      <img src="https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/journal-v2/puja-1.jpg" alt="Wine floral kurta beside a carved stone wall" width="300" height="400" loading="lazy">
                    {%- endif -%}
                    <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                  </div>
                  <figcaption>{{ section.settings.ch1_look1_name | default: 'Floral expression' }}</figcaption>
                </figure>
              </a>
              <a class="kj-look" href="{{ section.settings.ch1_look2_link | default: '/products/wine-kurta-with-palm-embroidery-ka-1187' }}" aria-label="{{ section.settings.ch1_look2_name | default: 'Wine & palms' }}">
                <figure>
                  <div class="kj-photo">
                    {%- if section.settings.ch1_look2_img != blank -%}
                      <img src="{{ section.settings.ch1_look2_img | image_url: width: 600 }}" alt="{{ section.settings.ch1_look2_name }}" width="300" height="400" loading="lazy">
                    {%- else -%}
                      <img src="https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/journal-v2/puja-2.jpg" alt="Wine palm motif kurta with white trousers" width="300" height="400" loading="lazy">
                    {%- endif -%}
                    <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                  </div>
                  <figcaption>{{ section.settings.ch1_look2_name | default: 'Wine & palms' }}</figcaption>
                </figure>
              </a>
              <a class="kj-look" href="{{ section.settings.ch1_look3_link | default: '/collections/green-kurta' }}" aria-label="{{ section.settings.ch1_look3_name | default: 'Olive texture' }}">
                <figure>
                  <div class="kj-photo">
                    {%- if section.settings.ch1_look3_img != blank -%}
                      <img src="{{ section.settings.ch1_look3_img | image_url: width: 600 }}" alt="{{ section.settings.ch1_look3_name }}" width="300" height="400" loading="lazy">
                    {%- else -%}
                      <img src="https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/journal-v2/puja-3.jpg" alt="Olive textured kurta worn with black trousers" width="300" height="400" loading="lazy">
                    {%- endif -%}
                    <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                  </div>
                  <figcaption>{{ section.settings.ch1_look3_name | default: 'Olive texture' }}</figcaption>
                </figure>
              </a>
            </div>

            <p class="kj-story">{{ section.settings.ch1_story | default: 'The kurta holds family memories, festive rituals and memories of the first diya. This season, make your own signature memories with attires that capture your expressions &amp; stories.' }}</p>
            <p class="kj-expression"><strong>The new expression</strong>{{ section.settings.ch1_expression | default: 'Floral, olive, wine or midnight blue: choose your colour and expression.' }}</p>
            
            <a class="kj-cta" href="{{ section.settings.ch1_cta_link | default: '/collections/diwali-puja' }}">
              {{ section.settings.ch1_cta_text | default: 'Explore Puja & Rituals' }}
            </a>

            <div class="kj-next-row">
              <span class="kj-step">01 / 04</span>
              <button class="kj-next" type="button" data-next-target="1">Next: {{ section.settings.tab_2_title | default: 'Art & Print' }}<span aria-hidden="true">→</span></button>
            </div>
          </div>
        </article>

        <!-- CHAPTER 2: ART & PRINT -->
        <article 
          class="kj-panel kj-panel--light" 
          id="kj-panel-2-{{ sid }}" 
          role="tabpanel" 
          aria-labelledby="kj-tab-2-{{ sid }}" 
          data-theme="{{ section.settings.tab_2_title | default: 'Art & Print' }}" 
          style="--scene: {{ section.settings.ch2_bg | default: '#e5eadf' }}; --tone: {{ section.settings.ch2_text | default: '#203025' }};"
          inert
          aria-hidden="true"
        >
          <div class="kj-panel-inner">
            <div class="kj-eyebrow">
              <span>02 / {{ section.settings.tab_2_title | default: 'ART & PRINT' | upcase }}</span>
              <small>SWIPE →</small>
            </div>
            <h3 class="kj-headline">{{ section.settings.ch2_headline | default: 'Wear a little\nimagination.' | newline_to_br }}</h3>

            <div class="kj-looks" data-count="3">
              <a class="kj-look" href="{{ section.settings.ch2_look1_link | default: '/collections/the-printed-man' }}" aria-label="{{ section.settings.ch2_look1_name | default: 'Navy floral kurta set' }}">
                <figure>
                  <div class="kj-photo">
                    {%- if section.settings.ch2_look1_img != blank -%}
                      <img src="{{ section.settings.ch2_look1_img | image_url: width: 600 }}" alt="{{ section.settings.ch2_look1_name }}" width="300" height="400" loading="lazy">
                    {%- else -%}
                      <img src="https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/journal-v3/navy-floral-v3.webp" alt="Navy floral kurta set" width="300" height="400" loading="lazy">
                    {%- endif -%}
                    <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                  </div>
                  <figcaption>{{ section.settings.ch2_look1_name | default: 'Navy floral kurta set' }}</figcaption>
                </figure>
              </a>
              <a class="kj-look" href="{{ section.settings.ch2_look2_link | default: '/collections/the-printed-man' }}" aria-label="{{ section.settings.ch2_look2_name | default: 'Black floral jacket set' }}">
                <figure>
                  <div class="kj-photo">
                    {%- if section.settings.ch2_look2_img != blank -%}
                      <img src="{{ section.settings.ch2_look2_img | image_url: width: 600 }}" alt="{{ section.settings.ch2_look2_name }}" width="300" height="400" loading="lazy">
                    {%- else -%}
                      <img src="https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/journal-v3/black-floral-v3.webp" alt="Black floral jacket set" width="300" height="400" loading="lazy">
                    {%- endif -%}
                    <span class="kj-photo-arrow" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
                  </div>
                  <figcaption>{{ section.settings.ch2_look2_name | default: 'Black floral jacket set' }}</figcaption>
                </figure>
              </a>
              <a class="kj-look" href="{{ section.settings.ch2_look3_link | default: '/collections/the-printed-man' }}" aria-label="{{ section.settings.ch2_look3_name | default: 'Blue floral Nehru set' }}">
                <figure>
                  <div class="kj-photo">
                    {%- if section.settings.ch2_look3_img != blank -%}
                      <img src="{{ section.settings.ch2_look3_img | image_url: width: 600 }}" alt="{{ section.settings.ch2_look3_name }}" width="300" height="400" loading="lazy">
                    {%- else -%}
                      <img src="https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/journal-v3/blue-jacket-v3.webp" alt="Blue floral Nehru set" width="300" height="400" loading="lazy">
                    {%- endif -%}
