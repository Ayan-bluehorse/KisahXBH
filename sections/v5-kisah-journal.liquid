<script>
  (function() {
    var sid = '{{ sid }}';
    var root = document.getElementById('kj-wrapper-' + sid);
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    var track = document.getElementById('kj-track-' + sid);
    if (!track) return;

    var panels = Array.prototype.slice.call(root.querySelectorAll('.kj-panel'));
    var tabs = Array.prototype.slice.call(root.querySelectorAll('.kj-tab'));
    var status = root.querySelector('.kj-status');
    var active = 0;
    var requested = null;
    var timer;
    var frame;

    var reduced = function() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    };

    var position = function(i) {
      return track.scrollLeft + panels[i].getBoundingClientRect().left - track.getBoundingClientRect().left;
    };

    var nearest = function() {
      var best = 0;
      var curScroll = track.scrollLeft;
      for (var i = 0; i < panels.length; i++) {
        if (Math.abs(position(i) - curScroll) < Math.abs(position(best) - curScroll)) {
          best = i;
        }
      }
      return best;
    };

    function fit() {
      if (panels[active]) {
        track.style.height = Math.ceil(panels[active].getBoundingClientRect().height) + 'px';
      }
    }

    function paint(i) {
      active = i;
      tabs.forEach(function(tab, k) {
        tab.setAttribute('aria-selected', String(i === k));
        tab.tabIndex = i === k ? 0 : -1;
      });
      panels.forEach(function(panel, k) {
        panel.inert = k !== i;
        panel.setAttribute('aria-hidden', String(k !== i));
      });
      if (status && panels[i]) {
        status.textContent = 'Chapter ' + (i + 1) + ' of ' + panels.length + ': ' + panels[i].dataset.theme;
      }
      fit();
    }

    function go(i, instant) {
      i = Math.max(0, Math.min(i, panels.length - 1));
      requested = i;
      paint(i);
      track.scrollTo({
        left: position(i),
        behavior: instant || reduced() ? 'auto' : 'smooth'
      });
    }

    tabs.forEach(function(tab, i) {
      tab.addEventListener('click', function() { go(i); });
      tab.addEventListener('keydown', function(event) {
        var target;
        if (event.key === 'ArrowRight') target = (i + 1) % tabs.length;
        if (event.key === 'ArrowLeft') target = (i - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') target = 0;
        if (event.key === 'End') target = tabs.length - 1;
        if (target !== undefined) {
          event.preventDefault();
          go(target);
          tabs[target].focus();
        }
      });
    });

    root.querySelectorAll('.kj-next').forEach(function(button) {
      button.addEventListener('click', function() {
        var nextIdx = parseInt(button.getAttribute('data-next-target') || '0', 10);
        go(nextIdx);
        var nav = root.querySelector('.kj-nav');
        if (nav) nav.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' });
        if (tabs[active]) tabs[active].focus({ preventScroll: true });
      });
    });

    var settled = function() {
      clearTimeout(timer);
      requested = null;
      paint(nearest());
    };

    track.addEventListener('scroll', function() {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(function() {
        if (requested === null) paint(nearest());
      });
      clearTimeout(timer);
      timer = setTimeout(settled, 180);
    }, { passive: true });

    ['pointerdown', 'touchstart', 'wheel'].forEach(function(name) {
      track.addEventListener(name, function() { requested = null; }, { passive: true });
    });

    track.addEventListener('keydown', function(event) {
      if (event.target !== track) return;
      if (event.key === 'ArrowRight') { event.preventDefault(); go(active + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); go(active - 1); }
    });

    window.addEventListener('resize', fit, { passive: true });
    root.querySelectorAll('img').forEach(function(img) {
      img.addEventListener('load', fit);
    });

    setTimeout(function() {
      paint(0);
      fit();
    }, 120);
  })();
</script>

