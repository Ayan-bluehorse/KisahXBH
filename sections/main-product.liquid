                                {%- else -%}<path d="M7 10.5v8"/><path d="M4.5 10.5h2.5v8H4.5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1Z"/><path d="M7 11.2 11 4.5a2 2 0 0 1 2.9 2.4L13 10.5h5a1.8 1.8 0 0 1 1.7 2.3l-1.4 5A2 2 0 0 1 16.4 19H7"/>
                              {%- endcase -%}
