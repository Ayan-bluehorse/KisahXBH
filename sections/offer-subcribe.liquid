<style>
#shopify-section-{{section.id}} {
   padding-top: {{ section.settings.desk-padding-top }}px;
   padding-bottom: {{ section.settings.desk-padding-bottom }}px;
   background:{{section.settings.bg-color}};
}
#shopify-section-{{section.id}} .offer-subscribe-section {
    display: flex;
    max-width: 1000px; 
    gap: 20px;
    margin: 0 auto;
    align-items: center;
    width:100%;
}
#shopify-section-{{section.id}} .offer-subscribe-section .image-container{
     width:50%;
}
#shopify-section-{{section.id}} .offer-subscribe-section .image-container img{
     max-width:480px;
     width:100%;
}
#shopify-section-{{section.id}} .offer-subscribe-section .offer-information{
     width:50%;
}
#shopify-section-{{section.id}} .offer-subscribe-section .offer-information h3{
    font-family: var(--base-font-family);
    font-size: 26px;
    font-weight: 400;
    line-height: 28px;
    text-transform: capitalize;
}
#shopify-section-{{section.id}} .offer-subscribe-section .offer-information p{
     max-width:350px;
     font-size: 18px;
     line-height: 25px;

}
@media screen and (max-width:767px){
#shopify-section-{{section.id}} .offer-subscribe-section {
    flex-direction:column;
    gap:10px
}
 #shopify-section-{{section.id}} .offer-subscribe-section .image-container{
     width:100%;
} 
#shopify-section-{{section.id}} .offer-subscribe-section .offer-information{
     width:100%;
}
#shopify-section-{{section.id}} .offer-subscribe-section .offer-information h3{
  
    font-size: 22px;
    line-height: 24px;

}
#shopify-section-{{section.id}} .offer-subscribe-section .offer-information p{
     font-size: 16px;
     line-height: 22px;
}
#shopify-section-{{section.id}} {
    padding-top: {{ section.settings.mob-padding-top }}px;
    padding-bottom: {{ section.settings.mob-padding-bottom }}px;
}
}
</style>


<div class="container">
    <div class="offer-subscribe-section">
      <div class="image-container">
        {% if section.settings.img != blank %}
         <img src="{{ section.settings.img | image_url }}" width="auto" height="auto"> 
         {% endif %} 
        </div>
        <div class="offer-information">
        <h3>{{ section.settings.head }}</h3>
        {{ section.settings.text }}
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "offer subcribe",
    "settings": [
      {
        "type": "image_picker",
         "id": "img",
         "label": "Image"
      },
      {
        "type": "text",
        "id":"head",
         "label": "Heading"
      },
      {
         "type": "textarea",
         "id": "text",
         "label": "text"
      },
      {
        "type": "color",
         "id":"bg-color",
         "label": "Background color"
      },
       {
        "type": "header",
        "content": "SECTION PADDING FOR DESKTOP"
       },
      {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
     },
     {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
     },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
    ],
    "presets": [
      {
        "name": "offer subcribe"
      }
    ]
  }
{% endschema %}