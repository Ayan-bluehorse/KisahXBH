  $('#shopify-section-{{ section.id }} .side-img-part').slick({
    dots: true,
    infinite: false,
    speed: 300,
    slidesToShow: 4.38,
    slidesToScroll: 2,
   prevArrow: '<button type="button" class="slick-prev"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="27" viewBox="0 0 32 27" fill="none"><g><path d="M9.33313 26.9997C9.15765 27.0005 8.9837 26.9722 8.82125 26.9162C8.6588 26.8602 8.51105 26.7777 8.38646 26.6734C8.26149 26.5689 8.1623 26.4444 8.09461 26.3073C8.02692 26.1702 7.99207 26.0232 7.99207 25.8747C7.99207 25.7262 8.02692 25.5791 8.09461 25.442C8.1623 25.305 8.26149 25.1805 8.38646 25.0759L19.2798 15.8847C20.0289 15.2519 20.4496 14.3941 20.4496 13.4997C20.4496 12.6053 20.0289 11.7475 19.2798 11.1147L8.38646 1.92347C8.13539 1.71163 7.99434 1.42431 7.99434 1.12472C7.99434 0.82513 8.13539 0.537811 8.38646 0.32597C8.63753 0.114128 8.97806 -0.00488281 9.33313 -0.00488281C9.6882 -0.00488281 10.0287 0.114128 10.2798 0.32597L21.1731 9.51721C21.794 10.0397 22.2865 10.6604 22.6226 11.3438C22.9587 12.0272 23.1317 12.7598 23.1317 13.4997C23.1317 14.2396 22.9587 14.9722 22.6226 15.6556C22.2865 16.339 21.794 16.9597 21.1731 17.4822L10.2798 26.6734C10.1552 26.7777 10.0075 26.8602 9.84501 26.9162C9.68256 26.9722 9.50861 27.0005 9.33313 26.9997Z" fill="black" fill-opacity="0.83"/></g></svg></button>',
   nextArrow: '<button type="button" class="slick-next"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="27" viewBox="0 0 32 27" fill="none"><g><path d="M9.33313 26.9997C9.15765 27.0005 8.9837 26.9722 8.82125 26.9162C8.6588 26.8602 8.51105 26.7777 8.38646 26.6734C8.26149 26.5689 8.1623 26.4444 8.09461 26.3073C8.02692 26.1702 7.99207 26.0232 7.99207 25.8747C7.99207 25.7262 8.02692 25.5791 8.09461 25.442C8.1623 25.305 8.26149 25.1805 8.38646 25.0759L19.2798 15.8847C20.0289 15.2519 20.4496 14.3941 20.4496 13.4997C20.4496 12.6053 20.0289 11.7475 19.2798 11.1147L8.38646 1.92347C8.13539 1.71163 7.99434 1.42431 7.99434 1.12472C7.99434 0.82513 8.13539 0.537811 8.38646 0.32597C8.63753 0.114128 8.97806 -0.00488281 9.33313 -0.00488281C9.6882 -0.00488281 10.0287 0.114128 10.2798 0.32597L21.1731 9.51721C21.794 10.0397 22.2865 10.6604 22.6226 11.3438C22.9587 12.0272 23.1317 12.7598 23.1317 13.4997C23.1317 14.2396 22.9587 14.9722 22.6226 15.6556C22.2865 16.339 21.794 16.9597 21.1731 17.4822L10.2798 26.6734C10.1552 26.7777 10.0075 26.8602 9.84501 26.9162C9.68256 26.9722 9.50861 27.0005 9.33313 26.9997Z" fill="black" fill-opacity="0.83"/></g></svg></button>',
    responsive: [
        {

          breakpoint: 1000,
          settings: {
              slidesToShow: 3,
              slidesToScroll: 2,
              infinite: true,
            
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2
          }
        }
       
    ]
  });


function updatePadding() {
  const sideImgPart = document.querySelector('.side-img-part');
  const categoryGrid = document.querySelector('.cp-category-grid');

  if (!sideImgPart || !categoryGrid) return;

  if (window.innerWidth >= 769) {
    const left = categoryGrid.getBoundingClientRect().left;
    sideImgPart.style.paddingLeft = left + 'px';
  } else {
    // Reset padding for mobile
    sideImgPart.style.paddingLeft = '';
  }
}

window.addEventListener('load', () => {
  requestAnimationFrame(updatePadding);
});

window.addEventListener('resize', updatePadding);



  

});
</script>



{% schema %}
  {
    "name": "Slide images",
    "class": "slide-image-wrapper",
    "settings": [
      {
        "type": "text",
         "id": "head",
          "label": "Heading"
      },
      {
        "type": "text",
         "id": "sub_head",
          "label": "Sub Heading"
      },
      {
         "type": "color",
          "id": "bg-color",
          "label": "Background color"
      },
      {
         "type": "color",
         "id": "head-color",
          "label": "Heading color"
      },
      
      {
        "type": "header",
        "content": "SECTION PADDING FOR DESKTOP"
      },
     {
          "type": "range",
          "id": "desk-padding-top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Padding Top",
          "default": 16
     },
    {
          "type": "range",
          "id": "desk-padding-bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Padding Bottom",
          "default": 16
    },
    {
          "type": "header",
          "content": "SECTION PADDING FOR MOBILE"
    },
    {
          "type": "range",
          "id": "mob-padding-top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Padding Top",
          "default": 16
    },
    {
          "type": "range",
          "id": "mob-padding-bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Padding Bottom",
          "default": 16
    }
    ],
    "blocks": [
       {
        "type": "slide-images",
         "name":"Slide images",
          "settings": [
          {
            "type": "image_picker",
             "id": "img",
              "label": "Image"
          },
          {
            "type": "url",
             "id": "link",
              "label": "Image link"
          },
          {
            "type":"text",
             "id": "text",
             "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Slide images"
      }
    ]
  }
{% endschema %}