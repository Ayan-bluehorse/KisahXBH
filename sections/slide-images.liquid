<div class="slide-images container">
  <div class="slide-img-cont-pad">
      <div class="slide-sec-head">
        <h2>{{ section.settings.head }}</h2>
        {% if section.settings.sub_head != blank %}
        <p>{{ section.settings.sub_head }}</p>
        {% endif %}
      </div>
      <div class="side-img-part side-img-part-slider ">
        {% for block in section.blocks %}
          <div class="imges-part-wrap slick-slide">
          {% if block.settings.link != blank  %}
           <a href="{{ block.settings.link }}">
            {% endif %}
              {% if block.settings.img != blank  %}
               <img src="{{ block.settings.img | image_url }}" width="auto" height="auto">
               {% endif %} 
              {% if block.settings.link != blank  %} 
              </a>
              {% endif %}  
               {% if  block.settings.text != blank %}
               <div class="image-day-text-container">
                <span>{{ block.settings.text }}</span>
              </div>
              {% endif %}
          </div>
        {% endfor %}
      </div>
  </div>
</div>

<style>
#shopify-section-{{section.id}}{
    padding-top: {{ section.settings.desk-padding-top }}px;
    padding-bottom: {{ section.settings.desk-padding-bottom }}px; 
    background:{{section.settings.bg-color}};
}
#shopify-section-{{section.id}} .slide-images{
      margin:0 auto;
}
/* #shopify-section-{{section.id}} .slide-images .slide-img-cont-pad{
      padding:0 25px;
}  */
#shopify-section-{{section.id}} .slide-images .slide-sec-head{
      text-align:center;
}
#shopify-section-{{section.id}} .slide-images .slide-sec-head h2{
      font-family: Gabarito;
      font-size: 48px;
      font-weight: 700;
      line-height: 57.6px;
      text-align: center;
      text-transform: uppercase;
      color:{{ section.settings.head-color | default:"#201747" }};

}
#shopify-section-{{section.id}} .slide-images .side-img-part .imges-part-wrap{
       margin-right:8px
}  
#shopify-section-{{section.id}} .slick-dotted.slick-slider{
      margin-bottom:10px;
}
#shopify-section-{{section.id}} .slick-dots{
       display:none !important;
}
#shopify-section-{{section.id}} .slick-dots li button{
       display:none;
}
/* #shopify-section-{{section.id}} .slick-slider .slick-next:before {
        content: "";
        display: block;
        background-repeat: no-repeat;
        width: 20px;
        height: 37px;
        background-position: center;
        background-size: contain;
        opacity: 1;
        background-image: url(https://cdn.shopify.com/s/files/1/0496/1003/1256/files/fi-rr-angle-right.png?v=1715866691);
        transform: rotate(180deg);
}
#shopify-section-{{section.id}} .slick-slider .slick-prev:before {
        content: "";
        display: block;
        background-repeat: no-repeat;
        width: 20px;
        height: 37px;
        background-position: center;
        background-size: contain;
        opacity: 1;
        background-image: url(https://cdn.shopify.com/s/files/1/0496/1003/1256/files/fi-rr-angle-right.png?v=1715866691);
   
} */
#shopify-section-{{section.id}} .slide-img-cont-pad .image-day-text-container span{
        text-align:center;
        font-size:16px;
        line-height:18px;
        margin: 0;
        padding: 8px 0;
        display:block;
        font-family: 'Generis Sans W01 Bold';
}
#shopify-section-{{section.id}} .slick-prev, .slick-next {
  background: transparent;
  border: none;
  cursor: pointer;
  outline: none;
  position: absolute; 
  top: 50%; 
  transform: translateY(-50%);
  z-index: 12; 
}
#shopify-section-{{section.id}} .slick-arrow svg{
  text-align: center;
  box-shadow: rgba(50, 50, 105, 0.15) 0px 2px 5px 0px, rgba(0, 0, 0, 0.05) 0px 1px 1px 0px;
  background: #fff;
  padding: 5px;
  border-radius: 50px;
  width: 35px;
  height: 35px; 
}
#shopify-section-{{section.id}} .slick-prev {
  left: -19px;
 
}
#shopify-section-{{section.id}} .slick-prev svg{
   transform: rotate(180deg);
}
#shopify-section-{{section.id}} .slick-next {
  right: -10px; 
}
#shopify-section-{{section.id}} .slick-prev:before,#shopify-section-{{section.id}} .slick-next:before{
    content: ' ';
}

@media screen and (max-width:767px){
#shopify-section-{{section.id}}{
        padding-top: {{ section.settings.mob-padding-top }}px;
        padding-bottom: {{ section.settings.mob-padding-bottom }}px; 
    }
#shopify-section-{{section.id}} .slide-images .slide-sec-head h2{
        font-size: 28px;
        line-height: 33.6px;
}
#shopify-section-{{section.id}} .slick-next.slick-arrow{
     right: -3px;
     z-index:999;
}
#shopify-section-{{section.id}} .slick-prev.slick-arrow{
    left: -12px;
    z-index:999;
}
#shopify-section-{{section.id}} .slide-img-cont-pad .image-day-text-container span{
    font-size:14px;
    line-height:16px;
}
#shopify-section-{{section.id}} .slick-arrow svg{
  width: 30px;
  height: 30px; 
  padding: 4px;
}
#shopify-section-{{section.id}} .slick-next {
  right: 0; 
}
}
</style>


<script>
