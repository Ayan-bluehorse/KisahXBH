<style>
#shopify-section-{{section.id}} .pagination-row .prev a{
   display:flex;
   flex-direction:column;
   align-items:center;
}
#shopify-section-{{section.id}} .pagination-row a span{
   font-family: var(--base-font-family);
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
    text-align: center;
    color: #000000;
}
#shopify-section-{{section.id}} .pagination-row .next a{
   display:flex;
   flex-direction:column-reverse;
   align-items:center;
}
#shopify-section-{{section.id}} .pagination-row .next a .icon--small svg{
   transform: rotate(180deg);
}

#shopify-section-{{section.id}} .main-article-svg-container .blog_share_svg{
    float:right;
}
#shopify-section-{{section.id}} .main-article-svg-container .blog-share{
    background:#201747;
    border-radius:50px;
    padding:10px 8px;
    position:absolute;
    bottom:17px;
    right:45px;
    opacity:0;
    visibility:hidden;
}
#shopify-section-{{section.id}} .main-article-svg-container.active .blog-share{
   opacity:1;
   visibility:visible;
}
#shopify-section-{{section.id}} .article .meta .time{
    font-family: var(--base-font-family);
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 15px;
    color: #000000;

}

/* Blog Article Sidebar, Related Products & CTA (Slide 4 & 5) */
.article-layout-with-sidebar {
  display: flex;
  align-items: flex-start;
  gap: 48px;
  max-width: 1240px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
}
.article-sidebar {
  width: 280px;
  flex-shrink: 0;
  position: -webkit-sticky;
  position: sticky;
  top: 100px;
  align-self: flex-start;
}
.article-sidebar__inner {
  background: #FFFFFF;
  border: 1px solid #EAEAEA;
  border-radius: 12px;
  padding: 22px 20px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
}
.article-sidebar__header {
  margin-bottom: 18px;
  padding-bottom: 12px;
  border-bottom: 2px solid #E5E5E5;
}
.article-sidebar__title {
  font-family: var(--heading-font-family, inherit);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #111111;
  text-transform: uppercase;
  margin: 0;
}
.article-sidebar__products {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.article-related-product {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-bottom: 14px;
  border-bottom: 1px solid #F5F5F5;
}
.article-related-product:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.article-related-product__image-wrap {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid #EAEAEA;
  display: block;
  background: #fafafa;
}
.article-related-product__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.article-related-product__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
}
.article-related-product__placeholder svg {
  width: 60%;
  height: 60%;
  opacity: 0.4;
}
.article-related-product__info {
  flex: 1;
  min-width: 0;
}
.article-related-product__title {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.35;
  color: #111111;
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 6px;
  transition: color 0.2s;
}
.article-related-product__title:hover {
  color: #9C7049;
}
.article-related-product__prices {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.article-related-product__price {
  font-size: 13px;
  font-weight: 700;
  color: #111111;
}
.article-related-product__compare-price {
  font-size: 12px;
  color: #888888;
  text-decoration: line-through;
}
.article-main-body {
  flex: 1;
  min-width: 0;
}
.article-cta-row {
  margin: 36px 0 28px;
  text-align: center;
}
.article-cta-btn {
  display: inline-block;
  background: #C24361;
  color: #FFFFFF !important;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.5px;
  padding: 13px 36px;
  border-radius: 6px;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(194, 67, 97, 0.25);
  transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}
.article-cta-btn:hover {
  background: #A3334E;
  color: #FFFFFF !important;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(194, 67, 97, 0.35);
}
.article-share-row {
  margin: 28px 0;
  padding: 16px 0;
  border-top: 1px solid #ECECEC;
  border-bottom: 1px solid #ECECEC;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

@media screen and (max-width: 900px) {
  .article-layout-with-sidebar {
    flex-direction: column;
    gap: 32px;
    padding-left: 16px;
    padding-right: 16px;
  }
  .article-main-body {
    order: 1;
    width: 100%;
    min-width: 0;
  }
  .article-sidebar {
    order: 2;
    width: 100% !important;
    max-width: 100% !important;
    position: static !important;
    margin: 28px 0 16px 0;
    align-self: stretch;
    box-sizing: border-box;
  }
  .article-sidebar__inner {
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
    padding: 20px 18px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    max-height: none !important;
    overflow-y: visible !important;
  }
  .article-sidebar__header {
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid #E5E5E5;
  }
  .article-sidebar__title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }
  .article-sidebar__products {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-related-product {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid #F2F2F2;
    box-sizing: border-box;
    width: 100%;
  }
  .article-related-product:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .article-related-product__image-wrap {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 8px;
  }
  .article-related-product__info {
    flex: 1;
    min-width: 0;
  }
  .article-related-product__title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    color: #111111;
  }
  .article-related-product__price {
    font-size: 14px;
    font-weight: 700;
  }
  .article-related-product__compare-price {
    font-size: 12px;
  }
}
</style>


{% if section.settings.show_featured_image and article.image != blank %}
  <div class="article-image article-image--large align-center {% unless section.settings.full_width_image %}container{% endunless %}">
    {% if section.settings.featured_image_height == 'natural' %}
      <div class="page-header page-header--with-background height--adapt {% if section.settings.enable_title_overlay %}image-overlay image-overlay--bg-{{ section.settings.overlay_style }}{% endif %}" style="--aspect-ratio: {{ article.image.aspect_ratio | default: 2.0 }}">
        {% if section.settings.enable_title_overlay %}
          <div class="image-overlay__image">
            {%- render 'image' with article.image, loading: 'eager', class: 'height__image' -%}
          </div>
          <div class="text-overlay text-overlay--v-center text-overlay--h-center image-overlay__over" data-cc-animate data-cc-animate-delay="0.2s">
            <div class="text-overlay__inner">
              <div class="text-overlay__text">
                <h1 class="text-overlay__title super-large-text">{{ article.title | escape }}</h1>
              </div>
            </div>
          </div>
        {% else %}
          {%- render 'image' with article.image, loading: 'eager', class: 'height__image' -%}
        {% endif %}
      </div>

    {% else %}
      <div class="page-header page-header--with-background img-fill {% if section.settings.enable_title_overlay %}image-overlay image-overlay--bg-{{ section.settings.overlay_style }}{% endif %} page-header--padded-{{ section.settings.featured_image_height }}">
        {% if section.settings.enable_title_overlay %}
          <div class="image-overlay__image">
            {%- render 'image' with article.image, loading: 'eager' -%}
          </div>
          <div class="text-overlay text-overlay--inline text-overlay--v-center text-overlay--h-center image-overlay__over" data-cc-animate data-cc-animate-delay="0.2s">
            <div class="text-overlay__inner">
              <div class="text-overlay__text">
                <h1 class="text-overlay__title super-large-text">{{ article.title | escape }}</h1>
              </div>
            </div>
          </div>
        {% else %}
          {%- render 'image' with article.image, loading: 'eager' -%}
          
          <div class="text-overlay text-overlay--inline">{% comment %}For padding{% endcomment %}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}
{% if section.settings.enable_title_overlay == false or section.settings.show_featured_image == false or article.image == blank %}
  <div class="container" data-cc-animate>
      <div class="page-header cf">
        <h1 class="majortitle">{{ article.title | escape }}</h1>
      </div>
  </div>
{% endif %}

{%- assign related_prod_limit = section.settings.related_limit | default: 4 -%}
{%- capture related_products_markup -%}
  {%- assign count = 0 -%}
  {%- if article.metafields.custom.related_products != blank -%}
    {%- for prod in article.metafields.custom.related_products.value limit: related_prod_limit -%}
      {%- render 'article-related-product-card', product: prod -%}
      {%- assign count = count | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if count == 0 and section.settings.related_collection != blank -%}
    {%- for prod in collections[section.settings.related_collection].products limit: related_prod_limit -%}
      {%- render 'article-related-product-card', product: prod -%}
      {%- assign count = count | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if count == 0 -%}
    {%- assign content_parts = article.content | split: 'href="' -%}
    {%- assign used_handles = '' -%}
    {%- for part in content_parts -%}
      {%- if count >= related_prod_limit -%}{%- break -%}{%- endif -%}
      {%- if part contains '/products/' -%}
        {%- assign handle_raw = part | split: '/products/' | last -%}
        {%- assign product_handle = handle_raw | split: '"' | first | split: '?' | first | split: '/' | first -%}
        {%- unless used_handles contains product_handle -%}
          {%- assign p = all_products[product_handle] -%}
          {%- if p != blank and p.available -%}
            {%- assign used_handles = used_handles | append: product_handle | append: ',' -%}
            {%- render 'article-related-product-card', product: p -%}
            {%- assign count = count | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if count < related_prod_limit and collections.all.products.size > 0 -%}
    {%- for prod in collections.all.products -%}
      {%- if count >= related_prod_limit -%}{%- break -%}{%- endif -%}
      {%- unless used_handles contains prod.handle -%}
        {%- render 'article-related-product-card', product: prod -%}
        {%- assign count = count | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- assign has_sidebar = false -%}
{%- if section.settings.show_related_sidebar and related_products_markup != blank -%}
  {%- assign has_sidebar = true -%}
{%- endif -%}

<div class="article article--main">
  <div class="container {% if has_sidebar %}article-layout-with-sidebar{% else %}container--reading-width{% endif %}">

    {% if has_sidebar %}
      <aside class="article-sidebar" data-cc-animate>
        <div class="article-sidebar__inner">
          <div class="article-sidebar__header">
            <h3 class="article-sidebar__title">{{ section.settings.related_sidebar_title | default: 'RELATED PRODUCTS' }}</h3>
          </div>
          <div class="article-sidebar__products">
            {{ related_products_markup }}
          </div>
        </div>
      </aside>
    {% endif %}

    <div class="article-main-body">
      <div class="rte cf " data-cc-animate>
        {{ article.content }}
      </div>

      {%- assign cta_label = article.metafields.custom.cta_button_text.value | default: article.metafields.custom.cta_button_text | default: section.settings.cta_button_text -%}
      {%- assign cta_url = article.metafields.custom.cta_button_url.value | default: article.metafields.custom.cta_button_url | default: section.settings.cta_button_url -%}
      {%- if cta_url == blank and section.settings.related_collection != blank -%}
        {%- assign cta_url = collections[section.settings.related_collection].url -%}
      {%- endif -%}
      {%- if cta_url == blank -%}
        {%- assign cta_url = '/collections/all' -%}
      {%- endif -%}

      {% if section.settings.show_cta_button and cta_label != blank %}
        <div class="article-cta-row" data-cc-animate>
          <a href="{{ cta_url }}" class="article-cta-btn">
            {{ cta_label | escape }}
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_sharing_icons %}
        <div class="article-share-row" data-cc-animate>
          {% render 'blog-social-share',
            share_title: article.title,
            share_url: article.url,
            share_image: article.image
          %}
        </div>
      {% endif %}

      {%- if section.settings.show_article_tags -%}
        {% capture tag_markup %}
          <div class="iconmeta tags">
            <span class="label">{{ 'blogs.tags.label' | t }}:</span>
            {% for tag in article.tags %}
              {{ tag | link_to_tag: tag }}
            {% endfor %}
          </div>
        {% endcapture %}
      {%- endif -%}

      <div class="meta" data-cc-animate>
        {% if section.settings.show_date or section.settings.show_author %}
          <span class="iconmeta time">
            {% if section.settings.show_date %}
              Updated: {{ article.updated_at | date: "%B %d, %Y" }}
            {% endif %}
            {% if section.settings.show_author %}
              {% if section.settings.show_date %}&mdash;{% endif %}
              <span class="author">{{ article.author }}</span>
            {% endif %}
          </span>
        {% endif %}

        {% if tag_markup contains '</a>' %}{{ tag_markup }}{% endif %}
      </div>

      <div class="pagination-row pagination-row-tabular" data-cc-animate>
        <span class="prev">
          {% if blog.previous_article %}
          <a href="{{ blog.previous_article }}"><span class="icon--small icon-natcol has-ltr-icon">{% render 'previous-svg' %}</span> <span> Previous</span></a>
          {% endif %}
        </span>
        <span class="next">
          {% if blog.next_article %}
          <a href="{{ blog.next_article }}"><span>Next</span> <span class="icon--small icon-natcol has-ltr-icon">{% render 'previous-svg' %}</span></a>
          {% endif %}
        </span>
      </div>
    </div>

  </div>
</div>

{% if blog.comments_enabled? %}
  <div class="container container--reading-width">
    {% paginate article.comments by 50 %}
      {% if article.comments != blank %}
        <div id="comments" class="fully-spaced-row" data-cc-animate>
          <h4 class="align-centre">{{ 'blogs.comments.title' | t }}</h4>

          {% comment %} Show a comment that was *just* submitted {% endcomment %}
          {% if comment and comment.status != 'published' %}
            <div class="comment">
              <div class="text">{{ comment.content }}</div>
              <div class="author small-text">&mdash; {{ comment.author }}</div>
            </div>
          {% endif %}

          {% comment %} Loop through approved comments: {% endcomment %}
          {% for comment in article.comments %}
            <div class="comment {% if forloop.first %}first{% endif %}">
              <div class="text">{{ comment.content }}</div>
              <div class="author small-text">&mdash; {{ comment.author }}</div>
            </div>
          {% endfor %}
        </div>

        <div class="pagination-row" data-cc-animate>{% render 'pagination-control', paginate: paginate %}</div>
      {% endif %}
    {% endpaginate %}

    <div class="account-form fully-spaced-row" data-cc-animate>
      {% form article %}
        <h4 id="add-comment-title">{{ 'blogs.comments.form_title' | t }}</h4>

        {% if form.posted_successfully? %}
          <p>{{ 'blogs.comments.success' | t }}</p>
        {% endif %}

        {% if blog.moderated? %}
          <p>{{ 'blogs.comments.moderated' | t }}</p>
        {% endif %}

        {% if form.errors %}
          <ul class="errors">
            {% for field in form.errors %}
            <li>{{ field | capitalize }} {{ form.errors.messages[field] }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        <div class="input-row {% if form.errors contains 'author' %}has-error{% endif %}">
          <label for="comment_author">{{ 'blogs.comments.name' | t }}</label>
          <input type="text" id="comment_author" name="comment[author]" size="40" value="{{ form.author }}" />
        </div>
        <div class="input-row {% if form.errors contains 'email' %}has-error{% endif %}">
          <label for="comment_email">{{ 'blogs.comments.email' | t }}</label>
          <input type="email" id="comment_email" name="comment[email]" size="40" value="{{ form.email }}" />
        </div>
        <div class="input-row {% if form.errors contains 'body' %}has-error{% endif %}">
          <label for="comment_body">{{ 'blogs.comments.message' | t }}</label>
          <textarea id="comment_body" name="comment[body]" cols="40" rows="5">{{ form.body }}</textarea>
        </div>

        <div class="lightly-spaced-row-above">
          <button type="submit" id="comment-submit" class="btn">{{ 'blogs.comments.post' | t }}</button>
        </div>

      {% endform %}
    </div>
  </div>
{% endif %}

{% for block in section.blocks %}
  {% render block %}
{% endfor %}

{% render 'structured-data-article', article: article %}
