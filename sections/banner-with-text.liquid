<div class="new-home-page-banner">
    <div class="banner-image-sec">
         {% for block in section.blocks %}
            {% assign first = forloop.first %}
           <div class="slide wrapping-content {% if first != true %}slick-slide{% endif %}" id="block-{{block.id}}">
             {% if block.type == 'slide_banner_dual_button' %}
                <div class="desk-mob-img-wrap dual-button-wrap" id="dual-wrap-{{block.id}}" style="position:relative;display:block;">
                 {% if block.settings.mob-img != blank %}
                   <img
                     src="{{ block.settings.mob-img | image_url: width: 800 }}"
                     srcset="
                       {{ block.settings.mob-img | image_url: width: 320 }} 320w,
                       {{ block.settings.mob-img | image_url: width: 420 }} 420w,
                       {{ block.settings.mob-img | image_url: width: 600 }} 600w
                     "
                     sizes="(max-width: 768px) 100vw"
                     width="420"
                     height="auto"
                     alt="{{ block.settings.mob-img.alt | escape }}"
                     class="mob-img"
                     loading="eager"
                     fetchpriority="high"
                   >
                 {% endif %}
                 
                 {% if block.settings.desk-img != blank %}
                   <img
                     src="{{ block.settings.desk-img | image_url: width: 2000 }}"
                     srcset="
                       {{ block.settings.desk-img | image_url: width: 800 }} 800w,
                       {{ block.settings.desk-img | image_url: width: 1000 }} 1000w,
                       {{ block.settings.desk-img | image_url: width: 1400 }} 1400w
                     "
                     sizes="(min-width: 769px) 100vw"
                     width="1000"
                     height="auto"
                     alt="{{ block.settings.desk-img.alt | escape }}"
                     class="desk-img"
                     loading="eager"
                     fetchpriority="high"
                   >
                 {% endif %}
                 <div style="position:absolute;top:0;bottom:0;left:0;right:0;z-index:15;pointer-events:none;">
                   <div class="rakhi-btn-{{block.id}}" style="position:absolute;bottom:{{ block.settings.desk_top_offset | default: 22 }}%;left:{{ block.settings.desk_left_offset | default: 5 }}%;display:flex;flex-direction:column;gap:10px;width:auto;min-width:220px;max-width:250px;box-sizing:border-box;pointer-events:auto;">
                     {% if block.settings.button1_name != blank %}
                       <a href="{{ block.settings.button1_link | default: '#' }}" class="rakhi-dual-btn primary-rakhi-btn">{{ block.settings.button1_name }}</a>
                     {% endif %}
                     {% if block.settings.button2_name != blank %}
                       <a href="{{ block.settings.button2_link | default: '#' }}" class="rakhi-dual-btn secondary-rakhi-btn">{{ block.settings.button2_name }}</a>
                     {% endif %}
                   </div>
                 </div>
               </div>
            {% else %}
              <div class="desk-mob-img-wrap">
               {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" aria-label="Banner Url">
              {% endif %}
               {% if block.settings.mob-img != blank %}
              <img
               src="{{ block.settings.mob-img | image_url: width: 800 }}"
                  srcset="
                {{ block.settings.mob-img | image_url: width: 320 }} 320w,
                {{ block.settings.mob-img | image_url: width: 420 }} 420w,
                {{ block.settings.mob-img | image_url: width: 600 }} 600w"
                 sizes="(max-width: 768px) 100vw"
                  width="420"
                 height="auto"
                 alt="{{ block.settings.mob-img.alt | escape }}"
                class="mob-img"
                loading="eager"
                 fetchpriority="high"
                />
          {% endif %}
          
           {% if block.settings.desk-img != blank %}
            <img
               src="{{ block.settings.desk-img | image_url: width: 2000 }}"
               srcset="
                 {{ block.settings.desk-img | image_url: width: 800 }} 800w,
                 {{ block.settings.desk-img | image_url: width: 1000 }} 1000w,
                 {{ block.settings.desk-img | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 769px) 100vw"
                 width="1000"
                 height="auto"
                 alt="{{ block.settings.desk-img.alt | escape }}"
                 class="desk-img"
                 loading="eager"
                fetchpriority="high"
             />
            {% endif %}
                {% if block.settings.link != blank %}
                 </a>
                 {% endif %}
                   <div class="butn-para-content position-{{block.settings.position}} mob-pos-{{ block.settings.mob-position }}">
                 <div class="button-with-content">
                   <div class="hide-mobile-cont">
                     <p>{{ block.settings.sub-head}}</p>
                     <h2>{{ block.settings.head }}</h2>
                     <p class="sub-para">{{ block.settings.content }}</p>
                   </div>
                    <div class="content-bannner-link" id="no-{{block.id}}">
                      {% if block.settings.button-link != blank %}
                      <a href="{{ block.settings.button-link }}">{{block.settings.button-name }}</a>
                      {% endif %}
                     </div>
                 </div>
              </div> 
             </div>
             <div class="content-bannner-link mob-link" id="no-{{block.id}}">
                       {% if block.settings.button-link != blank %}
                       <a href="{{ block.settings.button-link }}">{{block.settings.button-name }}</a>
                     {% endif %}    
               </div>
            {% endif %}
               <style>
             #block-{{block.id}}.wrapping-content{
                 position:relative;
            } 
             #block-{{block.id}} .desk-mob-img-wrap{
                 position:relative;
            }
             /* Dual Button Mobile Override */
             {% if block.type == 'slide_banner_dual_button' %}
             @media screen and (max-width: 768px) {
               .rakhi-btn-{{block.id}} {
                   bottom: {{ block.settings.mob_top_offset | default: 20 }}% !important;
                   top: auto !important;
                   left: 50% !important;
                   transform: translateX(-50%) !important;
                   width: auto !important;
                   min-width: 155px !important;
                   max-width: 190px !important;
                   gap: 7px !important;
               }
             }
             {% endif %}

                  #block-{{block.id}} .butn-para-content{
                    display:none;
                  }
             #block-{{block.id}} .butn-para-content.position-left{
                   display:flex;
                   justify-content:flex-start;
                   width:100%;
                   position:absolute;
                   top:70px; 
                   z-index:9999;
                   padding: 1rem 1rem 1rem 6.2rem;
             }
              #block-{{block.id}} .butn-para-content.position-right{
                   display:flex;
                   justify-content:flex-end;
                   width:100%;
                   position:absolute;
                   top:70px; 
                   z-index:9999;
                   padding: 1rem 6.2rem 1rem 1rem;
             }
             #block-{{block.id}} .butn-para-content.position-bottom{
                   display:flex;
                   align-items:flex-end;
                   justify-content:center;
                   width:100%;
                   position:absolute;
                   bottom:50px;
                   z-index:9999;
                   padding: 1rem 6.2rem 1rem 1rem;
             }
              #block-{{block.id}} .butn-para-content.position-top{
                   display:flex;
                   align-items:flex-start;
                   justify-content:center;
                   position:absolute;
                   top:50px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 6.2rem 1rem 1rem;
             }
             #block-{{block.id}} .button-with-content .hide-mobile-cont {
                  max-width: 42rem;
                  display:flex;
                  flex-direction:column;
                  position:relative;
             } 
            
           #block-{{block.id}} .button-with-content p{
                  font-size: 36px;
                  font-weight: 400;
                  line-height: 41.41px;
                  text-align: left;
                  color:#ffffff;
                  margin:0;
           }
           #block-{{block.id}} .content-bannner-link{ 
                  max-width: 42rem;
                  margin-top:30px;
                  position:absolute;
                  bottom:20px;
                  left:50%;
                  transform:translate(-50%, -42px);
           }
            @media screen and (max-width:768px){
              /* #block-{{block.id}} .butn-para-content.position-top, #block-{{block.id}} .butn-para-content.position-bottom,#block-{{block.id}} .butn-para-content.position-right,
              #block-{{block.id}} .butn-para-content.position-left{
                   display:flex;
                   align-items:flex-end;
                   justify-content:center;
                   width:100%;
                   position:absolute;
                   bottom:-1%;
                   left:58%;
                   top:unset;
                   transform:translate(-50%, -50%);
                   z-index:9999;
                   padding: 1rem 6.2rem 1rem 1rem;
             } */
               #block-{{block.id}} .butn-para-content.mob-pos-top{
                   display:flex;
                   align-items:flex-start;
                   justify-content:center;
                   position:absolute;
                   top:50px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 1rem 1rem 1rem;
               }
              #block-{{block.id}} .butn-para-content.mob-pos-center{
                   display:flex;
                   align-items:center;
                   justify-content:center;
                   position:absolute;
                   top:50px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 1rem 1rem 1rem;
               }
                 
              #block-{{block.id}} .butn-para-content.mob-pos-bottom{
                   display:flex;
                   align-items:flex-end;
                   justify-content:center;
                   position:absolute;
                   bottom:75px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 1rem 1rem 1rem;
               }
             .butn-para-content.mob-pos-bottom .content-bannner-link{
                   position:fixed;
                   bottom:3%;
                   left:37%;
                   transform:translate(-50%,-50%);
            }
            .butn-para-content.mob-pos-top .content-bannner-link{
                   position:fixed;
                   bottom:3%;
                   left:13%;
                   transform:translate(-50%,-50%);
              }
              .butn-para-content.mob-pos-center .content-bannner-link{
                   position:fixed;
                   bottom:3%;
                   left:63%;
                   transform:translate(-50%,-50%);
             }
            
            }
           </style> 
           </div>
         {% endfor %}
     </div>
     {% if section.settings.whats-icon != blank %}
      <div class="icon-pos-part">
      <a href="{{  }}">
        <img src="{{ section.settings.whats-icon | image_url}}" width="auto" height="auto">
        </a>
     </div>
      {% endif %}
    <div class="icon-width">
      {% if section.settings.gift-icon != blank %}
      <div class="icons-part">
        <a href="#gift-form">
          <img src="{{ section.settings.gift-icon | image_url }}" width="auto" height="auto">
         </a>
      </div>
      {% endif %}
   </div>
</div>


<style>
#shopify-section-{{section.id}} {
   padding-top: {{ section.settings.desk-padding-top }}px;
