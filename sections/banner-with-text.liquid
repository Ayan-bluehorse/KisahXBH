<script>
window.kisahWhenJQueryReady(function($) {
  function initializeSlick() {
    var slickOptions = {
      dots: {% if section.settings.show_dots == false %}false{% else %}true{% endif %},  
      infinite: true,
      speed: 500,
      autoplay:true,
     autoplaySpeed:3000,
    };

    // Initialize or reinitialize the Slick slider
    var $slider = $('#shopify-section-{{ section.id }} .banner-image-sec');
    if ($slider.hasClass('slick-initialized')) {
      $slider.slick('unslick');
    }
    $slider.slick(slickOptions);
  }

  // Initial check
  initializeSlick();

  // Check on window resize
  $(window).resize(function() {
    initializeSlick();
  });
});

</script>


{% schema %}
{
  "name": "New Home Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "gift-icon",
      "label": "Gift icon"
    },
    {
      "type": "image_picker",
      "id": "whats-icon",
      "label": "Whats app icon"
    },
    {
      "type": "url",
      "id": "whats-app-link",
      "label": "whats app link"
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR DESKTOP"
    },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
