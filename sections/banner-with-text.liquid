}
/* Fix: global button reset (font-size:inherit, color:inherit) overrides Slick's
   arrow/dot styles. These high-specificity rules restore them. */
#shopify-section-{{section.id}} .slick-prev,
#shopify-section-{{section.id}} .slick-next {
  font-size: 0;
  line-height: 0;
  position: absolute;
  top: 50%;
  display: block;
  width: 20px;
  height: 20px;
  padding: 0;
  transform: translate(0, -50%);
  cursor: pointer;
  color: transparent;
  border: none;
  outline: none;
  background: transparent;
  z-index: 100;
}
#shopify-section-{{section.id}} .slick-dots li button {
  font-size: 0;
  line-height: 0;
  display: block;
  width: 20px;
  height: 20px;
  padding: 5px;
  cursor: pointer;
  color: transparent;
  border: 0;
  outline: none;
  background: transparent;
}
#shopify-section-{{section.id}} .new-home-page-banner .banner-image-sec .mob-img{
      display:none;
}
#shopify-section-{{section.id}} .slick-dotted.slick-slider{
      margin-bottom: 0px;/*10px*/
}
/* Position dots overlaid on the banner image */
#shopify-section-{{section.id}} .slick-dots {
  display: flex !important;
  justify-content: center;
  list-style: none;
  padding: 0;
  margin: 0;
  position: absolute;
  bottom: 20px !important;
  left: 0;
  right: 0;
  width: 100% !important;
  z-index: 10;
}
#shopify-section-{{section.id}} .slick-dots li {
  display: block !important;
  margin: 0 5px !important;
  width: 9px !important;
  height: 9px !important;
}
#shopify-section-{{section.id}} .slick-dots li button {
  display: block !important;
  width: 9px !important;
  height: 9px !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: rgba(255, 255, 255, 0.5) !important;
  text-indent: -9999px !important;
  border: none !important;
  cursor: pointer !important;
}
#shopify-section-{{section.id}} .slick-dots li button:before {
  display: none !important; /* Hide original slick icon font dot */
}
#shopify-section-{{section.id}} .slick-dots li.slick-active button {
  background: #ffffff !important;
}
{% unless section.settings.show_dots %}
