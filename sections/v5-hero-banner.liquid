{% comment %}
  Kisah Homepage Revamp - Hero Banner Slider
  - Matches Prototype HTML (.hero) & Image 1
  - Top-Left Progress Line Bars (.hdots) with Animated Fill
  - Circle Arrow Buttons Next to Dots (<) (>)
  - Bottom-Left Copy with Gradient Scrim
  - White CTA Button (.btn.alt)
  - 100% Responsive: Aspect-ratio 4/4.5 on mobile, 600px on desktop
  - Auto-play every 6s, touch swipe on mobile
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign slide_count = section.blocks.size
  if slide_count == 0
    assign slide_count = 3
  endif
-%}

<section 
  id="shopify-section-{{ sid }}" 
  class="v5-revamp-hero" 
  aria-label="Campaign Banner"
>
  <div class="v5-hero-slider" id="hero-slider-{{ sid }}">
    
    <!-- SLIDES -->
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_active = forloop.first
          assign desk_img = block.settings.desk_img
          assign mob_img = block.settings.mob_img | default: desk_img
          assign eyebrow = block.settings.eyebrow
          assign heading = block.settings.heading
          assign subhead = block.settings.subheading
          assign btn_text = block.settings.btn_text
          assign btn_link = block.settings.btn_link
          assign has_copy = false
          if eyebrow != blank or heading != blank or subhead != blank or btn_text != blank
            assign has_copy = true
          endif
        -%}
        <div 
          class="v5-hero-slide {% if is_active %}is-active{% endif %}{% if has_copy %} has-copy{% endif %}" 
          data-slide-index="{{ forloop.index0 }}"
          role="group" 
          aria-roledescription="slide" 
          aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
          {% unless is_active %}inert aria-hidden="true"{% endunless %}
        >
          {%- if btn_link != blank -%}
            <a href="{{ btn_link }}" class="v5-hero-slide-link" aria-label="Banner Link"></a>
          {%- endif -%}

          <!-- Background Picture -->
          <picture class="v5-hero-pic">
            {%- if mob_img != blank -%}
              <source media="(max-width: 768px)" srcset="{{ mob_img | image_url: width: 800 }}">
            {%- endif -%}
            {%- if desk_img != blank -%}
              <img 
                src="{{ desk_img | image_url: width: 2000 }}" 
                alt="{{ heading | default: block.settings.desk_img.alt | default: 'Kisah Campaign' | escape }}" 
                class="v5-hero-img"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                decoding="async"
                width="2000"
                height="989"
              >
            {%- else -%}
              <div class="v5-hero-fallback-bg"></div>
            {%- endif -%}
          </picture>

          {%- if has_copy -%}
            <!-- Content Copy (Bottom Left) -->
            <div class="v5-hero-copy">
              {%- if eyebrow != blank -%}
                <div class="v5-hero-eyebrow">{{ eyebrow }}</div>
              {%- endif -%}
              {%- if heading != blank -%}
                <h1 class="v5-hero-title">{{ heading | newline_to_br }}</h1>
              {%- endif -%}
              {%- if subhead != blank -%}
                <p class="v5-hero-sub">{{ subhead }}</p>
              {%- endif -%}
              {%- if btn_text != blank -%}
                <div class="v5-hero-ctas">
                  <a href="{{ btn_link }}" class="v5-hero-btn">{{ btn_text }}</a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Default Demo Slides if no blocks -->
      <div class="v5-hero-slide is-active" data-slide-index="0">
        <picture class="v5-hero-pic">
          <source media="(max-width: 768px)" srcset="//kisah.in/cdn/shop/files/WhatsApp_Image_2026-10-23_at_4.29.56_PM.webp?width=800">
          <img src="//kisah.in/cdn/shop/files/WhatsApp_Image_2026-10-23_at_4.17.15_PM.webp?width=2000" alt="Wedding Edit" class="v5-hero-img" loading="eager" fetchpriority="high">
        </picture>
        <div class="v5-hero-copy">
          <div class="v5-hero-eyebrow">FOR FESTIVE &amp; PUJAS</div>
          <h1 class="v5-hero-title">One festival.<br>Many occasions.</h1>
          <p class="v5-hero-sub">Puja mornings, family lunches, card nights. A look for each.</p>
          <div class="v5-hero-ctas">
            <a href="/collections/wedding" class="v5-hero-btn">SHOP FESTIVE EDIT</a>
          </div>
        </div>
      </div>
      <div class="v5-hero-slide" data-slide-index="1" inert aria-hidden="true">
        <picture class="v5-hero-pic">
          <source media="(max-width: 768px)" srcset="//kisah.in/cdn/shop/files/image_8.webp?width=800">
          <img src="//kisah.in/cdn/shop/files/image_7.webp?width=2000" alt="Haldi Edit" class="v5-hero-img" loading="lazy">
        </picture>
        <div class="v5-hero-copy">
          <div class="v5-hero-eyebrow">FOR THE WEDDING GUEST</div>
          <h1 class="v5-hero-title">You don't have to be the groom<br>to be the star.</h1>
          <p class="v5-hero-sub">Kurta sets, jacket sets and indo-westerns for every function on the card.</p>
          <div class="v5-hero-ctas">
            <a href="/collections/wedding" class="v5-hero-btn">SHOP WEDDING EDIT</a>
          </div>
        </div>
      </div>
      <div class="v5-hero-slide" data-slide-index="2" inert aria-hidden="true">
        <picture class="v5-hero-pic">
          <source media="(max-width: 768px)" srcset="//kisah.in/cdn/shop/files/WhatsApp_Image_2026-10-23_at_4.29.56_PM.webp?width=800">
          <img src="//kisah.in/cdn/shop/files/WhatsApp_Image_2026-10-23_at_4.17.15_PM.webp?width=2000" alt="Groom Squad" class="v5-hero-img" loading="lazy">
        </picture>
        <div class="v5-hero-copy">
          <div class="v5-hero-eyebrow">FOR THE GROOM’S SQUAD · DULHE KI TOLI</div>
          <h1 class="v5-hero-title">Matching, without<br>the uniform.</h1>
          <p class="v5-hero-sub">Coordinated looks for the brothers, cousins and best friends.</p>
          <div class="v5-hero-ctas">
            <a href="/collections/dulhe-ki-toli" class="v5-hero-btn">SHOP THE SQUAD EDIT</a>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- TOP-LEFT CONTROLS: PROGRESS BARS + ARROWS -->
    <div class="v5-hero-controls">
      <!-- Progress Bar Indicators -->
      <div class="v5-hero-dots" role="tablist" aria-label="Slide indicators">
        {%- assign total = section.blocks.size -%}
        {%- if total == 0 -%}{%- assign total = 3 -%}{%- endif -%}
        {%- for i in (1..total) -%}
          <button 
            type="button" 
            class="v5-hdot {% if forloop.first %}is-active{% endif %}" 
            data-target-slide="{{ forloop.index0 }}"
            aria-label="Slide {{ forloop.index }}"
          >
            <i></i>
          </button>
        {%- endfor -%}
      </div>

      <!-- Arrow Buttons right beside dots -->
      <div class="v5-hero-arrows">
        <button type="button" class="v5-hnav v5-hnav--prev" aria-label="Previous slide">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="v5-hnav v5-hnav--next" aria-label="Next slide">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  #shopify-section-{{ sid }} {
    width: 100%;
    display: block;
    position: relative;
  }
  .v5-revamp-hero {
    width: 100%;
    background: #171717;
    position: relative;
    overflow: hidden;
  }
  .v5-hero-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 1067;
    max-width: 100%;
    overflow: hidden;
    background: #171717;
    touch-action: pan-y;
    user-select: none;
  }
  @media (min-width: 769px) {
    .v5-hero-slider {
      aspect-ratio: 2000 / 989;
      height: auto;
    }
  }

  /* Slide Stacking */
  .v5-hero-slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.8s;
    z-index: 1;
  }
  .v5-hero-slide.is-active {
    visibility: visible;
    opacity: 1;
    z-index: 2;
  }
  .v5-hero-slide-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    cursor: pointer;
    display: block;
  }

  /* Background Image & Scrim */
  .v5-hero-pic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .v5-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .v5-hero-fallback-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #2b1f3d 0%, #171717 100%);
  }

  /* Scrim Gradient for Legibility - only when slide has text copy */
  .v5-hero-slide.has-copy::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(16, 10, 26, 0.85) 0%,
      rgba(16, 10, 26, 0.52) 34%,
      rgba(16, 10, 26, 0.15) 54%,
      rgba(16, 10, 26, 0) 70%
    );
  }

  /* Top-Left Controls: Line Dots + Prev/Next */
  .v5-hero-controls {
    position: absolute;
    z-index: 10;
    top: 14px;
    left: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }
  .v5-hero-dots {
    display: flex;
    gap: 8px;
    flex: 1;
    max-width: 220px;
  }
  .v5-hdot {
    flex: 1;
    height: 20px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    box-sizing: border-box;
  }
  .v5-hdot i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    position: relative;
    overflow: hidden;
  }
  .v5-hdot i::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .v5-hdot.is-done i::after {
    transform: scaleX(1);
  }
  .v5-hdot.is-active i::after {
    animation: v5HeroFill 6s linear forwards;
  }
  .v5-hero-slider:hover .v5-hdot.is-active i::after {
    animation-play-state: paused;
  }
  @keyframes v5HeroFill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* Prev / Next Arrows */
  .v5-hero-arrows {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .v5-hnav {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.65);
    background: rgba(23, 23, 23, 0.28);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }
  .v5-hnav:hover {
    background: rgba(255, 255, 255, 0.95);
    color: #171717;
    border-color: #ffffff;
    transform: scale(1.06);
  }

  /* Content Copy (Bottom Left) */
  .v5-hero-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    color: #ffffff;
    padding: 0 16px 24px;
    box-sizing: border-box;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7), 0 2px 14px rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .v5-hero-ctas,
  .v5-hero-btn {
    pointer-events: auto;
  }
  .v5-hero-eyebrow {
    font-family: var(--base-font-family, sans-serif);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .v5-hero-title {
    font-family: var(--heading-font-family, "Playfair Display", serif);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.08;
    color: #ffffff;
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }
  .v5-hero-sub {
    font-family: var(--base-font-family, sans-serif);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.35;
    color: #ffffff;
    margin: 0 0 16px 0;
    max-width: 44ch;
  }
  .v5-hero-ctas {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    text-shadow: none;
  }
  .v5-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    background: #ffffff;
    color: #171717;
    border: 1px solid #ffffff;
    border-radius: 0 !important;
    font-family: var(--base-font-family, sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .v5-hero-btn:hover {
    background: #c16452;
    color: #ffffff;
    border-color: #c16452;
  }

  /* Desktop View */
  @media (min-width: 992px) {
    .v5-hero-slider {
      aspect-ratio: 2000 / 989;
      height: auto;
    }
    .v5-hero-controls {
      top: 24px;
      left: max(40px, calc((100% - 1360px) / 2 + 40px));
      right: auto;
      gap: 16px;
      justify-content: flex-start;
      width: auto;
    }
    .v5-hero-dots {
      width: 320px;
      max-width: 320px;
    }
    .v5-hnav {
      width: 36px;
      height: 36px;
    }
    .v5-hero-copy {
      left: max(40px, calc((100% - 1360px) / 2 + 40px));
      right: auto;
      max-width: 650px;
      padding: 0 0 54px 0;
    }
    .v5-hero-title {
      font-size: 48px;
      margin-bottom: 12px;
    }
    .v5-hero-sub {
      font-size: 16px;
      margin-bottom: 20px;
    }
    .v5-hero-btn {
      min-height: 48px;
      padding: 0 26px;
      font-size: 13px;
    }
    /* Side Scrim for Desktop Text */
    .v5-hero-slide::after {
      background: linear-gradient(
        to right,
        rgba(16, 10, 26, 0.72) 0%,
        rgba(16, 10, 26, 0.35) 40%,
        rgba(16, 10, 26, 0) 65%
      ), linear-gradient(
        to top,
        rgba(16, 10, 26, 0.65) 0%,
        rgba(16, 10, 26, 0) 45%
      );
    }
  }
</style>

<script>
  (function() {
    var sid = '{{ sid }}';
    var root = document.getElementById('shopify-section-' + sid);
    if (!root) return;

    var slider = root.querySelector('#hero-slider-' + sid);
    var slides = root.querySelectorAll('.v5-hero-slide');
    var dots = root.querySelectorAll('.v5-hdot');
    var prevBtn = root.querySelector('.v5-hnav--prev');
    var nextBtn = root.querySelector('.v5-hnav--next');
    if (!slides.length) return;

    var curIdx = 0;
    var timer = null;
    var duration = 6000;

    function goTo(idx) {
      if (idx < 0) idx = slides.length - 1;
      if (idx >= slides.length) idx = 0;
      if (idx === curIdx && slides[curIdx].classList.contains('is-active')) return;

      slides.forEach(function(s, i) {
        var isTarget = (i === idx);
        s.classList.toggle('is-active', isTarget);
        if (isTarget) {
          s.removeAttribute('inert');
          s.removeAttribute('aria-hidden');
        } else {
          s.setAttribute('inert', '');
          s.setAttribute('aria-hidden', 'true');
        }
      });

      dots.forEach(function(d, i) {
        d.classList.toggle('is-done', i < idx);
        d.classList.remove('is-active');
      });
      if (dots[idx]) {
        void dots[idx].offsetWidth; // reflow to restart fill animation
        dots[idx].classList.add('is-active');
      }

      curIdx = idx;
      startTimer();
    }

    function startTimer() {
      clearTimeout(timer);
      timer = setTimeout(function() {
        goTo(curIdx + 1);
      }, duration);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function(e) {
        e.preventDefault();
        goTo(curIdx - 1);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function(e) {
        e.preventDefault();
        goTo(curIdx + 1);
      });
    }

    dots.forEach(function(d) {
      d.addEventListener('click', function() {
        var target = parseInt(this.getAttribute('data-target-slide'), 10);
        goTo(target);
      });
    });

    // Touch Swipe
    var touchStartX = 0;
    var touchEndX = 0;
    slider.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    slider.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) goTo(curIdx + 1);
        else goTo(curIdx - 1);
      }
    }, { passive: true });

    // Hover pause
    slider.addEventListener('mouseenter', function() {
      clearTimeout(timer);
    });
    slider.addEventListener('mouseleave', function() {
      startTimer();
    });

    startTimer();
  })();
</script>

{% schema %}
{
  "name": "V5 Hero Banner",
  "tag": "section",
  "class": "v5-hero-banner-section",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Campaign Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desk_img",
          "label": "Desktop Image (2000x989 recommended)"
        },
        {
          "type": "image_picker",
          "id": "mob_img",
          "label": "Mobile Image (800x1067 recommended)"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Banner Link"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text (Optional)"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading (Optional)"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading (Optional)"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V5 Hero Banner"
    }
  ]
}
{% endschema %}
