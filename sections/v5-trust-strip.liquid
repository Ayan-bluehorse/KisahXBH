{% comment %}
  Kisah Homepage Revamp - Trust Strip
  - Matches Prototype HTML (.trust) & Screenshot
  - 3 Badges: Cash on Delivery | 7-Day Return & Exchange | Money-Back Guarantee
  - Authentic Wine-colored Stroke SVGs
  - Mobile: Centered stacked icon + text
  - Desktop: Side-by-side icon + text
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

<section 
  id="shopify-section-{{ sid }}" 
  class="v5-revamp-trust"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 14 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 14 }}px;
  "
>
  <div class="v5-trust-wrap">
    <div class="v5-trust-grid">
      
      <!-- Badge 1: Cash on delivery -->
      <div class="v5-trust-item">
        <div class="v5-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="6" width="19" height="12" rx="1.5"></rect>
            <circle cx="12" cy="12" r="2.6"></circle>
            <path d="M6 9.5v5M18 9.5v5"></path>
          </svg>
        </div>
        <div class="v5-trust-text">
          <b class="v5-trust-title">{{ section.settings.b1_title | default: 'Cash on delivery' }}</b>
          <span class="v5-trust-sub">{{ section.settings.b1_sub | default: 'Pay when it arrives' }}</span>
        </div>
      </div>

      <!-- Badge 2: 7-day return -->
      <div class="v5-trust-item">
        <div class="v5-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 9h11a5 5 0 0 1 0 10H9"></path>
            <path d="m8 5-4 4 4 4"></path>
          </svg>
        </div>
        <div class="v5-trust-text">
          <b class="v5-trust-title">{{ section.settings.b2_title | default: '7-day return' }}</b>
          <span class="v5-trust-sub">{{ section.settings.b2_sub | default: '& exchange' }}</span>
        </div>
      </div>

      <!-- Badge 3: Money-back guarantee -->
      <div class="v5-trust-item">
        <div class="v5-trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3z"></path>
            <path d="m8.8 12.2 2.3 2.3 4.3-4.6"></path>
          </svg>
        </div>
        <div class="v5-trust-text">
          <b class="v5-trust-title">{{ section.settings.b3_title | default: 'Money-back' }}</b>
          <span class="v5-trust-sub">{{ section.settings.b3_sub | default: 'guarantee' }}</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #shopify-section-{{ sid }} {
    width: 100%;
    display: block;
  }
  .v5-revamp-trust {
    width: 100%;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
  }
  .v5-trust-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
  .v5-trust-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    align-items: center;
  }
  .v5-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    color: #5c5c5c;
    box-sizing: border-box;
  }
  .v5-trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #702c40;
    flex-shrink: 0;
  }
  .v5-trust-icon svg {
    display: block;
    width: 24px;
    height: 24px;
    stroke: #702c40;
  }
  .v5-trust-text {
    display: flex;
    flex-direction: column;
    font-family: var(--base-font-family, sans-serif);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.25;
  }
  .v5-trust-title {
    font-family: var(--base-font-family, sans-serif);
    font-weight: 700;
    font-size: 12px;
    color: #171717;
    white-space: nowrap;
  }
  .v5-trust-sub {
    color: #5c5c5c;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .v5-trust-grid {
      gap: 20px;
    }
    .v5-trust-item {
      flex-direction: row;
      gap: 12px;
      justify-content: center;
      text-align: left;
    }
    .v5-trust-text {
      font-size: 12px;
    }
    .v5-trust-title {
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Strip",
  "tag": "section",
  "class": "v5-trust-strip-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 6,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 6,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 14
    },
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "text",
      "id": "b1_title",
      "label": "Title",
      "default": "Cash on delivery"
    },
    {
      "type": "text",
      "id": "b1_sub",
      "label": "Subtitle",
      "default": "Pay when it arrives"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "text",
      "id": "b2_title",
      "label": "Title",
      "default": "7-day return"
    },
    {
      "type": "text",
      "id": "b2_sub",
      "label": "Subtitle",
      "default": "& exchange"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "text",
      "id": "b3_title",
      "label": "Title",
      "default": "Money-back"
    },
    {
      "type": "text",
      "id": "b3_sub",
      "label": "Subtitle",
      "default": "guarantee"
    }
  ],
  "presets": [
    {
      "name": "Trust Strip"
    }
  ]
}
{% endschema %}
