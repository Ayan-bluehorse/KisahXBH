<section id="shopify-section-{{ section.id }}" class="afterparty-lookbook" style="
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}">
  <div class="container">

    {% if section.settings.heading != blank %}
      <h2 class="ap-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ap-grid lookbook-slider">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product_handle] %}

        <div class="ap-card">

          <!-- IMAGE WRAP WITH SHAPE -->
          <a href="{{ product.url }}" class="ap-image-wrap">
            {% if block.settings.image %}
              <img 
                width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ product.title }}"
                class="ap-image"
              >
            {% endif %}
          </a>

          <!-- PRODUCT TITLE -->
          {% if block.settings.product_title != blank %}
          <h3 class="ap-title">
            <a href="{{ product.url }}"> 
            {{ block.settings.product_title }}
            </a>
          </h3>
          {% else %}
          <h3 class="ap-title">
            <a href="{{ product.url }}">
            {{ product.title  }}
            </a>
          </h3>    
          {% endif %}

          <!-- ADD TO CART / LINK TO PRODUCT ICON -->
          <a href="{{ product.url }}" class="ap-cart-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M21 5L19 12H7.37671M20 16H8L6 3H3M16 5.5H13.5M13.5 5.5H11M13.5 5.5V8M13.5 5.5V3M9 20C9 20.5523 8.55228 21 8 21C7.44772 21 7 20.5523 7 20C7 19.4477 7.44772 19 8 19C8.55228 19 9 19.4477 9 20ZM20 20C20 20.5523 19.5523 21 19 21C18.4477 21 18 20.5523 18 20C18 19.4477 18.4477 19 19 19C19.5523 19 20 19.4477 20 20Z" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.afterparty-lookbook {
padding: 0px 0 50px;
    text-align: center;
}

.afterparty-lookbook .container {
    max-width: 1280px;
}

.afterparty-lookbook h2.ap-heading {
    text-align: center;
    font-size: 48px !important;
    line-height: 48px !important;
    font-family: var(--heading-font-family) !important;
    font-weight: 600 !important;
    text-transform: none !important;
    color: #101828;
    margin-bottom: 50px;
}


.ap-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
gap: 20px;
}

/* CARD */
.ap-card {
  position: relative;
  text-align: center;
}

/* IMAGE ARCH SHAPE */
.ap-image-wrap {
  display: block;
  overflow: hidden;
background: #D9D9D9;
border-radius: 150px 150px 0px 0px;
}

.ap-image {
  width: 100%;
  height: auto;
  display: block;
}


.ap-title {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 600;
    color: #000000;
    margin-bottom: 0;
    font-family: var(--heading-font-family) !important;
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: normal;
}

/* CART ICON */
.ap-cart-icon {
    position: absolute;
    bottom: 40px;
    right: 10px;
    border-radius: 50%;
    cursor: pointer;
}

.ap-cart-icon:hover {
  transform: scale(1.1);
}

/* RESPONSIVE */
@media(max-width: 991px) {
  .ap-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width: 768px) {
  .ap-grid {
    grid-template-columns: unset;
  }

.ap-card {
    margin-right: 10px;
}

.afterparty-lookbook .container {
    padding-right: 0;
}

.afterparty-lookbook h2.ap-heading {
    padding-right: 16px;
    font-size: 24px !important;
    line-height: normal !important;
    margin-bottom: 26px;
}

.ap-cart-icon svg {
    width: 14px;
    height: 14px;
}

.ap-title {
    margin-top: 5px;
    font-size: 13px;
    line-height: normal;
}

.afterparty-lookbook {
    padding: 0px 0 30px;
}

}

</style>


<script>
window.kisahWhenJQueryReady(function($) {
  const $slider = $('.lookbook-slider');

  function initOrDestroyLookbookSlider() {
    if ($(window).width() < 768) {

      if (!$slider.hasClass('slick-initialized')) {
        $slider.slick({
          slidesToShow: 2.3,
          slidesToScroll: 1,
          infinite: false,
          dots: false,
          arrows: true,
          speed: 400,
          prevArrow: '<button class="slick-prev">‹</button>',
          nextArrow: '<button class="slick-next">›</button>',
        });
      }

    } else {
      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }
    }
  }

  // Initial check
  initOrDestroyLookbookSlider();

  // Resize watcher
  let resizeTimer;
  $(window).on('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(initOrDestroyLookbookSlider, 200);
  });
});
</script>


{% schema %}
{
  "name": "Afterparty Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Afterparty Lookbook"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFF2EA"
    }
  ],
  "blocks": [
    {
      "type": "lookbook_item",
      "name": "Lookbook Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lookbook Image"
        },
        {
          "type": "product",
          "id": "product_handle",
          "label": "Select Product"
        },
         {
          "type": "text",
          "id": "product_title",
          "label": "Title"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Afterparty Lookbook"
    }
  ]
}
{% endschema %}
