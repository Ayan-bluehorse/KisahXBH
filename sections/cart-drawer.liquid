            <circle cx="57.5" cy="77.5" r="22.5" fill="#D9D9D9"/>
            <ellipse cx="49.5" cy="71" rx="2.5" ry="3" fill="#A3A3A3"/>
            <ellipse cx="64.5" cy="71" rx="2.5" ry="3" fill="#A3A3A3"/>
