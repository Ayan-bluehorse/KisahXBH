 {% assign metaProduct = product.metafields.custom.bundle_product.value %}
 {% assign metacurrent_variant = metaProduct.selected_or_first_available_variant %}
 {% assign currProductprice = product.price   %}
 {% assign metaproprice =  metaProduct.price %}
 {% assign totalPrice = currProductprice | plus: metaproprice %}
 {% assign curproCom =  product.compare_at_price  %}
 {% assign metaproComp =  metaProduct.compare_at_price %}
 {% assign totalComp = metaproComp | plus: curproCom %}
 {% if metaProduct != blank %}
