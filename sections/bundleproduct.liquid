</style>

<div class="container">
<div class="bundle-product-sec">
  <div class="section-offer-details">
    <h3>{{ section.settings.head }}</h3>
     {{ section.settings.text }}
  </div>
   <div class="products_image-wrap">
     
     <div class="image-only-wrapp">
       <div class="current-product-image-details">
        <img src="{{ product.featured_image | image_url }}" width="210px" height="auto">
      </div>
        {% if metaProduct != blank %}
       <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
          <line y1="10.5" x2="22" y2="10.5" stroke="black"/>
          <line x1="10.5" y1="22" x2="10.5" stroke="black"/>
       </svg>
       
       <div class="second-pro-details">
          <div class="metapro-imag">
            <img src="{{ metaProduct.featured_image | image_url  }}"  width="210px" height="auto">
         </div>
        </div>
        {% endif %}
      </div>
        
  <div class="product-details-container">
      <div class="offer-percentage-container">
        <span class="offer-text-detail">{{ section.settings.percent }}</span>
      </div>
        <div class="current-product-details">
          <p>{{ product.title }}</p>
           {% render 'price' %} 
        </div>
       {% if metaProduct != blank %}
          <div class="second-product-details">
             <p>{{ metaProduct.title }}</p>
              {% render 'price', product:metaProduct ,  for_variant_picker: true, current_variant: metacurrent_variant %}
          </div>
          {% endif %}
           <div class="total-price">
            <span class="total-price-text">Total price:</span> 
            <div class="metapro-price-container">
              <div class="total-cur-price">
              {{ totalPrice  | money }}
              </div>
              <div class="comapare-total-price">
                {{ totalComp | money }}
              </div>
            </div>
          </div>
       <a href="{{  }}" class="bundle-anchor-tag">Add selected to cart</a>
      </div>
   </div>
  </div>
</div>
{% endif %}
{% schema %}
  {
    "name": "Bundle Product",
    "settings": [
      {
        "type": "text",
         "id": "percent",
         "label": "Offer text"
      },
      {
        "type": "text",
         "id": "head",
         "label": "Heading"
      },
      {
        "type": "textarea",
         "id": "text",
         "label": "textarea"
      },
      {
        "type": "header",
        "content": "SECTION PADDING FOR DESKTOP"
    },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
    ],
    "presets": [
      {
        "name": "Bundle Product"
      }
    ]
  }
  
{% endschema %}