{{ 'search.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'search-page-size-inclusive.js' | asset_url }}" defer></script>
{% paginate search.results by section.settings.coll_num_per_page_int %} 
<div class="page-header" data-cc-animate>
  <div class="container">
    <h1 class="visually-hidden">{{ 'general.search.title' | t }}</h1>

    <div class="main-search">
      <div class="main-search__container">
        <form class="main-search__form" action="{{ routes.search_url }}" method="get" autocomplete="off">
          <input type="hidden" name="filter.v.availability" value="1">
          <input type="hidden" name="type" value="product">
          <div class="main-search__input-container">
            <input
              class="main-search__input"
              type="text"
              name="q"
              autocomplete="off"
              placeholder="{{ 'general.search.placeholder' | t | escape }}"
              aria-label="{{ 'general.search.input_label' | t | escape }}"
              value="{{ search.terms | escape }}" />
            <button class="main-search__button" type="submit" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon-search' %}</button>
          </div>
          {%- if settings.show_search_suggestions -%}
            <script src="{{ 'search-suggestions.js' | asset_url }}" defer></script>
            <search-suggestions></search-suggestions>
          {%- endif -%}
        </form>
      </div>
    </div>
  </div>
</div>

{% if search.performed %}
  {% capture override_handle %}{% render 'collection-search-override-handle', terms: search.terms %}{% endcapture %}
  {%- liquid
    assign override_handle = override_handle | strip
    assign override_coll = blank
    assign search_override_ok = false
    if override_handle != blank and paginate.current_page == 1
      assign override_coll = collections[override_handle]
      if override_coll
        assign search_override_ok = true
      endif
    endif

    assign so_cap = section.settings.coll_num_per_page_int
    assign so_grid_count = 0
    if search_override_ok
      for product in override_coll.products
        if product.available
          unless product.tags contains 'no-search'
            assign so_grid_count = so_grid_count | plus: 1
            if so_grid_count >= so_cap
              break
            endif
          endunless
        endif
      endfor
    endif

    assign show_override_grid = false
    if search_override_ok and so_grid_count > 0
      assign show_override_grid = true
    endif

    assign show_filters = section.settings.enable_filtering
    if search.filters == empty
      assign show_filters = false
    endif

    assign no_search_count = 0
    for item in search.results
      if item.object_type == 'product'
        if item.tags contains 'no-search'
          assign no_search_count = no_search_count | plus: 1
        endif
      endif
    endfor
    assign base_visible = paginate.items | minus: no_search_count
    if base_visible < 0
      assign base_visible = 0
    endif
    assign visible_count = base_visible
    if search.results == empty and show_override_grid and so_grid_count > 0
      assign visible_count = so_grid_count
    endif
  -%}

  {% if visible_count == 0 and search.results != empty %}
    <div class="container">
      <h5 class="align-centre fully-spaced-row" data-cc-animate>{{ 'general.search.no_results' | t: terms: search.terms }}</h5>
    </div>
  {% else %}
  <div class="container{% if settings.use_fullwidth_layout %} container--no-max{% endif %}">
    {% liquid
      assign filter_count = 0
      for filter in search.filters
        if filter.param_name == 'filter.v.availability'
          continue
        endif
        assign filter_count = filter_count | plus: filter.active_values.size
        if filter.type == 'price_range'
          if filter.min_value.value != nil or filter.max_value.value != nil
            assign filter_count = filter_count | plus: 1
          endif
        endif
      endfor
    %}

    <div class="kisah-ctrl" data-ajax-container>
      <div class="kisah-ctrl__n"><b>{{ search.results_count }}</b> results</div>
      {%- if section.settings.show_sort -%}
        <button class="kisah-ctrl__btn" id="kisahSortBtn" type="button">
          <svg viewBox="0 0 24 24"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg>
          Sort
        </button>
      {%- endif -%}
      {%- if section.settings.show_sort and show_filters -%}
        <span class="kisah-ctrl__rule"></span>
      {%- endif -%}
      {%- if show_filters -%}
        <button class="kisah-ctrl__btn kisah-ctrl__btn--filter" id="kisahFilterBtn" type="button" data-any="{% if filter_count > 0 %}1{% else %}0{% endif %}">
          <svg viewBox="0 0 24 24"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
          Filter{% if filter_count > 0 %}<span class="kisah-ctrl__pip">{{ filter_count }}</span>{% endif %}
        </button>
      {%- endif -%}
    </div>

    {%- if filter_count > 0 -%}
      <div class="kisah-applied" id="kisahApplied" data-ajax-container>
        {%- for filter in search.filters -%}
          {%- if filter.param_name == 'filter.v.availability' -%}
            {%- continue -%}
          {%- endif -%}
          {%- for value in filter.active_values -%}
            <a class="kisah-achip" href="{{ value.url_to_remove }}">
              {{ value.label }}
              <span class="close-x">&times;</span>
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil -%}
            <a class="kisah-achip" href="{{ filter.url_to_remove }}">
              {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }}
              <span class="close-x">&times;</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
        {% assign clear_url = search.terms | escape | prepend: '?q=' | prepend: routes.search_url %}
        <a class="kisah-achip kisah-achip--clear" href="{{ clear_url }}">Clear all</a>
      </div>
    {%- endif -%}

    <filter-container class="filter-container" data-ajax-filtering="{{ settings.ajax_products }}" data-filter-section-id="{{ section.id }}">
      {% liquid
        assign clear_url = search.terms | escape | prepend: '?q=' | prepend: routes.search_url
        if section.settings.show_sort or show_filters
          render 'faceted-filters', filter_context: search, clear_url: clear_url, current_sort: current_sort
        endif
      %}

      <div class="filters-adjacent collection-listing" data-ajax-container>
        {% if search.results == empty and so_grid_count == 0 %}
          <h5 class="align-centre fully-spaced-row" data-cc-animate>{{ 'general.search.no_results' | t: terms: search.terms }}</h5>
        {% else %}
          <div class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }} search-infinite-scroll-grid" data-size-limit="{{ section.settings.coll_num_per_page_int }}">
            {%- liquid
              assign so_aspect_products = false
              if search.results == empty and show_override_grid
                assign so_aspect_products = true
              endif

              if settings.prod_thumb_shape == 'portrait-23'
                assign chosen_product_aspect_ratio = 0.67
              elsif settings.prod_thumb_shape == 'portrait-45'
                assign chosen_product_aspect_ratio = 0.8
              elsif settings.prod_thumb_shape == 'square'
                assign chosen_product_aspect_ratio = 1.0
              elsif settings.prod_thumb_shape == 'landscape-54'
                assign chosen_product_aspect_ratio = 1.25
              elsif settings.prod_thumb_shape == 'landscape-32'
                assign chosen_product_aspect_ratio = 1.50
              elsif settings.prod_thumb_shape == 'tallest'
                assign chosen_product_aspect_ratio = 99
                if so_aspect_products
                  for product in override_coll.products
                    if product.available
                      unless product.tags contains 'no-search'
                        if product.featured_media.preview_image.aspect_ratio < chosen_product_aspect_ratio
                          assign chosen_product_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                        endif
                      endunless
                    endif
                  endfor
                else
                  for product in search.results
                    if product.object_type == 'product'
                      unless product.tags contains 'no-search'
                        if product.featured_media.preview_image.aspect_ratio < chosen_product_aspect_ratio
                          assign chosen_product_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                        endif
                      endunless
                    endif
                  endfor
                endif
              else
                assign chosen_product_aspect_ratio = 0
                if so_aspect_products
                  for product in override_coll.products
                    if product.available
                      unless product.tags contains 'no-search'
                        if product.featured_media.preview_image.aspect_ratio > chosen_product_aspect_ratio
                          assign chosen_product_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                        endif
                      endunless
                    endif
                  endfor
                else
                  for product in search.results
                    if product.object_type == 'product'
                      unless product.tags contains 'no-search'
                        if product.featured_media.preview_image.aspect_ratio > chosen_product_aspect_ratio
                          assign chosen_product_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                        endif
                      endunless
                    endif
                  endfor
                endif
              endif

              if settings.coll_grid_image_shape == 'portrait-23'
                assign chosen_collection_aspect_ratio = 0.67
              elsif settings.coll_grid_image_shape == 'portrait-45'
                assign chosen_collection_aspect_ratio = 0.8
              elsif settings.coll_grid_image_shape == 'square'
                assign chosen_collection_aspect_ratio = 1.0
              elsif settings.coll_grid_image_shape == 'landscape-54'
                assign chosen_collection_aspect_ratio = 1.25
              elsif settings.coll_grid_image_shape == 'landscape-32'
                assign chosen_collection_aspect_ratio = 1.50
              elsif settings.coll_grid_image_shape == 'tallest'
                assign chosen_collection_aspect_ratio = 99
                for collection in search.results
                  if collection.object_type == 'collection'
                    if collection.featured_image.aspect_ratio < chosen_collection_aspect_ratio
                      assign chosen_collection_aspect_ratio = collection.featured_image.aspect_ratio
                    endif
                  endif
                endfor
              else
                assign chosen_collection_aspect_ratio = 0
                for collection in search.results
                  if collection.object_type == 'collection'
                    if collection.featured_image.aspect_ratio > chosen_collection_aspect_ratio
                      assign chosen_collection_aspect_ratio = collection.featured_image.aspect_ratio
                    endif
                  endif
                endfor
              endif
            -%}
            {%- if show_override_grid and so_grid_count > 0 -%}
              {%- assign so_id_prefix = ',' -%}
              {%- assign so_rendered = 0 -%}
              {%- for product in override_coll.products -%}
                {%- if product.available -%}
                  {%- if product.tags contains 'no-search' -%}{%- continue -%}{%- endif -%}
                  {% render 'product-block', product: product, collection: override_coll, custom_aspect_ratio: chosen_product_aspect_ratio, animate: true %}
                  {%- assign so_id_prefix = so_id_prefix | append: product.id | append: ',' -%}
                  {%- assign so_rendered = so_rendered | plus: 1 -%}
                  {%- if so_rendered >= so_cap -%}{%- break -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- liquid
              assign size_map = 'XS:36,S:38,M:40,L:42,XL:44,XXL:46,3XL:48,4XL:50,5XL:52,6XL:54,7XL:56' | split: ','
              assign mapped_s = '38'
              assign mapped_m = '40'
              assign mapped_l = '42'
              assign mapped_xl = '44'

              for pair in size_map
                assign p = pair | split: ':'
                assign p_letter = p[0] | downcase | strip
                assign p_number = p[1] | strip

                if p_letter == 's'
                  assign mapped_s = p_number
                elsif p_letter == 'm'
                  assign mapped_m = p_number
                elsif p_letter == 'l'
                  assign mapped_l = p_number
                elsif p_letter == 'xl'
                  assign mapped_xl = p_number
                endif
              endfor
            -%}

            {%- comment -%}---- PASS 1: IN-STOCK PRODUCTS & NON-PRODUCTS ----{%- endcomment -%}
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% if item.tags contains 'no-search' %}
                  {% continue %}
                {% endif %}
                {%- if show_override_grid and so_grid_count > 0 -%}
                  {%- assign so_needle = ',' | append: item.id | append: ',' -%}
                  {%- if so_id_prefix contains so_needle -%}{%- continue -%}{%- endif -%}
                {%- endif -%}
                {%- liquid
                  assign total_variants = item.variants.size
                  assign available_variants = item.variants | where: 'available', true | size
                -%}
                {% if available_variants > 0 %}
                  {%- liquid
                    assign size_s_available = false
                    assign size_m_available = false
                    assign size_l_available = false
                    assign size_xl_available = false

                    for option in item.options_with_values
                      assign option_name = option.name | downcase | strip
                      if option_name == 'size'
                        for value in option.values
                          assign size_clean = value | downcase | strip | replace: ' ', '' | replace: '/', '-'

                          if size_clean == 's' or size_clean == 'small' or size_clean == '38' or size_clean == 's-38' or size_clean == 's38'
                            if value.available
                              assign size_s_available = true
                            endif
                          endif

                          if size_clean == 'm' or size_clean == 'medium' or size_clean == '40' or size_clean == 'm-40' or size_clean == 'm40'
                            if value.available
                              assign size_m_available = true
                            endif
                          endif

                          if size_clean == 'l' or size_clean == 'large' or size_clean == '42' or size_clean == 'l-42' or size_clean == 'l42'
                            if value.available
                              assign size_l_available = true
                            endif
                          endif

                          if size_clean == 'xl' or size_clean == 'extralarge' or size_clean == 'extra-large' or size_clean == '44' or size_clean == 'xl-44' or size_clean == 'xl44'
                            if value.available
                              assign size_xl_available = true
                            endif
                          endif

                          if size_s_available and size_m_available and size_l_available and size_xl_available
                            break
                          endif
                        endfor
                        break
                      endif
                    endfor
                  -%}
                  <div
                    class="stock-sort-item"
                    data-stock-sort-item
                    data-stock-tier="primary"
                    data-product-handle="{{ item.handle }}"
                    data-available-variants="{{ available_variants }}"
                    data-total-variants="{{ total_variants }}"
                    data-option-name="Size"
                    data-product-type="{{ item.type | downcase | strip | escape }}"
                    data-size-s-available="{{ size_s_available }}"
                    data-size-m-available="{{ size_m_available }}"
                    data-size-l-available="{{ size_l_available }}"
                    data-size-xl-available="{{ size_xl_available }}"
                  >
                    {% render 'product-block', product: item, custom_aspect_ratio: chosen_product_aspect_ratio, animate: true %}
                  </div>
                {% endif %}
              {% elsif item.object_type == 'collection' %}
                {% render 'collection-block', collection: item, custom_aspect_ratio: chosen_collection_aspect_ratio, animate: true %}
              {% else %}
                <div class="product-block page-block" data-cc-animate>
                  <div class="block-inner">
                    <div class="block-inner-inner">
                      {% if item.object_type == 'article' and item.image %}
                        <div class="article-image">
                          <a href="{{ item.url }}">
                            {%- render 'image' with item.image, size_cols_mobile: 2, size_cols_desktop: section.settings.grid, custom_aspect_ratio: 1.33 -%}
                          </a>
                        </div>
                      {% endif %}
                      <div class="text-cont">
                        <h6 class="page-block__title"><a href="{{ item.url }}">{{ item.title }}</a></h6>
                        {% unless item.object_type == 'article' and item.image %}
                          <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                        {% endunless %}
                        <a href="{{ item.url }}" class="more">
                          <span class="beside-svg underline">{{ 'blogs.article.read_more' | t }}</span>
                          <span class="icon--small icon-natcol has-ltr-icon">{% render 'icon-chevron-right' %}</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}

            {%- comment -%}---- PASS 2: OUT-OF-STOCK PRODUCTS (dimmed, rendered at the bottom) ----{%- endcomment -%}
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% if item.tags contains 'no-search' %}
                  {% continue %}
                {% endif %}
                {%- if show_override_grid and so_grid_count > 0 -%}
                  {%- assign so_needle = ',' | append: item.id | append: ',' -%}
                  {%- if so_id_prefix contains so_needle -%}{%- continue -%}{%- endif -%}
                {%- endif -%}
                {%- liquid
                  assign total_variants = item.variants.size
                  assign available_variants = item.variants | where: 'available', true | size
                -%}
                {% if available_variants == 0 %}
                  <div
                    class="stock-sort-item stock-sort-item--oos"
                    data-stock-sort-item
                    data-stock-tier="out-of-stock"
                    data-product-handle="{{ item.handle }}"
                    data-available-variants="0"
                    data-total-variants="{{ total_variants }}"
                    data-option-name="Size"
                    data-product-type="{{ item.type | downcase | strip | escape }}"
                    data-size-s-available="false"
                    data-size-m-available="false"
                    data-size-l-available="false"
                    data-size-xl-available="false"
                  >
                    {% render 'product-block', product: item, custom_aspect_ratio: chosen_product_aspect_ratio, animate: true %}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </filter-container>
  </div>

  <div class="container pagination-row search-infinite-scroll-wrap" data-ajax-container>
    {% if paginate.next %}
      <div class="infinite-scroll-sentinel" data-next-url="{{ paginate.next.url }}" data-section-id="{{ section.id }}" aria-hidden="true">
        <div class="infinite-scroll-loading" style="display: none; text-align: center; padding: 0.5rem;">
          <span class="infinite-scroll-spinner"></span>
        </div>
      </div>
    {% endif %}
  </div>
  {% endif %}
{% endif %}

{% endpaginate %}

<script>
(function() {
  'use strict';
  function initSearchInfiniteScroll() {
    var grid = document.querySelector('.search-infinite-scroll-grid');
    var wrap = document.querySelector('.search-infinite-scroll-wrap');
    var sentinel = document.querySelector('.search-infinite-scroll-wrap .infinite-scroll-sentinel[data-next-url]');
    if (!grid || !sentinel) {
      if (wrap && !sentinel) wrap.style.display = 'none';
      return;
    }
    if (sentinel._infiniteScrollObserved) return;
    sentinel._infiniteScrollObserved = true;

    var loading = false;

    function loadMore() {
      var nextUrl = sentinel.getAttribute('data-next-url');
      if (!nextUrl || loading) return;

      loading = true;
      var loadingEl = sentinel.querySelector('.infinite-scroll-loading');
      if (loadingEl) loadingEl.style.display = 'block';

      var sectionId = sentinel.getAttribute('data-section-id');
      var fetchUrl = nextUrl + (nextUrl.indexOf('?') >= 0 ? '&' : '?') + 'section_id=' + encodeURIComponent(sectionId);

      fetch(fetchUrl)
        .then(function(res) { return res.text(); })
        .then(function(html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newGrid = doc.querySelector('.search-infinite-scroll-grid');
          var newSentinel = doc.querySelector('.infinite-scroll-sentinel');

          if (newGrid && newGrid.children.length) {
            for (var i = 0; i < newGrid.children.length; i++) {
              grid.appendChild(newGrid.children[i].cloneNode(true));
            }
            if (window.__reorderSearchGrid) {
              window.__reorderSearchGrid();
            }
          }

          if (newSentinel && newSentinel.getAttribute('data-next-url')) {
            sentinel.setAttribute('data-next-url', newSentinel.getAttribute('data-next-url'));
            if (newSentinel.getAttribute('data-section-id')) sentinel.setAttribute('data-section-id', newSentinel.getAttribute('data-section-id'));
          } else {
            sentinel.removeAttribute('data-next-url');
            if (sentinel.parentNode) sentinel.parentNode.style.display = 'none';
          }
        })
        .catch(function() {
          sentinel.removeAttribute('data-next-url');
          if (sentinel.parentNode) sentinel.parentNode.style.display = 'none';
        })
        .finally(function() {
          loading = false;
          if (loadingEl) loadingEl.style.display = 'none';
        });
    }

    var observer = new IntersectionObserver(function(entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting && sentinel.getAttribute('data-next-url')) {
          loadMore();
          break;
        }
      }
    }, { rootMargin: '0px 0px 80px 0px', threshold: 0 });

    observer.observe(sentinel);
  }

  initSearchInfiniteScroll();
  var wrap = document.querySelector('.search-infinite-scroll-wrap');
  if (wrap && typeof MutationObserver !== 'undefined') {
    var mo = new MutationObserver(function() {
      initSearchInfiniteScroll();
    });
    mo.observe(wrap, { childList: true, subtree: true });
  }
})();
</script>

{% schema %}
{
  "name": "Search results",
  "class": "section-search-template page-section-spacing",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendors",
      "default": false
    },
    {
      "type": "range",
      "id": "coll_num_per_page_int",
      "min": 16,
      "max": 50,
      "step": 2,
      "label": "Number of products to show per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "[Customize filters](/admin/menus)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collapse_tag_sidebar_by_default",
      "label": "Collapse filter column",
      "default": false
    },
    {
      "type": "select",
      "id": "collapse_filters_method",
      "label": "Filter row collapse",
      "default": "over-12",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "over-6",
          "label": "Over 6 items"
        },
        {
          "value": "over-12",
          "label": "Over 12 items"
        },
        {
          "value": "over-18",
          "label": "Over 18 items"
        },
        {
          "value": "all",
          "label": "All rows"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_filter_counts",
      "label": "Show filter counts",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_disabled_filters",
      "label": "Show filters with zero results",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_apply_hide_unavailable",
      "label": "On selecting a filter, automatically apply 'Hide out of stock'",
      "default": false,
      "info": "Requires Availability filter to be enabled"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_filter",
      "label": "Enable stick on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "filter_two_columns",
      "label": "Two column filter values",
      "default": false
    },
    {
      "type": "header",
      "content": "Sorting"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sorting dropdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sort_show_featured",
      "label": "Enable order: Featured",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sort_show_best",
      "label": "Enable order: Best selling",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sort_show_alpha",
      "label": "Enable order: Alphabetical",
      "default": true
    },
    {
