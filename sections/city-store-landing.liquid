    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.35);
    animation: kslPulse 1.8s infinite;
  }
  .ksl-dot-soon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #F5A623;
    display: inline-block;
  }
  @keyframes kslPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }

  .ksl-card__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .ksl-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .ksl-card__title {
