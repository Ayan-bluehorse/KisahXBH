    gap: 24px;
    margin-bottom: 36px;
  }
  .ksl-card {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #ECE7DE;
    overflow: hidden;
    display: flex;
    flex-direction: column;
