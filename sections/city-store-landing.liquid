  .ksl-link-arrow:hover { text-decoration: underline; }

  /* 11. BEFORE YOU VISIT (FAQ - PDF Page 4) */
  .ksl-faq {
    padding: 64px 0 72px;
    background: #FFFFFF;
  }
  .ksl-faq__inner { max-width: 820px; }
  .ksl-faq__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 28px;
  }
  .ksl-faq__item {
    border: 1px solid #ECE7DE;
    border-radius: 10px;
    background: #FAF8F5;
    overflow: hidden;
  }
