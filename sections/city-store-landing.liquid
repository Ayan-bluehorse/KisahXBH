    width: 100%;
    aspect-ratio: 4 / 3;
    background: #ECE7DE;
    overflow: hidden;
  }
  .ksl-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* Top-left high contrast badge */
  .ksl-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #FFFFFF !important;
    color: #1B1226 !important;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 99px;
    display: inline-flex;
    align-items: center;
