    margin-bottom: 6px;
  }
  .ksl-cat-title {
    font-size: clamp(28px, 3.4vw, 38px) !important;
    font-weight: 800 !important;
    color: #1B1226 !important;
    margin: 0 0 6px !important;
  }
  .ksl-cat-desc {
    font-size: 14.5px;
    color: #635E55;
    margin: 0;
  }
  .ksl-slider-nav { display: flex; gap: 8px; }
  .ksl-slider-nav-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #D9D4C7;
    background: #FFFFFF;
    color: #1B1226;
    font-size: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
