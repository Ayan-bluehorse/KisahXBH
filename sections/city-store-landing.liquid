    font-weight: 700;
    font-size: 13.5px;
    text-decoration: none;
  }
  .ksl-upcoming-link:hover { text-decoration: underline; }

  /* 5. WHY VISIT THE STORE (PDF Page 2 - Exact Match) */
  .ksl-why-visit {
    background-color: #201747;
    color: #FFFFFF;
    padding: 64px 0 72px;
  }
  .ksl-why-visit__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    gap: 20px;
  }
  .ksl-why-visit__eyebrow {
    font-size: 12px;
