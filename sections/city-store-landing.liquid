  }
  .ksl-upcoming-title {
    font-size: 20px !important;
    font-weight: 800 !important;
    color: #1B1226 !important;
    margin: 0 0 8px !important;
  }
  .ksl-upcoming-desc {
    font-size: 13.5px;
    color: #635E55;
