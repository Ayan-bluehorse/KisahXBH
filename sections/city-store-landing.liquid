    transition: transform 0.4s ease;
  }
  .ksl-gallery-card:hover .ksl-gallery-img {
    transform: scale(1.03);
  }
  .ksl-gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 36px 16px 14px;
    background: linear-gradient(to top, rgba(20, 14, 40, 0.88) 0%, rgba(20, 14, 40, 0.45) 60%, rgba(20, 14, 40, 0) 100%);
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    pointer-events: none;
