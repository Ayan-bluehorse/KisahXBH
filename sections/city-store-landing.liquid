  .ksl-phone-link {
    color: #1B1226;
    text-decoration: none;
    font-weight: 500;
  }
  .ksl-phone-link:hover { color: #201747; text-decoration: underline; }

  .ksl-card__actions {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ksl-btn--directions {
    width: 100%;
    background-color: #F5A623;
    color: #1B1226 !important;
    font-size: 14px;
    font-weight: 700;
    padding: 11px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(245, 166, 35, 0.25);
  }
  .ksl-btn--directions:hover { background-color: #E09214; }
  .ksl-card__sub-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ksl-btn--card-call,
  .ksl-btn--card-whatsapp {
    background-color: #FFFFFF;
    border: 1px solid #1B1226;
    color: #1B1226 !important;
    font-size: 13px;
    font-weight: 600;
    padding: 9px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .ksl-btn--card-call:hover,
  .ksl-btn--card-whatsapp:hover { background-color: #F5F3ED; }

  /* Map & Upcoming Card (PDF Page 2) */
  .ksl-stores-bottom-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 24px;
    margin-top: 24px;
  }
  .ksl-map-card {
    background: #FFFFFF;
    border: 1px solid #ECE7DE;
    border-radius: 14px;
    overflow: hidden;
  }
  .ksl-map-card__header {
    padding: 12px 18px;
    background: #FAF8F5;
    border-bottom: 1px solid #ECE7DE;
    font-size: 13.5px;
    font-weight: 600;
    color: #1B1226;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ksl-map-card__header svg { color: #F5A623; }
  .ksl-map-card__iframe-wrap { width: 100%; height: 250px; }
  .ksl-map-card__iframe-wrap iframe { width: 100%; height: 100%; border: 0; }
  .ksl-upcoming-card {
    background: #FAF8F5;
    border: 1px dashed #D9D4C7;
    border-radius: 14px;
