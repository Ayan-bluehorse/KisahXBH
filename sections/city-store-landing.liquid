  }

  /* 9. INSIDE OUR STORES - STEP INSIDE (PDF Page 3) */
  .ksl-step-inside {
    padding: 64px 0 72px;
    background: #FFFFFF;
  }
  .ksl-gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
    align-items: stretch;
  }
  .ksl-gallery-subgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    height: 100%;
  }
  .ksl-gallery-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #EAE6DE;
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    display: flex;
  }
