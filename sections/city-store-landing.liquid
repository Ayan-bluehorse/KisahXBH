  .ksl-btn--directions-pill {
    background-color: #F5A623;
    color: #1B1226 !important;
    font-size: 14.5px;
    font-weight: 700;
    padding: 12px 28px;
    border-radius: 99px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(245, 166, 35, 0.35);
  }
  .ksl-btn--directions-pill:hover {
    background-color: #E09214;
    transform: translateY(-1px);
  }
  .ksl-reasons-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .ksl-reason-card {
    background: rgba(255, 255, 255, 0.05);
