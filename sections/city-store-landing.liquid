{%- liquid
  comment
    Kisah 100% Dynamic Multi-City Store-Visit Landing Page
    - 100% exact design match to "Kisah Kolkata Store-Visit Landing Page.pdf"
    - High-performance, clean modern typography (Plus Jakarta Sans)
    - Full store cards with 4:3 facade framing and high-contrast status badge
    - Interactive boutique switcher with arrow controls
    - Curated "Why Visit", Marquee ticker, "Find your signature" rails
    - "Every ritual, every look", "Step inside" gallery, "Loved by Kolkata" reviews
    - "Before you visit" FAQ and 3-column bottom store strip
  endcomment

  assign initial_city = section.settings.default_city | default: 'kolkata' | downcase

  # Extract unique cities from store blocks
  assign unique_cities_raw = ''
  assign total_stores_count = 0
  for block in section.blocks
    if block.type == 'store'
      assign total_stores_count = total_stores_count | plus: 1
      assign c = block.settings.city | strip
      if c != blank
        assign check_list = unique_cities_raw | split: '|||'
        assign city_already_in = false
        for ec in check_list
          if ec == c
            assign city_already_in = true
            break
          endif
        endfor
        unless city_already_in
          if unique_cities_raw == ''
            assign unique_cities_raw = c
          else
            assign unique_cities_raw = unique_cities_raw | append: '|||' | append: c
          endif
        endunless
      endif
    endif
  endfor

  assign city_list = unique_cities_raw | split: '|||'
-%}

<div class="ksl-wrap" id="ksl-wrap-{{ section.id }}" data-section-id="{{ section.id }}" data-default-city="{{ initial_city }}">

  <!-- 1. DYNAMIC CITY SWITCHER LIST (only show when multiple cities exist) -->
  {% if city_list.size > 1 %}
    <nav class="ksl-city-bar" aria-label="Select Kisah City">
      <div class="ksl-container ksl-city-bar__inner">
        <div class="ksl-city-bar__label">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Select City:</span>
        </div>
        <div class="ksl-city-tabs-wrap">
          <div class="ksl-city-tabs" id="kslCityTabs" role="tablist" aria-label="Kisah Store Cities">
            <button type="button" class="ksl-city-pill" data-city-key="all" data-city-name="All Stores" role="tab" aria-selected="false">
              <span class="ksl-city-pill__name">All Stores</span>
              <span class="ksl-city-pill__count">{{ total_stores_count }} stores</span>
            </button>
          {% for c in city_list %}
            {%- liquid
              assign c_key = c | downcase | replace: ' ', '-'
              assign c_count = 0
              assign c_is_all_soon = true
              for block in section.blocks
                if block.type == 'store'
                  assign b_city = block.settings.city | strip
                  if b_city == c
                    assign c_count = c_count | plus: 1
                    unless block.settings.is_coming_soon
                      assign c_is_all_soon = false
                    endunless
                  endif
                endif
              endfor
            -%}
            <button type="button" class="ksl-city-pill" data-city-key="{{ c_key }}" data-city-name="{{ c }}" role="tab" aria-selected="false">
              <span class="ksl-city-pill__name">{{ c }}</span>
              {% if c_is_all_soon %}
                <span class="ksl-city-pill__count ksl-pill-soon">Soon</span>
              {% else %}
                <span class="ksl-city-pill__count">{{ c_count }} {% if c_count == 1 %}store{% else %}stores{% endif %}</span>
              {% endif %}
            </button>
          {% endfor %}
          </div>
          <div class="ksl-city-nav">
            <button type="button" class="ksl-tabs-nav-btn ksl-tabs-nav-btn--sm" id="kslCityTabPrev" aria-label="Slide cities left">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="ksl-tabs-nav-btn ksl-tabs-nav-btn--sm" id="kslCityTabNext" aria-label="Slide cities right">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>
      </div>
    </nav>
  {% endif %}

  <!-- 2. HERO SECTION (PDF Page 1) -->
  <section class="ksl-hero">
    <div class="ksl-container ksl-hero__inner">
      <div class="ksl-hero__content">
        <div class="ksl-hero__eyebrow">
          <span class="ksl-eyebrow-text" id="kslHeroEyebrow">
            {{ section.settings.hero_eyebrow | default: "MEN'S WEDDING & FESTIVE WEAR · KOLKATA" }}
          </span>
        </div>
        <h1 class="ksl-hero__title" id="kslHeroTitle">
          {% if section.settings.hero_title != blank %}
            {{ section.settings.hero_title }}
          {% else %}
            3 Kisah stores in Kolkata. Walk in, try on, stand out.
          {% endif %}
        </h1>
        <p class="ksl-hero__subtitle" id="kslHeroSubtitle">
          {% if section.settings.hero_subtitle != blank %}
            {{ section.settings.hero_subtitle }}
          {% else %}
            Sherwanis, kurta sets, bandhgalas and Indo-westerns for men and kids. Gariahat, Lake Mall and Lindsay Street — open daily, 10:30 AM to 9:30 PM.
          {% endif %}
        </p>

        <!-- In-Store Offer Badge (Dashed Border) -->
        <div class="ksl-offer-badge" role="note">
          <div class="ksl-offer-badge__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          </div>
          <div class="ksl-offer-badge__text">
            <span>Show this page in-store for <strong id="kslHeroOffer">{{ section.settings.in_store_offer | default: 'SPECIAL IN-STORE FESTIVE OFFER' }}</strong></span>
          </div>
        </div>

        <!-- Hero CTAs with Geolocation & Call -->
        <div class="ksl-hero__ctas">
          <button type="button" class="ksl-btn ksl-btn--primary ksl-geo-trigger" id="kslHeroGeoBtn">
            <svg class="ksl-btn-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
            <span class="ksl-geo-btn-text">Find my nearest store</span>
          </button>
          <button type="button" class="ksl-btn ksl-btn--secondary" id="kslHeroCallBtn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Call a store</span>
          </button>
        </div>
        <p class="ksl-geo-status-banner ksl-is-hidden" id="kslGeoStatus" aria-live="polite"></p>

        <!-- Quick Store Anchors -->
        <div class="ksl-hero__chips" id="kslHeroChips" aria-label="Jump to store details">
          <!-- Dynamic store chips rendered based on active city -->
        </div>
      </div>

      <!-- Hero Visual Card (Clean 4:3 / 390x200 framing, NO floating tags) -->
      <div class="ksl-hero__media">
        <div class="ksl-hero__image-card">
          {% if section.settings.hero_image != blank %}
            <img src="{{ section.settings.hero_image | image_url: width: 900 }}"
                 alt="Kisah Celebration Collection"
                 class="ksl-hero__img"
                 id="kslHeroImg"
                 loading="eager"
                 width="480"
                 height="360">
          {% else %}
            <img src="{{ 'iconic_diwali_desktop_final.png' | file_img_url: '900x' }}"
                 srcset="{{ 'iconic_diwali_desktop_final.png' | file_img_url: '480x' }} 480w,
                         {{ 'iconic_diwali_desktop_final.png' | file_img_url: '900x' }} 900w"
                 sizes="(max-width: 767px) 100vw, 480px"
                 alt="Kisah Celebration Collection"
                 class="ksl-hero__img"
                 id="kslHeroImg"
                 loading="eager"
                 width="480"
                 height="360">
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. TRUST HIGHLIGHTS STRIP (PDF Page 1) -->
  <section class="ksl-trust-strip">
    <div class="ksl-container ksl-trust-strip__grid">
      <!-- 1. Rating -->
      <div class="ksl-trust-item">
        <span class="ksl-trust-svg" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="#F5A623" stroke="#F5A623" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        <div class="ksl-trust-text">
          <strong id="kslTrustRating">{{ section.settings.rating_score | default: '4.8' }} on Google</strong>
          <small id="kslTrustReviews">{{ section.settings.reviews_count | default: '300+' }} local reviews</small>
        </div>
      </div>

      <!-- 2. Store Count -->
      <div class="ksl-trust-item">
        <span class="ksl-trust-svg" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#201747" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3l9 7H3l9-7z"/></svg>
        </span>
        <div class="ksl-trust-text">
          <strong id="kslTrustCount">{{ total_stores_count }} Boutiques</strong>
          <small id="kslTrustCity">Across Kolkata</small>
        </div>
      </div>

      <!-- 3. Open Hours -->
      <div class="ksl-trust-item">
        <span class="ksl-trust-svg" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#201747" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        <div class="ksl-trust-text">
          <strong>Open 7 Days</strong>
          <small id="kslTrustHours">{{ section.settings.timings_summary | default: '10:30 AM – 9:30 PM' }}</small>
        </div>
      </div>

      <!-- 4. Family & Sizing -->
      <div class="ksl-trust-item">
        <span class="ksl-trust-svg" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#201747" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <div class="ksl-trust-text">
          <strong>Men, Kids &amp; Plus</strong>
          <small>Under one roof</small>
        </div>
      </div>

      <!-- 5. Exchange Policy -->
      <div class="ksl-trust-item">
        <span class="ksl-trust-svg" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#201747" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </span>
        <div class="ksl-trust-text">
          <strong>Easy Exchange</strong>
          <small>{{ section.settings.exchange_policy | default: '7-day in-store policy' }}</small>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. OUR BOUTIQUES (PDF Page 1 & 2) -->
  <section class="ksl-stores" id="ksl-stores-section">
    <div class="ksl-container">
      <div class="ksl-section-header-wrap">
        <div class="ksl-section-header">
          <span class="ksl-section-eyebrow">OUR BOUTIQUES</span>
          <h2 class="ksl-section-title" id="kslStoresTitle">
            {{ section.settings.stores_heading | default: 'Visit Kisah in Kolkata' }}
          </h2>
          <p class="ksl-section-desc" id="kslStoresDesc">
            {{ section.settings.stores_subheading | default: 'Two stores on Rash Behari Avenue, one in Central Kolkata. Walk in — no appointment needed.' }}
          </p>
        </div>
        <div class="ksl-tabs-nav" aria-label="Slide store tabs">
          <button type="button" class="ksl-tabs-nav-btn" id="kslStoreTabPrev" aria-label="Slide stores left">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="ksl-tabs-nav-btn" id="kslStoreTabNext" aria-label="Slide stores right">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Store Filter Tabs (Full width, no clipped pills) -->
      <div class="ksl-store-tabs" id="kslStoreFilterTabs" role="tablist" aria-label="Filter stores">
        <!-- Injected dynamically by JS based on active city -->
      </div>

      <!-- Store Cards Grid -->
      <div class="ksl-store-cards-grid" id="kslStoreCardsGrid">
        {% for block in section.blocks %}
          {% if block.type == 'store' %}
            {%- liquid
              assign s_city = block.settings.city | strip
              assign s_city_key = s_city | downcase | replace: ' ', '-'
              assign s_name = block.settings.name | default: 'Kisah Boutique'
              assign s_address = block.settings.address
              assign s_landmark = block.settings.landmark
              assign s_hours = block.settings.hours | default: '10:30 AM – 9:30 PM · All days'
              assign s_phone = block.settings.phone
              assign s_phone_raw = s_phone | replace: ' ', '' | replace: '-', ''
              assign s_rating = block.settings.rating | default: '4.8'
              assign s_reviews = block.settings.reviews | default: '120+ reviews'
              assign s_maps_url = block.settings.maps_url | default: 'https://maps.google.com/?q=Kisah+' | append: s_name
              assign s_whatsapp_msg = block.settings.whatsapp_msg | default: 'Hi Kisah, I am planning to visit the ' | append: s_name | append: ' store.'
              assign s_is_soon = block.settings.is_coming_soon
              assign s_lat = block.settings.lat | default: '0'
              assign s_lng = block.settings.lng | default: '0'
            -%}
            <article class="ksl-card"
                     id="store-{{ block.id }}"
                     data-store-id="store-{{ block.id }}"
                     data-city="{{ s_city_key }}"
                     data-city-name="{{ s_city }}"
                     data-store-name="{{ s_name | escape }}"
                     data-lat="{{ s_lat }}"
                     data-lng="{{ s_lng }}"
                     data-phone="{{ s_phone }}"
                     data-phone-raw="{{ s_phone_raw }}"
                     data-hours="{{ s_hours | escape }}"
                     data-landmark="{{ s_landmark | escape }}"
                     data-address="{{ s_address | escape }}"
                     data-is-soon="{% if s_is_soon %}true{% else %}false{% endif %}"
                     data-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% else %}/cdn/shop/files/Gariahat.png{% endif %}"
                     {{ block.shopify_attributes }}>
              
              <!-- Store Media (4:3 ratio, badge at top-left) -->
              <div class="ksl-card__media">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 800 }}"
                       alt="Kisah {{ s_name }}"
                       class="ksl-card__img"
                       loading="lazy"
                       width="640"
                       height="480">
                {% else %}
                  <img src="/cdn/shop/files/Gariahat.png?v=1786366650&width=800"
                       alt="Kisah {{ s_name }}"
                       class="ksl-card__img"
                       loading="lazy"
                       width="640"
                       height="480">
                {% endif %}
                <span class="ksl-card__badge">
                  {% if s_is_soon %}
                    <span class="ksl-dot-soon"></span> Opening soon
                  {% else %}
                    <span class="ksl-dot-live"></span> Open now · closes 9:30 PM
                  {% endif %}
                </span>
              </div>

              <!-- Store Body -->
              <div class="ksl-card__body">
                <div class="ksl-card__head">
                  <h3 class="ksl-card__title">{{ s_name }}</h3>
                  <div class="ksl-card__rating">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#F5A623" stroke="#F5A623" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <strong>{{ s_rating }}</strong>
                    <small>({{ s_reviews }})</small>
                  </div>
                </div>

                {% if s_address != blank %}
                  <div class="ksl-card__info-row">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <span>{{ s_address }}</span>
                  </div>
                {% endif %}

                {% if s_landmark != blank %}
                  <div class="ksl-card__landmark"><strong>Landmark:</strong> {{ s_landmark }}</div>
                {% endif %}

                <div class="ksl-card__info-row">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  <span>{{ s_hours }}</span>
                </div>

                {% if s_phone != blank %}
                  <div class="ksl-card__info-row">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    <a href="tel:{{ s_phone_raw }}" class="ksl-phone-link">{{ s_phone }}</a>
                  </div>
                {% endif %}

                <!-- Card Actions -->
                <div class="ksl-card__actions">
                  <a href="{{ s_maps_url }}" target="_blank" rel="noopener noreferrer" class="ksl-btn ksl-btn--directions">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                    <span>Get directions</span>
                  </a>

                  <div class="ksl-card__sub-actions">
                    {% if s_phone != blank %}
                      <a href="tel:{{ s_phone_raw }}" class="ksl-btn ksl-btn--card-call">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        <span>Call</span>
                      </a>
                    {% else %}
                      <a href="https://wa.me/918100993480?text=Hi%20Kisah,%20I%20want%20to%20know%20more%20about%20{{ s_name | url_encode }}." target="_blank" rel="noopener noreferrer" class="ksl-btn ksl-btn--card-call">
                        <span>Details</span>
                      </a>
                    {% endif %}

                    <a href="https://wa.me/{{ s_phone_raw | default: '918100993480' }}?text={{ s_whatsapp_msg | url_encode }}" target="_blank" rel="noopener noreferrer" class="ksl-btn ksl-btn--card-whatsapp">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                      <span>WhatsApp</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Google Maps Embed & Upcoming Store Card (PDF Page 2) -->
      <div class="ksl-stores-bottom-grid">
        <div class="ksl-map-card">
          <div class="ksl-map-card__header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
            <span id="kslMapTitle">Live Google Map · Kolkata Stores</span>
          </div>
          <div class="ksl-map-card__iframe-wrap">
            <iframe id="kslMapIframe"
                    title="Kisah Store Map"
                    src="{{ section.settings.google_map_embed | default: 'https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d58963.91890333215!2d88.3300!3d22.5300!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1sKisah%20Stores%20Kolkata!5e0!3m2!1sen!2sin!4v1729600000000!5m2!1sen!2sin' }}"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>

        {% if section.settings.show_upcoming_card != false %}
        <div class="ksl-upcoming-card">
          <span class="ksl-upcoming-badge">{{ section.settings.upcoming_badge | default: 'OPENING SOON' }}</span>
          <h3 class="ksl-upcoming-title" id="kslUpcomingTitle">{{ section.settings.upcoming_title | default: 'Kisah Allenby Road' }}</h3>
          <p class="ksl-upcoming-desc" id="kslUpcomingDesc">{{ section.settings.upcoming_desc | default: 'A fourth Kolkata store is on its way. Until then, Gariahat, Lake Mall and Lindsay Street are the closest destinations.' }}</p>
