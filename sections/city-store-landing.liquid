  }
  .ksl-reason-title {
    font-size: 17px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin: 0 0 8px !important;
    line-height: 1.25 !important;
  }
  .ksl-reason-text {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.76);
    margin: 0;
    line-height: 1.5;
  }

  /* 6. MARQUEE BANNER (PDF Page 2) - Seamless Infinite Loop */
  .ksl-ticker {
    background-color: #171033;
    color: #FFFFFF;
    padding: 16px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    width: 100%;
    position: relative;
    display: flex;
  }
  .ksl-ticker__track {
    display: flex;
    width: max-content;
    animation: kslTickerScroll 35s linear infinite;
    will-change: transform;
  }
  .ksl-ticker__track:hover {
    animation-play-state: paused;
  }
  .ksl-ticker__group {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .ksl-ticker__group span {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #FFFFFF;
    white-space: nowrap;
  }
  .ksl-ticker__sep {
    color: #F5A623 !important;
    font-size: 16px;
    margin: 0 24px;
    display: inline-block;
  }
  @keyframes kslTickerScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 7. IN STORE NOW - FIND YOUR SIGNATURE */
  .ksl-categories {
    padding: 64px 0 72px;
    background: #FFFFFF;
  }
  .ksl-cat-head {
    display: flex;
    justify-content: space-between;
