    font-weight: 700;
    color: #201747;
    text-decoration: none;
  }
  .ksl-cat-card__link:hover { text-decoration: underline; }
  .ksl-cat-browse-all { text-align: center; margin-top: 28px; }
  .ksl-browse-link { color: #4A443A; font-size: 14px; text-decoration: none; }
  .ksl-browse-link strong { color: #201747; }

  /* 8. EVERY RITUAL, EVERY LOOK (PDF Page 3) */
  .ksl-occasions {
