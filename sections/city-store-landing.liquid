      min-height: 180px;
    }
  }
  @media (max-width: 540px) {
    .ksl-gallery-subgrid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .ksl-gallery-card--sub {
      min-height: 200px;
    }
  }

