<script>
(function() {
  function initDynamicStorePage() {
    var wrap = document.querySelector('.ksl-wrap');
    if (!wrap) return;

    var allCards = Array.from(wrap.querySelectorAll('.ksl-store-cards-grid .ksl-card'));
    var cityPills = Array.from(wrap.querySelectorAll('.ksl-city-pill'));
    var heroChipsContainer = document.getElementById('kslHeroChips');
    var storeTabsContainer = document.getElementById('kslStoreFilterTabs');
    var modalStoreList = document.getElementById('kslModalStoreList');
    var heroTitle = document.getElementById('kslHeroTitle');
    var heroSubtitle = document.getElementById('kslHeroSubtitle');
    var trustCount = document.getElementById('kslTrustCount');
    var trustCity = document.getElementById('kslTrustCity');
    var storesTitle = document.getElementById('kslStoresTitle');
    var catCityNote = document.getElementById('kslCatCityNote');
    var bottomTitle = document.getElementById('kslBottomTitle');
    var reviewsTitle = document.getElementById('kslReviewsTitle');
    var stepInsideEyebrow = document.getElementById('kslStepInsideEyebrow');
    var geoTriggers = Array.from(document.querySelectorAll('.ksl-geo-trigger'));
    var geoStatus = document.getElementById('kslGeoStatus');

    // Detect single-city mode (page has only stores from one city)
    var uniqueCitiesOnPage = [];
    allCards.forEach(function(card) {
      var c = card.getAttribute('data-city');
      if (c && uniqueCitiesOnPage.indexOf(c) === -1) uniqueCitiesOnPage.push(c);
    });
    var isSingleCityPage = uniqueCitiesOnPage.length <= 1;

    // Get initial city from URL param ?city= or default setting
    var urlParams = new URLSearchParams(window.location.search);
    var requestedCity = (urlParams.get('city') || wrap.getAttribute('data-default-city') || 'kolkata').toLowerCase().trim();

    // On single-city pages, always use 'all' to show everything (since all blocks are same city)
    if (isSingleCityPage && requestedCity !== 'all') {
      requestedCity = 'all';
    }

    var activeCityKey = '';
    var activeCityName = '';

    function filterByCity(cKey) {
      activeCityKey = cKey;
      var matchingCards;

      if (cKey === 'all') {
        matchingCards = allCards;
        activeCityName = 'India';
      } else {
        matchingCards = allCards.filter(function(card) {
          return card.getAttribute('data-city') === cKey;
        });

        if (matchingCards.length === 0 && allCards.length > 0) {
          cKey = allCards[0].getAttribute('data-city');
          activeCityKey = cKey;
          matchingCards = allCards.filter(function(card) {
            return card.getAttribute('data-city') === cKey;
          });
        }
        activeCityName = matchingCards.length > 0 ? matchingCards[0].getAttribute('data-city-name') : cKey;
      }

      // Update City Switcher Tab Pills
      cityPills.forEach(function(pill) {
        if (pill.getAttribute('data-city-key') === cKey) {
          pill.classList.add('is-active');
          pill.setAttribute('aria-selected', 'true');
        } else {
          pill.classList.remove('is-active');
          pill.setAttribute('aria-selected', 'false');
        }
      });

      // Filter Store Cards
      allCards.forEach(function(card) {
        if (cKey === 'all' || card.getAttribute('data-city') === cKey) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });

      // Extract store names list for active city (e.g. "Sarath City Capital Mall and Himayat Nagar")
      var storeNamesArray = matchingCards.map(function(c) {
        return c.getAttribute('data-store-name');
      }).filter(Boolean);

      var storeNamesFormatted = '';
      if (storeNamesArray.length === 1) {
        storeNamesFormatted = storeNamesArray[0];
      } else if (storeNamesArray.length === 2) {
        storeNamesFormatted = storeNamesArray[0] + ' and ' + storeNamesArray[1];
      } else if (storeNamesArray.length > 2) {
        storeNamesFormatted = storeNamesArray.slice(0, -1).join(', ') + ' and ' + storeNamesArray[storeNamesArray.length - 1];
      }

      // On single-city pages, preserve section settings text (editable in Theme Customizer)
      // Only override text dynamically on multi-city pages when switching cities
      if (!isSingleCityPage) {
        // 1. Hero Eyebrow
        var heroEyebrow = document.getElementById('kslHeroEyebrow');
        if (heroEyebrow) {
          heroEyebrow.textContent = "MEN'S WEDDING & FESTIVE WEAR · " + (cKey === 'all' ? 'INDIA' : activeCityName.toUpperCase());
        }

        // 2. Hero Title
        var storeWord = matchingCards.length === 1 ? 'store' : 'stores';
        if (heroTitle) {
          if (cKey === 'all') {
            heroTitle.innerHTML = matchingCards.length + ' Kisah Flagship Stores Across India. Walk in, try on, stand out.';
          } else {
            heroTitle.innerHTML = matchingCards.length + ' Kisah ' + storeWord + ' in ' + activeCityName + '. Walk in, try on, stand out.';
          }
        }

        // 3. Hero Subtitle
        if (heroSubtitle) {
          if (cKey === 'all') {
            heroSubtitle.textContent = 'Sherwanis, kurta sets, bandhgalas and Indo-westerns for men and kids. Walk into our flagship boutiques across India — open daily, 10:30 AM to 9:30 PM.';
          } else {
            heroSubtitle.textContent = 'Sherwanis, kurta sets, bandhgalas and Indo-westerns for men and kids. ' + (storeNamesFormatted ? storeNamesFormatted + ' — ' : '') + 'open daily, 10:30 AM to 9:30 PM.';
          }
        }

        // 5. Stores Section Header & Subheading
        if (storesTitle) {
          storesTitle.textContent = cKey === 'all' ? 'Visit Kisah Flagships Across India' : 'Visit Kisah in ' + activeCityName;
        }
        var storesDesc = document.getElementById('kslStoresDesc');
        if (storesDesc) {
          if (cKey === 'kolkata') {
            storesDesc.textContent = 'Two stores on Rash Behari Avenue, one in Central Kolkata. Walk in — no appointment needed.';
          } else if (cKey === 'all') {
            storesDesc.textContent = 'Explore our luxury flagship boutiques nationwide. Walk in — no appointment needed.';
          } else {
            storesDesc.textContent = 'Explore our boutiques across ' + activeCityName + (storeNamesFormatted ? ' (' + storeNamesFormatted + ')' : '') + '. Walk in — no appointment needed.';
          }
        }
      }

      // 4. Trust Strip (always update since it's count-based)
      if (trustCount) {
        trustCount.textContent = matchingCards.length + ' ' + (matchingCards.length === 1 ? 'Boutique' : 'Boutiques');
      }
      if (trustCity) {
        trustCity.textContent = isSingleCityPage ? 'Across ' + (matchingCards.length > 0 ? matchingCards[0].getAttribute('data-city-name') : 'the city') : (cKey === 'all' ? 'Across India' : 'Across ' + activeCityName);
      }

      // 6-7: Map & Upcoming Card (skip on single-city pages to preserve section settings)
      if (!isSingleCityPage) {
        // 6. Live Google Map
        var mapTitle = document.getElementById('kslMapTitle');
        var mapIframe = document.getElementById('kslMapIframe');
        if (mapTitle) {
          mapTitle.textContent = 'Live Google Map · ' + (cKey === 'all' ? 'All' : activeCityName) + ' Stores';
        }
        if (mapIframe) {
          if (cKey === 'kolkata') {
            mapIframe.src = 'https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d58963.91890333215!2d88.3300!3d22.5300!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1sKisah%20Stores%20Kolkata!5e0!3m2!1sen!2sin!4v1729600000000!5m2!1sen!2sin';
          } else {
            var mapQuery = 'Kisah ' + (cKey === 'all' ? 'Stores India' : (activeCityName + ' Stores'));
            mapIframe.src = 'https://maps.google.com/maps?q=' + encodeURIComponent(mapQuery) + '&t=&z=12&ie=UTF8&iwloc=&output=embed';
          }
        }

        // 7. Upcoming Store Card
        var upcomingCard = document.querySelector('.ksl-upcoming-card');
        var upcomingTitle = document.getElementById('kslUpcomingTitle');
        var upcomingDesc = document.getElementById('kslUpcomingDesc');
        var upcomingLink = upcomingCard ? upcomingCard.querySelector('a') : null;

        if (upcomingTitle && upcomingDesc) {
          var comingSoonCard = matchingCards.find(function(c) {
            return c.getAttribute('data-is-soon') === 'true';
          });

          if (cKey === 'kolkata') {
            upcomingTitle.textContent = 'Kisah Allenby Road';
            upcomingDesc.textContent = 'A fourth Kolkata store is on its way. Until then, Gariahat, Lake Mall and Lindsay Street are the closest destinations.';
            if (upcomingLink) {
              upcomingLink.href = 'https://wa.me/918100993480?text=' + encodeURIComponent('Hi Kisah, please notify me when Allenby Road store opens.');
            }
          } else if (comingSoonCard) {
            var csName = comingSoonCard.getAttribute('data-store-name');
            upcomingTitle.textContent = 'Kisah ' + csName;
            upcomingDesc.textContent = 'A new Kisah destination in ' + activeCityName + ' is on its way. Stay tuned for our launch.';
            if (upcomingLink) {
              upcomingLink.href = 'https://wa.me/918100993480?text=' + encodeURIComponent('Hi Kisah, please notify me when ' + csName + ' opens in ' + activeCityName + '.');
            }
          } else {
            upcomingTitle.textContent = 'More ' + activeCityName + ' Stores Coming Soon';
            upcomingDesc.textContent = 'New Kisah destinations are expanding across ' + activeCityName + '. Until then, visit our open boutiques at ' + (storeNamesFormatted || activeCityName) + '.';
            if (upcomingLink) {
              upcomingLink.href = 'https://wa.me/918100993480?text=' + encodeURIComponent('Hi Kisah, please notify me about upcoming stores in ' + activeCityName + '.');
            }
          }
        }
      }

      // On single-city pages, preserve section settings for these texts
      if (!isSingleCityPage) {
        // 8. "Step inside" Gallery Eyebrow & Feature Photo
        var stepInsideEyebrow = document.getElementById('kslStepInsideEyebrow');
        if (stepInsideEyebrow) {
          stepInsideEyebrow.textContent = 'INSIDE OUR ' + (cKey === 'all' ? 'INDIA' : activeCityName.toUpperCase()) + ' STORES';
        }
        var galleryFeatureImg = document.getElementById('kslGalleryFeatureImg');
        var galleryFeatureCap = document.getElementById('kslGalleryFeatureCaption');
        if (galleryFeatureImg && galleryFeatureCap) {
          if (cKey === 'kolkata') {
            galleryFeatureImg.src = '/cdn/shop/files/Gariahat.png?v=1786366650&width=800';
            galleryFeatureCap.textContent = 'Storefront · Gariahat (so you recognise it on the street)';
          } else if (cKey === 'hyderabad') {
            galleryFeatureImg.src = '/cdn/shop/files/Himayat_Nagar_Hyderabad.jpg?v=1786366650&width=800';
            galleryFeatureCap.textContent = 'Storefront & Showroom · Himayat Nagar (Hyderabad)';
          } else if (cKey === 'bengaluru') {
            galleryFeatureImg.src = '/cdn/shop/files/commercial_street.png?v=1786366650&width=800';
            galleryFeatureCap.textContent = 'Flagship Storefront · Commercial Street (Bengaluru)';
          } else if (matchingCards.length > 0 && matchingCards[0].getAttribute('data-image')) {
            galleryFeatureImg.src = matchingCards[0].getAttribute('data-image');
            galleryFeatureCap.textContent = 'Boutique · ' + matchingCards[0].getAttribute('data-store-name') + ' (' + activeCityName + ')';
          }
        }

        // 9. Categories Note
        if (catCityNote) {
          catCityNote.textContent = cKey === 'all' ? 'Every category is available to try on at all our flagship stores.' : 'Every category is available to try on at all ' + activeCityName + ' stores.';
        }

        // 10. Reviews & Bottom Headings
        if (reviewsTitle) {
          reviewsTitle.textContent = 'Loved by ' + (cKey === 'all' ? 'India' : activeCityName);
        }
        if (bottomTitle) {
          bottomTitle.textContent = 'Your next look is waiting in ' + (cKey === 'all' ? 'Kolkata' : activeCityName);
        }
      }

      // Render Final Bottom Stores Strip (PDF Page 4 & 5: 3 side-by-side cards)
      var bottomStoresList = document.getElementById('kslBottomStoresList');
      if (bottomStoresList) {
        var bHtml = '';
        matchingCards.forEach(function(card) {
          var sName = card.getAttribute('data-store-name');
          var sLandmark = card.querySelector('.ksl-card__landmark') ? card.querySelector('.ksl-card__landmark').textContent.replace('Landmark:', '').trim() : '';
          var sAddrRow = card.querySelector('.ksl-card__info-row span') ? card.querySelector('.ksl-card__info-row span').textContent.trim() : '';
          var shortAddr = sLandmark || sAddrRow.split(',')[0] || '';
          var sPhoneRaw = card.getAttribute('data-phone-raw');
          var dirBtn = card.querySelector('.ksl-btn--directions');
          var dirUrl = dirBtn ? dirBtn.getAttribute('href') : '#';

          bHtml += '<div class="ksl-bottom-store-card">';
          bHtml += '  <div class="ksl-bottom-store-info">';
          bHtml += '    <h4 class="ksl-bottom-store-name">' + sName + '</h4>';
          bHtml += '    <p class="ksl-bottom-store-addr">' + shortAddr + '</p>';
          bHtml += '  </div>';
          bHtml += '  <div class="ksl-bottom-store-actions">';
          if (sPhoneRaw) {
            bHtml += '    <a href="tel:' + sPhoneRaw + '" class="ksl-btn-bottom-call" aria-label="Call ' + sName + '">';
            bHtml += '      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
            bHtml += '    </a>';
          }
          bHtml += '    <a href="' + dirUrl + '" target="_blank" rel="noopener noreferrer" class="ksl-btn-bottom-nav" aria-label="Directions to ' + sName + '">';
          bHtml += '      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>';
          bHtml += '    </a>';
          bHtml += '  </div>';
          bHtml += '</div>';
        });
        bottomStoresList.innerHTML = bHtml;
      }

      // Render Store Filter Tabs
      if (storeTabsContainer) {
        var tabsHtml = '<button type="button" class="ksl-tab-btn is-active" data-store-filter="all">All Stores (' + matchingCards.length + ')</button>';
        matchingCards.forEach(function(card) {
          var sId = card.getAttribute('data-store-id');
          var sName = card.getAttribute('data-store-name');
          tabsHtml += '<button type="button" class="ksl-tab-btn" data-store-filter="' + sId + '">' + sName + '</button>';
        });
        storeTabsContainer.innerHTML = tabsHtml;
        bindStoreFilterTabs();
        var storeTabs = document.getElementById('kslStoreFilterTabs');
        var storeTabPrev = document.getElementById('kslStoreTabPrev');
        var storeTabNext = document.getElementById('kslStoreTabNext');
        if (storeTabs && storeTabPrev && storeTabNext) {
          storeTabPrev.onclick = function() { storeTabs.scrollBy({ left: -260, behavior: 'smooth' }); };
          storeTabNext.onclick = function() { storeTabs.scrollBy({ left: 260, behavior: 'smooth' }); };
        }
      }

      // Render Hero Quick Select Chips
      if (heroChipsContainer) {
        var chipsHtml = '';
        matchingCards.forEach(function(card) {
          var sId = card.getAttribute('data-store-id');
          var sName = card.getAttribute('data-store-name');
          chipsHtml += '<a href="#' + sId + '" class="ksl-chip" data-store-target="' + sId + '">' + sName + '</a>';
        });
        heroChipsContainer.innerHTML = chipsHtml;
        bindHeroChips();
      }

      // Render Modal Store Call List
      if (modalStoreList) {
        var modalHtml = '';
        matchingCards.forEach(function(card) {
          var sName = card.getAttribute('data-store-name');
          var sPhone = card.getAttribute('data-phone');
          var sPhoneRaw = card.getAttribute('data-phone-raw');
          var sHours = card.getAttribute('data-hours');
          modalHtml += '<div class="ksl-modal-item">';
          modalHtml += '  <div>';
          modalHtml += '    <strong>' + sName + '</strong>';
          modalHtml += '    <small>' + (sPhone || 'Open daily') + ' · ' + sHours + '</small>';
          modalHtml += '  </div>';
          if (sPhoneRaw) {
            modalHtml += '  <a href="tel:' + sPhoneRaw + '" class="ksl-modal-call-btn"><span>Call Store</span></a>';
          }
          modalHtml += '</div>';
        });
        modalStoreList.innerHTML = modalHtml;
      }
    }

    function bindStoreFilterTabs() {
      var tabBtns = document.querySelectorAll('#kslStoreFilterTabs .ksl-tab-btn');
      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetId = this.getAttribute('data-store-filter');
          tabBtns.forEach(function(b) { b.classList.remove('is-active'); });
          this.classList.add('is-active');

          allCards.forEach(function(card) {
            if (card.getAttribute('data-city') !== activeCityKey && activeCityKey !== 'all') {
              card.style.display = 'none';
              return;
            }
            if (targetId === 'all' || card.getAttribute('data-store-id') === targetId) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    function bindHeroChips() {
      var chips = document.querySelectorAll('#kslHeroChips .ksl-chip');
      chips.forEach(function(chip) {
        chip.addEventListener('click', function(e) {
          var targetId = this.getAttribute('data-store-target');
          if (targetId) {
            var tabBtn = document.querySelector('#kslStoreFilterTabs .ksl-tab-btn[data-store-filter="' + targetId + '"]');
            if (tabBtn) tabBtn.click();
            var el = document.getElementById(targetId);
            if (el) {
              e.preventDefault();
              el.scrollIntoView({ behavior: 'smooth', block: 'center' });
              el.classList.add('is-nearest-highlight');
              setTimeout(function() { el.classList.remove('is-nearest-highlight'); }, 2500);
            }
          }
        });
      });
    }

    // City Pill Click Listener
    cityPills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        var key = this.getAttribute('data-city-key');
        if (key) {
          filterByCity(key);
          if (window.history && window.history.replaceState) {
            var newUrl = new URL(window.location);
            newUrl.searchParams.set('city', key);
            window.history.replaceState({}, '', newUrl);
          }
        }
      });
    });

    // GEOLOCATION: "Find my nearest store" click handler
    function detectNearestStore() {
      if (!navigator.geolocation) {
        if (geoStatus) {
          geoStatus.textContent = 'Geolocation not supported. Showing our flagship stores.';
          geoStatus.classList.remove('ksl-is-hidden');
        }
        var targetSection = document.getElementById('ksl-stores-section');
        if (targetSection) targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      if (geoStatus) {
        geoStatus.textContent = 'Detecting your location…';
        geoStatus.classList.remove('ksl-is-hidden');
      }

      function getDistanceKm(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      navigator.geolocation.getCurrentPosition(function(pos) {
        var userLat = pos.coords.latitude;
        var userLng = pos.coords.longitude;
        var closestCard = null;
        var shortestKm = 1e12;

        allCards.forEach(function(card) {
          var lat = parseFloat(card.getAttribute('data-lat'));
          var lng = parseFloat(card.getAttribute('data-lng'));
          if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
            var dist = getDistanceKm(userLat, userLng, lat, lng);
            if (dist < shortestKm) {
              shortestKm = dist;
              closestCard = card;
            }
          }
        });

        if (closestCard) {
          var nearestCityKey = closestCard.getAttribute('data-city');
          var nearestStoreName = closestCard.getAttribute('data-store-name');
          var nearestStoreId = closestCard.getAttribute('data-store-id');
          var nearestCityName = closestCard.getAttribute('data-city-name');

          filterByCity(nearestCityKey);

          if (geoStatus) {
            var distDisplay = shortestKm < 50 ? Math.round(shortestKm) + ' km away' : 'in ' + nearestCityName;
            geoStatus.textContent = 'Nearest boutique: ' + nearestStoreName + ' (' + distDisplay + ')';
            geoStatus.classList.remove('ksl-is-hidden');
          }

          setTimeout(function() {
            var el = document.getElementById(nearestStoreId);
            if (el) {
              el.scrollIntoView({ behavior: 'smooth', block: 'center' });
              el.classList.add('is-nearest-highlight');
              setTimeout(function() { el.classList.remove('is-nearest-highlight'); }, 3500);
            }
          }, 350);
        } else {
          var storesEl = document.getElementById('ksl-stores-section');
          if (storesEl) storesEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, function() {
        if (geoStatus) {
          geoStatus.textContent = 'Location access not enabled. Showing our boutique network below.';
          geoStatus.classList.remove('ksl-is-hidden');
        }
        var storesEl = document.getElementById('ksl-stores-section');
        if (storesEl) storesEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, { timeout: 8000, enableHighAccuracy: true });
    }

    geoTriggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        detectNearestStore();
      });
    });

    // Call Modal Handlers
    var callModal = document.getElementById('kslStoreCallModal');
    var modalBackdrop = document.getElementById('kslModalBackdrop');
    var modalCloseBtn = document.getElementById('kslModalCloseBtn');
    var heroCallBtn = document.getElementById('kslHeroCallBtn');
    var stickyCallBtn = document.getElementById('kslStickyCallBtn');

    function openModal() { if (callModal) callModal.classList.add('is-open'); }
    function closeModal() { if (callModal) callModal.classList.remove('is-open'); }

    if (heroCallBtn) heroCallBtn.addEventListener('click', openModal);
    if (stickyCallBtn) stickyCallBtn.addEventListener('click', openModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);

    // Initial Filter
    filterByCity(requestedCity);

    // City slider controls
    var cityTabs = document.getElementById('kslCityTabs');
    var cityTabPrev = document.getElementById('kslCityTabPrev');
    var cityTabNext = document.getElementById('kslCityTabNext');
    if (cityTabs && cityTabPrev && cityTabNext) {
      cityTabPrev.addEventListener('click', function() { cityTabs.scrollBy({ left: -200, behavior: 'smooth' }); });
      cityTabNext.addEventListener('click', function() { cityTabs.scrollBy({ left: 200, behavior: 'smooth' }); });
    }

    // Category slider controls
    var sigSlider = document.getElementById('kslSigSlider');
    var sigPrev = document.getElementById('kslSigPrev');
    var sigNext = document.getElementById('kslSigNext');
    if (sigSlider && sigPrev && sigNext) {
      sigPrev.addEventListener('click', function() { sigSlider.scrollBy({ left: -280, behavior: 'smooth' }); });
      sigNext.addEventListener('click', function() { sigSlider.scrollBy({ left: 280, behavior: 'smooth' }); });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDynamicStorePage);
  } else {
    initDynamicStorePage();
  }
})();
</script>

