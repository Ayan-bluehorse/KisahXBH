  .ksl-cat-tint--1 { background: #EAE8F8; }
  .ksl-cat-tint--2 { background: #FDF4E7; }
  .ksl-cat-tint--3 { background: #E5F2EC; }
  .ksl-cat-tint--4 { background: #FDEFE9; }
