{%- liquid
  assign city_id = section.settings.city_id | downcase | strip
  assign city_name = section.settings.city_name

  # Detect city from request URL or path
  assign req_full = request.path | append: ' ' | append: canonical_url | downcase
  if req_full contains 'gurgaon'
    assign city_name = 'Gurgaon'
    assign city_id = 'gurgaon'
  elsif req_full contains 'jaipur'
    assign city_name = 'Jaipur'
    assign city_id = 'jaipur'
  elsif req_full contains 'mumbai'
    assign city_name = 'Mumbai'
    assign city_id = 'mumbai'
  elsif req_full contains 'bengaluru' or req_full contains 'bangalore'
    assign city_name = 'Bengaluru'
    assign city_id = 'bengaluru'
  elsif req_full contains 'hyderabad'
    assign city_name = 'Hyderabad'
    assign city_id = 'hyderabad'
  elsif req_full contains 'vishakhapatnam' or req_full contains 'vizag'
    assign city_name = 'Vishakhapatnam'
    assign city_id = 'vishakhapatnam'
  elsif req_full contains 'kolkata'
    assign city_name = 'Kolkata'
    assign city_id = 'kolkata'
  endif

  # If city_name is empty or defaulted, inspect store blocks to accurately determine the city
  assign check_stores_for_city = false
  if city_name == blank
    assign check_stores_for_city = true
  elsif city_name == 'Kolkata'
    unless req_full contains 'kolkata'
      assign check_stores_for_city = true
    endunless
  endif

  if check_stores_for_city
    for block in section.blocks
      if block.type == 'store'
        assign s_addr = block.settings.address | downcase
        assign s_nm = block.settings.name | downcase
        if s_addr contains 'gurgaon' or s_nm contains 'm3m'
          assign city_name = 'Gurgaon'
          assign city_id = 'gurgaon'
          break
        elsif s_addr contains 'mumbai' or s_nm contains 'malad' or s_nm contains 'infiniti'
          assign city_name = 'Mumbai'
          assign city_id = 'mumbai'
          break
        elsif s_addr contains 'bengaluru' or s_addr contains 'bangalore' or s_nm contains 'indiranagar' or s_nm contains 'jayanagar'
          assign city_name = 'Bengaluru'
          assign city_id = 'bengaluru'
          break
        elsif s_addr contains 'hyderabad' or s_nm contains 'sarath' or s_nm contains 'himayat'
          assign city_name = 'Hyderabad'
          assign city_id = 'hyderabad'
          break
        elsif s_addr contains 'vishakhapatnam' or s_addr contains 'vizag' or s_nm contains 'inorbit'
          assign city_name = 'Vishakhapatnam'
          assign city_id = 'vishakhapatnam'
          break
        elsif s_addr contains 'jaipur' or s_nm contains 'pacific'
          assign city_name = 'Jaipur'
          assign city_id = 'jaipur'
          break
        elsif s_addr contains 'kolkata' or s_nm contains 'gariahat'
          assign city_name = 'Kolkata'
          assign city_id = 'kolkata'
          break
        endif
      endif
    endfor
  endif

  if city_name == blank
    assign city_name = 'Kolkata'
    assign city_id = 'kolkata'
  endif

  assign is_coming_soon = section.settings.is_coming_soon
  if city_id == 'gurgaon' or city_id == 'jaipur'
    if section.settings.is_coming_soon
      assign is_coming_soon = true
    endif
  endif

  assign store_count = 0
  for block in section.blocks
    if block.type == 'store'
      assign store_count = store_count | plus: 1
    endif
  endfor

  assign ally_phone = section.settings.ally_phone | default: '918100993480' | replace: ' ', '' | replace: '+', ''
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Trirong:wght@500;600&display=swap">

<style>
.ksl-page {
  --navy: #201747;
  --saffron: #F5A623;
  --saffron-d: #E09214;
  --ink: #1B1226;
  --muted: #635E55;
  --line: #ECE7DE;
  --cream: #FAF7F2;
  --paper: #FFFFFF;
  --gold: #8F6A06;
  --wa: #128C4A;
  --font: "Manrope", -apple-system, "Segoe UI", Roboto, sans-serif;
  --serif: "Trirong", "Lora", Georgia, serif;
  font-family: var(--font);
  font-size: 15px;
  line-height: 1.5;
  color: var(--ink);
  background: var(--paper);
  padding-bottom: 80px;
  -webkit-font-smoothing: antialiased;
}
.ksl-page * { box-sizing: border-box; }
.ksl-page [hidden] { display: none !important; }
.ksl-card[hidden] { display: none !important; }
.ksl-sheet-backdrop[hidden] { display: none !important; }
.ksl-sheet[hidden] { display: none !important; }
.ksl-page a { color: inherit; }
.ksl-page button { font: inherit; }
.ksl-page :focus-visible { outline: 2px solid var(--navy); outline-offset: 2px; }

.ksl-c {
  max-width: 1120px;
  margin: 0 auto;
  padding-inline: 24px;
}

/* 1. Hero Campaign Banner */
.ksl-hero {
  position: relative;
  background: var(--navy);
  overflow: hidden;
  width: 100%;
}
.ksl-hero__pic {
  display: block;
  width: 100%;
  height: 100%;
}
.ksl-hero__img {
  display: block;
  width: 100%;
  height: 660px;
  min-height: 560px;
  object-fit: cover;
  object-position: 80% 15% !important;
}
@media (min-width: 1024px) {
  .ksl-hero__img {
    height: 700px;
    min-height: 620px;
    object-position: 80% 15% !important;
  }
}
@media (max-width: 768px) {
  .ksl-hero__img {
    height: 560px !important;
    min-height: 500px !important;
    max-height: 80vh;
    object-fit: cover;
    object-position: 82% 15% !important;
  }
  .ksl-hero__img.has-separate-mobile {
    object-position: center center !important;
  }
}
.ksl-hero__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20,24,33,0) 0%, rgba(20,24,33,0.12) 36%, rgba(27,33,44,0.72) 68%, rgba(20,25,34,0.96) 98%);
  pointer-events: none;
}
.ksl-hero__over {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 0 32px;
  z-index: 2;
}
.ksl-hero__title {
  color: #fff;
  font-size: clamp(26px, 3.8vw, 42px);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -.02em;
  margin: 0;
  max-width: 16ch;
  text-wrap: balance;
  text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}
.ksl-hero__divider {
  width: 100%;
  max-width: 520px;
  height: 1px;
  background: rgba(255, 255, 255, 0.22);
  margin: 14px 0 12px;
}
.ksl-hero__sub {
  color: #ffffff;
  font-size: clamp(14.5px, 2vw, 17.5px);
  font-weight: 700;
  margin: 0;
  letter-spacing: -.01em;
  display: flex;
  align-items: center;
  gap: 7px;
  text-shadow: 0 1px 6px rgba(0,0,0,0.4);
}
.ksl-hero__sub .dot {
  color: var(--saffron);
  font-size: 1.15em;
  line-height: 1;
}

.ksl-btns {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.ksl-geo {
  margin: 0 0 16px;
  display: inline-block;
  background: rgba(245,166,35,.15);
  border: 1px solid var(--saffron);
  color: var(--navy);
  font-size: 13px;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: 99px;
  width: fit-content;
  max-width: 100%;
}
.is-nearest {
  outline: 3px solid var(--saffron) !important;
  outline-offset: 3px;
  box-shadow: 0 0 24px rgba(245,166,35,.55) !important;
  border-radius: 14px;
  transition: all .3s ease;
}

/* Buttons */
.ksl-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 700;
  padding: 11px 20px;
  border-radius: 99px;
  text-decoration: none;
  border: 1.5px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  line-height: 1.2;
  transition: background-color .2s, border-color .2s, transform .1s;
}
.ksl-btn:active { transform: scale(0.98); }
.ksl-btn svg { width: 16px; height: 16px; flex: none; }
.ksl-btn--pri {
  background: var(--saffron);
  border-color: var(--saffron);
  color: var(--ink);
}
.ksl-btn--pri:hover {
  background: var(--saffron-d);
  border-color: var(--saffron-d);
}
.ksl-btn--ghost,
button.ksl-btn--ghost,
a.ksl-btn--ghost,
.ksl-band .ksl-btn--ghost,
.ksl-sticky .ksl-btn--ghost {
  border-color: rgba(255,255,255,.85) !important;
  color: #ffffff !important;
  background: transparent !important;
}
.ksl-btn--ghost svg,
button.ksl-btn--ghost svg,
a.ksl-btn--ghost svg,
.ksl-band .ksl-btn--ghost svg,
.ksl-sticky .ksl-btn--ghost svg {
  stroke: #ffffff !important;
  color: #ffffff !important;
}
.ksl-btn--ghost:hover,
button.ksl-btn--ghost:hover,
a.ksl-btn--ghost:hover,
.ksl-band .ksl-btn--ghost:hover,
.ksl-sticky .ksl-btn--ghost:hover {
  background: rgba(255,255,255,.16) !important;
  color: #ffffff !important;
  border-color: #ffffff !important;
}
.ksl-band .ksl-btn--ghost[style],
.ksl-sticky .ksl-btn--ghost[style] {
  color: rgba(255,255,255,0.75) !important;
  border-color: rgba(255,255,255,0.45) !important;
}
.ksl-band .ksl-btn--ghost[style] svg,
.ksl-sticky .ksl-btn--ghost[style] svg {
  stroke: rgba(255,255,255,0.75) !important;
}
.ksl-btn--line {
  border-color: var(--ink);
  color: var(--ink);
  background: var(--paper);
}
.ksl-btn--line:hover {
  background: var(--cream);
}
.ksl-btn--wa {
  background: var(--wa);
  border-color: var(--wa);
  color: #fff;
}
.ksl-btn--wa:hover {
  background: #0f7a3f;
  border-color: #0f7a3f;
}
.ksl-btn--off {
  border-style: dashed;
  border-color: #C9C2B5;
  color: #8C857A;
  background: var(--paper);
  cursor: not-allowed;
}

/* 2. Brand Strip */
.ksl-brand {
  background: var(--cream);
  border-bottom: 1px solid var(--line);
  padding-block: 22px;
}
.ksl-brand ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.ksl-brand li {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.ksl-brand b {
  font-size: 24px;
  font-weight: 800;
  color: var(--navy);
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.ksl-brand span {
  font-size: 13px;
  color: var(--muted);
  font-weight: 600;
  margin-top: 2px;
}

/* Sections Common */
.ksl-sec {
  padding-block: 56px;
}
.ksl-eyebrow {
  display: block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 6px;
}
.ksl-title {
  font-size: clamp(24px, 3.2vw, 34px);
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.15;
  margin: 0 0 6px;
  text-wrap: balance;
}
.ksl-desc {
  color: var(--muted);
  margin: 0;
  font-size: 14.5px;
}
.ksl-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 26px;
}

/* 3. Stores Section */
.ksl-stores {
  padding-block: 48px 56px;
}
/* Single Store Layout */
.ksl-one {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 36px;
  align-items: center;
}
.ksl-one__img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  border-radius: 14px;
  background: var(--line);
  display: block;
}
.ksl-one h3, .ksl-card h3 {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -.015em;
  margin: 0 0 8px;
}
.ksl-card h3 {
  font-size: 20px;
  margin: 0 0 6px;
}
.ksl-facts {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 16px 0 20px;
  font-size: 14.5px;
}
.ksl-fact {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.ksl-fact svg {
  width: 17px;
  height: 17px;
  flex: none;
  margin-top: 2px;
  color: var(--navy);
}
.ksl-fact small {
  color: var(--muted);
}
.ksl-rating {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 14px;
  flex-wrap: wrap;
}
.ksl-rating b {
  font-size: 15px;
}
.ksl-stars {
  color: #E8A317;
  letter-spacing: 1px;
  font-size: 14px;
}
.ksl-g {
  font-size: 12px;
  color: var(--muted);
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.ksl-g svg {
  width: 13px;
  height: 13px;
}
.ksl-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 12.5px;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 99px;
  background: #EAF6EF;
  color: #16653A;
}
.ksl-status i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #1E9E57;
  display: inline-block;
}
.ksl-status.closed {
  background: #F6EEEE;
  color: #8A2B2B;
}
.ksl-status.closed i {
  background: #C24040;
}

/* Multi-Store Layout */
.ksl-vhead {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 20px;
}
.ksl-vtitle {
  font-family: var(--serif);
  font-size: clamp(28px, 3.6vw, 40px);
  font-weight: 600;
  letter-spacing: -.01em;
  line-height: 1.12;
  margin: 0 0 8px;
  text-wrap: balance;
}
.ksl-arrows {
  display: flex;
  gap: 8px;
  flex: none;
}
.ksl-arrow {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid #D9D4C7;
  background: var(--paper);
  color: var(--navy);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0,0,0,.06);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 3px;
  transition: opacity .25s ease, visibility .25s ease, background-color .2s, border-color .2s;
}
.ksl-arrow:hover {
  border-color: var(--navy);
  background: var(--cream);
}
.ksl-chips {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scrollbar-width: none;
  padding: 2px 2px 8px;
  margin-bottom: 24px;
  scroll-behavior: smooth;
}
.ksl-chips::-webkit-scrollbar { display: none; }
.ksl-chip {
  flex: none;
  border: 1px solid #D9D4C7;
  background: var(--paper);
  color: var(--ink);
  font-size: 14px;
  font-weight: 600;
  padding: 9px 20px;
  border-radius: 99px;
  cursor: pointer;
  white-space: nowrap;
  transition: all .2s;
}
.ksl-chip:hover {
  border-color: var(--navy);
}
.ksl-chip.is-active {
  background: var(--navy);
  border-color: var(--navy);
  color: #fff;
  box-shadow: 0 3px 10px rgba(32,23,71,.25);
}

.ksl-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  align-items: stretch;
}
.ksl-card {
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  box-shadow: 0 4px 16px rgba(0,0,0,.05);
  transition: transform .2s, box-shadow .2s;
  height: 100%;
}
.ksl-card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,.08);
}
.ksl-card__media {
  position: relative;
  width: 100%;
  height: 250px;
  overflow: hidden;
  background: var(--line);
}
.ksl-card__media img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  max-height: none !important;
  object-fit: cover !important;
  object-position: center 35% !important;
  display: block;
}
.ksl-card__media .ksl-status {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #fff;
  color: var(--ink);
  box-shadow: 0 4px 14px rgba(0,0,0,.18);
  z-index: 2;
}
.ksl-card__media .ksl-status.closed {
  color: #8A2B2B;
}
.ksl-card__body {
  padding: 20px 22px 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.ksl-card .ksl-facts {
  margin: 14px 0 20px;
  font-size: 14px;
  flex: 1;
}
.ksl-card .ksl-btns {
  margin-top: auto;
}
.ksl-card .ksl-btn {
  padding: 10px 14px;
  font-size: 13.5px;
  flex: 1;
}

/* 4. Recent Collections */
.ksl-cols {
  background: var(--cream);
}
.ksl-colgrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}
.ksl-col {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  text-decoration: none;
  color: #fff !important;
  aspect-ratio: 3/4;
  display: block;
  background: var(--navy);
}
.ksl-col img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block;
  transition: transform .4s ease;
}
.ksl-col:hover img {
  transform: scale(1.05);
}
.ksl-col::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(16,10,30,.88) 100%);
  pointer-events: none;
}
.ksl-col div {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 18px;
  z-index: 2;
}
.ksl-col b {
  color: #ffffff !important;
  display: block;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -.01em;
  text-shadow: 0 2px 6px rgba(0,0,0,0.8);
}
.ksl-col span {
  color: #f5f2fa !important;
  font-size: 13.5px;
  opacity: .95;
  display: block;
  line-height: 1.35;
  margin-top: 3px;
  text-shadow: 0 1px 4px rgba(0,0,0,0.8);
}
.ksl-col em {
  font-style: normal;
  font-size: 13px;
  font-weight: 700;
  color: #F5A623 !important;
  display: block;
  margin-top: 8px;
  text-shadow: 0 1px 4px rgba(0,0,0,0.8);
}

/* 5. Categories Rail */
.ksl-cats {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 200px;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 6px;
  scrollbar-width: none !important;
  -ms-overflow-style: none !important;
  scroll-behavior: smooth;
}
.ksl-cats::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}
.ksl-arrow:disabled, .ksl-arrow.is-disabled, .ksl-arrow[aria-disabled="true"] {
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}
.ksl-cat {
  scroll-snap-align: start;
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: var(--ink);
  background: var(--paper);
  transition: box-shadow .2s;
}
.ksl-cat:hover {
  box-shadow: 0 4px 16px rgba(0,0,0,.08);
}
.ksl-cat img {
  width: 100%;
  aspect-ratio: 4/5;
  object-fit: cover;
  object-position: center top;
  display: block;
  background: var(--line);
}
.ksl-cat div {
  padding: 12px 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.ksl-cat b {
  font-size: 15px;
}
.ksl-cat span {
  font-size: 12.5px;
  color: var(--muted);
  line-height: 1.4;
}
.ksl-cat em {
  font-style: normal;
  font-weight: 700;
  font-size: 13px;
  color: var(--navy);
  margin-top: auto;
  padding-top: 6px;
}
.ksl-cat:hover em {
  text-decoration: underline;
}

/* 6. FAQ */
.ksl-faq {
  max-width: 780px;
  margin: 0 auto;
}
.ksl-eyebrow--ink {
  color: var(--ink);
  letter-spacing: .12em;
}
.ksl-faq details {
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #F8F6F2;
}
.ksl-faq details + details {
  margin-top: 14px;
}
.ksl-faq summary {
  list-style: none;
  cursor: pointer;
  padding: 18px 22px;
  font-weight: 600;
  font-size: 15.5px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  line-height: 1.4;
}
.ksl-faq summary::-webkit-details-marker { display: none; }
.ksl-faq summary::after {
  content: "";
  flex: none;
  width: 8px;
  height: 8px;
  border-right: 2px solid var(--ink);
  border-bottom: 2px solid var(--ink);
  transform: rotate(45deg) translateY(-2px);
  transition: transform .2s ease;
}
.ksl-faq details[open] summary::after {
  transform: rotate(-135deg) translateY(-2px);
}
.ksl-faq p {
  margin: 0;
  padding: 0 22px 18px;
  color: var(--muted);
  font-size: 14.5px;
  line-height: 1.6;
}
.ksl-chat {
  margin-top: 36px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  text-align: center;
}
.ksl-chat p {
  margin: 0;
  color: var(--muted);
  font-size: 14.5px;
  max-width: 44ch;
}
.ksl-btn--out {
  border-color: var(--navy);
  color: var(--ink);
  background: var(--paper);
  font-weight: 600;
  padding: 12px 26px;
}
.ksl-btn--out:hover {
  background: var(--cream);
}
.ksl-btn--out svg {
  color: var(--wa);
}

/* 7. Sticky Bar (Globally Sticky) */
.ksl-sticky {
  display: block;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #1B1226;
  box-shadow: 0 -4px 20px rgba(0,0,0,.28);
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: transform .25s ease, opacity .2s ease, visibility .25s;
}
.ksl-sticky.picking {
  transform: translateY(115%);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.ksl-sticky .in {
  display: grid;
  grid-template-columns: 1.35fr 1fr 1fr;
  gap: 8px;
  max-width: 540px;
  margin: 0 auto;
  align-items: stretch;
}
.ksl-sticky .ksl-btn {
  padding: 8px 6px;
  font-size: 12.5px;
  font-weight: 700;
  gap: 6px;
  white-space: normal;
  text-align: center;
  line-height: 1.16;
  min-height: 46px;
  border-radius: 99px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.ksl-sticky .ksl-btn svg {
  width: 15px;
  height: 15px;
  flex: none;
}
.ksl-sticky .ksl-btn--pri {
  background: var(--saffron);
  border: 1.5px solid var(--saffron);
  color: var(--ink);
}
.ksl-sticky .ksl-btn--pri:hover {
  background: var(--saffron-d);
  border-color: var(--saffron-d);
}
.ksl-sticky .ksl-btn--ghost {
  background: rgba(255,255,255,0.06) !important;
  border: 1.5px solid rgba(255,255,255,0.72) !important;
  color: #ffffff !important;
}
.ksl-sticky .ksl-btn--ghost svg {
  stroke: #ffffff !important;
  color: #ffffff !important;
}
.ksl-sticky .ksl-btn--ghost:hover {
  background: rgba(255,255,255,0.18) !important;
  border-color: #ffffff !important;
}
.ksl-sticky .ksl-btn--wa {
  background: #128C4A;
  border: 1.5px solid #128C4A;
  color: #ffffff;
}
.ksl-sticky .ksl-btn--wa:hover {
  background: #0e733c;
  border-color: #0e733c;
}

/* 8. Store Chooser Center Modal Popup */
.ksl-sheet-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(16, 10, 30, 0.65);
  z-index: 9998;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.ksl-sheet {
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  bottom: auto !important;
  right: auto !important;
  transform: translate(-50%, -50%) !important;
  z-index: 9999;
  background: #ffffff;
  border: 1px solid var(--line);
  box-shadow: 0 24px 60px rgba(16, 10, 30, 0.35);
  padding: 24px 26px;
  border-radius: 20px;
  width: calc(100% - 36px);
  max-width: 480px;
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.ksl-sheet h4 {
  margin: 0 0 16px;
  font-size: 19px;
  font-weight: 800;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--navy);
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
}
.ksl-sheet h4 button {
  border: 0;
  background: none;
  font-size: 26px;
  line-height: 1;
  cursor: pointer;
  color: var(--muted);
  padding: 4px;
}
.ksl-sheet a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 14px 6px;
  border-bottom: 1px solid var(--line);
  text-decoration: none;
  transition: background-color .2s;
  border-radius: 8px;
}
.ksl-sheet a:last-child {
  border-bottom: none;
}
.ksl-sheet a:hover {
  background: var(--cream);
}
.ksl-sheet__phone {
  color: var(--navy);
  font-weight: 700;
  font-size: 13.5px;
  background: var(--cream);
  padding: 6px 12px;
  border-radius: 99px;
  border: 1px solid var(--line);
  white-space: nowrap;
}

/* 9. Coming Soon Page */
.ksl-soonpg {
  position: relative;
  background: var(--navy);
  color: #fff;
  min-height: 560px;
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.ksl-soonpg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 60% 20%;
  display: block;
}
.ksl-soonpg__txt {
  padding: 56px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
}
.ksl-soonpg .ksl-eyebrow {
  color: var(--saffron);
  margin: 0;
}
.ksl-soonpg h1 {
  font-size: clamp(30px, 4vw, 46px);
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.1;
  margin: 0;
  text-wrap: balance;
}
.ksl-soonpg p {
  margin: 0;
  color: #DCD8EE;
  max-width: 42ch;
  line-height: 1.6;
}
.ksl-soonpg .addr {
  font-size: 15px;
  color: #fff;
  font-weight: 600;
}
.ksl-soonpg .online {
  color: #CFC9E8;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,.35);
  align-self: flex-start;
  margin-top: 8px;
}
.ksl-soonpg .online:hover {
  color: #fff;
  border-bottom-color: #fff;
}

/* Responsive Media Queries */
@media (max-width: 768px) {
  .ksl-c { padding-inline: 16px; }
  .ksl-hero__img { height: 560px !important; min-height: 500px !important; max-height: 80vh; object-fit: cover; object-position: 82% 15% !important; }
  .ksl-hero__img.has-separate-mobile { object-position: center center !important; }
  .ksl-soonpg img.has-separate-mobile { object-position: center center !important; }
  .ksl-hero__shade { background: linear-gradient(180deg, rgba(20,24,33,0) 0%, rgba(20,24,33,0.12) 36%, rgba(27,33,44,0.72) 68%, rgba(20,25,34,0.96) 98%); }
  .ksl-hero__over { padding-bottom: 24px; }
  .ksl-hero__title { font-size: 26px; }
  .ksl-vhead { align-items: center; }
  .ksl-sec { padding-block: 40px; }
  .ksl-stores { padding-block: 32px 40px; }
  .ksl-one { grid-template-columns: 1fr; gap: 20px; }
  .ksl-one .ksl-btns, .ksl-card .ksl-btns { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
  .ksl-one .ksl-btn, .ksl-card .ksl-btn { padding: 10px 6px; font-size: 12px; gap: 4px; }
  .ksl-cards { grid-template-columns: 1fr; gap: 18px; }
  .ksl-card__media { height: 230px; }
  .ksl-colgrid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .ksl-col b { font-size: 15.5px; }
  .ksl-col span { font-size: 12px; }
  .ksl-cats { grid-auto-columns: 160px; gap: 12px; }
  .ksl-sheet { width: calc(100% - 30px); max-width: 420px; padding: 20px 18px 22px; border-radius: 18px; }
  .ksl-soonpg { grid-template-columns: 1fr; min-height: 0; }
  .ksl-soonpg img { aspect-ratio: 4/5; height: auto; }
  .ksl-soonpg__txt { padding: 28px 20px 36px; }
}
</style>

<div class="ksl-page" id="kslPage-{{ section.id }}" data-section-id="{{ section.id }}" data-city="{{ city_id }}">

{%- if is_coming_soon -%}
  {%- liquid
    assign mall = section.settings.coming_soon_mall | default: 'City Mall'
    assign addr = section.settings.coming_soon_address | default: city_name
    assign soon_title = section.settings.coming_soon_title
    if soon_title == blank
      assign soon_title = 'Kisah is coming to ' | append: city_name
    endif
    assign soon_note = section.settings.coming_soon_note | default: "We'll message you on WhatsApp the day the doors open."
    assign soon_msg = 'Hi Kisah, please let me know when the ' | append: mall | append: ' store in ' | append: city_name | append: ' opens.'
  -%}
  <section class="ksl-soonpg">
    {%- assign soon_desk = section.settings.hero_image -%}
    {%- assign soon_mob = section.settings.hero_image_mobile -%}
    {%- if soon_desk != blank or soon_mob != blank -%}
      <picture class="ksl-soonpg__pic">
        {%- if soon_mob != blank -%}
          <source media="(max-width: 768px)" srcset="{{ soon_mob | image_url: width: 900 }}">
        {%- endif -%}
        {%- if soon_desk != blank -%}
          <source media="(min-width: 769px)" srcset="{{ soon_desk | image_url: width: 1400 }}">
        {%- endif -%}
        {%- assign soon_fallback = soon_desk | default: soon_mob -%}
        <img class="{% if soon_mob != blank %}has-separate-mobile{% endif %}"
             src="{{ soon_fallback | image_url: width: 1200 }}"
             alt="{{ soon_title }}"
             loading="eager"
             width="{{ soon_fallback.width | default: 800 }}"
             height="{{ soon_fallback.height | default: 600 }}">
      </picture>
    {%- else -%}
      <div style="background: linear-gradient(135deg, #1b1226 0%, #201747 100%); display:flex; align-items:center; justify-content:center; min-height:360px; padding:40px;">
        <span style="font-size:28px; font-weight:800; color:rgba(255,255,255,0.2); letter-spacing:0.08em; text-transform:uppercase;">KISAH · {{ city_name }}</span>
      </div>
    {%- endif -%}
    <div class="ksl-soonpg__txt">
      <span class="ksl-eyebrow">Coming soon</span>
      <h1>{{ soon_title }}</h1>
      <p class="addr">{{ mall }} · {{ addr }}</p>
      <p>{{ soon_note }}</p>
      <div class="ksl-btns">
        <a class="ksl-btn ksl-btn--wa"
           href="https://wa.me/{{ ally_phone }}?text={{ soon_msg | url_encode }}"
           target="_blank"
           rel="noopener"
           data-track-cta="whatsapp"
           data-track-city="{{ city_name }}"
           data-track-store="{{ mall }}">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
          Get notified on WhatsApp
        </a>
      </div>
      <a class="online" href="/collections/new-arrivals">Until then, shop new arrivals online →</a>
    </div>
  </section>

{%- else -%}

  {%- liquid
    assign first_store = null
    for block in section.blocks
      if block.type == 'store'
        assign first_store = block
        break
      endif
    endfor
  -%}

  <!-- 1. Hero Campaign Banner -->
  <section class="ksl-hero">
    {%- assign default_desk_banner = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Herobanner_sheer2.jpg?v=1793162097' -%}
    {%- assign default_mob_banner = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Herobanner_sheer1.jpg?v=1793162097' -%}

    {%- if section.settings.hero_image != blank -%}
      {%- assign hero_desk_src = section.settings.hero_image | image_url: width: 2000 -%}
      {%- assign hero_desk_w = section.settings.hero_image.width | default: 1440 -%}
      {%- assign hero_desk_h = section.settings.hero_image.height | default: 660 -%}
    {%- else -%}
      {%- assign hero_desk_src = default_desk_banner -%}
      {%- assign hero_desk_w = 1920 -%}
      {%- assign hero_desk_h = 700 -%}
    {%- endif -%}

    {%- if section.settings.hero_image_mobile != blank -%}
      {%- assign hero_mob_src = section.settings.hero_image_mobile | image_url: width: 900 -%}
    {%- else -%}
      {%- assign hero_mob_src = default_mob_banner -%}
    {%- endif -%}

    <picture class="ksl-hero__pic">
      {%- if hero_mob_src != blank -%}
        <source media="(max-width: 768px)" srcset="{{ hero_mob_src }}">
      {%- endif -%}
      {%- if hero_desk_src != blank -%}
        <source media="(min-width: 769px)" srcset="{{ hero_desk_src }}">
      {%- endif -%}
      <img class="ksl-hero__img has-separate-mobile"
           src="{{ hero_desk_src | default: hero_mob_src }}"
           alt="{{ section.settings.hero_title | default: 'Kisah - Available in your nearest store' }}"
           loading="eager"
           fetchpriority="high"
           width="{{ hero_desk_w }}"
           height="{{ hero_desk_h }}">
    </picture>
    <div class="ksl-hero__shade"></div>
    <div class="ksl-hero__over">
      <div class="ksl-c">
        <h2 class="ksl-hero__title">{{ section.settings.hero_title | default: 'Kisah, available in your nearest store' }}</h2>
        <div class="ksl-hero__divider" aria-hidden="true"></div>
        {%- if store_count == 1 and first_store != null -%}
          <p class="ksl-hero__sub">
            {%- if section.settings.band_headline != blank -%}
              {{ section.settings.band_headline }}
            {%- else -%}
              Kisah in {{ city_name }} <span class="dot">•</span> {{ first_store.settings.name }}
            {%- endif -%}
          </p>
        {%- else -%}
          <p class="ksl-hero__sub">
            {%- if section.settings.band_headline != blank -%}
              {{ section.settings.band_headline }}
            {%- else -%}
              Kisah in {{ city_name }} <span class="dot">•</span> {{ store_count }} stores
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- 2. Stores Section -->
  <section class="ksl-stores" id="stores">
    <div class="ksl-c">
      <p class="ksl-geo" id="kslGeoMsg" hidden aria-live="polite"></p>
      {%- if store_count == 1 and first_store != null -%}
        {%- liquid
          assign s = first_store.settings
        -%}
        <div class="ksl-one">
          {%- if s.image != blank -%}
            <img class="ksl-one__img" src="{{ s.image | image_url: width: 800 }}" alt="{{ s.name }} storefront" loading="lazy" width="600" height="450">
          {%- else -%}
            <div class="ksl-one__img" style="background: linear-gradient(135deg, #f7f4ed 0%, #ece5d8 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:280px; color:#201747; border-radius:14px; gap:8px;">
              <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <b style="font-size:16px; font-weight:700;">{{ s.full_name | default: s.name }}</b>
            </div>
          {%- endif -%}
          <div>
            <h3>{{ s.full_name | default: s.name }}</h3>
            <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
              {%- if s.show_rating != false and s.rating != blank -%}
                {%- liquid
                  assign s_reviews = s.reviews | default: '100+'
                  assign s_reviews_lower = s_reviews | downcase
                  unless s_reviews_lower contains 'review' or s_reviews_lower contains 'soon'
                    assign s_reviews = s_reviews | append: ' reviews'
                  endunless
                -%}
                <a class="ksl-rating" href="{{ s.maps_url | default: '#' }}" target="_blank" rel="noopener" data-place-id="{{ s.place_id }}" title="View on Google Maps" style="text-decoration:none;">
                  <b>{{ s.rating }}</b>
                  <span class="ksl-stars" aria-hidden="true">★★★★★</span>
                  <span class="ksl-reviews-count">{{ s_reviews }}</span>
                  <span class="ksl-g">
                    <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4z"/></svg>
                    Google
                  </span>
                </a>
              {%- endif -%}
              <span class="ksl-status" data-store-open="{{ s.open_time | default: '11:00' }}" data-store-close="{{ s.close_time | default: '22:00' }}"><i></i>Open now</span>
            </div>
            <div class="ksl-facts">
              <div class="ksl-fact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                <span>{{ s.address }}</span>
              </div>
              <div class="ksl-fact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <span>{{ s.open_time | default: '11:00 AM' }} – {{ s.close_time | default: '10:00 PM' }} · All days</span>
              </div>
              <div class="ksl-fact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                <span>{% if s.phone != blank %}+91 {{ s.phone }}{% else %}<small>Store number to be confirmed</small>{% endif %}</span>
              </div>
            </div>
            <div class="ksl-btns">
              <a class="ksl-btn ksl-btn--pri"
                 href="{{ s.maps_url }}"
                 target="_blank"
                 rel="noopener"
                 data-track-cta="get_directions"
                 data-track-city="{{ city_name }}"
                 data-track-store="{{ s.name }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>
                Get directions
              </a>
              {%- if s.phone != blank -%}
                <a class="ksl-btn ksl-btn--line"
                   href="tel:+91{{ s.phone | replace: ' ', '' | replace: '+', '' }}"
                   data-track-cta="call"
                   data-track-city="{{ city_name }}"
                   data-track-store="{{ s.name }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                  Call store
                </a>
              {%- else -%}
                <span class="ksl-btn ksl-btn--off" title="Number pending confirmation">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                  Call store
                </span>
              {%- endif -%}
              <a class="ksl-btn ksl-btn--wa"
                 href="https://wa.me/{{ ally_phone }}?text={{ wa_single | url_encode }}"
                 target="_blank"
                 rel="noopener"
                 data-track-cta="whatsapp"
                 data-track-city="{{ city_name }}"
                 data-track-store="{{ s.name }}">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
                WhatsApp
              </a>
            </div>
          </div>
        </div>

      {%- else -%}
        <!-- Multi-Store Section Header -->
        {%- assign default_stores_title = 'Visit Kisah in ' | append: city_name -%}
        <div class="ksl-vhead">
          <div>
            <h2 class="ksl-vtitle">{{ section.settings.stores_title | default: default_stores_title }}</h2>
            <p class="ksl-desc">{{ section.settings.stores_subtitle | default: 'Find your nearest boutique. Walk in anytime — no prior appointment needed.' }}</p>
          </div>
          <div class="ksl-arrows">
            <button type="button" class="ksl-arrow" data-slide="-1" aria-label="Scroll store tabs left">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="ksl-arrow" data-slide="1" aria-label="Scroll store tabs right">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <!-- Filter Chips (Requirement 2: Store tabs for cities with multiple stores) -->
        <div class="ksl-chips" id="kslChips" role="group" aria-label="Filter stores">
          <button type="button" class="ksl-chip is-active" data-filter="all">All Stores ({{ store_count }})</button>
          {%- for block in section.blocks -%}
            {%- if block.type == 'store' -%}
              <button type="button" class="ksl-chip" data-filter="{{ block.id }}">{{ block.settings.name }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Cards Grid -->
        <div class="ksl-cards">
          {%- for block in section.blocks -%}
            {%- if block.type == 'store' -%}
              {%- liquid
                assign s = block.settings
                assign wa_store = "Hi Kisah, I'm planning to visit the " | append: s.name | append: " store in " | append: city_name | append: "."
                if s.full_name != blank
                  assign store_card_name = s.full_name
                elsif s.name contains 'Kisah'
                  assign store_card_name = s.name
                else
                  assign store_card_name = 'Kisah ' | append: s.name
                endif
              -%}
              <article class="ksl-card"
                       id="st-{{ block.id }}"
                       data-store-id="{{ block.id }}"
                       data-name="{{ s.name | escape }}"
                       data-lat="{{ s.lat }}"
                       data-lng="{{ s.lng }}"
                       data-phone="{{ s.phone }}">
                <div class="ksl-card__media">
                  {%- if s.image != blank -%}
                    <img src="{{ s.image | image_url: width: 800 }}" alt="{{ store_card_name }} store" loading="lazy" width="600" height="375">
                  {%- else -%}
                    <div style="width:100%; height:100%; background: linear-gradient(135deg, #f7f4ed 0%, #ece5d8 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; color:#201747; gap:6px;">
                      <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                      <b style="font-size:14px; font-weight:700;">{{ s.name }}</b>
                    </div>
                  {%- endif -%}
                  <span class="ksl-status" data-store-open="{{ s.open_time | default: '10:30' }}" data-store-close="{{ s.close_time | default: '21:30' }}"><i></i>Open now</span>
                </div>
                <div class="ksl-card__body">
                  <h3>{{ store_card_name }}</h3>
                  {%- if s.show_rating != false and s.rating != blank -%}
                    {%- liquid
                      assign s_reviews = s.reviews | default: '100+'
                      assign s_reviews_lower = s_reviews | downcase
                      unless s_reviews_lower contains 'review' or s_reviews_lower contains 'soon'
                        assign s_reviews = s_reviews | append: ' reviews'
                      endunless
                    -%}
                    <a class="ksl-rating" href="{{ s.maps_url | default: '#' }}" target="_blank" rel="noopener" data-place-id="{{ s.place_id }}" title="View on Google Maps" style="margin-bottom:10px;text-decoration:none;">
                      <b>{{ s.rating }}</b>
                      <span class="ksl-stars" aria-hidden="true">★★★★★</span>
                      <span class="ksl-reviews-count">{{ s_reviews }}</span>
                      <span class="ksl-g">
                        <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4z"/></svg>
                        Google
                      </span>
                    </a>
                  {%- endif -%}
                  <div class="ksl-facts">
                    <div class="ksl-fact">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                      <span>{{ s.address }}</span>
                    </div>
                    <div class="ksl-fact">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                      <span>{{ s.open_time | default: '10:30 AM' }} – {{ s.close_time | default: '09:30 PM' }} · All days</span>
                    </div>
                    <div class="ksl-fact">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                      <span>{% if s.phone != blank %}+91 {{ s.phone }}{% else %}<small>Store number to be confirmed</small>{% endif %}</span>
                    </div>
                  </div>
                  <div class="ksl-btns">
                    <a class="ksl-btn ksl-btn--pri"
                       href="{{ s.maps_url }}"
                       target="_blank"
                       rel="noopener"
                       data-track-cta="get_directions"
                       data-track-city="{{ city_name }}"
                       data-track-store="{{ s.name }}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>
                      Get directions
                    </a>
                    {%- if s.phone != blank -%}
                      <a class="ksl-btn ksl-btn--line"
                         href="tel:+91{{ s.phone | replace: ' ', '' | replace: '+', '' }}"
                         data-track-cta="call"
                         data-track-city="{{ city_name }}"
                         data-track-store="{{ s.name }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                        Call store
                      </a>
                    {%- else -%}
                      <span class="ksl-btn ksl-btn--off" title="Number pending confirmation">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                        Call store
                      </span>
                    {%- endif -%}
                    <a class="ksl-btn ksl-btn--wa"
                       href="https://wa.me/{{ ally_phone }}?text={{ wa_store | url_encode }}"
                       target="_blank"
                       rel="noopener"
                       data-track-cta="whatsapp"
                       data-track-city="{{ city_name }}"
                       data-track-store="{{ s.name }}">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
                      WhatsApp
                    </a>
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  <!-- 4. Recent Collections -->
  <section class="ksl-sec ksl-cols">
    <div class="ksl-c">
      <div class="ksl-head">
        <div>
          <span class="ksl-eyebrow">New this season</span>
          <h2 class="ksl-title">Recent collections</h2>
          <p class="ksl-desc">See them in store, or shop them online.</p>
        </div>
      </div>
      <div class="ksl-colgrid">
        {%- assign col_1 = section.settings.collection_1 | default: collections['shor-collection'] -%}
        {%- if col_1 != blank -%}
          {%- assign col_1_img = col_1.image | default: col_1.featured_image -%}
          <a class="ksl-col" href="{{ col_1.url }}">
            {%- if col_1_img != blank -%}
              <img src="{{ col_1_img | image_url: width: 600 }}" alt="{{ col_1.title | escape }}" loading="lazy" width="400" height="533">
            {%- endif -%}
            <div>
              <b>{{ col_1.title }}</b>
              <span>{{ section.settings.collection_1_sub | default: 'Colour that walks in before you do' }}</span>
              <em>Shop the collection →</em>
            </div>
          </a>
        {%- endif -%}

        {%- assign col_2 = section.settings.collection_2 | default: collections['sheer'] | default: collections['sheer-collection'] -%}
        {%- if col_2 != blank -%}
          {%- assign col_2_img = col_2.image | default: col_2.featured_image -%}
          {%- assign col_2_fallback_img = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/sheer.jpg?v=1793161624' -%}
          <a class="ksl-col" href="{{ col_2.url | default: '/collections/sheer' }}">
            {%- if col_2_img != blank -%}
              <img src="{{ col_2_img | image_url: width: 600 }}" alt="{{ col_2.title | default: 'Sheer' | escape }}" loading="lazy" width="400" height="533">
            {%- else -%}
              <img src="{{ col_2_fallback_img }}" alt="{{ col_2.title | default: 'Sheer' | escape }}" loading="lazy" width="400" height="533">
            {%- endif -%}
            <div>
              <b>{{ col_2.title | default: 'Sheer' }}</b>
              <span>{{ section.settings.collection_2_sub | default: 'Sheer by nature. Intriguing by design' }}</span>
              <em>Shop the collection →</em>
            </div>
          </a>
        {%- endif -%}

        {%- assign col_3 = section.settings.collection_3 | default: collections['bougee-1'] -%}
        {%- if col_3 != blank -%}
          {%- assign col_3_img = col_3.image | default: col_3.featured_image -%}
          <a class="ksl-col" href="{{ col_3.url }}">
            {%- if col_3_img != blank -%}
              <img src="{{ col_3_img | image_url: width: 600 }}" alt="{{ col_3.title | escape }}" loading="lazy" width="400" height="533">
            {%- endif -%}
            <div>
              <b>{{ col_3.title }}</b>
              <span>{{ section.settings.collection_3_sub | default: 'Rich textures, easy confidence' }}</span>
              <em>Shop the collection →</em>
            </div>
          </a>
        {%- endif -%}

        {%- assign col_4 = section.settings.collection_4 | default: collections['wedding-core25'] -%}
        {%- if col_4 != blank -%}
          {%- assign col_4_img = col_4.image | default: col_4.featured_image -%}
          <a class="ksl-col" href="{{ col_4.url }}">
            {%- if col_4_img != blank -%}
              <img src="{{ col_4_img | image_url: width: 600 }}" alt="{{ col_4.title | escape }}" loading="lazy" width="400" height="533">
            {%- endif -%}
            <div>
              <b>{{ col_4.title }}</b>
              <span>{{ section.settings.collection_4_sub | default: "The season's staples, sharpened" }}</span>
              <em>Shop the collection →</em>
            </div>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- 5. Categories Rail -->
  <section class="ksl-sec">
    <div class="ksl-c">
      <div class="ksl-head">
        <div>
          <span class="ksl-eyebrow">Shop by category</span>
          <h2 class="ksl-title">Find your signature</h2>
        </div>
        <div class="ksl-arrows ksl-cats-arrows" aria-label="Slide category cards">
          <button type="button" class="ksl-arrow" id="kslCatSlidePrev" aria-label="Slide categories left">‹</button>
          <button type="button" class="ksl-arrow" id="kslCatSlideNext" aria-label="Slide categories right">›</button>
        </div>
      </div>
      <div class="ksl-cats">
        {%- assign cat_list = "kurta-sets:Kurta Sets:Easy festive dressing, from puja evenings to family dinners|kurtajacketset:Kurta Jacket Sets:Layered and polished for receptions|kurta:Kurtas:Prints, solids and embroidery for every ritual|short-kurta:Short Kurtas:Relaxed and modern for casual celebrations|nehru-jackets:Nehru Jackets:Sharpens any solid kurta|indowestern-sets:Indo-Western Sets:Structured drapes for cocktail and sangeet nights|sherwani-achkans:Sherwanis & Achkans:Craft that owns the room|jodhpuri-bandhgala:Jodhpuri & Bandhgala:Sharp tailoring with a modern edge|kids:Kids:Mini kurtas, jackets and sherwanis|plus:Plus Size:Celebration wear in sizes that fit right" | split: "|" -%}
        {%- for cat_item in cat_list -%}
          {%- assign cat_parts = cat_item | split: ":" -%}
          {%- assign cat_handle = cat_parts[0] -%}
          {%- assign cat_title = cat_parts[1] -%}
          {%- assign cat_desc = cat_parts[2] -%}
          {%- assign cat_col = collections[cat_handle] -%}
          <a class="ksl-cat" href="{{ cat_col.url | default: '/collections/' | append: cat_handle }}">
            {%- if cat_col.featured_image != blank -%}
              <img src="{{ cat_col.featured_image | image_url: width: 300 }}" alt="{{ cat_title }}" loading="lazy" width="200" height="250">
            {%- else -%}
              <div style="width:100%; aspect-ratio:4/5; background:linear-gradient(135deg, #f7f4ed 0%, #ece5d8 100%); display:flex; align-items:center; justify-content:center; color:#201747; font-weight:700; font-size:13px; text-align:center; padding:12px;">
                <span>{{ cat_title }}</span>
              </div>
            {%- endif -%}
            <div><b>{{ cat_title }}</b><span>{{ cat_desc }}</span><em>See the range →</em></div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- 6. FAQ Section (Requirement 3: 3 Focused FAQs) -->
  <section class="ksl-sec" style="padding-top:12px;">
    <div class="ksl-c">
      <div class="ksl-faq">
        <span class="ksl-eyebrow ksl-eyebrow--ink">Frequently asked</span>
        <h2 class="ksl-vtitle" style="margin-bottom:24px;">Planning your visit</h2>
        <details open>
          <summary>Do I need an appointment before visiting?</summary>
          <p>No. Walk in any time during store hours and our stylists will help you with styling and sizing. {% if store_count == 1 and first_store != null %}The store is open {{ first_store.settings.open_time | default: '11:00 AM' }} to {{ first_store.settings.close_time | default: '10:00 PM' }}, all 7 days.{% else %}Our stores are open all 7 days a week; each store's exact hours are listed on its card above.{% endif %}</p>
        </details>
        <details>
          <summary>Are alterations available in-store?</summary>
          <p>Yes. Our in-store team can adjust sleeve length, chest, waist and trouser hem so the outfit fits you right.</p>
        </details>
        <div class="ksl-chat">
          {%- if store_count > 1 -%}
            {%- assign store_s = 's' -%}
          {%- else -%}
            {%- assign store_s = '' -%}
          {%- endif -%}
          {%- assign wa_chat = "Hi Kisah, I have a question about your " | append: city_name | append: " store" | append: store_s | append: "." -%}
          <a class="ksl-btn ksl-btn--out"
             href="https://wa.me/{{ ally_phone }}?text={{ wa_chat | url_encode }}"
             target="_blank"
             rel="noopener"
             data-track-cta="whatsapp"
             data-track-city="{{ city_name }}">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
            Chat with us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Sticky Mobile Bar -->
  <div class="ksl-sticky" id="kslSticky">
    <div class="in">
      {%- if store_count == 1 and first_store != null -%}
        <a class="ksl-btn ksl-btn--pri"
           href="{{ first_store.settings.maps_url }}"
           target="_blank"
           rel="noopener"
           data-scrollto
           data-track-cta="get_directions"
           data-track-city="{{ city_name }}"
           data-track-store="{{ first_store.settings.name }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>
          Get directions
        </a>
        {%- if first_store.settings.phone != blank -%}
          <a class="ksl-btn ksl-btn--ghost"
             href="tel:+91{{ first_store.settings.phone | replace: ' ', '' | replace: '+', '' }}"
             data-track-cta="call"
             data-track-city="{{ city_name }}"
             data-track-store="{{ first_store.settings.name }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            Call store
          </a>
        {%- else -%}
          <span class="ksl-btn ksl-btn--ghost" style="opacity:.55;cursor:not-allowed">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            Call store
          </span>
        {%- endif -%}
        <a class="ksl-btn ksl-btn--wa"
           href="https://wa.me/{{ ally_phone }}?text={{ wa_single | url_encode }}"
           target="_blank"
           rel="noopener"
           data-track-cta="whatsapp"
           data-track-city="{{ city_name }}"
           data-track-store="{{ first_store.settings.name }}">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
          WhatsApp
        </a>
      {%- else -%}
        <button type="button"
                class="ksl-btn ksl-btn--pri"
                data-geo
                data-track-cta="find_nearest"
                data-track-city="{{ city_name }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
          Find my nearest store
        </button>
        <button type="button"
                class="ksl-btn ksl-btn--ghost"
                data-pick="call"
                data-track-cta="call_picker"
                data-track-city="{{ city_name }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          Call store
        </button>
        <a class="ksl-btn ksl-btn--wa"
           href="https://wa.me/{{ ally_phone }}?text={{ wa_multi | url_encode }}"
           target="_blank"
           rel="noopener"
           data-track-cta="whatsapp"
           data-track-city="{{ city_name }}">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
          WhatsApp
        </a>
      {%- endif -%}
    </div>
  </div>

  <!-- 8. Multi-Store Call Picker Center Popup Modal -->
  <div class="ksl-sheet-backdrop" id="kslSheetBackdrop" hidden></div>
  <div class="ksl-sheet" id="kslSheet" hidden role="dialog" aria-modal="true" aria-label="Select a store to call">
    <h4>Call a store <button type="button" aria-label="Close" data-close>×</button></h4>
    <div id="kslSheetList">
      {%- for block in section.blocks -%}
        {%- if block.type == 'store' -%}
          {%- liquid
            assign s = block.settings
            if s.full_name != blank
              assign modal_store_title = s.full_name
            elsif s.name contains 'Kisah'
              assign modal_store_title = s.name
            else
              assign modal_store_title = 'Kisah ' | append: s.name
            endif
          -%}
          {%- if s.phone != blank -%}
            <a href="tel:+91{{ s.phone | replace: ' ', '' | replace: '+', '' }}"
               data-track-cta="call"
               data-track-city="{{ city_name }}"
               data-track-store="{{ s.name }}">
              <div style="display:flex;flex-direction:column;gap:3px;text-align:left;">
                <strong style="color:var(--navy);font-size:15px;font-weight:700;">{{ modal_store_title }}</strong>
                <span style="color:var(--muted);font-size:12.5px;font-weight:500;">{{ s.name }} · {{ city_name }}</span>
              </div>
              <span class="ksl-sheet__phone">+91 {{ s.phone }}</span>
            </a>
          {%- else -%}
            <a aria-disabled="true" style="opacity:.6;cursor:not-allowed;">
              <div style="display:flex;flex-direction:column;gap:3px;text-align:left;">
                <strong style="color:var(--navy);font-size:15px;font-weight:700;">{{ modal_store_title }}</strong>
                <span style="color:var(--muted);font-size:12.5px;font-weight:500;">{{ s.name }} · {{ city_name }}</span>
              </div>
              <span class="ksl-sheet__phone">Number pending</span>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

{%- endif -%}

</div>

<script>
(function() {
  const root = document.getElementById('kslPage-{{ section.id }}');
  if (!root) return;

  const cityName = "{{ city_name }}";

  /* 1. Live IST Open/Closed Status Badges */
  function istMinutes() {
    try {
      const p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
      const g = t => Number(p.find(x => x.type === t).value);
      return g('hour') * 60 + g('minute');
    } catch(e) {
      const d = new Date();
      return ((d.getUTCHours() * 60 + d.getUTCMinutes() + 330) % 1440);
    }
  }

  function parseTime(tStr) {
    if (!tStr) return 0;
    // Format "10:30" or "10:30 AM" or "11:00 PM"
    let clean = tStr.trim().toUpperCase();
    let isPM = clean.includes('PM');
    let isAM = clean.includes('AM');
    clean = clean.replace('AM', '').replace('PM', '').trim();
    let [h, m] = clean.split(':').map(Number);
    h = h || 0;
    m = m || 0;
    if (isPM && h < 12) h += 12;
    if (isAM && h === 12) h = 0;
    return h * 60 + m;
  }

  function format12(hmMins) {
    let h = Math.floor(hmMins / 60) % 24;
    let m = hmMins % 60;
    const ap = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    return h + ':' + String(m).padStart(2, '0') + ' ' + ap;
  }

  function updateStatusPills() {
    const now = istMinutes();
    root.querySelectorAll('.ksl-status[data-store-open]').forEach(el => {
      const o = parseTime(el.dataset.storeOpen);
      const c = parseTime(el.dataset.storeClose);
      const isOpen = now >= o && now < c;
      el.classList.toggle('closed', !isOpen);
      if (isOpen) {
        el.innerHTML = '<i></i>Open now · closes ' + format12(c);
      } else {
        el.innerHTML = '<i></i>Closed · opens ' + format12(o) + (now >= c ? ' tomorrow' : '');
      }
    });
  }
  updateStatusPills();
  setInterval(updateStatusPills, 60000);

  /* 2. Store filter tabs for cities with multiple stores */
  function filterTo(key) {
    root.querySelectorAll('#kslChips .ksl-chip').forEach(b => {
      b.classList.toggle('is-active', b.dataset.filter === key);
    });
    root.querySelectorAll('.ksl-cards .ksl-card').forEach(card => {
      const match = (key === 'all' || card.dataset.storeId === key);
      card.hidden = !match;
      card.style.display = match ? '' : 'none';
    });
  }

  root.addEventListener('click', e => {
    const ch = e.target.closest('#kslChips [data-filter]');
    if (ch) {
      filterTo(ch.dataset.filter);
    }
  });

  /* Dynamic slider arrows with scroll boundary checking (Categories and Store Chips) */
  function setupSlider(sliderEl, prevBtn, nextBtn, step) {
    if (!sliderEl || !prevBtn || !nextBtn) return;

    function checkBounds() {
      const sLeft = sliderEl.scrollLeft;
      const maxScroll = sliderEl.scrollWidth - sliderEl.clientWidth - 4;
      const canScroll = sliderEl.scrollWidth > (sliderEl.clientWidth + 5);

      if (!canScroll) {
        prevBtn.style.opacity = '0';
        prevBtn.style.visibility = 'hidden';
        prevBtn.style.pointerEvents = 'none';
        nextBtn.style.opacity = '0';
        nextBtn.style.visibility = 'hidden';
        nextBtn.style.pointerEvents = 'none';
        return;
      }

      const atStart = sLeft <= 4;
      const atEnd = sLeft >= maxScroll;

      if (atStart) {
        prevBtn.style.opacity = '0';
        prevBtn.style.visibility = 'hidden';
        prevBtn.style.pointerEvents = 'none';
        prevBtn.disabled = true;
      } else {
        prevBtn.style.opacity = '1';
        prevBtn.style.visibility = 'visible';
        prevBtn.style.pointerEvents = 'auto';
        prevBtn.disabled = false;
      }

      if (atEnd) {
        nextBtn.style.opacity = '0';
        nextBtn.style.visibility = 'hidden';
        nextBtn.style.pointerEvents = 'none';
        nextBtn.disabled = true;
      } else {
        nextBtn.style.opacity = '1';
        nextBtn.style.visibility = 'visible';
        nextBtn.style.pointerEvents = 'auto';
        nextBtn.disabled = false;
      }
    }

    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      sliderEl.scrollBy({ left: -step, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      sliderEl.scrollBy({ left: step, behavior: 'smooth' });
    });

    sliderEl.addEventListener('scroll', checkBounds, { passive: true });
    window.addEventListener('resize', checkBounds);
    checkBounds();
    setTimeout(checkBounds, 150);
    setTimeout(checkBounds, 600);
  }

  // Setup for Categories Rail
  const catRail = root.querySelector('.ksl-cats');
  const catPrev = root.querySelector('#kslCatSlidePrev');
  const catNext = root.querySelector('#kslCatSlideNext');
  setupSlider(catRail, catPrev, catNext, 340);

  // Setup for Store Filter Chips
  const chipRail = root.querySelector('#kslChips');
  const chipPrev = root.querySelector('.ksl-vhead [data-slide="-1"]');
  const chipNext = root.querySelector('.ksl-vhead [data-slide="1"]');
  setupSlider(chipRail, chipPrev, chipNext, 280);

  /* 3. Geolocation & Haversine formula for "Find my nearest store" */
  function haversineKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const r = Math.PI / 180;
    const dLat = (lat2 - lat1) * r;
    const dLon = (lon2 - lon1) * r;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * r) * Math.cos(lat2 * r) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function showGeoMsg(text) {
    const g = root.querySelector('#kslGeoMsg');
    if (g) {
      g.textContent = text;
      g.hidden = false;
    }
  }

  function toStores() {
    const el = root.querySelector('#stores');
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function findNearestStore(userLat, userLng) {
    const cards = Array.from(root.querySelectorAll('.ksl-cards .ksl-card'));
    if (!cards.length) {
      toStores();
      return;
    }

    let bestCard = null;
    let minDistance = 1e12;

    cards.forEach(card => {
      const lat = parseFloat(card.dataset.lat);
      const lng = parseFloat(card.dataset.lng);
      if (!isNaN(lat) && !isNaN(lng) && (lat !== 0 || lng !== 0)) {
        const d = haversineKm(userLat, userLng, lat, lng);
        if (d < minDistance) {
          minDistance = d;
          bestCard = card;
        }
      }
    });

    if (!bestCard) {
      toStores();
      return;
    }

    // Reset filter to show all so the target card is visible
    filterTo('all');

    const sName = bestCard.dataset.name || 'our store';
    const distText = minDistance < 50
      ? Math.max(1, Math.round(minDistance)) + ' km away'
      : 'in ' + cityName;
    showGeoMsg('Nearest store: ' + sName + ' (' + distText + ')');

    setTimeout(() => {
      bestCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      bestCard.classList.add('is-nearest');
      setTimeout(() => bestCard.classList.remove('is-nearest'), 3500);
    }, 350);
  }

  root.addEventListener('click', e => {
    if (!e.target.closest('[data-geo]')) return;
    if (!navigator.geolocation) {
      showGeoMsg("Location isn't available on this device. Showing all our stores below.");
      toStores();
      return;
    }
    showGeoMsg('Finding your nearest store…');
    navigator.geolocation.getCurrentPosition(
      pos => findNearestStore(pos.coords.latitude, pos.coords.longitude),
      err => {
        showGeoMsg('Location access is off. Showing all our stores below.');
        toStores();
      },
      { timeout: 8000, enableHighAccuracy: true }
    );
  });

  /* 4. Single-store "data-scrollto" smooth scroll */
  root.addEventListener('click', e => {
    if (!e.target.closest('[data-scrollto]')) return;
    const el = root.querySelector('#stores');
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    const blk = el.querySelector('.ksl-one');
    if (blk) {
      blk.classList.add('is-nearest');
      setTimeout(() => blk.classList.remove('is-nearest'), 3000);
    }
  });

  /* 5. Sticky bar visibility: globally sticky at all times */
  const bar = root.querySelector('#kslSticky');
  if (bar) {
    bar.classList.add('on');
  }

  /* 6. Call store modal popup */
  const sheet = root.querySelector('#kslSheet');
  const backdrop = root.querySelector('#kslSheetBackdrop');

  function openSheet() {
    if (sheet && backdrop) {
      sheet.removeAttribute('hidden');
      backdrop.removeAttribute('hidden');
      sheet.style.display = 'block';
      backdrop.style.display = 'block';
      document.body.style.overflow = 'hidden';
      if (bar) bar.classList.add('picking');
    }
  }

  function closeSheet() {
    if (sheet && backdrop) {
      sheet.setAttribute('hidden', '');
      backdrop.setAttribute('hidden', '');
      sheet.style.display = 'none';
      backdrop.style.display = 'none';
      document.body.style.overflow = '';
      if (bar) bar.classList.remove('picking');
    }
  }

  root.addEventListener('click', e => {
    if (e.target.closest('[data-pick="call"]')) {
      e.preventDefault();
      openSheet();
      return;
    }
    if (e.target.closest('[data-close]') || e.target === backdrop) {
      e.preventDefault();
      closeSheet();
    }
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && sheet && !sheet.hidden) {
      closeSheet();
    }
  });

  /* 7. Analytics: GA4 & Meta Pixel event tracking */
  root.addEventListener('click', e => {
    const t = e.target.closest('[data-track-cta]');
    if (!t) return;
    const action = t.dataset.trackCta;
    const city = t.dataset.trackCity || cityName;
    const store = t.dataset.trackStore || 'General';

    // Google Analytics 4
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'store_action', {
        action_type: action,
        city: city,
        store: store
      });
    }

    // Meta Pixel
    if (typeof window.fbq === 'function') {
      if (action === 'get_directions' || action === 'find_nearest') {
        window.fbq('trackCustom', 'FindLocation', { city: city, store: store });
      } else if (action === 'call' || action === 'whatsapp') {
        window.fbq('track', 'Contact', { city: city, store: store, method: action });
      }
    }
  });

  /* 8. Live Google Places API Review Rating Sync (if API key & Place ID configured) */
  const gmpApiKey = "{{ section.settings.google_places_api_key | escape }}";
  if (gmpApiKey) {
    root.querySelectorAll('.ksl-rating[data-place-id]').forEach(ratingEl => {
      const placeId = ratingEl.dataset.placeId;
      if (!placeId) return;
      fetch('https://places.googleapis.com/v1/places/' + encodeURIComponent(placeId) + '?fields=rating,userRatingCount&key=' + encodeURIComponent(gmpApiKey))
        .then(res => res.json())
        .then(data => {
          if (data && data.rating) {
            const score = Number(data.rating).toFixed(1);
            const count = data.userRatingCount || 0;
            const scoreEl = ratingEl.querySelector('b');
            const countEl = ratingEl.querySelector('.ksl-reviews-count');
            if (scoreEl) scoreEl.textContent = score;
            if (countEl) countEl.textContent = count + '+ reviews';
          }
        })
        .catch(() => {});
    });
  }
})();
</script>

