    border-color: #201747;
  }

  .ksl-cat-slider-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 2px 16px;
  }
  .ksl-cat-slider-track::-webkit-scrollbar { display: none; }
  .ksl-cat-card {
    flex: 0 0 250px;
    scroll-snap-align: start;
    background: #FFFFFF;
    border: 1px solid #ECE7DE;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 3px 12px rgba(0,0,0,0.03);
