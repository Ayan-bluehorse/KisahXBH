    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ksl-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(32, 23, 71, 0.1);
  }
  .ksl-card.is-nearest-highlight {
