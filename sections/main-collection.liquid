{%- liquid
  assign in_stock_total = 0
  for f in collection.filters
    if f.param_name == 'filter.v.availability'
      for v in f.values
        if v.value == '1'
          assign in_stock_total = v.count
        endif
      endfor
    endif
  endfor
-%}
{%- if in_stock_total > 0 -%}
  <script>
    (function() {
      try {
        var isBot = /bot|googlebot|crawler|spider|robot|crawling/i.test(navigator.userAgent);
        var search = window.location.search;
        if (!isBot && !search.includes('filter.v.availability')) {
          var p = new URLSearchParams(search);
          p.set('filter.v.availability', '1');
          var newUrl = window.location.pathname + '?' + p.toString() + window.location.hash;
          window.location.replace(newUrl);
        }
      } catch(e) {}
    })();
  </script>
{%- endif -%}

<div data-section-id="{{ section.id }}" data-cc-animate>


{%- liquid
  if section.settings.show_image_behind_heading and collection.image
    assign header_image_enabled = true
  else
    assign header_image_enabled = false
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by

  assign show_filters = section.settings.enable_filtering
  if collection.filters == empty
    assign show_filters = false
  endif
-%}

{%- liquid
  assign related_collections_count = 0
  if section.settings.related_collections != empty
    for loop_collection in section.settings.related_collections
      unless loop_collection.handle == collection.handle
        assign related_collections_count = related_collections_count | plus: 1
      endunless
    endfor
  endif
-%}

  
  
  
{%- if related_collections_count > 0 -%}
  {% capture related_collection_html %}
    {% if section.settings.related_collections_style == 'buttons' %}
      <div class="container{% if header_image_enabled %} container--not-mobile{% endif %} lightish-spaced-row-above">
      {% comment %}  <related-collection-link-buttons class="related-collection-links related-collection-links--buttons align-center kmk{% if header_image_enabled %} image-overlay__over{% endif %}" data-expander-btn-text="{{ 'sections.collection.view_all_related_collections' | t }}">
          {%- for loop_collection in section.settings.related_collections -%}
            {%- unless loop_collection.handle == collection.handle -%}
              <a class="btn btn--tertiary" href="{{ loop_collection.url }}">{{ loop_collection.title | escape }}</a>
            {%- endunless -%}
          {%- endfor -%}
        </related-collection-link-buttons> {% endcomment %}
      </div>
    {% else %}
      {% unless section.settings.rel_coll_gall_full_width %}
        <div class="container container--not-mobile lightish-spaced-row-above lightish-spaced-row-above--not-mobile{% if section.settings.rel_coll_grid_mobile == 'hide' %} desktop-only{% endif %}">
      {% endunless %}
      <div class="
        gallery
        gallery--height-adapt
        gallery--grid-desktop-{{ related_collections_count | at_most: 4 }}
        gallery--grid-mobile-{{ section.settings.rel_coll_grid_mobile }}
        {%- if section.settings.rel_coll_grid_mobile != 'hide' -%}
          {%- assign rel_coll_grid_mobile_int = section.settings.rel_coll_grid_mobile | plus: 0 -%}
          {%- if related_collections_count > rel_coll_grid_mobile_int %} gallery--mobile-carousel{% endif %}
        {%- endif -%}
        {%- if section.settings.rel_coll_gall_enable_margin %} gallery--with-margins{% endif %}
        related-collection-links
        related-collection-links--gallery
        {%- if section.settings.rel_coll_gall_full_width %} related-collection-links--is-full-width{% endif %}
        {%- if header_image_enabled %} related-collection-links--under-image-header{% endif %}
        {%- if section.settings.rel_coll_grid_mobile == 'hide' %} desktop-only{% endif %}">
        <carousel-slider class="carousel{% if section.settings.rel_coll_gall_mobile_layout == 'hide' %} desktop-only{% endif %}" inactive>
          <div class="slider slider--no-scrollbar" id="slider-{{ section.id }}">
            <div class="slider__grid">
              {%- for loop_collection in section.settings.related_collections -%}
                {%- unless loop_collection.handle == collection.handle -%}
                  <div class="slider__item
                      gallery__item
                      image-overlay
                      image-overlay--bg-{{ section.settings.rel_coll_gall_overlay_style }}
                      image-overlay--edge-boxes
                      {% unless section.settings.rel_coll_gall_full_width and section.settings.rel_coll_gall_enable_margin == false %}image-overlay--edge-boxes--pad-to-corner{% endunless %}
                      ">
                    <a class="image-overlay__image-link" href="{{ loop_collection.url }}">
                      <div class="image-overlay__image gallery__image img-stretch">
                        {%- liquid
                          if loop_collection.featured_image
                            assign rel_coll_image = loop_collection.featured_image
                          else
                            assign rel_coll_image = false
                          endif
                          assign custom_aspect_ratio = section.settings.rel_coll_gall_aspect_ratio | times: 1.0
                        -%}
                        {%- if rel_coll_image -%}
                          {%- liquid
                            assign desktop_image_cols = section.settings.grid | at_most: section.blocks.size
                          -%}
                          {%- render 'image' with rel_coll_image, custom_aspect_ratio: custom_aspect_ratio, custom_crop: section.settings.image_position, size_cols_mobile: section.settings.rel_coll_grid_mobile, size_cols_desktop: desktop_image_cols -%}
                        {%- else -%}
                          <div class="placeholder-image dark">
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {%- endif -%}
                      </div>

                      <div class="text-overlay text-overlay--v-{{ section.settings.rel_coll_gall_text_alignment | split: ' ' | first }} text-overlay--h-{{ section.settings.rel_coll_gall_text_alignment | split: ' ' | last }} image-overlay__over">
                        <div class="text-overlay__inner">
                          <div class="text-overlay__text">
                            <h2 class="text-overlay__title h4">{{ loop_collection.title | escape }}</h2>
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="slider-nav slider-nav--floating desktop-only no-js-hidden">
            <button type="button" class="slider-nav__btn has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
              {%- render 'icon-chevron-left', stroke_width: 1.3 -%}
            </button>
            <button type="button" class="slider-nav__btn has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
              {%- render 'icon-chevron-right', stroke_width: 1.3 -%}
            </button>
          </div>
        </carousel-slider>
      </div>
      {% unless section.settings.rel_coll_gall_full_width %}
        </div>
      {% endunless %}
    {% endif %}
  {% endcapture %}
{%- endif -%}

{% if header_image_enabled %}
  {%- liquid
    assign show_header = false
    if section.settings.show_title
      assign show_header = true
    endif
    if related_collections_count > 0 and section.settings.related_collections_style == 'buttons'
      assign show_header = true
    endif
  -%}
  {%- if show_header -%}
    <div class="page-header page-header--with-background img-fill image-overlay image-overlay--bg-{{ section.settings.overlay_style }} page-header--padded-{{ section.settings.heading_image_height }}">
      <div class="image-overlay__image">
        {%- render 'image' with collection.image, loading: 'eager', fetchpriority: 'high' -%}
      </div>
      <div class="text-overlay text-overlay--inline text-overlay--v-center text-overlay--h-center image-overlay__over" data-cc-animate data-cc-animate-delay="0.2s">
        <div class="text-overlay__inner">
          <div class="text-overlay__text">
            {%- if section.settings.show_title -%}
              <h1 class="text-overlay__title super-large-text">{{ collection.title | escape }}</h1>
            {%- endif -%}

            {%- if related_collections_count > 0 and section.settings.related_collections_style == 'buttons' -%}
              {{ related_collection_html }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
{% else %}
  {{ related_collection_html }}
  {%- liquid
    assign show_header = false
    if section.settings.show_title
      assign show_header = true
    endif
  -%}
  {%- if show_header -%}
    <div class="page-header page-header--with-upper-spacing">
      <div class="container">
        
        {%- if section.settings.show_title -%}
          <h1 class="pagetitle h3">{{ collection.title | escape }}</h1>
        {%- endif -%}
      </div>
    </div>
  {% endif %}
{% endif %}

  {%- if related_collections_count > 0 and header_image_enabled and section.settings.related_collections_style != 'buttons' -%}
    {{ related_collection_html }}
  {%- endif -%}

  <div class="container{% if settings.use_fullwidth_layout %} container--no-max{% endif %}{% if show_header == false %} lightly-spaced-row-above{% endif %}">
    {% assign col_desc_lower = collection.description | downcase %}
    {% if col_desc_lower contains '<h1' %}
      <div class="col-title">
        {{ collection.title }}
      </div>
    {% else %}
      <h1 class="col-title">
        {{ collection.title }}
      </h1>
    {% endif %}

    {% liquid
      assign show_filters = section.settings.enable_filtering
      if collection.filters == empty
        assign show_filters = false
      endif

      assign filter_count = 0
      for filter in collection.filters
        if filter.param_name == 'filter.v.availability'
          continue
        endif
        assign filter_count = filter_count | plus: filter.active_values.size
        if filter.type == 'price_range'
          if filter.min_value.value != nil or filter.max_value.value != nil
            assign filter_count = filter_count | plus: 1
          endif
        endif
      endfor
    %}

    {% paginate collection.products by section.settings.coll_num_per_page_int %}
    {%- liquid
      assign in_stock_total = 0
      for f in collection.filters
        if f.param_name == 'filter.v.availability'
          for v in f.values
            if v.value == '1'
              assign in_stock_total = v.count
            endif
          endfor
        endif
      endfor
    -%}
    {%- liquid
      if filter_count == 0
        assign collection_style_count = collection.all_products_count | default: paginate.items
      else
        assign collection_style_count = paginate.items
      endif
    -%}
    <div class="kisah-ctrl" data-ajax-container>
      <div class="kisah-ctrl__n"><b>{{ collection_style_count }}</b> styles</div>
      {%- if section.settings.show_sort -%}
        <button class="kisah-ctrl__btn" id="kisahSortBtn" type="button">
          <svg viewBox="0 0 24 24"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg>
          Sort
        </button>
      {%- endif -%}
      {%- if section.settings.show_sort and show_filters -%}
        <span class="kisah-ctrl__rule"></span>
      {%- endif -%}
      {%- if show_filters -%}
        <button class="kisah-ctrl__btn kisah-ctrl__btn--filter" id="kisahFilterBtn" type="button" data-any="{% if filter_count > 0 %}1{% else %}0{% endif %}">
          <svg viewBox="0 0 24 24"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
          Filter{% if filter_count > 0 %}<span class="kisah-ctrl__pip">{{ filter_count }}</span>{% endif %}
        </button>
      {%- endif -%}
    </div>

    {%- if filter_count > 0 -%}
      <div class="kisah-applied" id="kisahApplied" data-ajax-container>
        {%- for filter in collection.filters -%}
          {%- if filter.param_name == 'filter.v.availability' -%}
            {%- continue -%}
          {%- endif -%}
          {%- for value in filter.active_values -%}
            <a class="kisah-achip" href="{{ value.url_to_remove }}">
              {{ value.label }}
              <span class="close-x">&times;</span>
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil -%}
            <a class="kisah-achip" href="{{ filter.url_to_remove }}">
              {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }}
              <span class="close-x">&times;</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
        <a class="kisah-achip kisah-achip--clear" href="{{ collection.url }}{% if in_stock_total > 0 %}?filter.v.availability=1{% endif %}">Clear all</a>
      </div>
    {%- endif -%}

    <filter-container class="filter-container filter-container--side{% if section.settings.collapse_tag_sidebar_by_default == false %} filter-container--show-filters-desktop{% endif %}" data-ajax-filtering="{{ settings.ajax_products }}" data-filter-section-id="{{ section.id }}">
      {% if section.settings.show_sort or show_filters %}
        {% render 'faceted-filters', filter_context: collection, clear_url: collection.url, current_sort: current_sort, total_count: collection_style_count, in_stock_total: in_stock_total %}
      {% endif %}

      <div class="filters-adjacent collection-listing" data-ajax-container>
        {% if collection.products.size == 0 %}
          <h5 class="align-centre fully-spaced-row">{{ 'sections.collection.empty' | t }}</h5>
        {% else %}
  {%- liquid
    if settings.prod_thumb_shape == 'portrait-23'
      assign chosen_aspect_ratio = 0.67
    elsif settings.prod_thumb_shape == 'portrait-45'
      assign chosen_aspect_ratio = 0.8
    elsif settings.prod_thumb_shape == 'square'
      assign chosen_aspect_ratio = 1.0
    elsif settings.prod_thumb_shape == 'landscape-54'
      assign chosen_aspect_ratio = 1.25
    elsif settings.prod_thumb_shape == 'landscape-32'
      assign chosen_aspect_ratio = 1.50
    elsif settings.prod_thumb_shape == 'tallest'
      assign chosen_aspect_ratio = 99
    else
      assign chosen_aspect_ratio = 0
    endif

    assign collection_product_index = paginate.current_offset
    assign collection_products_total = paginate.items
  -%}

  {%- liquid
    assign size_map = 'XS:36,S:38,M:40,L:42,XL:44,XXL:46,3XL:48,4XL:50,5XL:52,6XL:54,7XL:56' | split: ','
    assign mapped_s = ''
    assign mapped_m = ''
    assign mapped_l = ''
    assign mapped_xl = ''

    for pair in size_map
      assign p = pair | split: ':'
      assign p_letter = p[0] | downcase | strip
      assign p_number = p[1] | strip

      if p_letter == 's'
        assign mapped_s = p_number
      elsif p_letter == 'm'
        assign mapped_m = p_number
      elsif p_letter == 'l'
        assign mapped_l = p_number
      elsif p_letter == 'xl'
        assign mapped_xl = p_number
      endif
    endfor
  -%}

  <div
    id="product-grid"
    class="product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}"
    data-primary-product-grid
    data-current-page="{{ paginate.current_page }}"
    data-total-pages="{{ paginate.pages }}"
    {% if paginate.next %}data-next-page-url="{{ paginate.next.url | escape }}"{% endif %}
  >
    {%- comment -%}
      PASS 1 — In-stock products (available_variants > 0), rendered first.
      PASS 2 — Out-of-stock products, rendered after with data-stock-tier="out-of-stock".
      Sorting is done server-side in Liquid so no JS layout shift on first paint.
    {%- endcomment -%}

    {%- liquid
      assign in_stock_count = 0
    -%}

    {%- comment -%}---- PASS 1: IN-STOCK ----{%- endcomment -%}
    {% for product in collection.products %}
      {%- liquid
        assign total_variants = product.variants.size
        assign available_variants = product.variants | where: 'available', true | size
      -%}
      {% if available_variants > 0 %}
        {%- liquid
          assign size_s_available = false
          assign size_m_available = false
          assign size_l_available = false
          assign size_xl_available = false

          for option in product.options_with_values
            assign option_name = option.name | downcase | strip
            if option_name == 'size'
              for value in option.values
                assign size_value = value | downcase | strip

                if size_value == 's' or size_value == 'small' or size_value == mapped_s
                  if value.available
                    assign size_s_available = true
                  endif
                endif

                if size_value == 'm' or size_value == 'medium' or size_value == mapped_m
                  if value.available
                    assign size_m_available = true
                  endif
                endif

                if size_value == 'l' or size_value == 'large' or size_value == mapped_l
                  if value.available
                    assign size_l_available = true
                  endif
                endif

                if size_value == 'xl' or size_value == 'extra large' or size_value == mapped_xl
                  if value.available
                    assign size_xl_available = true
                  endif
                endif

                if size_s_available and size_m_available and size_l_available and size_xl_available
                  break
                endif
              endfor
              break
            endif
          endfor

          assign prioritised_loading = false
          if in_stock_count < section.settings.grid
            assign prioritised_loading = true
          endif
          assign in_stock_count = in_stock_count | plus: 1
          assign collection_product_index = collection_product_index | plus: 1
        -%}

        <div
          class="stock-sort-item"
          data-stock-sort-item
          data-stock-tier="primary"
          data-product-handle="{{ product.handle }}"
          data-available-variants="{{ available_variants }}"
          data-total-variants="{{ total_variants }}"
          data-option-name="Size"
          data-product-type="{{ product.type | downcase | strip | escape }}"
          data-size-s-available="{{ size_s_available }}"
          data-size-m-available="{{ size_m_available }}"
          data-size-l-available="{{ size_l_available }}"
          data-size-xl-available="{{ size_xl_available }}"
        >
          {% render 'product-block',
            product: product,
            custom_aspect_ratio: chosen_aspect_ratio,
            animate: false,
            prioritised_loading: prioritised_loading,
            product_index: collection_product_index,
            products_total: collection_products_total
          %}
        </div>
      {% endif %}
    {% endfor %}

    {%- comment -%}---- PASS 2: OUT-OF-STOCK (dimmed, at the bottom) ----{%- endcomment -%}
    {% for product in collection.products %}
      {%- liquid
        assign total_variants = product.variants.size
        assign available_variants = product.variants | where: 'available', true | size
      -%}
      {% if available_variants == 0 %}
        {%- liquid
          assign collection_product_index = collection_product_index | plus: 1
        -%}

        <div
          class="stock-sort-item stock-sort-item--oos"
          data-stock-sort-item
          data-stock-tier="out-of-stock"
          data-product-handle="{{ product.handle }}"
          data-available-variants="0"
          data-total-variants="{{ total_variants }}"
          data-option-name="Size"
          data-product-type="{{ product.type | downcase | strip | escape }}"
          data-size-s-available="false"
          data-size-m-available="false"
          data-size-l-available="false"
          data-size-xl-available="false"
        >
          {% render 'product-block',
            product: product,
            custom_aspect_ratio: chosen_aspect_ratio,
            animate: false,
            prioritised_loading: false,
            product_index: collection_product_index,
            products_total: collection_products_total
          %}
        </div>
      {% endif %}
    {% endfor %}

  </div>

  <script>
    (function() {
      function applyLandingPageOrder() {
        try {
          var params = new URLSearchParams(window.location.search);
          var pinnedStr = params.get('pinned');
          if (!pinnedStr) {
            pinnedStr = sessionStorage.getItem('cp_pinned_handles');
          }
          if (!pinnedStr) return;

          var handles = pinnedStr.split(',').map(function(h) { return h.trim(); }).filter(Boolean);
          if (!handles || handles.length === 0) return;

          var grid = document.getElementById('product-grid');
          if (!grid) return;

          // Re-order matching items to the very top in the exact order they appeared on the LP
          for (var i = handles.length - 1; i >= 0; i--) {
            var handle = handles[i];
            var card = grid.querySelector('.stock-sort-item[data-product-handle="' + handle + '"]') ||
                       grid.querySelector('#jump-id' + handle);
            if (card) {
              var parentCard = card.closest('.stock-sort-item') || card;
              if (parentCard && parentCard.parentElement === grid) {
                grid.insertBefore(parentCard, grid.firstElementChild);
              }
            }
          }
        } catch(err) {
          console.error('[Pinned Products Order Error]', err);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyLandingPageOrder);
      } else {
        applyLandingPageOrder();
      }
    })();
  </script>


  {% render 'infinite-scroll', paginate: paginate %}
  <div
    id="low-stock-product-grid-{{ section.id }}"
    class="product-grid low-stock-product-grid product-grid--per-row-{{ section.settings.grid }} product-grid--per-row-mob-{{ settings.prod_thumb_mob_per_row }}"
    data-low-stock-product-grid
    hidden
  ></div>
        {% endif %}
      </div>
    </filter-container>
{% endpaginate %}
  {% comment %}
  {% if collection.description != blank %}
      <div class="col-description col-description--bottom rte cf" data-cc-animate>
        {{ collection.description }}
    </div>
  {% endif %}
  {% endcomment %}
</div>
</div>

{% schema %}
{
  "name": "Collection pages",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image_behind_heading",
      "label": "Show collection image behind title",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_image_height",
      "label": "Heading image height",
      "options": [
        {
          "value": "small",
          "label": "Compact"
        },
        {
          "value": "medium",
          "label": "Small"
        },
        {
          "value": "large",
          "label": "Medium"
        },
        {
          "value": "huge",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "id": "overlay_style",
      "type": "select",
      "label": "Overlay style",
      "default": "shadow",
      "options": [
        {
          "value": "full",
          "label": "Tint"
        },
        {
          "value": "box",
          "label": "Box"
        },
        {
          "value": "shadow",
          "label": "Text shadow"
        },
        {
          "value": "full image-overlay--bg-shadow",
          "label": "Text shadow and tint"
        },
        {
          "value": "no_background",
          "label": "No background"
        }
      ]
    },
    {
      "type": "select",
      "id": "coll_desc_pos",
      "label": "Description position",
      "default": "above",
      "options": [
        {
          "value": "above",
          "label": "Below collection title"
        },
        {
          "value": "below",
          "label": "Below products"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "coll_num_per_page_int",
      "min": 16,
      "max": 50,
      "step": 2,
      "label": "Number of products to show per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendors",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_total",
      "label": "Show product total",
      "default": true
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "[Customize filters](/admin/menus)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collapse_tag_sidebar_by_default",
      "label": "Collapse filter column",
      "default": false
