<style>
.{{ section.settings.main_class }} {
  padding: 40px 20px 10px;
}
.review-slider__wrapper {
  max-width: 1240px;
  margin: 0 auto;
}
.review-slider__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}
.review-slider__title {
    margin: 0;
    text-align: center;
    font-family: 'Generis Sans W01 Bold';
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    text-transform: uppercase;
    color: black;
}
.review-slider__top .swiper-navigation {
  display: flex;
  gap: 8px;
  position: relative;
  right: 50px;
  align-items: center;
}
.review-slider__top .swiper-button-prev,
.review-slider__top .swiper-button-next {
    position: static !important; 
    color: #201747;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    font-weight: bolder;
}
.swiper-button-prev::after,
.swiper-button-next::after {
  font-size: 22px;
}

.swiper-pagination {
  display: none;
  text-align: center;
  margin-top: 20px;
  position: relative;
}

.review-card {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 16px;
    height: 100%;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: 10px;
}
.review-card__header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}
.review-card__avatar {
    width: 57px;
    height: 57px;
    border-radius: 50%;
    object-fit: cover;
}
.review-card__name {
    color: #363636;
    font-family: Gabarito;
    font-size: 24px;
    font-style: normal;
    font-weight: 500;
}
.review-card__text {
    margin: 5px 0;
    color: #363636;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: 'Generis Sans W01 Regular';
    font-size: 21px;
    font-style: normal;
    font-weight: 400;
    line-height: 16px;
}
.review-card__stars {
  display: flex;
  gap: 4px;
  margin-top: 22px;
}
@media (max-width: 768px) {
  .{{ section.settings.main_class }} {
  padding: 20px 10px 0;
  }
  .swiper-navigation {
    display: none !important;
  }
  .swiper-pagination {
    display: block !important;
  }
  span.swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #201747;
}
  .review-card {
    justify-content: flex-start;
    gap: 10px;
}
  .review-slider__title {
    font-size: 21px;
}
  .review-card__name {
    font-size: 18px;
}
  .review-card__text {
    margin: 2px 0;
    font-size: 16px;
}
  .review-card__stars {
    margin-top: 15px;
}
   .review-swiper-{{ section.id }} .swiper-slide {
    width: 90%;
  }
}
</style>



<section class="{{ section.settings.main_class }}">
  <div class="review-slider__wrapper">
    <div class="review-slider__top">
      <h2 class="review-slider__title">{{ section.settings.title }}</h2>
      {% if section.blocks.size > 3 %}
      <div class="swiper-navigation nav-{{ section.id }}">
        <div class="swiper-button-prev prev-{{ section.id }}"></div>
        <div class="swiper-button-next next-{{ section.id }}"></div>
      </div>
      {% endif %}
    </div>

    <div class="swiper review-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="review-card">
              <div class="review-card-left">
              {% if block.settings.avatar %}
              <img class="review-card__avatar" width="{{ block.settings.avatar.width }}" height="{{ block.settings.avatar.height }}" loading="lazy" src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name }}">
              {% endif %}
              </div>
            <div class="review-card-left">
              <strong class="review-card__name">{{ block.settings.name }}</strong>

            <p class="review-card__text">{{ block.settings.review }}</p>
            <div class="review-card__stars">
              {% for i in (1..5) %}
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" style="color:#190B3F;">
                <path d="M10 15l-5.878 3.09L5.73 11.545.854 7.91l6.57-.955L10 1l2.576 5.955 6.57.955-4.876 3.636 1.608 6.545z"/>
              </svg>
              {% endfor %}
                </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="swiper-pagination pagination-{{ section.id }}"></div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const swiperContainer = document.querySelector(".review-swiper-{{ section.id }}");
  const totalSlides = swiperContainer.querySelectorAll(".swiper-slide").length;

  new Swiper(swiperContainer, {
    slidesPerView: 'auto',
centeredSlides: true,
spaceBetween: 2,
loop: false,
    pagination: totalSlides > 1 ? {
      el: ".pagination-{{ section.id }}",
      clickable: true
    } : {},
    navigation: {
      nextEl: ".next-{{ section.id }}",
      prevEl: ".prev-{{ section.id }}"
    },
    breakpoints: {
      768: {
        slidesPerView: 3,
    centeredSlides: false,
    spaceBetween: 24,
        loop: false
      }
    }
  });
});
</script>

                  {% schema %}
{
  "name": "Customer Review Slider",
  "tag": "section",
  "class": "customer-review-slider",
  "settings": [
    {
      "type": "text",
      "id": "main_class",
      "label": "Main Class (for reusing section)",
      "default": "customer-review-slider-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "WHAT OUR CUSTOMERS SAY"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "John D."
        },
        {
          "type": "text",
          "id": "review",
          "label": "Review Text",
          "default": "This is a great product!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Review Slider",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
