        {
          "type": "story",
          "settings": {
            "fallback_image_url": "https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/customer-story-2.jpeg",
            "badge": "02",
            "label": "THE BAARAT",
            "title": "The baarat, in full colour.",
