          "default": "SEE THE EDIT"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Stories",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "fallback_image_url": "https://kisah-festive-home-mobile.berry-ape-8136.chatgpt.site/assets/customer-story-1.png",
