<script>
(function() {
  function parseTimeToMinutes(val) {
    if (!val) return null;
    var str = String(val).trim();
    if (/^\d+$/.test(str)) {
      var num = parseInt(str, 10);
      if (num <= 1440) return num;
    }
    var m = str.match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i);
    if (!m) return null;
    var h = parseInt(m[1], 10);
    var min = m[2] ? parseInt(m[2], 10) : 0;
    var ampm = m[3] ? m[3].toUpperCase() : null;
    if (ampm === 'PM' && h < 12) h += 12;
    if (ampm === 'AM' && h === 12) h = 0;
    return h * 60 + min;
  }

  function formatTimeFromMinutes(minutes) {
    var h = Math.floor(minutes / 60);
    var mm = minutes % 60;
    var ap = h < 12 ? 'AM' : 'PM';
    var hh = h % 12 || 12;
    return hh + (mm ? ':' + ('0' + mm).slice(-2) : '') + ' ' + ap;
  }

  function initStoreLocator(sectionContainer) {
    if (!sectionContainer) return;
    var $ = function(s) { return sectionContainer.querySelector(s); };
    var $$ = function(s) { return sectionContainer.querySelectorAll(s); };

    var searchIn = $('.ksl-search-input');
    var geoBtn = $('.ksl-geo-btn');
    var geoMsg = $('.ksl-geo-status');
    var emptyMsg = $('.ksl-empty-state');
    var tabs = $$('.ksl-tab-btn');
    var stores = $$('.ksl-store-card');
    var soonCards = $$('.ksl-soon-card');
    var cityGroups = $$('.ksl-city-group');
    var openBand = $('.ksl-open-band');
    var soonBand = $('.ksl-soon-band');
    var tabsContainer = $('.ksl-city-tabs');
    var currentFilter = 'all';

    // Live Badge computation (Open Now vs Closed)
    function updateBadges() {
      var now = new Date();
      var nowMins = now.getHours() * 60 + now.getMinutes();

      stores.forEach(function(st) {
        var openMinutes = parseTimeToMinutes(st.dataset.open) || 630;
        var closeMinutes = parseTimeToMinutes(st.dataset.close) || 1290;
        var pill = st.querySelector('.ksl-live-status-pill');
        var txt = st.querySelector('.ksl-status-text');
        if (!pill || !txt) return;

        if (nowMins >= openMinutes && nowMins < closeMinutes) {
          pill.classList.remove('is-closed');
          txt.textContent = 'Open now';
        } else {
          pill.classList.add('is-closed');
          txt.textContent = 'Closed · Opens ' + formatTimeFromMinutes(openMinutes);
        }
      });
    }

    // Filter & Search Functionality
    function applyFilters() {
      var q = searchIn ? searchIn.value.trim().toLowerCase() : '';
      var totalOpenVisible = 0;
      var totalSoonVisible = 0;

      cityGroups.forEach(function(group) {
        var city = (group.dataset.city || '').trim().toLowerCase();
        var matchesTab = (currentFilter === 'all' || city === currentFilter.toLowerCase());
        var visibleInCity = 0;

        group.querySelectorAll('.ksl-store-card').forEach(function(st) {
          var sName = (st.dataset.name || '').toLowerCase();
          var sCity = (st.dataset.city || '').toLowerCase();
          var matchesSearch = (!q || (sName + ' ' + sCity).indexOf(q) > -1);
          var isVisible = matchesTab && matchesSearch;

          st.classList.toggle('ksl-is-hidden', !isVisible);
          if (isVisible) visibleInCity++;
        });

        group.classList.toggle('ksl-is-hidden', visibleInCity === 0);
        var ccount = group.querySelector('.ksl-city-count');
        if (ccount) ccount.textContent = visibleInCity + (visibleInCity === 1 ? ' Location' : ' Locations');
        totalOpenVisible += visibleInCity;
      });

      if (soonBand) {
        soonCards.forEach(function(card) {
          var pName = (card.dataset.name || '').toLowerCase();
          var pCity = (card.dataset.city || '').trim().toLowerCase();
          var matchesTab = (currentFilter === 'all' || pCity === currentFilter.toLowerCase());
          var matchesSearch = (!q || (pName + ' ' + pCity).indexOf(q) > -1);
          var isVisible = matchesTab && matchesSearch;

          card.classList.toggle('ksl-is-hidden', !isVisible);
          if (isVisible) totalSoonVisible++;
        });
        soonBand.classList.toggle('ksl-is-hidden', totalSoonVisible === 0);
      }

      if (openBand) {
        openBand.classList.toggle('ksl-is-hidden', totalOpenVisible === 0);
      }

      if (emptyMsg) {
        emptyMsg.classList.toggle('ksl-is-hidden', (totalOpenVisible + totalSoonVisible) !== 0);
      }
    }

    // City Tab Clicks
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        currentFilter = (tab.dataset.filter || 'all').trim();
        if (searchIn) searchIn.value = '';
        applyFilters();

        // Smoothly center the active tab into view
        if (tabsContainer) {
          var offset = tab.offsetLeft - (tabsContainer.clientWidth / 2) + (tab.clientWidth / 2);
          tabsContainer.scrollTo({ left: offset, behavior: 'smooth' });
        }
      });
    });

    if (searchIn) {
      searchIn.addEventListener('input', applyFilters);
    }

    // Geolocation Nearest Store Finder
    if (geoBtn) {
      geoBtn.addEventListener('click', function() {
        if (!navigator.geolocation) {
          if (geoMsg) { geoMsg.textContent = 'Geolocation not supported in your browser.'; geoMsg.classList.remove('ksl-is-hidden'); }
          return;
        }
        if (geoMsg) { geoMsg.textContent = 'Locating your nearest store…'; geoMsg.classList.remove('ksl-is-hidden'); }

        navigator.geolocation.getCurrentPosition(function(pos) {
          var userLat = pos.coords.latitude;
          var userLng = pos.coords.longitude;
          var closestCity = null;
          var shortestDist = 1e12;

          stores.forEach(function(st) {
            var lat = parseFloat(st.dataset.lat);
            var lng = parseFloat(st.dataset.lng);
            if (!isNaN(lat) && !isNaN(lng)) {
              var d = Math.pow(userLat - lat, 2) + Math.pow(userLng - lng, 2);
              if (d < shortestDist) {
                shortestDist = d;
                closestCity = st.dataset.city;
              }
            }
          });

          if (closestCity) {
            var targetTab = sectionContainer.querySelector('.ksl-tab-btn[data-filter="' + closestCity + '"]');
            if (targetTab) {
              targetTab.click();
              if (geoMsg) geoMsg.textContent = 'Nearest city identified: ' + closestCity;
            }
          }
        }, function() {
          if (geoMsg) geoMsg.textContent = 'Unable to determine location. Please choose a city tab above.';
        }, { timeout: 8000 });
      });
    }

    updateBadges();
    applyFilters();
    setInterval(updateBadges, 60000);
  }

  document.addEventListener('DOMContentLoaded', function() {
    var locator = document.querySelector('.kisah-store-locator-section');
    if (locator) initStoreLocator(locator);
  });

  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.classList.contains('kisah-store-locator-section')) {
      initStoreLocator(e.target);
    }
  });
})();
</script>

