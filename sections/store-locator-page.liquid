{%- liquid
  comment
    Kisah Dynamic Store Locator Section
    - 100% Dynamic Shopify Blocks Architecture
    - Pure Theme Colors (#201747 Navy Buttons & White Text)
    - Finger-Scroll City Filter Tabs with Auto-Centering
    - Live Status Computation (Open Now vs Closed)
    - Edge-to-Edge Store Images (4:3 Aspect Ratio)
    - Lead Capture Banner linking to Google Form
  endcomment

  assign all_stores_count = 0
  assign total_open_count = 0
  assign total_soon_count = 0
  assign city_names_raw = ''

  for block in section.blocks
    if block.type != 'store'
      continue
    endif
    assign all_stores_count = all_stores_count | plus: 1
    
    if block.settings.is_coming_soon
      assign total_soon_count = total_soon_count | plus: 1
    else
      assign total_open_count = total_open_count | plus: 1
    endif

    assign c_name = block.settings.city | strip
    if c_name != blank
      if city_names_raw == ''
        assign city_names_raw = c_name
      else
        assign check_cities = city_names_raw | split: '|||'
        assign city_exists = false
        for ec in check_cities
          if ec == c_name
            assign city_exists = true
            break
          endif
        endfor
        unless city_exists
          assign city_names_raw = city_names_raw | append: '|||' | append: c_name
        endunless
      endif
    endif
  endfor

  assign unique_cities = city_names_raw | split: '|||'
  assign total_open_cities = 0
  for c in unique_cities
    assign c_has_open = false
    for block in section.blocks
      assign b_city = block.settings.city | strip
      if block.type == 'store' and b_city == c and block.settings.is_coming_soon == false
        assign c_has_open = true
        break
      endif
    endfor
    if c_has_open
      assign total_open_cities = total_open_cities | plus: 1
    endif
  endfor

  assign form_url = section.settings.google_form_url | default: 'https://docs.google.com/forms/d/1D_IHN5sLwqo8bpLgqt6PuTqcn0qGY8vFF6Wdyncte-I/viewform'
  if form_url contains '/edit'
    assign form_url = form_url | replace: '/edit', '/viewform'
  endif
-%}

<div class="kisah-store-locator-section" id="StoreLocator-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container container--large">
    <!-- Header -->
    <header class="ksl-header">
      
      <h1 class="ksl-main-title">{{ section.settings.heading | default: 'Store Locator' }}</h1>
      <p class="ksl-subtitle">
        {% if section.settings.subheading != blank %}
          {{ section.settings.subheading }}
        {% else %}
          <strong>{{ total_open_count }} flagship stores</strong> open across <strong>{{ total_open_cities }} cities</strong>. Walk in to experience tailored luxury fit and personal styling.
        {% endif %}
      </p>
    </header>

    <!-- Filter & Search Toolbar with Native Finger Scroll Tabs -->
    <div class="ksl-sticky-bar">
      <div class="ksl-toolbar-inner">
        <!-- City Pills Finger Scroll Bar -->
        <div class="ksl-city-tabs" role="tablist" aria-label="Filter stores by city">
          <button type="button" class="ksl-tab-btn is-active" data-filter="all" role="tab" aria-selected="true">
            All ({{ all_stores_count }})
          </button>
          {% for c in unique_cities %}
            {%- liquid
              assign city_total = 0
              for block in section.blocks
                assign b_city = block.settings.city | strip
                if block.type == 'store' and b_city == c
                  assign city_total = city_total | plus: 1
                endif
              endfor
            -%}
            <button type="button" class="ksl-tab-btn" data-filter="{{ c | escape }}" role="tab" aria-selected="false">
              {{ c }} ({{ city_total }})
            </button>
          {% endfor %}
        </div>

        {% if section.settings.enable_search %}
          <div class="ksl-search-box">
            <div class="ksl-search-wrap">
              <svg class="ksl-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input class="ksl-search-input" type="search" placeholder="Search store or city..." autocomplete="off" aria-label="Search store or city">
            </div>
            {% if section.settings.enable_geo %}
              <button type="button" class="ksl-geo-btn" title="Find nearest store to me" aria-label="Find nearest store to me">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                </svg>
                <span>Near Me</span>
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>
      <p class="ksl-geo-status ksl-is-hidden" aria-live="polite"></p>
    </div>

    <!-- BAND 1: Open Flagship Stores -->
    <div class="ksl-stores-band ksl-open-band">
      <div class="ksl-band-header">
        <h2 class="ksl-band-title">{{ section.settings.open_heading | default: 'Open Now' }}</h2>
        <span class="ksl-band-badge">{{ total_open_count }} {% if total_open_count == 1 %}Store Active{% else %}Stores Active{% endif %}</span>
      </div>

      {% for c in unique_cities %}
        {%- liquid
          assign c_open_count = 0
          for block in section.blocks
            assign b_city = block.settings.city | strip
            if block.type == 'store' and b_city == c and block.settings.is_coming_soon == false
              assign c_open_count = c_open_count | plus: 1
            endif
          endfor
        -%}
        {% if c_open_count > 0 %}
          <div class="ksl-city-group" data-city="{{ c | escape }}">
            <div class="ksl-city-divider">
              <h3 class="ksl-city-title">{{ c }}</h3>
              <span class="ksl-city-count">{{ c_open_count }} {% if c_open_count == 1 %}Location{% else %}Locations{% endif %}</span>
            </div>
            
            <div class="ksl-cards-grid">
              {% for block in section.blocks %}
                {%- liquid
                  assign b_city = block.settings.city | strip
                  assign open_val = block.settings.open_time | default: '10:30 AM'
                  assign close_val = block.settings.close_time | default: '09:30 PM'
                -%}
                {% if block.type == 'store' and b_city == c and block.settings.is_coming_soon == false %}
                  <div
                    class="ksl-store-card"
                    data-name="{{ block.settings.name | escape }}"
                    data-city="{{ b_city | escape }}"
                    data-open="{{ open_val | escape }}"
                    data-close="{{ close_val | escape }}"
                    data-lat="{{ block.settings.city_lat }}"
                    data-lng="{{ block.settings.city_lng }}"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.image != blank %}
                      <div class="ksl-card-image-wrap">
                        <img
                          src="{{ block.settings.image | image_url: width: 800 }}"
                          alt="{{ block.settings.name | escape }}"
                          loading="lazy"
                          width="400"
                          height="280"
                        >
                      </div>
                    {% endif %}

                    <div class="ksl-card-body">
                      <div class="ksl-card-header">
                        <div class="ksl-live-status-pill">
                          <span class="ksl-status-dot"></span>
                          <span class="ksl-status-text">Open now</span>
                        </div>
                      </div>

                      <div class="ksl-card-content">
                        <h4 class="ksl-store-name">{{ block.settings.name }}</h4>
                        <p class="ksl-store-address">{{ block.settings.address }}</p>

                        {% if block.settings.phone != blank %}
                          <div class="ksl-store-phone">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                            </svg>
                            <span>Ph: <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' }}">{{ block.settings.phone }}</a></span>
                          </div>
                        {% endif %}
                        
                        <div class="ksl-store-timing">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                          </svg>
                          <span>{{ block.settings.hours_label | default: '10:30 AM – 9:30 PM (All Days)' }}</span>
                        </div>

                        <div class="ksl-card-actions">
                          {% if block.settings.maps_url != blank %}
                            <a href="{{ block.settings.maps_url }}" target="_blank" rel="noopener" class="ksl-btn-directions">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                              </svg>
                              <span>Directions</span>
                            </a>
                          {% else %}
                            <a href="https://maps.google.com/?q=Kisah+{{ block.settings.name | url_encode }}+{{ b_city | url_encode }}" target="_blank" rel="noopener" class="ksl-btn-directions">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                              </svg>
                              <span>Directions</span>
                            </a>
                          {% endif %}

                          {% if block.settings.phone != blank %}
                            <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' }}" class="ksl-btn-call" aria-label="Call {{ block.settings.name }}">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                              </svg>
                              <span>Call</span>
                            </a>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- BAND 2: Upcoming Stores -->
    <div class="ksl-stores-band ksl-soon-band">
      <div class="ksl-band-header">
        <h2 class="ksl-band-title">{{ section.settings.soon_heading | default: 'Opening Soon' }}</h2>
        <span class="ksl-band-badge">{{ total_soon_count }} Locations Planned</span>
      </div>
      
      <div class="ksl-soon-grid">
        {% for c in unique_cities %}
          {% for block in section.blocks %}
            {%- assign b_city = block.settings.city | strip -%}
            {% if block.type == 'store' and b_city == c and block.settings.is_coming_soon %}
              <div
                class="ksl-soon-card"
                data-name="{{ block.settings.name | escape }}"
                data-city="{{ b_city | escape }}"
                data-lat="{{ block.settings.city_lat }}"
                data-lng="{{ block.settings.city_lng }}"
                {{ block.shopify_attributes }}
              >
                <div class="ksl-soon-info">
                  <h4 class="ksl-soon-name">{{ block.settings.name }}</h4>
                  <span class="ksl-soon-city">{{ c }}</span>
                </div>
                <span class="ksl-soon-tag">Coming Soon</span>
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    <!-- Empty Search State -->
    <div class="ksl-empty-state ksl-is-hidden">
      <p class="ksl-empty-title">{{ section.settings.empty_message | default: 'No stores match your search.' }}</p>
      <p class="ksl-empty-desc">Try searching for a different city or clear your search to view all locations.</p>
    </div>

    <!-- Lead Capture "Not in your city yet?" Banner (Opens Google Form) -->
    {% if section.settings.enable_lead_capture %}
      <div class="ksl-lead-banner">
        <div class="ksl-lead-content">
          <span class="ksl-lead-eyebrow">Expansion Program</span>
          <h3 class="ksl-lead-title">{{ section.settings.not_in_city_title | default: 'Not in your city yet?' }}</h3>
          <p class="ksl-lead-desc">{{ section.settings.not_in_city_desc | default: 'Tell us where you are. It’s the only way we hear about the cities we haven’t picked.' }}</p>
        </div>
        <a
          href="{{ form_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="ksl-btn-lead"
          aria-label="{{ section.settings.not_in_city_cta | default: 'Tell Us' }} (Opens Google Form)"
        >
          {{ section.settings.not_in_city_cta | default: 'Tell Us' }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  /* Kisah Theme Palette: Signature Royal Navy #201747 & Warm Luxury Accents */
  :root {
    --ksl-theme-navy: #201747;
    --ksl-theme-navy-hover: #2d2260;
    --ksl-gold-grad: linear-gradient(90deg, #A68811 -15.48%, #C1A01E 49.84%, #836900 116.67%);
    --ksl-gold-solid: #b4894a;
    --ksl-gold-hover: #9c7336;
    --ksl-gold-soft: #fcf9ee;
    --ksl-gold-border: #e8debe;
    --ksl-dark-text: #201747;
    --ksl-body-text: #4a4a4a;
    --ksl-muted-text: #707070;
    --ksl-card-border: #ece7de;
    --ksl-bg-warm: #fcfbf9;
    --ksl-green: #3f7d4e;
    --ksl-green-bg: #edf6ef;
  }

  .kisah-store-locator-section {
    background-color: #ffffff;
    color: var(--ksl-dark-text);
    font-family: inherit;
    padding-top: {{ section.settings.padding_top_desktop | default: 35 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 70 }}px;
  }

  .ksl-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 32px;
  }



  .ksl-main-title {
    font-family: var(--base-font-family), 'Manrope', 'Gabarito', var(--font-heading-family), sans-serif;
    font-size: clamp(26px, 3.8vw, 38px);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ksl-dark-text);
    text-transform: uppercase;
    margin: 0 0 8px;
  }

  .ksl-subtitle {
    font-size: 14.5px;
    color: var(--ksl-body-text);
    line-height: 1.55;
    margin: 0;
  }

  /* Sticky Toolbar */
  .ksl-sticky-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--ksl-card-border);
    border-bottom: 1px solid var(--ksl-card-border);
    padding: 12px 0;
    margin-bottom: 30px;
  }

  .ksl-toolbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* City Tabs Native Finger Scroll */
  .ksl-city-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 4px 2px;
    flex: 1;
    min-width: 0;
  }
  .ksl-city-tabs::-webkit-scrollbar {
    display: none;
  }

  .ksl-tab-btn {
    border: 1px solid var(--ksl-card-border);
    background: #fff;
    color: var(--ksl-body-text);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 99px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .ksl-tab-btn:hover {
    border-color: var(--ksl-theme-navy);
    color: var(--ksl-theme-navy);
  }
  .kisah-store-locator-section .ksl-tab-btn.is-active,
  .kisah-store-locator-section .ksl-tab-btn.is-active * {
    background-color: #201747 !important;
    background: #201747 !important;
    border-color: #201747 !important;
    color: #ffffff !important;
    box-shadow: 0 3px 10px rgba(32, 23, 71, 0.25) !important;
  }

  .ksl-search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 290px;
    flex-shrink: 0;
  }

  .ksl-search-wrap {
    position: relative;
    flex: 1;
  }
  .ksl-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ksl-muted-text);
    pointer-events: none;
  }
  .ksl-search-input {
    width: 100%;
    border: 1px solid var(--ksl-card-border);
    background: #faf9f6;
    border-radius: 99px;
    padding: 8px 14px 8px 34px;
    font-size: 12.5px;
    color: var(--ksl-dark-text);
    font-family: inherit;
    transition: all 0.2s ease;
  }
  .ksl-search-input:focus {
    outline: none;
    border-color: var(--ksl-theme-navy);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(32, 23, 71, 0.15);
  }

  .kisah-store-locator-section .ksl-geo-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid var(--ksl-theme-navy);
    background: #fff;
    color: var(--ksl-theme-navy);
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 700;
    padding: 8px 13px;
    border-radius: 99px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .kisah-store-locator-section .ksl-geo-btn:hover,
  .kisah-store-locator-section .ksl-geo-btn:hover * {
    background-color: var(--ksl-theme-navy) !important;
    background: var(--ksl-theme-navy) !important;
    color: #ffffff !important;
  }

  .ksl-geo-status {
    font-size: 11.5px;
    color: var(--ksl-theme-navy);
    font-weight: 600;
    margin: 6px 0 0;
  }

  /* Bands */
  .ksl-stores-band {
    margin-bottom: 44px;
  }
  .ksl-band-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid var(--ksl-theme-navy);
    padding-bottom: 10px;
    margin-bottom: 20px;
  }
  .ksl-band-title {
    font-family: var(--base-font-family), var(--font-heading-family), sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ksl-dark-text);
    margin: 0;
  }
  .kisah-store-locator-section .ksl-band-badge,
  .kisah-store-locator-section .ksl-band-badge * {
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    background-color: #201747 !important;
    background: #201747 !important;
    color: #ffffff !important;
    padding: 5px 14px !important;
    border-radius: 99px !important;
    display: inline-block !important;
  }

  .ksl-city-divider {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 22px 0 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--ksl-card-border);
  }
  .ksl-city-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ksl-dark-text);
    margin: 0;
  }
  .ksl-city-count {
    font-size: 11.5px;
    color: var(--ksl-muted-text);
  }

  /* Store Card Grid */
  .ksl-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .ksl-store-card {
    background: var(--ksl-bg-warm);
    border: 1px solid var(--ksl-card-border);
    border-radius: 8px;
    padding: 0;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
  }
  .ksl-store-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(32, 23, 71, 0.12);
    border-color: rgba(32, 23, 71, 0.25);
    background: #fff;
  }

  /* Edge-to-Edge Image without cropping or margins */
  .ksl-card-image-wrap {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    margin: 0;
    padding: 0;
    background: #f0ebe1;
    display: block;
    line-height: 0;
  }
  .ksl-card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .ksl-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ksl-card-header {
    margin-bottom: 10px;
  }

  .ksl-live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--ksl-green-bg);
    padding: 3px 9px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ksl-green);
    border: 1px solid rgba(63, 125, 78, 0.2);
  }
  .ksl-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ksl-green);
  }
  .ksl-live-status-pill.is-closed {
    background: #f3f3f3;
    color: #888888;
    border-color: #e0e0e0;
  }
  .ksl-live-status-pill.is-closed .ksl-status-dot {
    background: #9e9e9e;
  }

  .ksl-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .ksl-store-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--ksl-dark-text);
    margin: 0 0 6px;
  }
  .ksl-store-address {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ksl-body-text);
    margin: 0 0 8px;
    flex: 1;
  }
  .ksl-store-phone {
