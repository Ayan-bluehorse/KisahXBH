<div id="shoplogo">
  <meta itemprop="url" content="{{ shop.url }}">
  <meta itemprop="name" content="{{ shop.name }}">
  {%- if section.settings.logo != blank -%}
    <h2 class="logo" itemscope itemtype="http://schema.org/Organization">
