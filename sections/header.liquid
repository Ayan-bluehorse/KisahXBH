{% style %}
  .logo img {
    width: {{ section.settings.logo_img_width_int }}px;
  }
  .logo-area__middle--logo-image {
    max-width: {{ section.settings.logo_img_width_int }}px;
  }
  @media (max-width: 767.98px) {
    .logo img {
      width: {{ section.settings.mobile_logo_img_width_int }}px;
    }
  }
  {%- if section.settings.enable_sticky -%}
  .section-header {
    position: -webkit-sticky;
    position: sticky;
  }
  {%- endif -%}
  {%- if section.settings.enable_transparent and template.name == 'index' -%}
    .section-header {
      margin-bottom: calc(var(--theme-header-height) * -1);
      --transparent-header-text-color: {{ section.settings.transparent_color }};
    }
    .section-store-messages {
      display: none;
    }
    #content .shopify-section:first-child .text-overlay {
      padding-top: var(--theme-header-height);
    }
  {%- endif -%}
{% endstyle %}

<script>
document.addEventListener("DOMContentLoaded", function () {
  // Function to handle submenu hover behavior
  function handleSubmenuHover(parentItem) {
    const submenuItems = parentItem.querySelectorAll(
      ".navigation__tier-2-container ul.navigation__tier-2 > li.navigation__item"
    );

    if (!submenuItems.length) return;

    // Remove existing .hover
    submenuItems.forEach((item) => item.classList.remove("hover"));

    // Add .hover to the first submenu item
    submenuItems[0].classList.add("hover");

    // Add hover switch behavior to each submenu item
    submenuItems.forEach((item) => {
      item.addEventListener("mouseenter", function () {
        submenuItems.forEach((el) => el.classList.remove("hover"));
        item.classList.add("hover");
      });
    });
  }

  // Initial check: If any parent already has the class on load
  const activeParents = document.querySelectorAll("li.navigation__item--show-children");
  activeParents.forEach((parent) => handleSubmenuHover(parent));

  // MutationObserver to detect dynamic class additions
  const observer = new MutationObserver((mutationsList) => {
    mutationsList.forEach((mutation) => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "class"
      ) {
        const target = mutation.target;
        if (target.classList.contains("navigation__item--show-children")) {
          handleSubmenuHover(target);
        }
      }
    });
  });

  // Observe top-level menu items for class changes
  const topLevelItems = document.querySelectorAll("li.navigation__item");
  topLevelItems.forEach((item) => {
    observer.observe(item, { attributes: true });
  });
});




</script>

