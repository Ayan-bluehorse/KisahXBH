{%- else -%}

{%- liquid
  assign featured_links = section.settings.nav_featured_link | split: ', '

  for block in section.blocks
    if block.type == 'menu-promotion-large' and block.settings.show_countdown
      assign has_countdown = true
    endif
  endfor
-%}
{%- if has_countdown -%}
  <script src="{{ 'countdown-timer.js' | asset_url }}" defer></script>
{%- endif -%}
<page-header data-section-id="{{ section.id }}" data-cc-animate>
  <div id="pageheader" class="pageheader pageheader--layout-{{ section.settings.menu_layout }}{% if section.settings.enable_transparent and template.name == 'index' %} pageheader--transparent-permitted pageheader--transparent{% endif %}{% if section.settings.enable_sticky %} pageheader--sticky{% endif %}">
    <div class="logo-area container container--no-max">
      <div class="logo-area__left">
        <div class="logo-area__left__inner">
          <button class="mobile-nav-toggle" aria-label="{{ 'general.navigation.menu' | t }}" aria-controls="main-nav">
            {%- render 'icon-menu' -%}
          </button>
          {% if section.settings.enable_search %}
            <a class="show-search-link" href="{{ routes.search_url }}" aria-label="{{ 'sections.header.search' | t }}">
              <span class="show-search-link__icon">
                {%- render 'icon-search' -%}
              </span>
              <span class="show-search-link__text{% if section.settings.icon_strategy == 'icons_only' %} visually-hidden{% endif %}">
                {{- 'sections.header.search' | t -}}
              </span>
            </a>
          {% endif %}
         
          {% if section.settings.menu_layout contains 'inline' %}
            <div id="proxy-nav" class="navigation navigation--left" role="navigation" aria-label="{{ 'accessibility.main_navigation' | t }}">
              <div class="navigation__tier-1-container">
                <ul class="navigation__tier-1">
                  {% for link in linklists[section.settings.menu_linklist].links %}
                    {%- liquid
                      assign has_dropdown = false
                      if link.links != blank
                        assign has_dropdown = true
                      endif
                      assign use_columns = false
                      if link.levels >= 2
                        assign use_columns = true
                      else
                        assign link_title_sanitised = link.title | downcase | strip
                        for block in section.blocks
                          assign dropdown_link_title_sanitised = block.settings.dropdown_link_title | downcase | strip
                          if dropdown_link_title_sanitised == link_title_sanitised
                            assign use_columns = true
                            assign has_dropdown = true
                          endif
                        endfor
                      endif
                    -%}
                    <li class="navigation__item{% if has_dropdown %} navigation__item--with-children {% if use_columns %}navigation__item--with-mega-menu{% else %}navigation__item--with-small-menu{% endif %}{% endif %}{% if featured_links contains link.title %} featured-link{% endif %}{% if link.active %} navigation__item--active{% endif %}">
                      <a href="{{ link.url }}" class="navigation__link kmk" {% if has_dropdown %}aria-haspopup="true" aria-expanded="false" aria-controls="NavigationTier2-{{ forloop.index }}"{% endif %}>
                        {{- link.title | escape -}}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="logo-area__middle logo-area__middle--logo-{% if section.settings.logo != blank %}image{% else %}text{% endif %}">
        <div class="logo-area__middle__inner">
          <div class="logo">
            {%- if request.page_type == 'index' and section.settings.logo_h2 -%}
              <h2 class="logo__h2">
            {%- endif -%}

            <a class="logo__link" href="{{ routes.root_url }}" title="{{ shop.name }}">
              {%- if section.settings.logo != blank -%}
                {%- assign logo_width_x2 = section.settings.logo_img_width_int | times: 2 -%}
                <img class="logo__image" src="{{ section.settings.logo | image_url: width: logo_width_x2 }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}" itemprop="logo" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="eager" />

                {%- if section.settings.enable_transparent and template.name == 'index' and section.settings.transparent_logo != blank -%}
                  <img class="logo__image-transparent" src="{{ section.settings.transparent_logo | image_url: width: logo_width_x2 }}" alt="{{ section.settings.transparent_logo.alt | escape }}" width="{{ section.settings.transparent_logo.width }}" height="{{ section.settings.transparent_logo.height }}" aria-hidden="true" loading="eager" />
                {%- endif -%}

              {%- else -%}
                <span class="logotext">{{ shop.name }}</span>
              {%- endif -%}
            </a>

            {%- if request.page_type == 'index' and section.settings.logo_h2 -%}
              </h2>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="logo-area__right">
        <div class="logo-area__right__inner">

          {% if section.settings.enable_search %}
            <a class="show-search-link" href="{{ routes.search_url }}">
              <span class="show-search-link__text {% if section.settings.icon_strategy == 'icons_only' %}visually-hidden{% else %}visually-hidden-mobile{% endif %} ">
                {{- 'sections.header.search' | t -}}
              </span>
              <span class="show-search-link__icon">
                {%- render 'icon-search' -%}
              </span>
            </a>
          {% endif %}
          
          {% if section.settings.enable_location %}
            <a class="header-location-link" href="{{ section.settings.location_link | default: '/pages/store-locator' }}" aria-label="{{ section.settings.location_text | default: 'Store Locator' | escape }}" title="{{ section.settings.location_text | default: 'Store Locator' | escape }}">
              <span class="header-location-link__text {% if section.settings.icon_strategy == 'icons_only' %}visually-hidden{% else %}visually-hidden-mobile{% endif %}">
                {{- section.settings.location_text | default: 'Store Locator' -}}
              </span>
              <span class="header-location-link__icon">
                {%- if section.settings.custom_location_icon != blank -%}
                  <img src="{{ section.settings.custom_location_icon | image_url: width: 44 }}" alt="{{ section.settings.location_text | default: 'Store Locator' | escape }}" width="22" height="22" loading="eager" />
                {%- else -%}
                  <img src="{{ 'icon-location.svg' | asset_url }}" alt="{{ section.settings.location_text | default: 'Store Locator' | escape }}" width="22" height="22" class="icon-location-pin" loading="eager" />
                {%- endif -%}
              </span>
            </a>
          {% endif %}
          
          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a class="header-account-link" href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t | escape }}">
                <span class="header-account-link__text {% if section.settings.icon_strategy == 'icons_only' %}visually-hidden{% else %}visually-hidden-mobile{% endif %}">{{ 'sections.header.account' | t }}</span>
                <span class="header-account-link__icon{% if section.settings.icon_strategy == 'icons_cart_search' %} mobile-only{% endif %}">{% render 'icon-user' %}</span>
              </a>
            {% else %}
              <a class="header-account-link" href="{{ routes.account_login_url }}" aria-label="{{ 'sections.header.account' | t | escape }}">
                <span class="header-account-link__text {% if section.settings.icon_strategy == 'icons_only' %}visually-hidden{% else %}visually-hidden-mobile{% endif %}">{{ 'sections.header.account' | t }}</span>
                <span class="header-account-link__icon{% if section.settings.icon_strategy == 'icons_cart_search' %} mobile-only{% endif %}">{% render 'icon-user' %}</span>
              </a>
            {% endif %}
          {% endif %}
          

             {% render 'wishlisthero-header-icon' %}
          
          <a href="{{ routes.cart_url }}"
   class="cart-link"
   onclick="event.preventDefault(); Rebuy.SmartCart.show();">
  <span class="cart-link__label {% if section.settings.icon_strategy == 'icons_only' %}visually-hidden{% else %}visually-hidden-mobile{% endif %}">
    {{- 'sections.header.cart' | t | escape -}}
  </span>
  <span class="cart-link__icon">
    {%- liquid
      if section.settings.cart_icon == 'basket'
        render 'icon-bag'
      elsif section.settings.cart_icon == 'bag'
        render 'icon-bag'
      else
        render 'icon-cart'
