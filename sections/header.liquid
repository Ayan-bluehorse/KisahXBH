      <img src="{{ section.settings.logo | image_url: width: logo_width_x2 }}" alt="{{ section.settings.logo.alt | escape }}" itemprop="logo" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="eager" />
