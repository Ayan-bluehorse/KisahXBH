<script src="{{ 'navratri.js' | asset_url }}" defer></script>

<section class="cp-color-grid-celebrate">
  {% if section.settings.section_heading != blank %}
    <h2 class="cp-color-grid-heading-celebrate">{{ section.settings.section_heading }}</h2>
  {% endif %}

  <div class="page-container">
  <div class="cp-color-grid-wrapper-celebrate">
    {% for block in section.blocks %}
      <div class="cp-color-card-celebrate">
        {% if block.settings.image != blank %}
          <div class="cp-color-image-celebrate">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="cp-color-link-celebrate">
                <img width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" src="{{ block.settings.image | image_url }}" alt="Navratri Color Card">
              </a>
            {% else %}
              <img width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" src="{{ block.settings.image | image_url }}" alt="Navratri Color Card">
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  </div>

</section>

{% schema %}
{
  "name": "Navratri Celebrate",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Celebrate endless joy in every color of Navratri"
    }
  ],
  "blocks": [
    {
      "type": "color_card",
      "name": "Color Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Navratri Celebrate",
      "blocks": [
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" },
        { "type": "color_card" }
      ]
    }
  ]
}
{% endschema %}
