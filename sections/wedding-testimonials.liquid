<section 
  id="shopify-section-{{ section.id }}" 
  class="wedding-testimonials-section color-{{ section.settings.color_scheme }} {{ section.settings.section_class }}"
  style="
    padding-top: {{ section.settings.desk-padding-top }}px;
    padding-bottom: {{ section.settings.desk-padding-bottom }}px;
  "
>

  <div class="container">

    {% if section.settings.head != blank %}
      <h2 class="wt-heading" style="color: {{ section.settings.head-color }};">
        {{ section.settings.head }}
      </h2>
    {% endif %}

    {% if section.settings.title != blank %}
      <p class="wt-subtitle">{{ section.settings.title }}</p>
    {% endif %}

    <div class="wt-slider">
      {% for block in section.blocks %}
        <div class="wt-slide">

            {%- if block.settings.star_rating > 0 -%}
            <div class="testimonial__star-rating heading-font">
                {%- for i in (1..block.settings.star_rating) -%}
                <span class="testimonial__star">{% render 'icon-star' %}</span>
                {%- endfor -%}
            </div>
            {%- endif -%}
          {% if block.settings.image != blank %}
            <div class="wt-image-wrap {{ section.settings.image_shape }}">
              <a href="{{ block.settings.link | default: '#' }}">
                <img 
                  width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" src="{{ block.settings.image | image_url: width: 800 }}" 
                  alt="{{ block.settings.author }}"
                  class="wt-image"
                >
              </a>
            </div>
          {% endif %}

          <div class="wt-quote">
            <p 
              class="wt-testimonial-text {% if section.settings.text_caps %}caps{% endif %}"
              style="
                font-size: {{ section.settings.quote_text_size }}px;
              "
            >
              {{ block.settings.testimonial }}
            </p>

            <p class="wt-author">{{ block.settings.author }}</p>
            <p class="wt-author-place">{{ block.settings.author-place }}</p>
          </div>

        </div>
      {% endfor %}
    </div>

  </div>

</section>

<style>
/* SECTION STYLING */
#wedding-testimonials-section { width: 100%; }

.wedding-testimonial-wrapper {
    background-color: #fff;
}

/* HEADING */
.wt-heading {
    font-size: 48px;
    line-height: 48px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 14px;
    font-family: Playfair Display !important;
    text-align: center;
}

.wt-subtitle {
    color: #4A5565;
    font-size: 18px;
    line-height: 28px;
    margin-bottom: 32px;
    font-family: Manrope !important;
    text-align: center;
}

.wedding-testimonials-section .container {
    max-width: 1280px;
}

/* SLIDER WRAP */
.wt-slider .slick-arrow::before {
    display: none;
}

.wt-slider .slick-list .wt-slide {
    padding: 0 10px;
}

.wt-slider {
  width: 100%;
}

/* SLIDE */
.wt-slide {
  padding: 0 15px;
  text-align: center;
}

/* IMAGE SHAPES */
.wt-image-wrap.square img { border-radius: 0; }
.wt-image-wrap.landscape img { aspect-ratio: 5 / 4; object-fit: cover; }
.wt-image-wrap.portrait img { aspect-ratio: 4 / 5; object-fit: cover; }
.wt-image-wrap.natural img { border-radius: 0; }

.wt-image-wrap img {
  width: 100%;
  display: block;
  margin: 0 auto;
}

/* QUOTE TEXT */
.wt-testimonial-text {
    margin-top: 16px;
    margin-bottom: 0;
    color: #364153;
    font-weight: 400;
    line-height: 24px;
    font-family: Manrope !important;
}

.wt-testimonial-text.caps {
  text-transform: uppercase;
}

.wt-slider .slick-list .wt-slide .wt-author,
.wt-slider .slick-list .wt-slide .wt-author-place {
    display: none;
}

/* AUTHOR */
.wt-author {
  font-weight: 600;
  margin-top: 10px;
}

.wt-author-place {
  font-size: 14px;
  opacity: 0.7;
}

/* MOBILE PADDING */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }}.wedding-testimonials-section {
    padding-top: {{ section.settings.mob-padding-top }}px !important;
    padding-bottom: {{ section.settings.mob-padding-bottom }}px !important;
  }

  .wt-testimonial-text {
    font-size: {{ section.settings.quote_text_size_mobile }}px !important;
  }

.wt-heading {
    font-size: 24px;
    line-height: normal;
    margin-bottom: 8px;
    padding: 0 16px;
}

.wt-subtitle {
    font-size: 14px;
    line-height: normal;
    margin-bottom: 20px;
    padding: 0 45px;
}

.wt-slider .slick-list .wt-slide {
    padding: 0 16px;
}

.wedding-testimonials-section .container {
    padding: 0;
}

.wt-testimonial-text {
    line-height: 22px;
}

.wt-slider .slick-list .wt-slide .wt-author,
.wt-slider .slick-list .wt-slide .wt-author-place {
    display: block;
}

.wt-slider .slick-list .wt-slide .wt-author {
    margin-top: 16px;
    margin-bottom: 4px;
    color: #101828;
    font-size: 16px;
    line-height: normal;
    font-family: Manrope !important;
}

.wt-slider .slick-list .wt-slide .wt-author-place {
    margin: 0;
    color: #D4AF37;
    opacity: 1;
    font-size: 12px;
    line-height: normal;
    font-family: Manrope !important;
}


.wedding-testimonials-section .container ul.slick-dots {
    position: static;
    margin-top: 13px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
}

.wedding-testimonials-section .container ul.slick-dots li {
    margin: 0;
    width: auto;
    height: auto;
}

.wedding-testimonials-section .container ul.slick-dots li button {
    padding: 0;
    width: 6px;
    height: 6px;
    background: #D1D5DC;
    border-radius: 100%;
}

.wedding-testimonials-section .container ul.slick-dots li button:before {
    display: none;
}

.wedding-testimonials-section .container ul.slick-dots li.slick-active button {
    width: 8px;
    height: 8px;
    background: #99A1AF;
}

.wt-slider .slick-arrow {
    display: none;
}

}
</style>


<script>
window.kisahWhenJQueryReady(function($) {

  $('.wt-slider').slick({
    dots: false,
    arrows: true,
    infinite: true,
    slidesToShow: 3,
    slidesToScroll: 1,
    autoplay: {{ section.settings.autoplay | json }},
    autoplaySpeed: {{ section.settings.autoplay_speed }}000,
    prevArrow: '<button class="slick-prev slick-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="27" viewBox="0 0 15 27" fill="none"> <path d="M14.082 25.5405L1.08203 13.0405L14.082 0.540528" stroke="#280856" stroke-width="1.5"/> </svg></button>',
    nextArrow: '<button class="slick-next slick-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="27" viewBox="0 0 15 27" fill="none"> <path d="M0.519531 25.5405L13.5195 13.0405L0.519531 0.540528" stroke="#280856" stroke-width="1.5"/> </svg></button>',

    responsive: [
      {
        breakpoint: 992,
        settings: {
          slidesToShow: 2,
          slidesToScroll: 1
        }
      },
      {
        breakpoint: 768,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1,
          dots: true,
          arrows: true,
        }
      }
    ]
  });

});
</script>


{% schema %}
{
  "name": "Wedding Testimonials",
  "class": "wedding-testimonial-wrapper",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_class",
      "label": "Section Class"
    },
    {
      "type": "text",
      "id": "head",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "head-color",
      "label": "Heading color"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "checkbox",
      "id": "text_caps",
      "label": "Capitalize text",
      "default": false
    },
    {
      "type": "range",
      "id": "quote_text_size",
      "min": 14,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Desktop quote text size",
      "default": 30
    },
    {
      "type": "range",
      "id": "quote_text_size_mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile quote text size",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "landscape",
          "label": "Landscape (5:4)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "id": "autoplay",
      "type": "checkbox",
      "label": "Auto-rotate testimonials",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "Change testimonials every",
      "default": 5
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR DESKTOP"
    },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "star_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "testimonial",
          "label": "Testimonial",
          "default": "Add customer reviews and testimonials to showcase your store’s happy customers.",
          "info": "Enter <br> for a line-break. For best results, keep the word count similar in each quote."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Author's name"
        },
        {
          "type": "text",
          "id": "author-place",
          "label": "Author Place",
          "default": "Author's place"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "390 x 530px recommended"
        },
        {
          "type": "text",
          "id": "image_caption",
          "label": "Image caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wedding Testimonials",
      "settings": {},
      "blocks": [
        {
          "type": "testimonial",
          "settings": {}
        },
        {
          "type": "testimonial",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}