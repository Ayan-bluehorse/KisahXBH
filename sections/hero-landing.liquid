<style>
.hero-landing {
  position: relative;
  background-size: cover;
  background-position: center;
  height: 65vh;
  color: white;
  display: flex;
  align-items: center;
}
.hero-landing__overlay {
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.60) 0%, rgba(0, 0, 0, 0.60) 100%);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 10%;
  justify-content: center;
}
.hero-landing__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    bottom: 100px;
    position: absolute;
}
.hero-landing__stars {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  font-weight: 500;
  font-size: 15px;
}
.hero-landing__stars svg {
  display: inline-block;
}
.hero-landing__heading {
    margin-bottom: 20px;
    color: #FFF;
    text-align: center;
    font-family: var(--base-font-family);
    font-size: 45px;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    text-transform: uppercase;
}
  .hero-landing__subheading {
    font-family: var(--base-font-family);
    color: #FFF !important;
    font-size: 28px;
    font-style: normal;
    font-weight: 400;
    line-height: 42px;
  }
.hero-landing__button {
    display: inline-block;
    padding: 10px 24px;
    text-decoration: none;
    transition: background 0.3s ease;
    border-radius: 33px;
    background: #B78A2E;
    color: #FFF;
    font-size: 20px;
    font-style: normal;
    font-family: var(--base-font-family);
    line-height: normal;
}

@media (max-width: 768px) {
  .hero-landing {
    height: 60vh;
  }
  .hero-landing__content {
    bottom: 50px;
    position: absolute;
    max-width: 350px;
}
  .hero-landing__heading {
    font-size: 24px;
  }
  .hero-landing__subheading {
    line-height: 0;
    font-size: 16px;
}
  .hero-landing__button {
    font-size: 16px;
}
}
</style>

<section class="hero-landing" style="background-image: url({{ section.settings.background_image | image_url: width: 1600 }});">
  <div class="hero-landing__overlay">
    <div class="hero-landing__content">
      <div class="hero-landing__stars">
        {% for i in (1..5) %}
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-star" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" style="color: #B78A2E;">
            <path d="M10 15l-5.878 3.09L5.73 11.545.854 7.91l6.57-.955L10 1l2.576 5.955 6.57.955-4.876 3.636 1.608 6.545z"/>
          </svg>
        {% endfor %}
        <span class="hero-landing__subheading">{{ section.settings.subheading }}</span>
      </div>
      <h2 class="hero-landing__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="hero-landing__button">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>


              {% schema %}
{
  "name": "Hero Landing Section",
  "tag": "section",
  "class": "hero-landing-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Stars + Text)",
      "default": "1k+ 5-star reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "A CLASSIC CAPSULE CRAFTED FOR YOU"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Your Denims Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Landing Section"
    }
  ]
}
{% endschema %}