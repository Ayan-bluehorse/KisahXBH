{% comment %}
  Kisah Homepage - Shop by Occasion: The Wedding Week
  - 100% Dynamic Shopify OS 2.0 Section
  - Sharp corners (border-radius: 0)
  - Eyebrow: SHOP BY OCCASION (wine accent)
  - Heading: The wedding week (var(--heading-font-family))
  - Subtitle: Pick the function. We'll show what works for it.
  - Top-Right Link: ALL OCCASIONS
  - Desktop: 7 equal columns
  - Mobile: Smooth swipeable horizontal rail
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

<section 
  id="shopify-section-{{ sid }}" 
  class="v5-revamp-occ"
  style="
    background-color: {{ section.settings.bg_color | default: '#fbf8f3' }};
    padding-top: {{ section.settings.mob_padding_top | default: 28 }}px;
    padding-bottom: {{ section.settings.mob_padding_bottom | default: 28 }}px;
  "
>
  <div class="v5-occ-wrap">
    <div class="v5-occ-header">
      <div class="v5-occ-titles">
        {%- if section.settings.eyebrow != blank -%}
          <span class="v5-occ-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="v5-occ-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="v5-occ-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link_url | default: '/pages/wedding' }}" class="v5-occ-all-link">
          {{ section.settings.link_text }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="v5-occ-rail-wrapper">
        <button 
          type="button" 
          class="v5-occ-arrow v5-occ-arrow--prev is-hidden" 
          data-rail-prev="{{ sid }}" 
          aria-label="Scroll left"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div 
          class="v5-occ-track" 
          id="v5-occ-track-{{ sid }}"
          role="region"
          aria-label="{{ section.settings.heading | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- assign item_link = block.settings.link | default: '#' -%}
            {%- assign item_title = block.settings.title | default: 'Occasion' -%}
            {%- assign item_sub = '' -%}
            {%- if block.settings.subtitle != blank -%}
              {%- assign item_sub = block.settings.subtitle -%}
            {%- else -%}
              {%- case item_title -%}
                {%- when 'Wedding' -%}{%- assign item_sub = 'Sets and jackets for the main event' -%}
                {%- when 'Haldi' -%}{%- assign item_sub = 'Yellows and prints that can take a splash' -%}
                {%- when 'Mehendi' -%}{%- assign item_sub = 'Florals and easy cuts for long afternoons' -%}
                {%- when 'Sangeet' -%}{%- assign item_sub = 'Jacket sets with some shine for the dance floor' -%}
                {%- when 'Reception' -%}{%- assign item_sub = 'Sharp bandhgalas and indo-westerns' -%}
                {%- when 'Cocktail' -%}{%- assign item_sub = 'Dark, clean, after-hours' -%}
                {%- when 'House Celebration' -%}{%- assign item_sub = 'Pujas, griha pravesh, family days' -%}
              {%- endcase -%}
            {%- endif -%}
            <a 
              href="{{ item_link }}" 
              class="v5-occ-item" 
              {{ block.shopify_attributes }}
              aria-label="{{ item_title | escape }}"
            >
              <div class="v5-occ-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 450 }}"
                    srcset="{{ block.settings.image | image_url: width: 200 }} 200w,
                            {{ block.settings.image | image_url: width: 350 }} 350w,
                            {{ block.settings.image | image_url: width: 450 }} 450w"
                    sizes="(max-width: 768px) 148px, (max-width: 1200px) 14vw, 175px"
                    alt="{{ item_title | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="175"
                    height="218"
                    class="v5-occ-img"
                  >
                {%- else -%}
                  <div class="v5-occ-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>
              <h3 class="v5-occ-name">{{ item_title }}</h3>
              {%- if item_sub != blank -%}
                <p class="v5-occ-desc">{{ item_sub }}</p>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>

        <button 
          type="button" 
          class="v5-occ-arrow v5-occ-arrow--next is-hidden" 
          data-rail-next="{{ sid }}" 
          aria-label="Scroll right"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ sid }} {
    width: 100%;
    display: block;
  }
  .v5-revamp-occ {
    width: 100%;
    box-sizing: border-box;
  }
  .v5-revamp-occ .v5-occ-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
  .v5-revamp-occ .v5-occ-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    gap: 16px;
  }
  .v5-revamp-occ .v5-occ-titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .v5-revamp-occ .v5-occ-eyebrow {
    font-family: var(--base-font-family, sans-serif);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #7a1a2e;
  }
  .v5-revamp-occ .v5-occ-title {
    font-family: var(--heading-font-family, "Playfair Display", serif);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.15;
    color: #171717;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .v5-revamp-occ .v5-occ-subtitle {
    font-family: var(--base-font-family, sans-serif);
    font-size: 13px;
    line-height: 1.4;
    color: #666666;
    margin: 0;
  }
  .v5-revamp-occ .v5-occ-all-link {
    font-family: var(--base-font-family, sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #171717;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
    padding-bottom: 2px;
  }

  .v5-revamp-occ .v5-occ-rail-wrapper {
    position: relative;
    width: 100%;
  }
  .v5-revamp-occ .v5-occ-track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 2px 2px 14px;
  }
  .v5-revamp-occ .v5-occ-track::-webkit-scrollbar {
    display: none;
  }
  .v5-revamp-occ .v5-occ-item {
    flex: 0 0 148px;
    max-width: 148px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #171717;
    scroll-snap-align: start;
    transition: transform 0.25s ease;
  }
  .v5-revamp-occ .v5-occ-media {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 0 !important; /* Sharp corners */
    overflow: hidden;
    background: #e8e2d8;
    margin-bottom: 10px;
    position: relative;
  }
  .v5-revamp-occ .v5-occ-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    display: block;
    border-radius: 0 !important;
    transition: transform 0.5s ease;
  }
  .v5-revamp-occ .v5-occ-item:hover .v5-occ-img {
    transform: scale(1.04);
  }
  .v5-revamp-occ .v5-occ-name {
    font-family: var(--heading-font-family, serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
    color: #171717;
    margin: 0 0 4px;
  }
  .v5-revamp-occ .v5-occ-desc {
    font-family: var(--base-font-family, sans-serif);
    font-size: 11.5px;
    line-height: 1.35;
    color: #767676;
    margin: 0;
  }
  .v5-revamp-occ .v5-occ-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e2d8;
  }
  .v5-revamp-occ .v5-occ-placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  /* Arrows */
  .v5-revamp-occ .v5-occ-arrow {
    display: none;
    position: absolute;
    top: calc(40% - 18px);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.12);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    cursor: pointer;
    z-index: 2;
    align-items: center;
    justify-content: center;
    color: #171717;
    transition: all 0.2s ease;
  }
  .v5-revamp-occ .v5-occ-arrow:hover {
    background: #171717;
    color: #ffffff;
    border-color: #171717;
  }
  .v5-revamp-occ .v5-occ-arrow--prev {
    left: -14px;
  }
  .v5-revamp-occ .v5-occ-arrow--next {
    right: -14px;
  }
  .v5-revamp-occ .v5-occ-arrow.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 992px) {
    .v5-revamp-occ {
      padding-top: {{ section.settings.desk_padding_top | default: 44 }}px !important;
      padding-bottom: {{ section.settings.desk_padding_bottom | default: 44 }}px !important;
    }
    .v5-revamp-occ .v5-occ-title {
      font-size: 34px;
    }
    .v5-revamp-occ .v5-occ-subtitle {
      font-size: 14px;
    }
    .v5-revamp-occ .v5-occ-track {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 16px;
      overflow: visible;
      padding-bottom: 0;
    }
    .v5-revamp-occ .v5-occ-item {
      flex: none;
      max-width: 100%;
    }
    .v5-revamp-occ .v5-occ-media {
      aspect-ratio: 4 / 5;
    }
    .v5-revamp-occ .v5-occ-name {
      font-size: 18px;
    }
    .v5-revamp-occ .v5-occ-desc {
      font-size: 12px;
    }
    .v5-revamp-occ .v5-occ-arrow {
      display: none !important;
    }
  }
</style>

<script>
  (function() {
    var sid = '{{ sid }}';
    var track = document.getElementById('v5-occ-track-' + sid);
    if (!track) return;
    var prevBtn = document.querySelector('[data-rail-prev="' + sid + '"]');
    var nextBtn = document.querySelector('[data-rail-next="' + sid + '"]');

    function checkArrows() {
      if (!prevBtn || !nextBtn || window.innerWidth >= 992) {
        if (prevBtn) prevBtn.classList.add('is-hidden');
        if (nextBtn) nextBtn.classList.add('is-hidden');
        return;
      }
      var canScroll = track.scrollWidth > track.clientWidth + 4;
      if (!canScroll) {
        prevBtn.classList.add('is-hidden');
        nextBtn.classList.add('is-hidden');
        return;
      }
      var sl = track.scrollLeft;
      var max = track.scrollWidth - track.clientWidth - 4;
      if (sl <= 4) prevBtn.classList.add('is-hidden'); else prevBtn.classList.remove('is-hidden');
      if (sl >= max) nextBtn.classList.add('is-hidden'); else nextBtn.classList.remove('is-hidden');
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -track.clientWidth * 0.75, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: track.clientWidth * 0.75, behavior: 'smooth' });
      });
    }

    track.addEventListener('scroll', checkArrows, { passive: true });
    window.addEventListener('resize', checkArrows, { passive: true });
    setTimeout(checkArrows, 100);
  })();
</script>

{% schema %}
{
  "name": "Shop by Occasion (Week)",
  "tag": "section",
  "class": "v5-shop-by-occasion-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SHOP BY OCCASION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The wedding week"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Pick the function. We'll show what works for it."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Header Link Text",
      "default": "ALL OCCASIONS"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Header Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf8f3"
    },
    {
      "type": "range",
      "id": "desk_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "desk_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "mob_padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "mob_padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Occasion Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wedding"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Short Subtitle",
          "default": "Sets and jackets for the main event"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion (Week)"
    }
  ]
}
{% endschema %}
