{% schema %}
  {
    "name": "about us timeline",
    "settings": [
      {
        "type": "text",
         "id": "head",
         "label": "Heading"
      },
      {
        "type": "image_picker",
        "id":"image",
         "label": "image"
      },
      {
        "type": "image_picker",
        "id":"mob-image",
         "label": "image"
      },
      {
      "type": "header",
     "content": "SECTION PADDING FOR DESKTOP"
    },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    }
      
    ],
    "presets": [
      {
        "name": "about us timeline"
      }
    ]
  }
{% endschema %}{%- comment -%}

