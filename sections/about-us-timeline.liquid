<div class="container">
 <div class="timeline-about-us">
   <div class="timeline-heading">
     <h2>{{ section.settings.head }}</h2>
   </div>
   <div class="desktop-timeline-img">
   
     {% render 'image', image: section.settings.image, width: renamed_variable_2330px %}
     </div>
     <div class="mobile-timeline-img">
        {% render 'image', image: section.settings.mob-image, width: renamed_variable_2330px %}
     </div>
</div>
</div>


<style>
#shopify-section-{{section.id}}{
  padding-top:{{section.settings.desk-padding-top}}px;
  padding-bottom:{{section.settings.desk-padding-bottom}}px;
}
#shopify-section-{{section.id}} .mobile-timeline-img{
   display:none;
}
#shopify-section-{{section.id}} .timeline-heading h2{
    font-family: var(--base-font-family);
    font-style: normal;
    font-weight: 600;
    font-size: 24px;
    line-height: 27px;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
}
#shopify-section-{{section.id}} .desktop-timeline-img img{
    width:1000px;
}
@media screen and (max-width:768px){
#shopify-section-{{section.id}}{
  padding-top:{{section.settings.mob-padding-top}}px;
  padding-bottom:{{section.settings.mob-padding-bottom}}px;
}
#shopify-section-{{section.id}} .timeline-heading h2{ 
    font-size: 20px;
    line-height: 22px;
    text-align:left;
}
#shopify-section-{{section.id}} .desktop-timeline-img{  
  display:none;
}
#shopify-section-{{section.id}} .mobile-timeline-img{
   display:block;
}
}
