<style>
.denim-in-action {
    background-size: cover;
    background-position: center;
    padding: 40px 20px;
    max-width: 1320px;
    margin: auto;
    border-radius: 8px;
}
.denim-in-action__content {
  display: flex;
  gap: 80px;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}
.denim-in-action__text {
  flex: 1 1 400px;
  color: white;
  font-family: var(--base-font-family), sans-serif;
}
.denim-in-action__text h2 {
  font-size: 45px;
  font-weight: 700;
  text-transform: uppercase;
  color: white;
  text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000;
}
.denim-in-action__description p {
  font-size: 28px;
  margin-top: 10px;
  line-height: 1.6;
  color: white;
  max-width: 500px;
}
.denim-in-action__description strong {
  font-weight: bold;
}
.denim-in-action__video-wrapper {
    flex: 15%;
    position: relative;
    justify-content: flex-end;
    display: flex;
}
.video-container {
  position: relative;
  width: 359px;
  height: 498px;
  overflow: hidden;
  border-radius: 10px;
}
.video-container video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
}
.video-thumbnail {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
  z-index: 5;
}
.play-button {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: transparent;
  border: none;
  cursor: pointer;
  width: 64px;
  height: 64px;
  z-index: 10;
}
.play-button img {
  width: 100%;
  height: auto;
}
@media (max-width: 768px) {
  .denim-in-action {
    border-radius: 0;
}
  .denim-in-action__text h2, .bold-text {
    font-size: 32px !important;
}
.denim-in-action__description p {
    font-size: 18px;
}
  .denim-in-action__text {
    flex: auto;
}
  .denim-in-action__content {
    flex-direction: column;
    text-align: center;
    gap: 0;
  }
  .video-container {
    width: auto;
    height: 498px;
}
  .denim-in-action__text {
    order: 1;
  }
  .denim-in-action__video-wrapper {
    order: 2;
  }
}
</style>

<section class="denim-in-action" style="background-image: url({{ section.settings.background_image | image_url }});">
  <div class="denim-in-action__content">
    <div class="denim-in-action__video-wrapper">
      <div class="video-container">
        {% if section.settings.video_thumbnail %}
          <img class="video-thumbnail" width="{{ section.settings.video_thumbnail.width }}" height="{{ section.settings.video_thumbnail.height }}" loading="lazy" src="{{ section.settings.video_thumbnail | image_url }}" alt="Video thumbnail">
        {% endif %}
        <video id="denimVideo-{{ section.id }}" playsinline loop muted>
          <source src="{{ section.settings.video_file }}" type="video/mp4">
        </video>
        <button class="play-button" data-target="denimVideo-{{ section.id }}">
          <img width="400" height="400" loading="lazy" src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Play_circle.png?v=1752582049" alt="Play">
        </button>
      </div>
    </div>
    <div class="denim-in-action__text">
      <h2>SEE THE <span class="bold-text" style="color: #B78A2E; text-transform: uppercase; font-weight: 700; font-size: 45px;">DENIM</span> IN ACTION</h2>
      <div class="denim-in-action__description">
        <p>Soft to the touch, strong in character. Our denim blends <strong>deep indigo</strong> hues with a lived-in feel that moves with your rhythm. Effortless style, timeless texture.</p>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const video = document.getElementById("denimVideo-{{ section.id }}");
  const playBtn = document.querySelector(".play-button[data-target='denimVideo-{{ section.id }}']");
  const thumbnail = video ? video.previousElementSibling : null;

  if (video && playBtn) {
    playBtn.addEventListener("click", function () {
      video.play();
      video.setAttribute("controls", "true");
      video.removeAttribute("muted");
      this.style.display = "none";
      if (thumbnail && thumbnail.classList.contains("video-thumbnail")) {
        thumbnail.style.display = "none";
      }
    });

    video.addEventListener("click", function () {
      if (!video.paused) {
        video.pause();
        playBtn.style.display = "block";
        video.removeAttribute("controls");
        if (thumbnail && thumbnail.classList.contains("video-thumbnail")) {
          thumbnail.style.display = "block";
        }
      }
    });
  }
});
</script>

{% schema %}
{
  "name": "Denim In Action Section",
  "tag": "section",
  "class": "denim-in-action-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SEE THE DENIM IN ACTION"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Soft to the touch, strong in character. Our denim blends deep indigo hues with a lived-in feel that moves with your rhythm. Effortless style, timeless texture.</p>"
    },
    {
      "type": "url",
      "id": "video_file",
      "label": "Video File (Upload in Shopify Files)"
    },
    {
      "type": "image_picker",
      "id": "video_thumbnail",
      "label": "Video Thumbnail"
    }
  ],
  "presets": [
    {
      "name": "Denim In Action"
    }
  ]
}
{% endschema %}
