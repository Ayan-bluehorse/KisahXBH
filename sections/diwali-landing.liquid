{%- liquid
  assign sid = section.id
-%}

{%- style -%}
  /* Global reset for Diwali LP to eliminate blank spaces */
  body.template-suffix-diwali #shopify-section-breadcrumbs,
  body.template-suffix-diwali .breadcrumbs-container,
  body.template-suffix-diwali nav.breadcrumbs {
    display: none !important;
  }
  body.template-suffix-diwali #content,
  body.template-suffix-diwali #content > .container {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    background-color: {{ section.settings.bg_color | default: '#fdfcf9' }} !important;
  }

  .diwali-occasions-section-{{ sid }} {
    background-color: {{ section.settings.bg_color | default: '#fdfcf9' }};
    color: {{ section.settings.text_color | default: '#141414' }};
    padding-top: {{ section.settings.pad_top | default: 12 }}px;
    padding-bottom: {{ section.settings.pad_bottom | default: 8 }}px;
    margin: 0 !important;
    position: relative;
  }

  /* Occasion & Category Square/Portrait Cards Rail (Matching HP Style) */
  .diwali-circles-rail-{{ sid }} {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 6px 14px 10px;
    margin: 0 -14px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    box-sizing: border-box;
  }
  .diwali-circles-rail-{{ sid }}::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    .diwali-circles-rail-{{ sid }} {
      justify-content: center;
      gap: 16px;
      margin: 0 auto;
      padding: 10px 0 14px;
      max-width: 100%;
      overflow-x: visible;
    }
  }
  @media (min-width: 992px) {
    .diwali-circles-rail-{{ sid }} {
      justify-content: center;
      gap: 20px;
      margin: 4px auto;
      padding: 10px 0 16px;
      max-width: 100%;
      width: 100%;
      overflow-x: visible;
    }
  }

  .diwali-circle-item-{{ sid }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex: 0 0 calc((100% - 20px) / 3.15);
    width: calc((100% - 20px) / 3.15);
    text-align: center;
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
    transition: transform 0.25s ease;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .diwali-circle-item-{{ sid }} {
      flex: 1 1 0;
      max-width: 190px;
      min-width: 130px;
      width: auto;
      gap: 8px;
    }
  }
  @media (min-width: 992px) {
    .diwali-circle-item-{{ sid }} {
      flex: 1 1 0;
      max-width: 240px;
      min-width: 170px;
      width: auto;
      gap: 10px;
    }
  }
  .diwali-circle-item-{{ sid }}:hover {
    transform: translateY(-4px);
    color: inherit;
  }

  .diwali-circle-img-{{ sid }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    background-color: #f6f3ee;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
    position: relative;
  }
  @media (min-width: 768px) {
    .diwali-circle-img-{{ sid }} {
      border-radius: 8px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }
  }
  @media (min-width: 992px) {
    .diwali-circle-img-{{ sid }} {
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    }
  }
  .diwali-circle-item-{{ sid }}:hover .diwali-circle-img-{{ sid }} {
    transform: scale(1.03);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .diwali-circle-label-{{ sid }} {
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.25;
    color: {{ section.settings.text_color | default: '#141414' }};
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 2px;
  }
  @media (min-width: 768px) {
    .diwali-circle-label-{{ sid }} {
      font-size: 13.5px;
      font-weight: 600;
      margin-top: 4px;
    }
  }
  @media (min-width: 992px) {
    .diwali-circle-label-{{ sid }} {
      font-size: 15px;
      font-weight: 600;
      margin-top: 6px;
    }
  }
{%- endstyle -%}

<div class="section-id-{{ sid }} diwali-occasions-section-{{ sid }}" id="diwali-occasions-{{ sid }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="diwali-circles-rail-{{ sid }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'occasion_circle' -%}
            {%- liquid
              assign circle_img_url = ''
              if block.settings.image != blank
                assign circle_img_url = block.settings.image | image_url: width: 480
              else
                assign btitle_lower = block.settings.title | downcase
                if btitle_lower contains 'new'
                  assign circle_img_url = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/New_Arrivals_f1d9edae-25c9-4f8a-b553-88542e5662ca.png?v=1772169881'
                elsif btitle_lower contains 'puja' or btitle_lower contains 'yellow'
                  assign circle_img_url = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Kurta_87d44b1a-b676-4f63-b4df-3f315b0cab3e.png?v=1772186846'
                elsif btitle_lower contains 'party' or btitle_lower contains 'indo' or btitle_lower contains 'set'
                  assign circle_img_url = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Indowestern_7f38c040-6874-4970-8b35-0acbf3e45227.png?v=1772186846'
                elsif btitle_lower contains 'kid'
                  assign circle_img_url = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Kids_7be95264-57b8-48c3-8619-5887acfd1ffb.png?v=1772169881'
                elsif btitle_lower contains 'plus'
                  assign circle_img_url = 'https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Plus.png?v=1772169881'
                endif
              endif
            -%}
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="diwali-circle-item-{{ sid }}" {{ block.shopify_attributes }}>
              <div class="diwali-circle-img-{{ sid }}" {% if circle_img_url != blank %}style="background-image: url('{{ circle_img_url }}');"{% endif %}></div>
              <span class="diwali-circle-label-{{ sid }}">{{ block.settings.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Diwali Landing Top Fold",
  "tag": "section",
  "class": "section-diwali-landing-top-fold",
  "settings": [
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 8
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfcf9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#141414"
    }
  ],
  "blocks": [
    {
      "type": "occasion_circle",
      "name": "Occasion Circle",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Occasion Title",
          "default": "Diwali Puja"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Occasion Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diwali Landing Top Fold",
      "blocks": [
        {
          "type": "occasion_circle",
          "settings": {
            "title": "New",
            "link": "/collections/new-arrivals"
          }
        },
        {
          "type": "occasion_circle",
          "settings": {
            "title": "Diwali Puja",
            "link": "/collections/yellow"
          }
        },
        {
          "type": "occasion_circle",
          "settings": {
            "title": "Diwali Party",
            "link": "/collections/kurta-sets"
          }
        },
        {
          "type": "occasion_circle",
          "settings": {
            "title": "Diwali Kids",
            "link": "/collections/kids"
          }
        },
        {
          "type": "occasion_circle",
          "settings": {
            "title": "Plus Size",
            "link": "/collections/plus-size"
          }
        }
      ]
    }
  ]
}
{% endschema %}
