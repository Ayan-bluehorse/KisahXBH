@media screen and (max-width:375px){
#shopify-section-{{section.id}} .new-home-page-banner .content-bannner-link a{
   padding: 7px 10px;
}
}
</style>

<script>
window.kisahWhenJQueryReady(function($) {
  function initializeSlick() {
    var slickOptions = {
      dots: true,  
      infinite: false,
      speed: 500,
      autoplay:true,
     autoplaySpeed:3000,
    };

    // Initialize or reinitialize the Slick slider
    var $slider = $('#shopify-section-{{ section.id }} .banner-image-sec');
    if ($slider.hasClass('slick-initialized')) {
      $slider.slick('unslick');
    }
    $slider.slick(slickOptions);
  }

  // Initial check
  initializeSlick();

  // Check on window resize
  $(window).resize(function() {
    initializeSlick();
  });
});

</script>


{% schema %}
  {
    "name": "Wedding Banner",
    "settings": [
      {
        "type": "image_picker",
         "id":"gift-icon",
          "label": "Gift icon"
      },
      {
        "type": "image_picker",
         "id" :"whats-icon",
         "label": "Whats app icon"
      },
      {
        "type": "url",
         "id": "whats-app-link",
          "label": "whats app link"
      },
      {
        "type": "header",
         "content": "SECTION PADDING FOR DESKTOP"
     },
    {
      "type": "range",
      "id": "desk-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "desk-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "SECTION PADDING FOR MOBILE"
    },
    {
      "type": "range",
      "id": "mob-padding-top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob-padding-bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
