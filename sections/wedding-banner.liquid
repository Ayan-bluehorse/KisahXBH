<div class="new-home-page-banner wedding-banner-wrapper">
    <div class="banner-image-sec">
         {% for block in section.blocks %}
            {% assign first = forloop.first %}
               
           <div class="slide wrapping-content {% if first != true %}slick-slide{% endif %}" id="block-{{block.id}}">
            {% if block.settings.button-link != blank %}
                       <a href="{{ block.settings.button-link }}" class="overlay_link"></a>
                     {% endif %} 
           <div class="desk-mob-img-wrap">
               {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" aria-label="Banner Url">
              {% endif %}
               {% if block.settings.mob-img != blank %}
              <img
               src="{{ block.settings.mob-img | image_url: width: 800 }}"
                  srcset="
                {{ block.settings.mob-img | image_url: width: 320 }} 320w,
                {{ block.settings.mob-img | image_url: width: 420 }} 420w,
                {{ block.settings.mob-img | image_url: width: 600 }} 600w"
                 sizes="(max-width: 768px) 100vw"
                  width="420"
                 height="auto"
                 alt="{{ block.settings.mob-img.alt | escape }}"
                class="mob-img"
                loading="eager"
                 fetchpriority="high"
                />
          {% endif %}
          
           {% if block.settings.desk-img != blank %}
            <img
               src="{{ block.settings.desk-img | image_url: width: 2000 }}"
               srcset="
                 {{ block.settings.desk-img | image_url: width: 800 }} 800w,
                 {{ block.settings.desk-img | image_url: width: 1000 }} 1000w,
                 {{ block.settings.desk-img | image_url: width: 1400 }} 1400w"
                 sizes="(min-width: 769px) 100vw"
                 width="1000"
                 height="auto"
                 alt="{{ block.settings.desk-img.alt | escape }}"
                 class="desk-img"
                 loading="eager"
                fetchpriority="high"
             />
            {% endif %}
                {% if block.settings.link != blank %}
                 </a>
                 {% endif %}
                   <div class="butn-para-content position-{{block.settings.position}} mob-pos-{{ block.settings.mob-position }}">
                 <div class="button-with-content">
                   <div class="hide-mobile-cont">
                     <p>{{ block.settings.sub-head}}</p>
                     <h2>{{ block.settings.head }}</h2>
                     <p class="sub-para">{{ block.settings.content }}</p>
                   </div>
                    <div class="content-bannner-link" id="no-{{block.id}}">
                      {% if block.settings.button-link != blank %}
                      <a href="{{ block.settings.button-link }}">{{block.settings.button-name }}</a>
                      {% endif %}
                     </div>
                 </div>
              </div> 
             </div>
             <div class="content-bannner-link mob-link" id="no-{{block.id}}">
                       {% if block.settings.button-link != blank %}
                       <a href="{{ block.settings.button-link }}">{{block.settings.button-name }}</a>
                     {% endif %}    
               </div>
               <style>
             #block-{{block.id}}.wrapping-content{
                 position:relative;
            } 
             #block-{{block.id}} .desk-mob-img-wrap{
                 position:relative;
            } 
                  {% comment %} #block-{{block.id}} .butn-para-content{
                    display:none;
                  } {% endcomment %}
             #block-{{block.id}} .butn-para-content.position-left{
                   display:flex;
                   justify-content:flex-start;
                   width:100%;
                   position:absolute;
                   top:70px; 
                   z-index:9999;
                   padding: 1rem 1rem 1rem 6.2rem;
             }
              #block-{{block.id}} .butn-para-content.position-right{
                   display:flex;
                   justify-content:flex-end;
                   width:100%;
                   position:absolute;
                   top:70px; 
                   z-index:9999;
                   padding: 1rem 6.2rem 1rem 1rem;
             }
             #block-{{block.id}} .butn-para-content.position-bottom{
                   display:flex;
                   align-items:flex-end;
                   justify-content:center;
                   width:100%;
                   position:absolute;
                   bottom:50px;
                   z-index:9999;
                   padding: 1rem 6.2rem 1rem 1rem;
             } 
              #block-{{block.id}} .butn-para-content.position-top{
                   display:flex;
                   align-items:flex-start;
                   justify-content:center;
                   position:absolute;
                   top:50px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 6.2rem 1rem 1rem;
             }
             #block-{{block.id}} .button-with-content .hide-mobile-cont {
                  max-width: 42rem;
                  display:flex;
                  flex-direction:column;
                  position:relative;
             } 
            
           #block-{{block.id}} .button-with-content p{
                  font-size: 36px;
                  font-weight: 400;
                  line-height: 41.41px;
                  text-align: left;
                  color:#ffffff;
                  margin:0;
           }
           #block-{{block.id}} .content-bannner-link{ 
                  max-width: 42rem;
                  margin-top:30px;
                  position:absolute;
                  bottom:20px;
                  left:50%;
                  transform:translate(-50%, -42px);
           }

           .wedding-banner-wrapper .wrapping-content a.overlay_link {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}
            @media screen and (max-width:768px){
              /* #block-{{block.id}} .butn-para-content.position-top, #block-{{block.id}} .butn-para-content.position-bottom,#block-{{block.id}} .butn-para-content.position-right,
              #block-{{block.id}} .butn-para-content.position-left{
                   display:flex;
                   align-items:flex-end;
                   justify-content:center;
                   width:100%;
                   position:absolute;
                   bottom:-1%;
                   left:58%;
                   top:unset;
                   transform:translate(-50%, -50%);
                   z-index:9999;
                   padding: 1rem 6.2rem 1rem 1rem;
             } */
               #block-{{block.id}} .butn-para-content.mob-pos-top{
                   display:flex;
                   align-items:flex-start;
                   justify-content:center;
                   position:absolute;
                   top:50px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 1rem 1rem 1rem;
               }
              #block-{{block.id}} .butn-para-content.mob-pos-center{
                   display:flex;
                   align-items:center;
                   justify-content:center;
                   position:absolute;
                   top:50px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 1rem 1rem 1rem;
               }
                 
              #block-{{block.id}} .butn-para-content.mob-pos-bottom{
                   display:flex;
                   align-items:flex-end;
                   justify-content:center;
                   position:absolute;
                   bottom:75px; 
                   z-index:9999;
                   width:100%;
                   padding: 1rem 1rem 1rem 1rem;
               }
             .butn-para-content.mob-pos-bottom .content-bannner-link{
                   position:fixed;
                   bottom:3%;
                   left:37%;
                   transform:translate(-50%,-50%);
            }
            .butn-para-content.mob-pos-top .content-bannner-link{
                   position:fixed;
                   bottom:3%;
                   left:13%;
                   transform:translate(-50%,-50%);
              }
              .butn-para-content.mob-pos-center .content-bannner-link{
                   position:fixed;
                   bottom:3%;
                   left:63%;
                   transform:translate(-50%,-50%);
             }
            
            }
           </style> 
           </div>
         {% endfor %}
     </div>
     {% if section.settings.whats-icon != blank %}
      <div class="icon-pos-part">
      <a href="{{  }}">
        <img src="{{ section.settings.whats-icon | image_url}}" width="auto" height="auto">
        </a>
     </div>
      {% endif %}
    <div class="icon-width">
      {% if section.settings.gift-icon != blank %}
      <div class="icons-part">
        <a href="#gift-form">
          <img src="{{ section.settings.gift-icon | image_url }}" width="auto" height="auto">
         </a>
      </div>
      {% endif %}
   </div>
</div>


