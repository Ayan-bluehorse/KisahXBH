{% comment %}
  Kisah Homepage - Shop by Category
  - 100% Dynamic Shopify OS 2.0 Section
  - Sharp corners (border-radius: 0)
  - Uses global theme typography: var(--heading-font-family), var(--base-font-family)
  - Desktop: Centered evenly spaced category cards
  - Mobile: Smooth horizontal touch scroll
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign desk_card_size = section.settings.desk_card_size | default: 150
-%}

<section 
  id="shopify-section-{{ sid }}" 
  class="v5-revamp-cats"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.mob_padding_top | default: 16 }}px;
    padding-bottom: {{ section.settings.mob_padding_bottom | default: 12 }}px;
  "
>
  <div class="v5-cats-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="v5-cats-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="v5-cats-rail-wrapper">
        <button 
          type="button" 
          class="v5-cats-arrow v5-cats-arrow--prev is-hidden" 
          data-rail-prev="{{ sid }}" 
          aria-label="Scroll left"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div 
          class="v5-cats-track" 
          id="v5-cats-track-{{ sid }}"
          role="region"
          aria-label="{{ section.settings.heading | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- assign item_link = block.settings.link | default: '#' -%}
            {%- assign item_title = block.settings.title | default: 'Category' -%}
            <a 
              href="{{ item_link }}" 
              class="v5-cat-item" 
              {{ block.shopify_attributes }}
              aria-label="{{ item_title | escape }}"
            >
              <div class="v5-cat-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 360 }}"
                    srcset="{{ block.settings.image | image_url: width: 180 }} 180w,
                            {{ block.settings.image | image_url: width: 280 }} 280w,
                            {{ block.settings.image | image_url: width: 360 }} 360w"
                    sizes="(max-width: 768px) 76px, {{ desk_card_size }}px"
                    alt="{{ item_title | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="{{ desk_card_size }}"
                    height="{{ desk_card_size }}"
                    class="v5-cat-img"
                  >
                {%- else -%}
                  <div class="v5-cat-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>
              <span class="v5-cat-name">{{ item_title }}</span>
            </a>
          {%- endfor -%}
        </div>

        <button 
          type="button" 
          class="v5-cats-arrow v5-cats-arrow--next is-hidden" 
          data-rail-next="{{ sid }}" 
          aria-label="Scroll right"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ sid }} {
    width: 100%;
    display: block;
  }
  .v5-revamp-cats {
    width: 100%;
    box-sizing: border-box;
  }
  .v5-revamp-cats .v5-cats-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
  .v5-revamp-cats .v5-cats-title {
    font-family: var(--heading-font-family);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.15;
    color: #171717;
    text-align: center;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .v5-revamp-cats .v5-cats-rail-wrapper {
    position: relative;
    width: 100%;
  }
  .v5-revamp-cats .v5-cats-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 4px 2px 10px;
  }
  .v5-revamp-cats .v5-cats-track::-webkit-scrollbar {
    display: none;
  }
  .v5-revamp-cats .v5-cat-item {
    flex: 0 0 76px;
    max-width: 76px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: #171717;
    scroll-snap-align: start;
    transition: transform 0.25s ease;
  }
  .v5-revamp-cats .v5-cat-media {
    width: 76px;
    height: 76px;
    border-radius: 0 !important; /* Sharp corners */
    overflow: hidden;
    background: #fbf8f3;
    margin-bottom: 8px;
    position: relative;
    transition: transform 0.25s ease;
  }
  .v5-revamp-cats .v5-cat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    display: block;
    border-radius: 0 !important;
    transition: transform 0.4s ease;
  }
  .v5-revamp-cats .v5-cat-item:hover .v5-cat-media {
    transform: translateY(-2px);
  }
  .v5-revamp-cats .v5-cat-item:hover .v5-cat-img {
    transform: scale(1.05);
  }
  .v5-revamp-cats .v5-cat-name {
    font-family: var(--base-font-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.25;
    color: #171717;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-align: center;
    width: 100%;
  }
  .v5-revamp-cats .v5-cat-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0ece3;
  }
  .v5-revamp-cats .v5-cat-placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  /* Arrows */
  .v5-revamp-cats .v5-cats-arrow {
    display: none;
    position: absolute;
    top: calc(50% - 20px);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.12);
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    cursor: pointer;
    z-index: 2;
    align-items: center;
    justify-content: center;
    color: #171717;
    transition: all 0.2s ease;
  }
  .v5-revamp-cats .v5-cats-arrow:hover {
    background: #171717;
    color: #ffffff;
    border-color: #171717;
  }
  .v5-revamp-cats .v5-cats-arrow--prev {
    left: -12px;
  }
  .v5-revamp-cats .v5-cats-arrow--next {
    right: -12px;
  }
  .v5-revamp-cats .v5-cats-arrow.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .v5-revamp-cats {
      padding-top: {{ section.settings.desk_padding_top | default: 28 }}px !important;
      padding-bottom: {{ section.settings.desk_padding_bottom | default: 24 }}px !important;
    }
    .v5-revamp-cats .v5-cats-title {
      font-size: 32px;
      margin-bottom: 24px;
    }
    .v5-revamp-cats .v5-cats-track {
      gap: 20px;
      justify-content: center;
      padding-bottom: 8px;
    }
    .v5-revamp-cats .v5-cat-item {
      flex: 0 0 {{ desk_card_size | times: 0.85 | round }}px;
      max-width: {{ desk_card_size | times: 0.85 | round }}px;
    }
    .v5-revamp-cats .v5-cat-media {
      width: {{ desk_card_size | times: 0.85 | round }}px;
      height: {{ desk_card_size | times: 0.85 | round }}px;
      margin-bottom: 10px;
    }
    .v5-revamp-cats .v5-cat-name {
      font-size: 13px;
    }
    .v5-revamp-cats .v5-cats-arrow {
      display: flex;
    }
  }

  @media (min-width: 1200px) {
    .v5-revamp-cats .v5-cats-track {
      gap: 24px;
    }
    .v5-revamp-cats .v5-cat-item {
      flex: 0 0 {{ desk_card_size }}px;
      max-width: {{ desk_card_size }}px;
    }
    .v5-revamp-cats .v5-cat-media {
      width: {{ desk_card_size }}px;
      height: {{ desk_card_size }}px;
      margin-bottom: 12px;
    }
    .v5-revamp-cats .v5-cat-name {
      font-size: 14px;
    }
  }
</style>

<script>
  (function() {
    var sid = '{{ sid }}';
    var track = document.getElementById('v5-cats-track-' + sid);
    if (!track) return;
    var prevBtn = document.querySelector('[data-rail-prev="' + sid + '"]');
    var nextBtn = document.querySelector('[data-rail-next="' + sid + '"]');

    function checkArrows() {
      if (!prevBtn || !nextBtn) return;
      var canScroll = track.scrollWidth > track.clientWidth + 4;
      if (!canScroll) {
        prevBtn.classList.add('is-hidden');
        nextBtn.classList.add('is-hidden');
        return;
      }
      var sl = track.scrollLeft;
      var max = track.scrollWidth - track.clientWidth - 4;
      if (sl <= 4) prevBtn.classList.add('is-hidden'); else prevBtn.classList.remove('is-hidden');
      if (sl >= max) nextBtn.classList.add('is-hidden'); else nextBtn.classList.remove('is-hidden');
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -track.clientWidth * 0.7, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: track.clientWidth * 0.7, behavior: 'smooth' });
      });
    }

    track.addEventListener('scroll', checkArrows, { passive: true });
    window.addEventListener('resize', checkArrows, { passive: true });
    setTimeout(checkArrows, 100);
  })();
</script>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "v5-shop-by-category-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desk_card_size",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Desktop Card Size",
      "default": 150
    },
    {
      "type": "range",
      "id": "desk_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "desk_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "mob_padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "mob_padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kurta Sets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}
