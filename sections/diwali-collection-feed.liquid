{%- liquid
  assign sid = section.id
  assign chosen_coll = section.settings.collection
  if chosen_coll.title == blank and section.settings.collection != blank
    assign chosen_coll = collections[section.settings.collection]
  endif
  if chosen_coll == blank or chosen_coll.products_count == 0
    assign chosen_coll = collections['diwali-party']
  endif
  if chosen_coll == blank or chosen_coll.products_count == 0
    assign chosen_coll = collections['festive-collection']
  endif
  if chosen_coll == blank or chosen_coll.products_count == 0
    assign chosen_coll = collections['all']
  endif

  assign products_limit = section.settings.products_per_page | default: 16

  if settings.prod_thumb_shape == 'portrait-23'
    assign chosen_aspect_ratio = 0.67
  elsif settings.prod_thumb_shape == 'portrait-45'
    assign chosen_aspect_ratio = 0.8
  elsif settings.prod_thumb_shape == 'square'
    assign chosen_aspect_ratio = 1.0
  elsif settings.prod_thumb_shape == 'landscape-54'
    assign chosen_aspect_ratio = 1.25
  elsif settings.prod_thumb_shape == 'landscape-32'
    assign chosen_aspect_ratio = 1.50
  else
    assign chosen_aspect_ratio = 0.75
  endif
-%}

<link rel="stylesheet" href="{{ 'collection-filter-sheet.css' | asset_url }}">
<script src="{{ 'collection-filter-sheet.js' | asset_url }}" defer></script>

{%- style -%}
  /* Hide unwanted slider arrow navigation buttons on product cards */
  .image-slider-nav,
  .image-slider-nav button,
  .product-block .image-slider-nav,
  .product-block .image-slider-nav button {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .diwali-feed-section-{{ sid }} {
    background-color: {{ section.settings.bg_color | default: '#fdfcf9' }};
    color: {{ section.settings.text_color | default: '#141414' }};
    padding-top: {{ section.settings.pad_top | default: 16 }}px;
    padding-bottom: {{ section.settings.pad_bottom | default: 32 }}px;
    margin: 0 !important;
    position: relative;
  }

  .cp-diwali-feed-anchor {
    position: relative;
    top: -70px;
    visibility: hidden;
    height: 0;
    width: 0;
    margin: 0;
    padding: 0;
    display: block;
  }

  .diwali-feed-header-{{ sid }} {
    margin-bottom: 14px;
    padding: 0 4px;
  }
  .diwali-feed-header-{{ sid }} .diwali-feed-title {
    margin: 0;
    font-family: var(--font-heading-family, "Bodoni Moda", "Didot", Georgia, serif);
    font-size: clamp(22px, 4.5vw, 30px);
    font-weight: 600;
    line-height: 1.2;
    color: {{ section.settings.text_color | default: '#141414' }};
  }
  .diwali-feed-header-{{ sid }} .diwali-feed-subtitle {
    margin: 4px 0 0;
    font-size: 13px;
    color: #5b5b5b;
  }

  /* Quick filter tabs */
  .diwali-feed-tabs-{{ sid }} {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 2px 4px 14px;
    margin-bottom: 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .diwali-feed-tabs-{{ sid }}::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    .diwali-feed-tabs-{{ sid }} {
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
  }

  .diwali-feed-tab-{{ sid }} {
    display: inline-flex;
    align-items: center;
    padding: 7px 15px;
    border-radius: 99px;
    font-size: 12.5px;
    font-weight: 500;
    border: 1px solid #d6d2ca;
    background: #ffffff;
    color: {{ section.settings.text_color | default: '#141414' }};
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .diwali-feed-tab-{{ sid }}:hover,
  .diwali-feed-tab-{{ sid }}.is-active {
    background: {{ section.settings.text_color | default: '#141414' }};
    color: #ffffff;
    border-color: {{ section.settings.text_color | default: '#141414' }};
  }

  /* Control Row (Sort + Filter Bar) integration */
  .diwali-feed-section-{{ sid }} .kisah-ctrl {
    margin: 4px 0 12px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #e7e3dc;
    box-shadow: 0 1px 4px rgba(32, 23, 71, 0.04);
  }
  .diwali-feed-section-{{ sid }} .kisah-applied {
    margin: -4px 0 12px;
    padding: 2px 2px 6px;
    background: transparent;
  }

  .diwali-feed-container {
    transition: opacity 0.2s ease;
  }
  .diwali-feed-container.is-loading {
    opacity: 0.45;
    pointer-events: none;
  }

{%- endstyle -%}

<span id="all-diwali-styles" class="cp-diwali-feed-anchor"></span>
<div class="section-id-{{ sid }} diwali-feed-section-{{ sid }} cp-navratri-pcarousel" data-pcarousel id="diwali-feed-{{ sid }}">
  <div class="container">

    <!-- Header -->
    <div class="diwali-feed-header-{{ sid }}">
      <h2 class="diwali-feed-title">{{ section.settings.title | default: 'All Diwali styles' }}</h2>
      <p class="diwali-feed-subtitle">{{ section.settings.subtitle | default: 'Sorted by most bought' }}</p>
    </div>

    <!-- Quick Filter Tabs -->
    {%- if section.settings.show_filter_tabs -%}
      <div class="diwali-feed-tabs-{{ sid }}" role="tablist">
        <a href="#all-diwali-styles" class="diwali-feed-tab-{{ sid }} is-active" data-collection-tab="all" role="tab" aria-selected="true">All Styles</a>
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter_tab' -%}
            {%- liquid
              assign tab_coll = collections[block.settings.collection]
              assign tab_url = block.settings.custom_link
              if tab_url == blank and tab_coll != blank
                assign tab_url = tab_coll.url
              endif
              if tab_url == blank
                assign tab_url = '/collections/all'
              endif
            -%}
            <a href="{{ tab_url }}" class="diwali-feed-tab-{{ sid }}" data-collection-tab="{{ block.settings.collection | default: block.id }}" role="tab" aria-selected="false" {{ block.shopify_attributes }}>
              {{ block.settings.title | default: tab_coll.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Filter & Sort Bar (Matching Kisah PLP) -->
    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <div class="kisah-ctrl" data-ajax-container>
        <div class="kisah-ctrl__n"><b><span data-diwali-style-count>{{ chosen_coll.all_products_count | default: chosen_coll.products_count | default: 0 }}</span></b> styles</div>
        {%- if section.settings.enable_sorting -%}
          <button class="kisah-ctrl__btn" id="kisahSortBtn" type="button" aria-label="Sort styles">
            <svg viewBox="0 0 24 24"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg>
            Sort
          </button>
        {%- endif -%}
        {%- if section.settings.enable_sorting and section.settings.enable_filtering -%}
          <span class="kisah-ctrl__rule"></span>
        {%- endif -%}
        {%- if section.settings.enable_filtering -%}
          <button class="kisah-ctrl__btn kisah-ctrl__btn--filter" id="kisahFilterBtn" type="button" data-any="0" aria-label="Filter styles">
            <svg viewBox="0 0 24 24"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
            Filter
          </button>
        {%- endif -%}
      </div>

      <div class="kisah-applied" id="kisahApplied" data-applied-filters style="display: none;"></div>
    {%- endif -%}

    <!-- Main Collection Grid matching main-collection.liquid -->
    <div class="collection-listing diwali-feed-container" data-feed-container>
      {%- paginate chosen_coll.products by products_limit -%}
        {%- liquid
          assign size_map = 'XS:36,S:38,M:40,L:42,XL:44,XXL:46,3XL:48,4XL:50,5XL:52,6XL:54,7XL:56' | split: ','
          assign mapped_s = ''
          assign mapped_m = ''
          assign mapped_l = ''
          assign mapped_xl = ''

          for pair in size_map
            assign p = pair | split: ':'
            assign p_letter = p[0] | downcase | strip
            assign p_number = p[1] | strip

            if p_letter == 's'
              assign mapped_s = p_number
            elsif p_letter == 'm'
              assign mapped_m = p_number
            elsif p_letter == 'l'
              assign mapped_l = p_number
            elsif p_letter == 'xl'
              assign mapped_xl = p_number
            endif
          endfor
        -%}

        <div
          id="product-grid"
          class="product-grid product-grid--per-row-{{ section.settings.grid | default: 4 }} product-grid--per-row-mob-{{ section.settings.grid_mobile | default: 2 }}"
          data-primary-product-grid
          data-current-page="{{ paginate.current_page }}"
          data-total-pages="{{ paginate.pages }}"
          {% if paginate.next %}data-next-page-url="{{ paginate.next.url | escape }}"{% endif %}
        >
          {%- for prod in chosen_coll.products -%}
            {%- liquid
              assign total_variants = prod.variants.size
              assign available_variants = prod.variants | where: 'available', true | size
            -%}
            {%- if available_variants > 0 -%}
              {%- liquid
                assign size_s_available = false
                assign size_m_available = false
                assign size_l_available = false
                assign size_xl_available = false

                for option in prod.options_with_values
                  assign option_name = option.name | downcase | strip
                  if option_name == 'size'
                    for value in option.values
                      assign size_value = value | downcase | strip
                      if size_value == 's' or size_value == 'small' or size_value == mapped_s
                        if value.available
                          assign size_s_available = true
                        endif
                      elsif size_value == 'm' or size_value == 'medium' or size_value == mapped_m
                        if value.available
                          assign size_m_available = true
                        endif
                      elsif size_value == 'l' or size_value == 'large' or size_value == mapped_l
                        if value.available
                          assign size_l_available = true
                        endif
                      elsif size_value == 'xl' or size_value == 'extra large' or size_value == mapped_xl
                        if value.available
                          assign size_xl_available = true
                        endif
                      endif
                    endfor
                    break
                  endif
                endfor

                assign prioritised_loading = false
                if forloop.index <= 4
                  assign prioritised_loading = true
                endif
              -%}
              <div
                class="stock-sort-item"
                data-stock-sort-item
                data-stock-tier="primary"
                data-product-handle="{{ prod.handle }}"
                data-available-variants="{{ available_variants }}"
                data-total-variants="{{ total_variants }}"
                data-option-name="Size"
                data-product-type="{{ prod.type | downcase | strip | escape }}"
                data-size-s-available="{{ size_s_available }}"
                data-size-m-available="{{ size_m_available }}"
                data-size-l-available="{{ size_l_available }}"
                data-size-xl-available="{{ size_xl_available }}"
              >
                {%- render 'product-block', 
                    product: prod, 
                    collection: chosen_coll,
                    custom_aspect_ratio: chosen_aspect_ratio,
                    animate: false,
                    prioritised_loading: prioritised_loading,
                    grid: 4 -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%}---- PASS 2: OUT-OF-STOCK (dimmed, at the bottom) ----{%- endcomment -%}
          {%- for prod in chosen_coll.products -%}
            {%- liquid
              assign total_variants = prod.variants.size
              assign available_variants = prod.variants | where: 'available', true | size
            -%}
            {%- if available_variants == 0 -%}
              <div
                class="stock-sort-item stock-sort-item--oos"
                data-stock-sort-item
                data-stock-tier="out-of-stock"
                data-product-handle="{{ prod.handle }}"
                data-available-variants="0"
                data-total-variants="{{ total_variants }}"
                data-option-name="Size"
                data-product-type="{{ prod.type | downcase | strip | escape }}"
                data-size-s-available="false"
                data-size-m-available="false"
                data-size-l-available="false"
                data-size-xl-available="false"
              >
                {%- render 'product-block', 
                    product: prod, 
                    collection: chosen_coll,
                    custom_aspect_ratio: chosen_aspect_ratio,
                    animate: false,
                    prioritised_loading: false,
                    grid: 4 -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Theme Native Infinite Scroll (Exact pattern from main-collection.liquid) -->
        {% render 'infinite-scroll', paginate: paginate %}
        <div
          id="low-stock-product-grid-{{ section.id }}"
          class="product-grid low-stock-product-grid product-grid--per-row-{{ section.settings.grid | default: 4 }} product-grid--per-row-mob-{{ section.settings.grid_mobile | default: 2 }}"
          data-low-stock-product-grid
          hidden
        ></div>

      {%- endpaginate -%}
    </div>

  </div>
</div>

<!-- Filter Bottom Sheet & Sort Modal Mount Point -->
<div id="diwali-filter-sheet-mount" data-filter-section-id="main-collection">
  <div class="kisah-scrim" id="kisahScrim"></div>
</div>

<script>
  (function () {
    function initDiwaliFeed() {
      var section = document.getElementById('diwali-feed-{{ sid }}');
      if (!section) return;

      var tabs = section.querySelectorAll('.diwali-feed-tab-{{ sid }}');
      var container = section.querySelector('[data-feed-container]');
      var styleCountEl = section.querySelector('[data-diwali-style-count]');
      var filterBtn = document.getElementById('kisahFilterBtn');
      var sortBtn = document.getElementById('kisahSortBtn');
      var appliedContainer = document.getElementById('kisahApplied');
      var sheetMount = document.getElementById('diwali-filter-sheet-mount');

      if (!container) return;

      var currentCollectionUrl = '{{ chosen_coll.url | default: "/collections/festive-collection" }}';
      var activeFilterParams = new URLSearchParams();
      activeFilterParams.set('filter.v.availability', '1');
      var activeSortBy = '';

      var isBusy = false;
      var sheetLoaded = false;
      var cachedSheets = {};

      // 1. Fetch & mount filter sheet + sort modal for a collection URL
      function loadFilterDrawer(collUrl, forceOpenFilter) {
        if (!sheetMount) return;
        var cleanUrl = collUrl.split('?')[0];

        if (cachedSheets[cleanUrl]) {
          applySheetHtml(cachedSheets[cleanUrl], forceOpenFilter);
          return;
        }

        var fetchUrl = cleanUrl + '?filter.v.availability=1';

        fetch(fetchUrl)
          .then(function (res) { return res.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var sheet = doc.getElementById('kisahSheet');
            var sortModal = doc.getElementById('kisahSortModal');
            var scrim = doc.getElementById('kisahScrim');

            // Update style count if present
            var retCountEl = doc.querySelector('.kisah-ctrl__n b') || doc.getElementById('kisahApplyBtn');
            if (retCountEl && styleCountEl && activeFilterParams.toString() === 'filter.v.availability=1') {
              var countText = retCountEl.getAttribute('data-initial-count') || retCountEl.textContent.trim();
              var m = countText.match(/\d[\d,]*/);
              if (m) styleCountEl.textContent = m[0];
            }

            if (sheet && sortModal) {
              cachedSheets[cleanUrl] = {
                sheet: sheet.outerHTML,
                sortModal: sortModal.outerHTML,
                scrim: scrim ? scrim.outerHTML : '<div class="kisah-scrim" id="kisahScrim"></div>'
              };
              applySheetHtml(cachedSheets[cleanUrl], forceOpenFilter);
            }
          })
          .catch(function (err) {
            console.error('Error loading filter drawer:', err);
          });
      }

      function applySheetHtml(sheetData, forceOpenFilter) {
        sheetMount.innerHTML = sheetData.scrim + sheetData.sheet + sheetData.sortModal;
        sheetLoaded = true;

        // Re-initialize collection-filter-sheet.js
        document.dispatchEvent(new CustomEvent('shopify:section:load'));

        // Bind interception for apply, clear all, and sort options
        bindDrawerInterceptors();

        if (forceOpenFilter && typeof window.openKisahSheet === 'function') {
          window.openKisahSheet();
        }
      }

      // 2. Intercept Apply Button, Clear All, and Sort Modal clicks
      function bindDrawerInterceptors() {
        var sheet = document.getElementById('kisahSheet');
        var sortModal = document.getElementById('kisahSortModal');
        var applyBtn = document.getElementById('kisahApplyBtn');
        var clearAllBtn = document.getElementById('kisahClearAll');
        var filterForm = document.getElementById('KisahCollectionFilterForm') || document.getElementById('CollectionFilterForm');

        if (applyBtn && filterForm) {
          applyBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (applyBtn.disabled) return;
            if (typeof window.closeKisahSheet === 'function') {
              window.closeKisahSheet();
            }

            var params = new URLSearchParams();
            filterForm.querySelectorAll('input[type="hidden"]').forEach(function (h) {
              if (h.name && h.value) params.append(h.name, h.value);
            });
            filterForm.querySelectorAll('input[type="checkbox"]:checked').forEach(function (cb) {
              if (cb.name && cb.value) params.append(cb.name, cb.value);
            });
            var minInput = sheet.querySelector('#kisahRngLo');
            var maxInput = sheet.querySelector('#kisahRngHi');
            if (minInput && minInput.hasAttribute('name') && minInput.value) {
              params.append(minInput.name, minInput.value);
            }
            if (maxInput && maxInput.hasAttribute('name') && maxInput.value) {
              params.append(maxInput.name, maxInput.value);
            }

            if (!params.has('filter.v.availability')) {
              params.set('filter.v.availability', '1');
            }
            if (activeSortBy) {
              params.set('sort_by', activeSortBy);
            }

            activeFilterParams = params;
            fetchAndRenderFiltered(currentCollectionUrl, activeFilterParams);
          }, true);
        }

        if (clearAllBtn) {
          clearAllBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (typeof window.closeKisahSheet === 'function') {
              window.closeKisahSheet();
            }

            activeFilterParams = new URLSearchParams();
            activeFilterParams.set('filter.v.availability', '1');
            if (activeSortBy) {
              activeFilterParams.set('sort_by', activeSortBy);
            }
            fetchAndRenderFiltered(currentCollectionUrl, activeFilterParams);
          }, true);
        }

        // Intercept Sort Rows in sort modal
        if (sortModal) {
          sortModal.querySelectorAll('.kisah-row').forEach(function (row) {
            row.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopImmediatePropagation();

              var href = row.getAttribute('href') || '';
              var sortMatch = href.match(/[?&]sort_by=([^&]+)/);
              activeSortBy = sortMatch ? decodeURIComponent(sortMatch[1]) : '';

              if (activeSortBy) {
                activeFilterParams.set('sort_by', activeSortBy);
              } else {
                activeFilterParams.delete('sort_by');
              }

              // Update active highlight in sort modal
              sortModal.querySelectorAll('.kisah-row').forEach(function (r) {
                r.setAttribute('data-on', '0');
                var box = r.querySelector('.kisah-box');
                if (box) box.remove();
              });
              row.setAttribute('data-on', '1');
              var checkSpan = document.createElement('span');
              checkSpan.className = 'kisah-box';
              checkSpan.style.cssText = 'background: var(--kisah-ink); border-color: var(--kisah-ink);';
              checkSpan.innerHTML = '<svg viewBox="0 0 24 24" style="opacity: 1;"><path d="m5 13 4 4L19 7"/></svg>';
              row.appendChild(checkSpan);

              // Update subtitle
              var sortLabelEl = row.querySelector('.kisah-row__l');
              var subtitleEl = section.querySelector('.diwali-feed-subtitle');
              if (sortLabelEl && subtitleEl) {
                subtitleEl.textContent = 'Sorted by ' + sortLabelEl.textContent.trim().toLowerCase();
              }

              if (typeof window.closeKisahSheet === 'function') {
                window.closeKisahSheet();
              }

              fetchAndRenderFiltered(currentCollectionUrl, activeFilterParams);
            });
          });
        }
      }

      // 3. Fetch products with active filters and render
      function fetchAndRenderFiltered(collUrl, params) {
        if (isBusy) return;
        isBusy = true;
        container.classList.add('is-loading');

        var fetchUrl = collUrl;
        var queryStr = params ? params.toString() : '';
        if (queryStr) {
          fetchUrl += (fetchUrl.indexOf('?') === -1 ? '?' : '&') + queryStr;
        }

        fetch(fetchUrl)
          .then(function (res) { return res.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var newListing = doc.querySelector('.collection-listing');
            var contentHtml = '';

            if (newListing) {
              contentHtml = newListing.innerHTML;
            } else {
              var grid = doc.querySelector('#product-grid');
              var inf = doc.querySelector('[data-infinite-scroll]');
              if (grid) {
                contentHtml = grid.outerHTML + (inf ? inf.outerHTML : '');
              }
            }

            if (contentHtml) {
              container.innerHTML = contentHtml;
              if (window.__kisahInfiniteScrollManager && typeof window.__kisahInfiniteScrollManager.boot === 'function') {
                window.__kisahInfiniteScrollManager.boot();
              }
              document.dispatchEvent(new CustomEvent('collection:reloaded'));
            }

            // Update style count
            var countEl = doc.querySelector('.kisah-ctrl__n b') || doc.getElementById('kisahApplyBtn');
            if (countEl && styleCountEl) {
              var countText = countEl.getAttribute('data-initial-count') || countEl.textContent.trim();
              var m = countText.match(/\d[\d,]*/);
              if (m) styleCountEl.textContent = m[0];
            }

            // Update active filter count on Filter button
            var activeFilterCount = 0;
            params.forEach(function (val, key) {
              if (key !== 'filter.v.availability' && key !== 'sort_by' && key !== 'q' && key !== 'page') {
                activeFilterCount++;
              }
            });

            if (filterBtn) {
              filterBtn.setAttribute('data-any', activeFilterCount > 0 ? '1' : '0');
              var pip = filterBtn.querySelector('.kisah-ctrl__pip');
              if (activeFilterCount > 0) {
                if (!pip) {
                  pip = document.createElement('span');
                  pip.className = 'kisah-ctrl__pip';
                  filterBtn.appendChild(pip);
                }
                pip.textContent = activeFilterCount;
              } else if (pip) {
                pip.remove();
              }
            }

            // Update Applied Filters Bar (#kisahApplied)
            var newApplied = doc.getElementById('kisahApplied') || doc.querySelector('.kisah-applied');
            if (appliedContainer) {
              if (newApplied && newApplied.children.length > 0) {
                appliedContainer.innerHTML = newApplied.innerHTML;
                appliedContainer.style.display = 'flex';
                bindAppliedChipClicks();
              } else {
                appliedContainer.innerHTML = '';
                appliedContainer.style.display = 'none';
              }
            }
          })
          .catch(function (err) {
            console.error('Error filtering collection:', err);
          })
          .finally(function () {
            container.classList.remove('is-loading');
            isBusy = false;
          });
      }

      // 4. Handle clicks on applied chips (to remove a single filter or clear all)
      function bindAppliedChipClicks() {
        if (!appliedContainer) return;
        appliedContainer.querySelectorAll('.kisah-achip').forEach(function (chip) {
          chip.addEventListener('click', function (e) {
            e.preventDefault();
            var href = chip.getAttribute('href');
            if (!href) return;

            var qIdx = href.indexOf('?');
            var newParams = new URLSearchParams(qIdx !== -1 ? href.substring(qIdx + 1) : '');
            if (!newParams.has('filter.v.availability')) {
              newParams.set('filter.v.availability', '1');
            }
            if (activeSortBy) {
              newParams.set('sort_by', activeSortBy);
            }

            activeFilterParams = newParams;
            fetchAndRenderFiltered(currentCollectionUrl, activeFilterParams);

            var cleanUrl = currentCollectionUrl.split('?')[0];
            delete cachedSheets[cleanUrl];
            loadFilterDrawer(currentCollectionUrl, false);
          });
        });
      }

      // 5. Filter button click - open sheet (or fetch first if not yet ready)
      if (filterBtn) {
        filterBtn.addEventListener('click', function (e) {
          e.preventDefault();
          if (sheetLoaded && typeof window.openKisahSheet === 'function') {
            window.openKisahSheet();
          } else {
            loadFilterDrawer(currentCollectionUrl, true);
          }
        });
      }

      // 6. Sort button click - open sort modal
      if (sortBtn) {
        sortBtn.addEventListener('click', function (e) {
          e.preventDefault();
          var sortModal = document.getElementById('kisahSortModal');
          var scrim = document.getElementById('kisahScrim');
          if (sortModal && scrim) {
            scrim.dataset.open = '1';
            sortModal.dataset.open = '1';
            document.body.style.overflow = 'hidden';
          } else {
            loadFilterDrawer(currentCollectionUrl, false);
          }
        });
      }

      // 7. Tabs switching - updates currentCollectionUrl and reloads products + filter drawer
      function switchTab(tab, shouldScroll) {
        var key = tab.getAttribute('data-collection-tab') || 'all';
        var url = tab.getAttribute('href');

        tabs.forEach(function (t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        var rail = section.querySelector('.diwali-feed-tabs-{{ sid }}');
        if (rail) {
          rail.scrollTo({
            left: tab.offsetLeft - (rail.offsetWidth / 2) + (tab.offsetWidth / 2),
            behavior: 'smooth'
          });
        }

        if (shouldScroll) {
          var header = section.querySelector('.diwali-feed-header-{{ sid }}');
          if (header) {
            var rect = header.getBoundingClientRect();
            if (rect.top < -20) {
              window.scrollTo({
                top: window.pageYOffset + rect.top - 80,
                behavior: 'smooth'
              });
            }
          }
        }

        currentCollectionUrl = (url && url !== '#' && url !== '#all-diwali-styles') ? url : '{{ chosen_coll.url | default: "/collections/festive-collection" }}';
        activeFilterParams = new URLSearchParams();
        activeFilterParams.set('filter.v.availability', '1');
        if (activeSortBy) {
          activeFilterParams.set('sort_by', activeSortBy);
        }

        if (filterBtn) {
          filterBtn.setAttribute('data-any', '0');
          var pip = filterBtn.querySelector('.kisah-ctrl__pip');
          if (pip) pip.remove();
        }
        if (appliedContainer) {
          appliedContainer.innerHTML = '';
          appliedContainer.style.display = 'none';
        }

        fetchAndRenderFiltered(currentCollectionUrl, activeFilterParams);
        loadFilterDrawer(currentCollectionUrl, false);
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function (e) {
          e.preventDefault();
          switchTab(tab, true);
        });
      });

      // Direct anchor clicks (e.g. occasion cards)
      document.addEventListener('click', function (e) {
        var anchor = e.target.closest('a[href*="#diwali-feed"], a[href*="#all-diwali-styles"], a[data-feed-tab]');
        if (anchor && anchor.getAttribute('data-feed-tab')) {
          var targetTab = section.querySelector('.diwali-feed-tab-{{ sid }}[data-collection-tab="' + anchor.getAttribute('data-feed-tab') + '"]');
          if (targetTab) {
            e.preventDefault();
            switchTab(targetTab, true);
          }
        }
      });

      // Initial hash check
      if (window.location.hash) {
        var hashId = window.location.hash.replace('#', '').replace('tab-', '');
        var initialTab = section.querySelector('.diwali-feed-tab-{{ sid }}[data-collection-tab="' + hashId + '"]');
        if (initialTab) {
          switchTab(initialTab, false);
        }
      }

      // Initial background pre-load of filter drawer
      loadFilterDrawer(currentCollectionUrl, false);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDiwaliFeed);
    } else {
      initDiwaliFeed();
    }
  })();
</script>

