{{ 'navratri.css' | asset_url | stylesheet_tag }}
<script src="{{ 'navratri.js' | asset_url }}" defer></script>


<section class="cp-customer-review-wrapper">
  <h2 class="cp-review-heading">{{ section.settings.heading }}</h2>

  <div class="cp-customer-review-slider">
    {% for block in section.blocks %}
      <div class="cp-review-slide">
        <div class="cp-review-image-wrapper">
          {% if block.settings.image != blank %}
            <img class="cp-review-image" 
                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" src="{{ block.settings.image | image_url }}" 
                 alt="{{ block.settings.author | escape }}">
          {% endif %}
          <div class="cp-review-overlay">
            {% if block.settings.text != blank %}
              <div class="cp-review-text">"{{ block.settings.text }}"</div>
            {% endif %}
            {% if block.settings.author != blank %}
              <div class="cp-review-author">— {{ block.settings.author }}</div>
            {% endif %}
            {% if block.settings.stars != blank %}
             <div class="cp-review-stars">
            {% for i in (1..block.settings.stars) %}
                <svg class="cp-star-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.99967 0.333252L9.05968 4.50659L13.6663 5.17992L10.333 8.42659L11.1197 13.0133L6.99967 10.8466L2.87967 13.0133L3.66634 8.42659L0.333008 5.17992L4.93967 4.50659L6.99967 0.333252Z" fill="#FEA203"/>
                </svg>
            {% endfor %}
            </div>

            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="cp-review-nav-buttons">
    <button class="slick-prev">
      <svg width="14" height="24" viewBox="0 0 14 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.25 22.5L1.75 12L12.25 1.5" stroke="#5C5C5C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="slick-next">
      <svg width="14" height="24" viewBox="0 0 14 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.75 22.5L12.25 12L1.75 1.5" stroke="#5C5C5C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>






{% schema %}
{
  "name": "Navratri Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "CUSTOMER STORIES"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Reviewer Image"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name",
          "default": "Customer Name"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "This is a sample review."
        },
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Navratri Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
