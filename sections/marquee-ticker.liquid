{%- style -%}
  {%- assign text_alpha = section.settings.text_opacity | divided_by: 100.0 -%}
  
  #shopify-section-{{ section.id }} .ticker {
    background: {{ section.settings.bg_color }};
    overflow: hidden;
    padding: {{ section.settings.padding_vertical }}rem 0;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    width: 100%;
  }
  
  #shopify-section-{{ section.id }} .t-track {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    width: max-content;
    flex-shrink: 0;
    animation: tick {{ section.settings.animation_speed }}s linear infinite;
  }
  
  #shopify-section-{{ section.id }} .t-track span.ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    font-size: {{ section.settings.font_size_mobile }}rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: {{ section.settings.text_color | color_modify: 'alpha', text_alpha }};
  }
  
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .t-track span.ticker-item {
      font-size: {{ section.settings.font_size_desktop }}rem;
    }
  }
  
  #shopify-section-{{ section.id }} .t-track b,
  #shopify-section-{{ section.id }} .t-track strong {
    color: {{ section.settings.highlight_color }};
    font-weight: 700;
  }
  
  #shopify-section-{{ section.id }} .tdot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    flex-shrink: 0;
  }
  
  @keyframes tick {
    to { transform: translateX(-50%); }
  }
{%- endstyle -%}

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
  <div class="t-track">
    {%- for i in (1..20) -%}
      {%- for block in section.blocks -%}
        <span class="ticker-item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
          {{ block.settings.text | replace: '[dot]', '<span class="tdot"></span>' }}
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Ticker",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0D0C0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Text Opacity (%)",
      "default": 38
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color (for bold text)",
      "default": "#C07050"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot Separator Color",
      "default": "#8B1A1A"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "s",
      "label": "Animation Speed",
      "default": 28
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 0.4,
      "max": 1.5,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size (Mobile)",
      "default": 0.6
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 0.4,
      "max": 1.5,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size (Desktop)",
      "default": 0.6
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Vertical Padding",
      "default": 0.7
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Your marquee text",
          "info": "Use bold text for the highlight color. Type [dot] to insert the colored dot separator."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Ticker",
      "category": "Custom",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "text": "<strong>The Social Club</strong>[dot]Kisah SS '25"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "Short Kurtas[dot]Fusion Shirts[dot]Camp Shirts"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "For the plans that weren't planned"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "26 Styles[dot]100% Indian Prints"
          }
        }
      ]
    }
  ]
}
{% endschema %}
