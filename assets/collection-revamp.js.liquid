  // ------------- Filter JS (updated) new filter functionality -------------
// - Allows multiple filter groups to stay open
// - Prevents auto-submit/auto-close when a single filter is clicked
// - Adds an "Apply Filters" button so user can select many filters then submit
// ------------------------------------------------

eleReady(".filterHead", function (filHead) {
  if (!window.jQuery) return;

  jQuery(filHead)
    .off("click.cpFilter")
    .on("click.cpFilter", function () {
      var $this = jQuery(this);
      var filTxt = ($this.attr("datatxt") || "").trim();
      var isOpen = $this.hasClass("open");

      // --- Close all first (accordion behavior) ---
      jQuery(".filterHead").removeClass("open");
      jQuery("form#CollectionFilterForm .filter-group").each(function () {
        jQuery(this).removeClass("open");
        jQuery(this)
          .find(".filter-group__heading")
          .addClass("toggle-target-toggler--is-hidden");
        jQuery(this)
          .find(".filter-group__items")
          .addClass("toggle-target--hidden");
      });

      // --- Open the clicked one (if it was not already open) ---
      if (!isOpen) {
        $this.addClass("open");

        jQuery("form#CollectionFilterForm .filter-group").each(function () {
          var filterWrap = (jQuery(this).attr("data-filter-wrap") || "").trim();
          if (filterWrap === filTxt) {
            jQuery(this).addClass("open");
            jQuery(this)
              .find(".filter-group__heading")
              .removeClass("toggle-target-toggler--is-hidden");
            jQuery(this)
              .find(".filter-group__items")
              .removeClass("toggle-target--hidden");
          }
        });
      }

      // --- Availability toggle logic ---
      if ($this.hasClass("availability")) {
        jQuery(".filter-group.filter-group--availability").toggleClass("showDwn");
      } else {
        jQuery(".filter-group.filter-group--availability").removeClass("showDwn");
      }

      deleteCookie("selectSize");

      // --- Show/hide Apply controls based on open state ---
      var openGroups = jQuery("form#CollectionFilterForm .filter-group.open").length;
      toggleApplyControls(openGroups > 0);
    });
});

// URL change observer (unchanged)
(function onUrlChange() {
  if (!window.jQuery) return;
  let lastUrl = location.href;
  new MutationObserver(() => {
    const url = location.href;
    if (url !== lastUrl) {
      lastUrl = url;
      setTimeout(function () {
        jQuery(
          "form#CollectionFilterForm .filter-group toggle-target.filter-group__heading:not(.toggle-target-toggler--is-hidden)"
        ).click();
      }, 600);
    }
  }).observe(document, { subtree: true, childList: true });
})();

// ----------------- Prevent auto-submit + Add Apply button -----------------
(function preventAutoSubmitAndAddApplyBtn() {
  if (!window.jQuery) return;
  var form = document.getElementById("CollectionFilterForm");
  if (!form) return;

  // --- Add actions container ---
  var actionsContainer = form.querySelector(".filter-actions");
  if (!actionsContainer) {
    actionsContainer = document.createElement("div");
    actionsContainer.className = "filter-actions";
    actionsContainer.style.marginTop = "10px";
    actionsContainer.style.display = "none";
    form.appendChild(actionsContainer);
  }

  // --- Apply button ---
  var applyBtn = form.querySelector(".apply-filters-btn");
  if (!applyBtn) {
    applyBtn = document.createElement("button");
    applyBtn.type = "button";
    applyBtn.className = "btn apply-filters-btn";
    applyBtn.textContent = "Apply Filters";
    actionsContainer.appendChild(applyBtn);
  }

  // --- Clear button ---
  var clearBtn = form.querySelector(".clear-filters-btn");
  if (!clearBtn) {
    clearBtn = document.createElement("a");
    clearBtn.href = window.location.pathname;
    clearBtn.className = "clear-filters-btn";
    clearBtn.textContent = "Clear";
    clearBtn.style.marginLeft = "8px";
    actionsContainer.appendChild(clearBtn);
  }

  // --- Toggle Apply Controls visibility ---
  window.toggleApplyControls = function (show) {
    actionsContainer.style.display = show ? "flex" : "none";
  };

  function hideApplyControls() {
    actionsContainer.style.display = "none";
  }

  // --- Prevent auto-submit (for multi-select) ---
  form.addEventListener(
    "change",
    function (e) {
      var t = e.target;
      if (!t) return;
      var isFilterInput =
        t.matches(".filter-group__checkbox") ||
        t.matches('input[name^="filter"]') ||
        t.matches('input[type="checkbox"]') ||
        t.matches('input[type="radio"]') ||
        t.matches("select") ||
        t.matches('input[name*="price"]');
      if (isFilterInput) {
        try {
          if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        } catch (err) {}
        e.stopPropagation();
        toggleApplyControls(true);
        updatePriceFilterHeadState();
      }
    },
    true
  );

  // --- Apply Filters ---
  applyBtn.addEventListener("click", function () {
    hideApplyControls();
    form.submit();
    updatePriceFilterHeadState();
  });

  // --- Clear Filters ---
  clearBtn.addEventListener("click", function (ev) {
    ev.preventDefault();
    var clearUrlInput = form.querySelector('input[name="clear_url"]');
    if (clearUrlInput && clearUrlInput.value) {
      window.location.href = clearUrlInput.value;
      return;
    }
    window.location.href = window.location.pathname;
  });

  // --- Show Apply when clicking label ---
  form.addEventListener("click", function (e) {
    if (e.target.closest && e.target.closest(".filter-group__item")) {
      toggleApplyControls(true);
    }
  });

  // ✅ --- Price Range Active Logic ---
  function updatePriceFilterHeadState() {
    var minInput = form.querySelector('input[name*="price.gte"]');
    var maxInput = form.querySelector('input[name*="price.lte"]');
    var hasValue =
      (minInput && minInput.value.trim() !== "") ||
      (maxInput && maxInput.value.trim() !== "");

    jQuery(".filterHead").each(function () {
      var $head = jQuery(this);
      var dataTxt = ($head.attr("datatxt") || "").trim().toLowerCase();
      if (dataTxt === "price" || dataTxt === "price range") {
        $head.toggleClass("active", hasValue);
      }
    });
  }

  // Detect input typing
  form.addEventListener("input", function (e) {
    if (e.target.matches('input[name*="price"]')) {
      updatePriceFilterHeadState();
    }
  });

  // Run once on load
  document.addEventListener("DOMContentLoaded", updatePriceFilterHeadState);
  document.addEventListener("shopify:section:load", updatePriceFilterHeadState);
  document.addEventListener("ajaxCollectionContentUpdated", updatePriceFilterHeadState);
})();



