/* ===== UPDATED FIX: Keep filter groups open until Apply Filters click ===== */
(function () {
  if (window.innerWidth >= 768) return; // run only on mobile

  function collapseAllGroups() {
    try {
      document.querySelectorAll('form#CollectionFilterForm toggle-target.filter-group__heading')
        .forEach(function (head) {
          var sel = head.getAttribute('data-toggle-target');
          if (!sel) return;
          document.querySelectorAll(sel).forEach(function (panel) {
            panel.classList.add('toggle-target', 'toggle-target--hidden');
            panel.style.display = '';
          });
          head.classList.remove('is-active', 'open', 'toggle-target--active');
          head.setAttribute('aria-expanded', 'false');
        });
      var avail = document.querySelector('.filter-group.filter-group--availability');
      if (avail) avail.classList.remove('showDwn');
      document.querySelectorAll('.topFilterWrap .filtrBx .filterHead').forEach(function (pill) {
        pill.classList.remove('open');
      });
    } catch (e) { /* no-op */ }
  }

  function onReady(cb) {
    var t = setInterval(function () {
      if (document.querySelector('form#CollectionFilterForm')) {
        clearInterval(t);
        cb();
      }
    }, 80);
  }

  onReady(function () {
    // Initially collapse all groups when page loads
    collapseAllGroups();

    // ---- REMOVE: auto-close on every filter change ----
    // Instead of collapsing immediately, just mark filters changed
    var filtersChanged = false;

    document.addEventListener('change', function (e) {
      var inFilters = e.target.closest('form#CollectionFilterForm');
      if (inFilters) {
        filtersChanged = true;
        // Do NOT collapse here — wait for Apply click
      }
    }, true);

    // ---- Keep panel open when user clears or removes a tag ----
    document.addEventListener('click', function (e) {
      if (e.target.closest('.filter-group__applied-item, .filter-group__clear-link')) {
        filtersChanged = true;
        // Don’t collapse immediately
      }
    }, true);

    // ---- Only collapse after user clicks "Apply Filters" button ----
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.apply-filters-btn');
      if (btn) {
        setTimeout(collapseAllGroups, 600);
        filtersChanged = false;
      }
    });

    // ---- Keep filters open after URL change (like via AJAX or Shopify filter load) ----
    // Disable mutation-based collapse
    /*
    var root = document.querySelector('.filters') || document.body;
    var mo = new MutationObserver(function () {
      clearTimeout(mo._t);
      mo._t = setTimeout(collapseAllGroups, 300);
    });
    mo.observe(root, { childList: true, subtree: true });
    */

    // ---- Keep filters open after popstate navigation ----
    window.addEventListener('popstate', function () {
      // Don’t auto-collapse — user might navigate back to filters
    });
  });
})();
