  /* ========== tiny delegate helper (no theme dependency needed) ========== */
  function onDelegate(root, type, selector, handler) {
    root.addEventListener(type, function (e) {
      const el = e.target.closest(selector);
      if (el && root.contains(el)) handler(e, el);
    });
  }

  /* ========== element-ready via MutationObserver (no rAF/interval) ========== */
  (function (win) {
    var listeners = [], doc = win.document, MutationObserver = win.MutationObserver || win.WebKitMutationObserver, observer;
    function ready(selector, fn) {
      listeners.push({ selector, fn });
      if (!observer) {
        observer = new MutationObserver(check);
        observer.observe(doc.documentElement, { childList: true, subtree: true });
      }
      check();
    }
    function check() {
      for (var i = 0; i < listeners.length; i++) {
        var listener = listeners[i];
        var elements = doc.querySelectorAll(listener.selector);
        for (var j = 0; j < elements.length; j++) {
          var el = elements[j];
          if (!el._eleReadyCalled) {
            el._eleReadyCalled = true;
            listener.fn.call(el, el);
          }
        }
      }
    }
    win.eleReady = ready;
  })(this);

