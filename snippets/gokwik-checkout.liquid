{% if settings.goEnable %}
<div class="gokwik-checkout"{% if settings.hideFlow %} style="display:none !important;" {% endif %}>
  <button type='button' class="btn btn--large" onclick="onCheckoutClick(this)">
            <span class="btn-text" >
                <span>{{ settings.main-titile }}</span>
                <span>{{ settings.sub-titile }}</span>
            </span>
           <span class="pay-opt-icon">
             <img width="40" height="24" loading="lazy" src="https://cdn.gokwik.co/v4/images/upi-icons.svg" alt="UPI Payment Options">
             <img width="16" height="16" loading="lazy" src="https://cdn.gokwik.co/v4/images/right-arrow.svg" alt="" aria-hidden="true"> 
         
 </span> 
    <div style="display:none" class="addloadr" id="btn-loader"><div class="cir-loader">Loading..</div></div>
  </button>
</div>
{% endif %}
