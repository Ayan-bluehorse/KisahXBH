{%- comment -%}
  Parameters:
  - share_title {String} - Title of the shared page.
  - shareurl {String} - Permalink of the shared page (relative).
  - shareimage {Object} - Image for the shared page (optional).
  - sharefacebook, shareinstagram, shareprintrest, sharewhatsapp {Boolean}
  - unique_id {String}

  Usage:
  {% capture pdp_share_url %}{% render 'pdp-share-url', product: product %}{% endcapture %}
  {% render 'mobile-soical-share', shareurl: pdp_share_url, ... %}
{%- endcomment -%}
{% assign unique_id = unique_id | default: '' %}
{%- liquid
  assign share_full_url = shop.url | append: shareurl
  assign share_full_url_encoded = share_full_url | url_encode
  assign share_title_encoded = sharetitle | url_param_escape
-%}

<ul class="{{ unique_id }}">
  {%- unless shareprintrest == false -%}
    <li>
      <a class="{{ unique_id }}-links" href="//pinterest.com/pin/create/button/?url={{ share_full_url_encoded }}&amp;media={{ shareimage | image_url: width: 1000 | url_encode }}&amp;description={{ share_title_encoded }}" target="_blank" rel="noopener" title="{{ 'general.social.share_on_pinterest' | t }}">
        <img src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/pinterest_2.png?v=1721279231" width="auto" height="auto">
      </a>
    </li>
  {% endunless %}

  {%- unless sharefacebook == false -%}
    <li>
      <a class="{{ unique_id }}-links" href="//www.facebook.com/sharer.php?u={{ share_full_url_encoded }}" target="_blank" rel="noopener" title="{{ 'general.social.share_on_facebook' | t }}">
        <img src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/facebook.png?v=1721279232" width="auto" height="auto">
      </a>
    </li>
  {%- endunless -%}

  {%- unless shareinstagram == false -%}
    <li>
      <a class="{{ unique_id }}-links" href="https://www.instagram.com/kisah_apparels/?url={{ share_full_url_encoded }}" target="_blank" rel="noopener" aria-label="Instagram">
        <img src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/instagram_1.png?v=1721279232" width="auto" height="auto">
      </a>
    </li>
  {%- endunless -%}

  {% unless sharewhatsapp == false %}
    <li>
      <a class="{{ unique_id }}-links" href="//wa.me/?text={{ share_full_url_encoded }}" target="_blank" rel="noopener" title="{{ 'general.social.share_on_whatsapp' | t }}">
        <img src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/whatsapp_2_1.png?v=1721279232" width="auto" height="auto">
      </a>
    </li>
  {% endunless %}

  <li class="svg-container-class">
    <a href="#" data-share-url="{{ share_full_url | escape }}">
      <img src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/fi-rr-share_1.png?v=1727065246" width="auto" height="auto" class="native-share-img">
    </a>
  </li>
</ul>
