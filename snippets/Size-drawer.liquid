<style>
  /* ---- Size chart: Size Guide / How to Measure ---- */

  /* Mobile only — desktop keeps the drawer's existing typography. */
  @media only screen and (max-width: 768px) {

  /* Typography: the whole drawer runs on Nunito Sans, same as the PDP.
     Two things fight this and both need !important to beat:
       - main.css:27  p { font-family: Generis Sans W01 Regular !important }  (site-wide)
       - the drawer's own table th/td rules above, which ask for Generis Sans
     Icon fonts are excluded so their glyphs still resolve. */
  .size-chart-drawer,
  .size-chart-drawer p,
  .size-chart-drawer h1,
  .size-chart-drawer h2,
  .size-chart-drawer h3,
  .size-chart-drawer h4,
  .size-chart-drawer h5,
  .size-chart-drawer h6,
  .size-chart-drawer ul,
  .size-chart-drawer li,
  .size-chart-drawer div,
  .size-chart-drawer span:not([class*="icon"]):not([class*="wlh-"]),
  .size-chart-drawer a,
  .size-chart-drawer button,
  .size-chart-drawer summary,
  .size-chart-drawer table,
  .size-chart-drawer th,
  .size-chart-drawer td {
    font-family: "Nunito Sans", sans-serif !important;
  }

  /* "How to Measure" list — the one panel that never got the PDP type scale,
     so it inherited the site defaults (Generis for <p>, theme heading for <h3>). */
  .size-chart-drawer .disclosure__content h3 {
    font-size: 14px !important;
    font-weight: 700 !important;
    line-height: 20px !important;
    color: #111 !important;
  }
  .size-chart-drawer .disclosure__content p {
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 20px !important;
    color: #222 !important;
  }
  .size-chart-drawer .disclosure__title p {
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 22px !important;
    color: #000 !important;
  }

  } /* end mobile-only typography */

  .size-chart-drawer .sc-help {
    display: flex; align-items: center; gap: 8px; flex-wrap: nowrap;
    margin: 0 0 18px; padding: 4px 0;
    border: 0; background: transparent;
  }
  .size-chart-drawer .sc-help__link { white-space: nowrap; }
  .size-chart-drawer .sc-help__badge {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 36px; height: 36px; border-radius: 50%; background: #FBF1DC;
  }
  .size-chart-drawer .sc-help__icon { width: 21px; height: 21px; }
  .size-chart-drawer .sc-help__icon--img { object-fit: contain; border-radius: 50%; }
  /* 16px is the spec, but at 375px the two strings alone need 297 of 307px.
     clamp holds 16px wherever it fits and shrinks only to keep one line. */
  .size-chart-drawer .sc-help__text {
    font-family: "Nunito Sans", sans-serif !important;
    font-size: clamp(12px, 3.8vw, 16px) !important; font-weight: 700 !important;
    line-height: 22px; color: #000; white-space: nowrap;
  }
  .size-chart-drawer .sc-help__link {
    font-family: "Nunito Sans", sans-serif !important;
    font-size: clamp(12px, 3.8vw, 16px) !important; font-weight: 700 !important;
    line-height: 22px; color: #B78A2E !important;
    text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px;
  }

  /* folder tabs — the theme styles these with .template-product ... a.tab-a.active-a
     and colour !important, so these need matching weight to win. */
  .size-chart-drawer ul.tabs-btn-container {
    display: flex !important;
    gap: 6px !important;
    width: 100% !important;
    margin: 0 0 18px !important;
    padding: 0 !important;
    list-style: none;
  }
  .size-chart-drawer ul.tabs-btn-container li { flex: 1 1 0; min-width: 0; margin: 0; }
  .size-chart-drawer ul.tabs-btn-container li + li { margin-left: 0; }
  .template-product .size-chart-drawer ul.tabs-btn-container a.tab-a.tab-a,
  .size-chart-drawer ul.tabs-btn-container a.tab-a.tab-a {
    position: relative;
    display: block !important;
    width: 100% !important;
    box-sizing: border-box;
    padding: 12px 8px !important;
    text-align: center;
    border: 1px solid #E9C98F !important;
    border-radius: 10px 10px 0 0;
    background: #FDEFD5 !important;
    font-family: "Nunito Sans", sans-serif !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    line-height: 20px !important;
    color: #111 !important;
    text-decoration: none;
  }
  .template-product .size-chart-drawer ul.tabs-btn-container a.tab-a.tab-a:hover,
  .size-chart-drawer ul.tabs-btn-container a.tab-a.tab-a:hover {
    background: #FDEFD5 !important;
    color: #111 !important;
    border: 1px solid #E9C98F !important;
    border-bottom-color: transparent !important;
  }
  .template-product .size-chart-drawer ul.tabs-btn-container a.tab-a.active-a.active-a,
  .template-product .size-chart-drawer ul.tabs-btn-container a.tab-a.active-a.active-a,
  .size-chart-drawer ul.tabs-btn-container a.tab-a.active-a.active-a {
    background: #FFF !important;
    color: #111 !important;
    border: 1px solid #E9C98F !important;
    border-bottom-color: transparent !important;
  }

  /* uniform inner padding for the whole drawer content */
  .template-product .size-chart-drawer,
  .size-chart-drawer { padding: 42px 24px 32px !important; box-sizing: border-box !important; }
  /* the theme pads .tab as well; drop it so the inset is not doubled */
  .size-chart-drawer .tab { padding-left: 0 !important; padding-right: 0 !important; }

  /* only the active panel shows (the theme rule above has a typo: "display none") */
  .size-chart-drawer .tab { display: none; }
  .size-chart-drawer .tab.tab-active { display: block; }
  /* theme sets .tab width:100% AND padding:0 20px on content-box, overflowing by 40px */
  .size-chart-drawer .tab,
  .size-chart-drawer .sc-help,
  .size-chart-drawer .sc-note-row,
  .size-chart-drawer .sc-table-wrap,
  .size-chart-drawer ul.tabs-btn-container { box-sizing: border-box !important; }
  .size-chart-drawer .sc-note-row {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px;
  }
  .size-chart-drawer .sc-note {
    margin: 0; font-family: "Nunito Sans", sans-serif !important;
    font-size: 14px !important; font-weight: 500 !important; line-height: 17px !important;
    color: #222;
  }
  .size-chart-drawer .sc-units {
    display: flex; flex: none; border: 1px solid #E9C98F; border-radius: 8px; overflow: hidden;
  }
  .size-chart-drawer .sc-unit {
    padding: 7px 16px; border: 0; background: #FDF6E8; cursor: pointer;
    font-family: "Nunito Sans", sans-serif !important; font-size: 14px; font-weight: 600; color: #8A8A8A;
  }
  .size-chart-drawer .sc-unit + .sc-unit { border-left: 1px solid #E9C98F; }
  .size-chart-drawer .sc-unit.is-active { background: #FFF; color: #111; }

  .size-chart-drawer .sc-table-wrap { overflow-x: auto; margin-top: 16px; }
  /* main.css sets border-top/bottom on every th,td and 3px under th */
  .size-chart-drawer .sc-table th,
  .size-chart-drawer .sc-table td { border: 0 !important; }

  .size-chart-drawer .sc-table {
    width: 100%; border-collapse: collapse; table-layout: fixed;
    font-family: "Nunito Sans", sans-serif; font-size: 13px;
  }
  .size-chart-drawer .sc-table th:first-child,
  .size-chart-drawer .sc-table td:first-child { width: 24%; }
  /* the header text is wider than an even share, so widen the column too -
     otherwise it overflows its box and the padding has no visual effect */
  .size-chart-drawer .sc-table th:last-child,
  .size-chart-drawer .sc-table td:last-child { width: 22%; padding-right: 16px !important; }
  .size-chart-drawer .sc-table thead th {
    padding: 12px 4px !important; background: #000 !important; color: #FFF !important;
    font-family: "Nunito Sans", sans-serif !important; font-size: 14px !important;
    font-weight: 700 !important; line-height: 27px !important;
    text-align: center !important; white-space: nowrap;
  }
  .size-chart-drawer .sc-table thead th:first-child { text-align: left; padding-left: 16px; }
  .size-chart-drawer .sc-table tbody th {
    padding: 11px 4px 11px 12px !important; text-align: left !important;
    font-family: "Nunito Sans", sans-serif !important; font-size: 14px !important;
    font-weight: 600 !important; line-height: 27px !important;
    color: #111 !important; white-space: nowrap;
    text-transform: none !important; background: transparent !important;
  }
  .size-chart-drawer .sc-table tbody td {
    padding: 11px 4px !important; text-align: center !important;
    font-family: "Nunito Sans", sans-serif !important; font-size: 14px !important;
    font-weight: 600 !important; line-height: 27px !important; color: #111 !important;
    text-transform: none !important; background: transparent !important;
    font-variant-numeric: tabular-nums;
  }
  /* stripe the row and its cells, so no cell can paint a different colour */
  .size-chart-drawer .sc-table tbody tr:nth-child(even),
  .size-chart-drawer .sc-table tbody tr:nth-child(even) > * { background: #F2F2F4 !important; }
  .size-chart-drawer .sc-table tbody tr:nth-child(odd),
  .size-chart-drawer .sc-table tbody tr:nth-child(odd) > * { background: #FFF !important; }
  .size-chart-drawer .sc-std { display: block; font-size: 11px; font-weight: 400; color: #777; }

  /* title removed by design; the close button stays in this header */
  .size-chart-drawer .size-chart-heading h2 { display: none !important; }
  .size-chart-drawer .size_drawer__close-btn { display: none !important; }

  @media only screen and (max-width: 430px) {
    .size-chart-drawer .sc-help { gap: 7px; padding: 4px 0; }
    /* largest that still keeps the line unbroken at 375px */
    .size-chart-drawer .sc-help__badge { width: 30px; height: 30px; }
    .size-chart-drawer .sc-help__icon { width: 18px; height: 18px; }
    /* size is fixed by spec at 16px; only the badge scales down */
    /* .sc-note size is fixed by spec at 14px */
    .size-chart-drawer .sc-unit { padding: 6px 12px; font-size: 13px; }
    .template-product .size-chart-drawer,
    .size-chart-drawer { padding: 34px 18px 26px !important; }
    .size-chart-drawer .sc-table { font-size: 12px; }
    .size-chart-drawer .sc-table th:first-child,
    .size-chart-drawer .sc-table td:first-child { width: 19%; }
    /* last resort: let a long header wrap rather than overflow */
    .size-chart-drawer .sc-table thead th { padding: 12px 1px !important; }
    .size-chart-drawer .sc-table tbody td { padding: 11px 1px !important; }
    .size-chart-drawer .sc-table tbody th { padding-left: 6px !important; padding-right: 1px !important; }
    /* thead size is fixed by spec at 14px */
    /* body cell size is fixed by spec at 14px */
  }
</style>

