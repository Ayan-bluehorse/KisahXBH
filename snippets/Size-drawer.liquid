<script>
  window.kisahWhenJQueryReady(function($) {
      $('.tab-a').click(function(){
        $(".tab").removeClass('tab-active');
        $(".tab[data-id='"+$(this).attr('data-id')+"']").addClass("tab-active");
        $(".tab-a").removeClass('active-a');
        $(this).parent().find(".tab-a").addClass('active-a');
        return false;
       });

      // in/cm toggle: cells carry inches in data-in
      function kisahApplyUnit(unit) {
        $('.sc-unit').removeClass('is-active');
        $('.sc-unit[data-sc-unit="' + unit + '"]').addClass('is-active');
        $('.sc-table td[data-in]').each(function () {
          var inches = parseFloat($(this).attr('data-in'));
          if (isNaN(inches)) return;
          $(this).text(unit === 'cm' ? Math.round(inches * 2.54 * 10) / 10 : inches);
        });
      }

      $(document).on('click', '.sc-unit', function () {
        kisahApplyUnit($(this).data('sc-unit'));
      });

      // cm is the default, so convert the inch values on load
      kisahApplyUnit($('.sc-unit.is-active').data('sc-unit') || 'in');
  });
</script>
