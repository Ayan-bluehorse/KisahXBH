<style>
  body.scroll{
    overflow:hidden !important;
  }
  body.scroll #sy-whatshelp a.sywh-open-services{
    display: none;
  }
  .template-product .size-chart-drawer .tab{
  	display: none;
      width:100%;
      padding:0 20px;
  }
  .template-product .size-chart-table{
    width:100%;
    overflow:auto;
  }
  .template-product .size-chart-drawer .tab-active{
  	display: block;
  }
  .template-product .size-chart-drawer{
      background: #fff;
      z-index: 9;
      display:flex;
      position:fixed;
      top: 0;
      right: 0;
      padding: var(--gutter-content);
      flex-direction: column;
      align-items: center;
      height: 100%;
      transition: opacity .5s;
      visibility: hidden;
      z-index: 8001;
      width:500px;
      max-width:100%;
      transition: transform .34s ease, visibility .34s ease;
      transform: translate3d(100%, 0, 0);
      outline: 0;
      overflow-y: scroll;
      /* height:1000px; */
  }
  .template-product .size-chart-heading{
     display:flex;
         flex-direction: column;
     justify-content:space-between;
     align-items:center;
     width:100%;
     padding:0 30px;
  }
  .template-product .size-chart-heading svg{
     width:18px;
     height:18px;
  }
  .template-product .size-chart-heading h2{
      font-size:26px;
      line-height:30px;
      margin:30px 0;
      width:100%;
      text-align:center;
  }
  .template-product .size-chart-drawer.open{
      visibility: visible;
      transition: visibility 0s 0s, transform .34s ease;
       transform: translateZ(0);
  }

  .template-product .size-chart-drawer .size_drawer__close-btn{
      position: absolute;
      right: 15px;
      top: 30px;
      background: #d9d9d9;
      border-radius: 50px;
      width:25px;
      height:25px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
  }
  .template-product .size-chart-drawer .overall-content-wraping{
      width:100%;
      padding:0 30px;
  }
  .template-product .size-chart-drawer .size-chart-accordion {
      width: 100%;
  }

  .template-product .size-chart-drawer .disclosure{
    border:none;
    margin-bottom:0;
  }
  .template-product .size-chart-drawer .disclosure__title{
    padding:15px 0;
    cursor:none;
  }
  .template-product .size-chart-drawer .disclosure__title span{
     justify-content: space-between;
      display: flex;
      align-items: center;
  }
  .template-product .size-chart-drawer .disclosure[open] .disclosure__title span svg.pro-dropdown.open {
      transform: rotate(180deg);
  }
  .template-product .size-cart-drawer-overlay{
      visibility: hidden;
      z-index: 8000;
      transition: visibility .3s, z-index 0s .3s, opacity .3s;
      opacity: 0;
      background-color: rgba(var(--modal-overlay-color) / var(--modal-overlay-opacity));
      pointer-events: none;
      position:fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
  }
  .template-product .size-cart-drawer-overlay.is-visible{
      visibility: visible;
      transition: visibility .3s, z-index 0s, opacity .3s;
      opacity: 1;
      pointer-events: initial;
  }
  .template-product .size-chart-drawer li{
    list-style:none !important;
    display:flex;
    align-items:center;
    margin-bottom: 20px;
    gap:15px;
  }
  .template-product .size-chart-drawer li span{
     border: 1px solid;
      border-radius: 50px;
      display: inline-block;
      width: 25px;
      height: 25px;
      text-align: center;
  }
  .template-product .size-chart-drawer li div h3, .size-chart-drawer li div p{
     margin:0 !important;
  }
  .template-product .size-chart-accordion .disclosure__title p{
      font-size:18px;
      line-height:20px;
      margin:0;
      font-weight:600;
      /* pointer-events:none; */
    }
  /* .template-product .size-chart-accordion .disclosure__title p:hover{
     color:#201747;
     font-weight:600;
    } */
  .template-product .size-chart-drawer ul.tabs-btn-container {
      display: flex;
      width: 100%;
      padding: 0 50px;
      justify-content:center;
      gap:20px;
      margin: 20px 0;
  }
  .template-product .size-chart-drawer ul.tabs-btn-container .tab-a{
      border: 1px solid #000;
      width: fit-content;
      padding: 10px;
      color: #000;
      transition: 0.3s;
  }
  .template-product .size-chart-drawer ul.tabs-btn-container a.tab-a:hover{
      background: #201747;
      color: #fff !important;
      border: 1px solid #fff !important;
  }
  .template-product .size-chart-drawer ul.tabs-btn-container a.tab-a.active-a {
      background: #201747;
      color: #fff !important;
      border: 1px solid #fff !important;
  }
  .template-product .size-chart-drawer .size-chart-table table{
      /* border: 1px solid #ddd;
       border-top-left-radius: 5px;
      border-top-right-radius: 5px; */
      width:100%;
  }
  .template-product .size-chart-drawer table th{
       font-size: 14px;
      line-height: 16px;
      font-family: 'Generis Sans W01 Bold';
  }
  .template-product .size-chart-drawer table td {
      font-size: 15px;
      line-height: 17px;
      font-weight: 600;
      color: #000;
      font-family: Generis Sans W01 Regular;
      text-align:center;
      text-transform:uppercase;
  }
  .template-product .size-chart-drawer table th.top-heading {
      text-align: center;
      background: #201747;
      color: #fff;
      border-top-left-radius: 5px;
      border-top-right-radius: 5px;
  }
  .template-product .size-chart-drawer .imge-details img{
      width:100%;
      /* max-width:350px; */
  }
  .template-product .size-chart-drawer .disclosure__content ul{
    margin:0;
  }

  #camweara-find-my-size {
    text-align: center !important;
    background: #201747 !important;
    color: #fff !important;
    border-top-left-radius: 5px !important;
    border-top-right-radius: 5px !important;
    padding: 0.7em !important;
}


  @media only screen and (max-width: 768px) {
  .template-product .size-chart-drawer {
      z-index: 8001;
      bottom: 0;
      left: 0;
      right: 0;
      top:unset;
      height: 80%;
      /* max-height: 450px; /* Adjust this based on your need */ */
      transition: opacity .5s, transform .34s ease, visibility .34s ease;
      visibility: hidden;
      width: 100%;
      transform: translate3d(0, 100%, 0); /* Move off-screen (bottom) */
  }

  .template-product .size-chart-drawer.open {
      visibility: visible;
      transition: visibility 0s 0s, transform .34s ease;
      transform: translate3d(0, 0, 0); /* Slide up into view */
  }
  .template-product .size-chart-drawer .size-chart-heading h2{
      font-size: 22px;
      line-height: 26px;
  }
  .template-product .size-chart-drawer .overall-content-wraping{
      padding: 0 20px;
  }
   .template-product .size-chart-drawer ul.tabs-btn-container{
     margin:5px 0;
   }
  }
</style>



