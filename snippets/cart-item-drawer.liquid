.25737L2.5897 12.0409H3.69289C3.80399 11.6748 4.00395 11.3473 4.26767 11.0826L4.26961 11.0807C4.685 10.6663 5.25785 10.4093 5.88964 10.4093L5.88777 10.4101ZM19.0537 11.9712C19.2565 11.9712 19.4401 12.0534 19.5724 12.1867C19.7048 12.319 19.7869 12.5035 19.7869 12.7054C19.7869 12.9073 19.7038 13.0899 19.5724 13.2222C19.4382 13.3556 19.2556 13.4386 19.0537 13.4386C18.8527 13.4386 18.6692 13.3565 18.5369 13.2242C18.4035 13.0899 18.3205 12.9073 18.3205 12.7054C18.3205 12.5035 18.4026 12.319 18.5349 12.1866C18.6673 12.0543 18.8508 11.9712 19.0537 11.9712ZM5.88777 11.9712C6.09063 11.9712 6.27418 12.0534 6.40653 12.1867C6.53888 12.319 6.62099 12.5035 6.62099 12.7054C6.62099 12.9073 6.53791 13.0899 6.40653 13.2222C6.27225 13.3556 6.0887 13.4386 5.88777 13.4386C5.68587 13.4386 5.50136 13.3565 5.369 13.2242C5.23665 13.0918 5.15358 12.9083 5.15358 12.7054C5.15358 12.5025 5.23569 12.319 5.369 12.1866L5.39798 12.1606C5.52839 12.0427 5.70036 11.9712 5.88777 11.9712ZM8.07098 5.80796C7.86618 5.80796 7.70003 5.64181 7.70003 5.43701C7.70003 5.23221 7.86618 5.06605 8.07098 5.06605H13.6788C13.8836 5.06605 14.0498 5.23221 14.0498 5.43701C14.0498 5.64181 13.8836 5.80796 13.6788 5.80796H8.07098ZM5.88777 5.80796C5.68297 5.80796 5.51681 5.64181 5.51681 5.43701C5.51681 5.23221 5.68297 5.06605 5.88777 5.06605H6.98421C7.189 5.06605 7.35516 5.23221 7.35516 5.43701C7.35516 5.64181 7.189 5.80796 6.98421 5.80796H5.88777ZM9.36262 4.57916C9.15782 4.57916 8.99166 4.41301 8.99166 4.20821C8.99166 4.00341 9.15782 3.83726 9.36262 3.83726H11.851C12.0558 3.83726 12.2219 4.00341 12.2219 4.20821C12.2219 4.41301 12.0558 4.57916 11.851 4.57916H9.36262ZM2.8729 4.58013C2.6681 4.58013 2.50194 4.41398 2.50194 4.20918C2.50194 4.00438 2.6681 3.83822 2.8729 3.83822H8.19658C8.40138 3.83822 8.56754 4.00438 8.56754 4.20918C8.56754 4.41398 8.40138 4.58013 8.19658 4.58013H2.8729ZM5.86576 3.10017C5.66096 3.10017 5.4948 2.93401 5.4948 2.72922C5.4948 2.52442 5.66096 2.35826 5.86576 2.35826H13.0791C13.2839 2.35826 13.45 2.52442 13.45 2.72922C13.45 2.93401 13.2839 3.10017 13.0791 3.10017H5.86576ZM4.41671 3.10017C4.21191 3.10017 4.04576 2.93401 4.04576 2.72922C4.04576 2.52442 4.21191 2.35826 4.41671 2.35826H4.7635C4.9683 2.35826 5.13446 2.52442 5.13446 2.72922C5.13446 2.93401 4.9683 3.10017 4.7635 3.10017H4.41671ZM0.941859 3.54455C0.941859 3.74935 0.775702 3.9155 0.570905 3.9155C0.366109 3.9155 0.199951 3.74935 0.199951 3.54455V3.50011C0.199951 3.29532 0.366109 3.12916 0.570905 3.12916C0.775702 3.12916 0.941859 3.29532 0.941859 3.50011V3.54455ZM21.494 7.74103H17.1303C16.9255 7.74103 16.7593 7.57487 16.7593 7.37008V4.80134H16.1401V12.6H16.7613C16.7883 12.0108 17.0395 11.4775 17.4307 11.0853L17.4327 11.0834C17.848 10.6689 18.4219 10.412 19.0527 10.412C19.6845 10.412 20.2583 10.669 20.6737 11.0844L20.6756 11.0863C21.0668 11.4785 21.3171 12.0108 21.3441 12.6001H22.456V8.4105L21.4929 7.74106L21.494 7.74103ZM17.5012 4.80134V6.99905H20.9442L20.2052 4.80134H17.5002H17.5012ZM20.1511 11.6071C19.871 11.327 19.4826 11.1531 19.0527 11.1531C18.6238 11.1531 18.2345 11.327 17.9553 11.6061C17.6742 11.8873 17.5003 12.2756 17.5003 12.7055C17.5003 13.1354 17.6742 13.5237 17.9534 13.8029C18.2345 14.084 18.6228 14.2579 19.0527 14.2579C19.4826 14.2579 19.871 14.084 20.1501 13.8048C20.4312 13.5237 20.6051 13.1354 20.6051 12.7055C20.6051 12.2766 20.4312 11.8873 20.1511 11.6071ZM6.9852 11.6071C6.70505 11.327 6.31671 11.1531 5.88683 11.1531C5.45694 11.1531 5.0686 11.327 4.78942 11.6061C4.50831 11.8873 4.33443 12.2756 4.33443 12.7055C4.33443 13.1354 4.50832 13.5237 4.78749 13.8029C5.0686 14.084 5.45694 14.2579 5.88683 14.2579C6.31575 14.2579 6.70505 14.084 6.98423 13.8048C7.26534 13.5237 7.43922 13.1354 7.43922 12.7055C7.43922 12.2766 7.26534 11.8873 6.9852 11.6071Z" fill="#0A9528" stroke-width="0.4" stroke="#0A9528"/>
      </svg>
      Free delivery applied
    </div>
    <div class="cart-item__column cart-item__quantity">
      <label class="cart-item__variant cart-item__variant--field">
        <span class="visually-hidden">Variant</span>
        <span class="cart-item__variant-select-wrap">
          <select class="cart-item__variant-select" aria-label="Select product variant">
            {%- for variant in item.product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant.id == item.variant.id %}
                  selected
                {% endif -%}
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {{ variant.title | escape_once }}
              </option>
            {%- endfor -%}
          </select>
        </span>
      </label>

      <div class="quantity buttoned-input">
        <a
          id="updates_dec_{{ forloop.index }}"
          class="quantity-down"
          href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ quantity | minus: 1 }}"
          aria-label="{{ 'cart.items.decrease_quantity' | t | escape }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="4" viewBox="0 0 21 2" fill="none">
            <path d="M1 1H20" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </a>
        <input
          class="cart-item__quantity-input"
          type="number"
          size="2"
          id="updates_{{ forloop.index }}"
          name="updates[]"
          data-initial-value="{{ quantity }}"
          data-key="{{ item.key }}"
          min="0"
          {% if item.variant.inventory_management != blank
            and item.variant.inventory_policy == 'deny'
            and item.variant.inventory_quantity > 0
          %}
            max="{{ item.variant.inventory_quantity }}"
            value="{{ quantity }}"
          {% else %}
            value="{{ quantity }}"
          {% endif %}
          aria-label="{{ 'cart.items.quantity' | t | escape }}"
        />
        <a
          id="updates_inc_{{ forloop.index }}"
          class="quantity-up {% unless can_increase %}unusable{% endunless %}"
          href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ quantity | plus: 1 }}"
          aria-label="{{ 'cart.items.increase_quantity' | t | escape }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 18 18" fill="none">
            <path d="M9 1V17" stroke="currentColor" stroke-linecap="round"></path>
            <path d="M17 9L1 9" stroke="currentColor" stroke-linecap="round"></path>
          </svg>
        </a>
      </div>
    </div>

        {%- if item.variant.inventory_management != blank
          and item.variant.inventory_quantity > 0
          and section.settings.show_inventory_notice != 'never'
        -%}
          {%- if section.settings.show_inventory_notice == 'always'
            or item.variant.inventory_quantity <= section.settings.inventory_threshold
          -%}
            {%- liquid
              assign show_inventory_count = false
              if section.settings.show_inventory_count == 'always'
                assign show_inventory_count = true
              endif
              if section.settings.show_inventory_count == 'low' and item.variant.inventory_quantity <= section.settings.inventory_threshold
                assign show_inventory_count = true
              endif

              if show_inventory_count
                assign notice = item.variant.inventory_quantity | append : ' left'
              else
                if item.variant.inventory_quantity <= section.settings.inventory_threshold
                  assign notice = item.variant.inventory_quantity | append : ' left'
                else
                  assign notice = item.variant.inventory_quantity | append : ' left'
                endif
              endif
            -%}
            <div class="product-info-block custom-item-product-inventory product-inventory product-inventory--small product-inventory--{% if item.variant.inventory_quantity <= section.settings.inventory_threshold %}low{% else %}ok{% endif %}">
                {{- notice -}}
            </div>
          {%- endif -%}
        {%- endif -%}
    {%- liquid
      assign has_size_option = false
      for option in item.product.options_with_values
        assign opt_name = option.name | downcase
        if opt_name == 'size'
          assign has_size_option = true
          break
        endif
      endfor

      assign is_gift_product = false
      assign type_down = item.product.type | downcase
      if type_down contains 'gift' or item.product.handle contains 'gift-box' or item.product.handle == 'rakhi-gift-box-rakhigb-26'
        assign is_gift_product = true
      endif
    -%}

    {% if has_size_option and is_gift_product == false %}
      <button
        type="button"
        class="cart-item__size-guide trigger-pop-up option-selector"
        data-size-guide-target="cart-size-guide-{{ forloop.index }}"
        style="cursor: pointer;"
      >
        {%- comment -%}
          The icon + underlined label are sized by
          product-custom-pdp.css; the default template keeps the plain
          link the theme styles in main.css.
        {%- endcomment -%}
        View Size Guide
      </button>
      {%- assign cart_size_guide_id = 'cart-size-guide-' | append: forloop.index -%}
      {% render 'cart-item-size-drawer', product: item.product, cart_size_guide_id: cart_size_guide_id %}
    {% endif %}
    {% assign product_includes = item.product.metafields.custom.set_includes %}
    {% if product_includes %}
      {%- capture dot_divider -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="3" height="3" viewBox="0 0 3 3" fill="none">
                <circle cx="1.5" cy="1.5" r="1.5" fill="black"/>
            </svg>
        {%- endcapture -%}
      <div class="cart-item__includes"><strong>Includes:</strong><span> {{ product_includes | replace:' : ', dot_divider }}</span></div>
    {% endif %}

    {% if item.line_level_discount_allocations.size > 0 %}
      <div class="cart-item__item-discounts">
        <ul class="cart-discount-list">
          {% for discount_allocation in item.line_level_discount_allocations %}
            <li class="cart-discount cart-discount--inline">
              <span class="cart-discount__label">
                <span class="cart-discount__icon">{% render 'icon-label' %}</span>
                <span class="cart-discount__title">
                  {{- discount_allocation.discount_application.title | escape_once -}}
                </span>
              </span>
              <span class="cart-discount__amount theme-money">{{ discount_allocation.amount | money }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</div>
