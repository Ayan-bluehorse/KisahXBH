{% if settings.envType == 'production' %}
  {% assign env = 'pdp' %}
{% elsif settings.envType == 'sandbox' %}
  {% assign env = 'sandbox.pdp' %}
{% endif %}

{% if settings.goEnable %}
  <script>
    window.gaTag = {ga4: "{{ settings.ga4Gokwik | default: 'G-31X587J1SK' }}"}
    window.merchantInfo  = {
            mid: "{{ settings.mid }}",
            environment: "{{ settings.envType }}",
            type: "merchantInfo",
      		storeId: "{{shop.id}}",
      		fbpixel: "{{settings.fbpixel}}",
          }
    var productFormSelector = '';
    var cart = {{ cart | json }}
    var templateName = '{{template.name}}'
  </script>

  <script src="https://{{ env }}.gokwik.co/merchant-integration/build/merchant.integration.js?v4" defer></script>

  <script>
  let userCountry = "India"; // Default to India for instant protection
  window.userCountry = userCountry;

  const getCountryData = async () => {
    try {
      const res = await fetch("/browsing_context_suggestions.json");
      const json = await res.json();
      userCountry = json?.detected_values?.country_name || "India";
      window.userCountry = userCountry;

      const styleElement = document.createElement("style");
      let css = "";
      if (userCountry === "India") {
        css = ".shopifycheckoutbtn { display: none !important; }";
      } else {
        css = ".gokwik-checkout { display: none !important; } #gokwik-buy-now { display: none !important; }";
      }
      styleElement.textContent = css;
      document.head.appendChild(styleElement);
    } catch (err) {
      console.error("Country fetch failed", err);
      userCountry = "India";
      window.userCountry = userCountry;
    }
  };

  document.addEventListener("DOMContentLoaded", getCountryData);
</script>

<!-- GA Tag Definition for GoKwik Events (Deduplicated: Config is handled strictly once in layout/theme.liquid) -->
<script>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
</script>

<!-- GoKwik Logic -->
<script>
  window.addEventListener('gokwikLoaded', () => {
    const buyNowButton = document.getElementById('gokwik-buy-now');
    if (buyNowButton) {
      buyNowButton.disabled = false;
      buyNowButton.classList.remove('disabled');
    }

    const gokwikCheckoutButtons = document.querySelectorAll('.gokwik-checkout button');
    gokwikCheckoutButtons.forEach(button => {
      button.disabled = false;
      button.classList.remove('disabled');
    });

    if (window.gokwikSdk && typeof window.gokwikSdk.on === 'function') {
      window.gokwikSdk.on('modal_closed', () => {
        window.__gk_clicked = false;
      });
    }
  });

  // Delegated click handler for GoKwik tracking (replaces 700ms listener pile-up)
  document.addEventListener("click", (e) => {
    const btn = e.target.closest("#gokwik-buy-now, .gokwik-checkout button");
    if (!btn) return;

    let gokwikAdsID = "{{ settings.gkAdsConfig }}";
    if (!window.__gk_clicked && gokwikAdsID) {
      window.__gk_clicked = true;
      {% if order and order.total_price %}
      gtag('event', 'conversion', {
        'send_to': gokwikAdsID.toString().trim(),
        'value': {{ order.total_price | divided_by: 100.0 }},
        'currency': '{{ order.shop.currency }}',
        'transaction_id': '{{ order.order_number }}'
      });
      {% endif %}
    }
  }, true);

  // Sync Buy Now disabled state with main add button on form changes
  function syncBuyNowState() {
    const addToCartButton = document.querySelector("button[name='add']");
    const gokwikBuyNowButton = document.getElementById('gokwik-buy-now');
    if (!gokwikBuyNowButton) return;
    if (addToCartButton && (addToCartButton.disabled || addToCartButton.getAttribute('aria-disabled') === 'true')) {
      gokwikBuyNowButton.setAttribute('disabled', 'disabled');
      gokwikBuyNowButton.classList.add('disabled');
    } else {
      gokwikBuyNowButton.removeAttribute('disabled');
      gokwikBuyNowButton.classList.remove('disabled');
    }
  }
  document.addEventListener('change', syncBuyNowState);
  document.addEventListener('click', (e) => {
    if (e.target.closest('.product-form, variant-radios, variant-selects')) {
      setTimeout(syncBuyNowState, 50);
    }
  });

  // Intercept checkout triggers so shoppers in India don't leak into Shopify native checkout
  document.addEventListener('click', function(e) {
    const checkoutTrigger = e.target.closest('a[href*="/checkout"], .checkout-button, [data-helium-name="checkout-button"], button[name="checkout"], .shopifycheckoutbtn');
    if (!checkoutTrigger) return;
    
    // Only intercept for India
    if (window.userCountry && window.userCountry !== 'India') return;
    // Don't intercept if already a GoKwik trigger
    if (checkoutTrigger.closest('.gokwik-checkout') || checkoutTrigger.id === 'gokwik-buy-now') return;

    e.preventDefault();
    e.stopPropagation();

    // Show loading state immediately on the checkout button
    checkoutTrigger.classList.add('is-loading', 'gokwik-loading');
    if (checkoutTrigger.tagName === 'BUTTON' || checkoutTrigger.tagName === 'INPUT') {
      checkoutTrigger.setAttribute('disabled', 'disabled');
    }

    function launchGoKwik() {
      if (window.gokwikSdk && typeof window.gokwikSdk.initCheckout === 'function') {
        window.gokwikSdk.initCheckout(window.merchantInfo);
        setTimeout(function() {
          checkoutTrigger.classList.remove('is-loading', 'gokwik-loading');
          checkoutTrigger.removeAttribute('disabled');
        }, 1500);
      } else {
        window.location.href = '/checkout';
      }
    }

    if (window.gokwikSdk && typeof window.gokwikSdk.initCheckout === 'function') {
      launchGoKwik();
    } else {
      let launched = false;
      const onLoaded = function() {
        if (launched) return;
        launched = true;
        window.removeEventListener('gokwikLoaded', onLoaded);
        launchGoKwik();
      };
      window.addEventListener('gokwikLoaded', onLoaded);
      setTimeout(function() {
        if (!launched) {
          launched = true;
          window.removeEventListener('gokwikLoaded', onLoaded);
          launchGoKwik();
        }
      }, 3500);
    }
  }, true);
</script>



{% endif %}

