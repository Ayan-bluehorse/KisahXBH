   <script>
  let gkButtonCode = `
    <div class="gokwik-checkout" {% if settings.hideFlow %} style="display:none !important;" {% endif %}>
      <button type="button" class="btn-theme" onclick="onCheckoutClick(this)">
        <span class="btn-text">
          <span>{{ settings.main-titile }}</span>
          <span>{{ settings.sub-titile }}</span>
        </span>
        <span class="pay-opt-icon">
          <img width="400" height="400" loading="lazy" src="https://cdn.gokwik.co/v4/images/upi-icons.svg">
          <img width="400" height="400" loading="lazy" src="https://cdn.gokwik.co/v4/images/right-arrow.svg">
        </span>
        <div style="display:none"><div class="cir-loader">Loading..</div></div>
      </button>
    </div>`;
    
  let parsedBtnCode = new DOMParser().parseFromString(gkButtonCode, 'text/html').querySelector('.gokwik-checkout');

  let checkoutLinkHTML = `
    <a href="/checkout"
       style="width:100%;height:45px;background:black;color:white;display:flex;
              justify-content:center;align-items:center;text-decoration:none;
              border-radius:6px;">
      Checkout
    </a>`;
    
  let parsedLink = new DOMParser().parseFromString(checkoutLinkHTML, 'text/html').body.firstElementChild;

  let userCountry = null;

  const sideCartCallback = (mutations) => {
    mutations.forEach(() => {
      const target = document.querySelector('.rebuy-cart__checkout-button');
      if (target && !target.classList.contains('custom-replaced')) {
        const replacement = (userCountry === "India")
          ? parsedBtnCode.cloneNode(true)
          : parsedLink.cloneNode(true);
        replacement.classList.add('custom-replaced');
        target.replaceWith(replacement);
      }
    });
  };

  const observer = new MutationObserver(sideCartCallback);
  const config = { attributes: true, childList: true, subtree: true };
  const targetNode = document.querySelector('html');

  const getCountryData = async () => {
    try {
      const res = await fetch("/browsing_context_suggestions.json");
      const json = await res.json();
      userCountry = json?.detected_values?.country_name || "Other";

      const styleElement = document.createElement("style");
      let css = "";

      if (userCountry === "India") {
        css = ".shopifycheckoutbtn { display: none !important; }";
      } else {
        css = ".gokwik-checkout { display: none !important; } #gokwik-buy-now { display: none !important; }";
      }

      styleElement.textContent = css;
      document.head.appendChild(styleElement);

      // Apply replacement on initial load too
      const btn = document.querySelector('.rebuy-cart__checkout-button');
      if (btn && !btn.classList.contains('custom-replaced')) {
        const replacement = (userCountry === "India")
          ? parsedBtnCode.cloneNode(true)
          : parsedLink.cloneNode(true);
        replacement.classList.add('custom-replaced');
        btn.replaceWith(replacement);
      }

    } catch (err) {
      console.error("Country fetch failed", err);
      userCountry = "Other";
    }
  };

  document.addEventListener("DOMContentLoaded", async () => {
    await getCountryData();
    observer.observe(targetNode, config);
  });
</script>

<!-- GA Tag Tracking -->
<!-- GA Tag Tracking -->
<script>
  (function() {
    var gaId = (window.gaTag && window.gaTag.ga4) ? window.gaTag.ga4 : 'G-31X587J1SK';
    if (gaId && gaId.trim() !== '' && gaId !== 'undefined') {
      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId, { 'groups': 'GA4' });
    }
  })();
</script>

<!-- GoKwik Logic -->
<script>
  window.addEventListener('gokwikLoaded', () => {
    const buyNowButton = document.getElementById('gokwik-buy-now');
    if (buyNowButton) {
      buyNowButton.disabled = false;
      buyNowButton.classList.remove('disabled');
    }

    const gokwikCheckoutButtons = document.querySelectorAll('.gokwik-checkout button');
    gokwikCheckoutButtons.forEach(button => {
      button.disabled = false;
      button.classList.remove('disabled');
    });

    let clicked = false;
    let gokwikAdsID = "{{ settings.gkAdsConfig }}";

    const gokwikCheckoutEnable = (selectors) => {
      selectors.forEach(selector => {
        const elements = document.querySelectorAll(selector);
        elements.forEach(el => {
          el.addEventListener("click", () => {
            if (!clicked && gokwikAdsID) {
              clicked = true;
              gtag('event', 'conversion', {
                'send_to': gokwikAdsID.toString().trim(),
                'value': {{ order.total_price | divided_by: 100.0 }},
                'currency': '{{ order.shop.currency }}',
                'transaction_id': '{{ order.order_number }}'
              });
            }
          });
        });
      });
    };

    gokwikCheckoutEnable(["#gokwik-buy-now", ".gokwik-checkout button"]);

    gokwikSdk.on('modal_closed', () => {
      clicked = false;
    });

    const targetElement = document.querySelector("body");

    function debounce(func, delay) {
      let timeoutId;
      return function () {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => func.apply(this, arguments), delay);
      };
    }

    const observer = new MutationObserver(() => {
      const addToCartButton = document.querySelector("button[name='add']");
      const gokwikBuyNowButton = document.getElementById('gokwik-buy-now');

      if (addToCartButton && addToCartButton.disabled) {
        gokwikBuyNowButton?.setAttribute('disabled', 'disabled');
      } else {
        gokwikBuyNowButton?.removeAttribute('disabled');
      }

      debouncedMyTimer();
    });

    const debouncedMyTimer = debounce(() => {
      observer.disconnect();
      gokwikCheckoutEnable(["#gokwik-buy-now", ".gokwik-checkout button"]);
      gokwikCheckoutButtons.forEach(button => {
        button.disabled = false;
        button.classList.remove('disabled');
      });
      observer.observe(targetElement, { childList: true, subtree: true });
    }, 700);

    observer.observe(targetElement, { childList: true, subtree: true });
  });
</script>



