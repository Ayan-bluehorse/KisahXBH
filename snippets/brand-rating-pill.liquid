{%- comment -%}
  One brand-rating pill, rendered from a `product_brand_rating` metaobject entry.

  Fields read from the entry:
    icon    - Image (File)      the brand logo shown at the far left
    text    - Rich text         the label incl. its own separator, e.g. "Brand Rating  -"
                                (flattened with metafield_text)
    svg     - Image (File)      the rating symbol, e.g. the star
    number  - Integer / Decimal the rating value, e.g. 4.1
    subtext - Single line text  the trailing note incl. brackets, e.g. "(98k)"

  Accepts:
    entry            - {Object} the metaobject entry (required)
    background_color - {String} pill background, falls back to the design default
    text_color       - {String} pill text colour, falls back to the design default

  Usage:
    {%- render 'brand-rating-pill', entry: br -%}
{%- endcomment -%}

{%- liquid
  assign br_icon = entry.icon.value
  assign br_symbol = entry.svg.value
  assign br_number = entry.number.value
  assign br_subtext = entry.subtext.value

  assign br_bg = background_color | default: '#FFF3DA'
  assign br_fg = text_color | default: '#1F1F1F'

  comment
    `text` is a rich-text field. metafield_text flattens it to the plain string the
    pill needs - printing the field directly emits its raw rich-text JSON instead.
  endcomment
  assign br_label = entry.text | metafield_text
  if br_label == blank
    assign br_label = entry.text.value
  endif
  if br_label contains '"type":"root"'
    assign br_label = br_label | split: '"value":"' | last | split: '"' | first
  endif
  assign br_label = br_label | strip

  assign has_label = false
  if br_label != blank
    assign has_label = true
  endif

  assign has_score = false
  if br_symbol != blank or br_number != blank
    assign has_score = true
  endif
-%}

{%- if br_icon != blank or has_label or has_score or br_subtext != blank -%}
  <div class="brand-rating__pill" style="--brand-rating-bg: {{ br_bg }}; --brand-rating-text: {{ br_fg }};">
    {%- if br_icon != blank -%}
      {%- comment -%} File-type fields hand back a generic file, not an image drop {%- endcomment -%}
      <img
        class="brand-rating__logo"
        src="{% if br_icon.width %}{{ br_icon | image_url: width: 120 }}{% else %}{{ br_icon.url }}{% endif %}"
        width="22"
        height="17"
        alt="{{ br_icon.alt | default: '' | escape }}"
        loading="lazy"
      >
    {%- endif -%}

    {%- if has_label -%}
      <span class="brand-rating__label">{{ br_label }}</span>
    {%- endif -%}

    {%- if has_score -%}
      <span class="brand-rating__score">
        {%- if br_symbol != blank -%}
          <img
            class="brand-rating__symbol"
            src="{% if br_symbol.width %}{{ br_symbol | image_url: width: 80 }}{% else %}{{ br_symbol.url }}{% endif %}"
            width="18"
            height="18"
            alt=""
            loading="lazy"
          >
        {%- else -%}
          <svg class="brand-rating__symbol brand-rating__symbol--fallback" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M10 1.6l2.47 5.3 5.53.66-4.08 3.9 1.07 5.94L10 14.5l-4.99 2.9 1.07-5.94L2 7.56l5.53-.66z"/>
          </svg>
        {%- endif -%}

        {%- if br_number != blank -%}
          <span class="brand-rating__value">{{ br_number }}</span>
        {%- endif -%}
      </span>
    {%- endif -%}

    {%- if br_subtext != blank -%}
      <span class="brand-rating__subtext">{{ br_subtext }}</span>
    {%- endif -%}
  </div>
{%- endif -%}
