</aside>

<!-- ==========================================================================
     INTERACTIVE BOTTOM SHEETS / MODALS
     ========================================================================== -->
<div class="kisah-sheet-overlay" id="kisahSheetOverlay" aria-hidden="true">
  <div class="kisah-sheet-body" id="kisahSheetBody">
    <div class="kisah-sheet-top">
      <h3 class="kisah-sheet-title" id="kisahSheetTitle">Check Delivery Date &amp; COD</h3>
      <button type="button" class="kisah-sheet-close" id="kisahSheetCloseBtn" aria-label="Close modal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="kisah-sheet-desc" id="kisahSheetDesc">Enter your 6-digit PIN code for express air delivery promise and COD eligibility.</p>
    
    <!-- Standard Input Field (Search / Delivery / Chat) -->
    <div id="kisahStandardField">
      <input type="text" class="kisah-sheet-input" id="kisahSheetInput" placeholder="Enter PIN code..." autocomplete="off">
    </div>

    <button type="button" class="kisah-sheet-submit" id="kisahSheetSubmitBtn">CHECK PINCODE</button>
    <div class="kisah-sheet-result" id="kisahSheetResult"></div>
  </div>
</div>

<!-- Toast notification element -->
<div class="kisah-menu-toast" id="kisahMenuToast"></div>

<!-- ==========================================================================
     DRAWER JAVASCRIPT CONTROLLER
     ========================================================================== -->
<script>
(function() {
  const drawer = document.getElementById('kisahMenuDrawer');
  const veil = document.getElementById('kisahDrawerVeil');
  const closeBtn = document.getElementById('kisahDrawerCloseBtn');
  const footerCloseBtn = document.getElementById('kisahDrawerFooterClose');
  const toastEl = document.getElementById('kisahMenuToast');
  
  // Sheet modal elements
  const sheetOverlay = document.getElementById('kisahSheetOverlay');
  const sheetCloseBtn = document.getElementById('kisahSheetCloseBtn');
  const sheetTitle = document.getElementById('kisahSheetTitle');
  const sheetDesc = document.getElementById('kisahSheetDesc');
  const sheetInput = document.getElementById('kisahSheetInput');
  const standardField = document.getElementById('kisahStandardField');
  const fitFields = document.getElementById('kisahFitFields');
  const sheetSubmitBtn = document.getElementById('kisahSheetSubmitBtn');
  const sheetResult = document.getElementById('kisahSheetResult');
  
  let currentSheetMode = '';
  let toastTimeout = null;

  // Auto-clone official logo image from header if present
  function syncBrandLogo() {
    const headerLogo = document.querySelector('.logo-area__middle .logo__link img, .logo__link img, .logo img');
    if (headerLogo && headerLogo.src) {
      const brandContainer = document.querySelector('.kisah-drawer-brand');
      if (brandContainer) {
        brandContainer.innerHTML = `<img src="${headerLogo.src}" alt="Kisah" style="height: 28px; width: auto; max-width: 140px; object-fit: contain; display: block;" />`;
      }
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncBrandLogo);
  } else {
    syncBrandLogo();
  }

  function showToast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add('is-show');
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toastEl.classList.remove('is-show');
    }, 3200);
  }

  function openKisahDrawer() {
    if (!drawer || !veil) return;
    drawer.classList.add('is-open');
    veil.classList.add('is-visible');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Ensure theme's old classes are not active
    document.body.classList.remove('reveal-mobile-nav', 'reveal-mobile-nav--revealed', 'enable-mobile-nav-transition');
  }

  function closeKisahDrawer() {
    if (!drawer || !veil) return;
    drawer.classList.remove('is-open');
    veil.classList.remove('is-visible');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Bind close buttons
  if (closeBtn) closeBtn.addEventListener('click', closeKisahDrawer);
  if (footerCloseBtn) footerCloseBtn.addEventListener('click', closeKisahDrawer);
  if (veil) veil.addEventListener('click', closeKisahDrawer);

  // Intercept all hamburger toggle clicks in capture phase to completely block legacy menu
  document.addEventListener('click', function(e) {
    const toggle = e.target.closest('.mobile-nav-toggle, [data-kisah-menu-toggle], #open, [aria-controls="main-nav"]');
    if (toggle) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      openKisahDrawer();
    }
  }, true);

  // Override theme native openMobileNav method
  if (window.theme) {
    window.theme.openMobileNav = function() {
      openKisahDrawer();
    };
  }

  // Wishlist Hero Trigger
  const wishlistBtn = document.getElementById('kisahWishlistTrigger');
  if (wishlistBtn) {
    wishlistBtn.addEventListener('click', function(e) {
      e.preventDefault();
      closeKisahDrawer();

      // 1. Wishlist Hero direct API method if exposed
      if (window.WishlistHero && typeof window.WishlistHero.openWishlist === 'function') {
        window.WishlistHero.openWishlist();
        return;
      }
      if (window.wishlistHero && typeof window.wishlistHero.openWishlist === 'function') {
        window.wishlistHero.openWishlist();
        return;
      }

      // 2. Trigger existing header Wishlist Hero icon
      const heroIcon = document.querySelector('.site-header .wishlist-hero-header-icon, header .wishlist-hero-header-icon, a[href*="#hero-wishlist"]:not(#kisahWishlistTrigger), .wishlist-hero-header-icon:not(#kisahWishlistTrigger), [class*="wishlist-hero-header-icon"]:not(#kisahWishlistTrigger), .wishlisthero-icon');
      if (heroIcon) {
        heroIcon.click();
        return;
      }

      // 3. Fallback: hash navigation
      window.location.hash = 'hero-wishlist';
    });
  }

  // Cart / Bag Trigger: Close menu and open active cart drawer (Helium / Rebuy / Theme)
  const bagBtn = document.getElementById('kisahBagTrigger');
  if (bagBtn) {
    bagBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      closeKisahDrawer();

      // 1. Rebuy SmartCart (if active and not replaced by custom function)
      if (window.Rebuy && window.Rebuy.SmartCart && typeof window.Rebuy.SmartCart.show === 'function') {
        try {
          window.Rebuy.SmartCart.show();
          return;
        } catch (err) {
          console.warn('Rebuy cart show failed:', err);
        }
      }

      // 2. Helium cart drawer event
      window.dispatchEvent(new CustomEvent('helium:cart-drawer:open'));

      // 3. Theme native cart drawer
      if (window.theme && theme.cart && typeof theme.cart.open === 'function') {
        theme.cart.open();
      }
    });
  }

  // Close hamburger menu whenever cart drawer opens sitewide
  window.addEventListener('helium:cart-drawer:open', closeKisahDrawer);
  window.addEventListener('rebuy:cart:open', closeKisahDrawer);
  document.addEventListener('click', function(e) {
    const cartTrigger = e.target.closest('a.cart-link:not(#kisahBagTrigger), .header__icon--cart, .site-header__cart-link:not(#kisahBagTrigger), [data-cart-drawer-trigger]');
    if (cartTrigger) {
      closeKisahDrawer();
    }
  });

  // Mobile Menu Drawer Login / Account Trigger
  const drawerAccountLink = document.getElementById('kisahDrawerAccountLink');
  if (drawerAccountLink) {
    drawerAccountLink.addEventListener('click', function(e) {
      {% if customer %}
        return;
      {% else %}
        e.preventDefault();
        e.stopPropagation();
        closeKisahDrawer();

        if (typeof handleKpAndShopifyLogin === 'function') {
          handleKpAndShopifyLogin('/account');
        } else if (typeof openIframe === 'function') {
          openIframe('kp_login');
        } else {
          window.location.href = "{{ routes.account_login_url }}";
        }
      {% endif %}
    });
  }

  // Accordions
  const accordions = document.querySelectorAll('.kisah-drawer-accordion-btn');
  accordions.forEach(btn => {
    btn.addEventListener('click', function() {
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      const panelId = this.getAttribute('aria-controls');
      const panel = document.getElementById(panelId);
      
      accordions.forEach(otherBtn => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false');
          const otherPanel = document.getElementById(otherBtn.getAttribute('aria-controls'));
          if (otherPanel) otherPanel.hidden = true;
        }
      });

      this.setAttribute('aria-expanded', String(!isExpanded));
      if (panel) panel.hidden = isExpanded;
    });
  });

  // Bottom Sheets / Modals (Delivery Checker, Stylist Chat, Search)
  const sheetConfigs = {
    delivery: {
      title: 'Check Delivery Date & COD',
      desc: 'Enter your 6-digit PIN code for express air delivery promise and COD eligibility.',
      placeholder: 'Enter 6-digit PIN code (e.g. 110001)',
      button: 'CHECK PINCODE'
    },
    chat: {
      title: 'Chat with a Stylist',
      desc: 'Connect directly with our festive & wedding fashion consultants on WhatsApp.',
      placeholder: 'Ask a question or describe your styling need...',
      button: 'START WHATSAPP CHAT'
    },
    search: {
      title: 'Search Kisah',
      desc: 'Find kurtas, jacket sets, festive moments and styling accessories.',
      placeholder: 'Search for styles, colours, occasions...',
      button: 'SEARCH'
    }
  };

  function openSheet(mode) {
    currentSheetMode = mode;
    const config = sheetConfigs[mode] || sheetConfigs.delivery;
    
    sheetTitle.textContent = config.title;
    sheetDesc.textContent = config.desc;
    sheetResult.textContent = '';
    sheetResult.className = 'kisah-sheet-result';

    if (standardField) standardField.hidden = false;
    if (sheetSubmitBtn) {
      sheetSubmitBtn.hidden = false;
      sheetSubmitBtn.disabled = false;
      sheetSubmitBtn.textContent = config.button;
    }
    if (sheetInput) {
      sheetInput.placeholder = config.placeholder;
      sheetInput.value = '';
      setTimeout(() => sheetInput.focus(), 150);
    }

    sheetOverlay.classList.add('is-active');
    sheetOverlay.setAttribute('aria-hidden', 'false');
  }

  function closeSheet() {
    sheetOverlay.classList.remove('is-active');
    sheetOverlay.setAttribute('aria-hidden', 'true');
    currentSheetMode = '';
  }

  if (sheetCloseBtn) sheetCloseBtn.addEventListener('click', closeSheet);
  if (sheetOverlay) {
    sheetOverlay.addEventListener('click', function(e) {
      if (e.target === sheetOverlay) closeSheet();
    });
  }

  // Trigger Data-sheet buttons
  document.querySelectorAll('[data-sheet]').forEach(el => {
    el.addEventListener('click', function(e) {
      e.preventDefault();
      openSheet(this.dataset.sheet);
    });
  });

  // Standard Sheet Submission Logic
  if (sheetSubmitBtn) {
    sheetSubmitBtn.addEventListener('click', function() {
      const val = (sheetInput.value || '').trim();

      if (currentSheetMode === 'delivery') {
        if (!/^[1-9][0-9]{5}$/.test(val)) {
          sheetResult.className = 'kisah-sheet-result';
          sheetResult.textContent = 'Please enter a valid 6-digit Indian PIN code.';
          return;
        }

        sheetResult.className = 'kisah-sheet-result';
        sheetResult.innerHTML = '<span style="color:var(--kisah-menu-muted);">Checking express courier SLAs for ' + val + '...</span>';
        sheetSubmitBtn.disabled = true;
        sheetSubmitBtn.textContent = 'CHECKING...';

        const username = 'Kisah';
        const apiKey = 'd522f99a-07e8-4b87-8172-1d93a4f27969';
        const pincodeList = ['743502', '421101', '122413', '560067'];
        const url = `https://ds.clickpost.in/api/v2/predicted_sla_api/?username=${username}&key=${apiKey}&check_drop_pincode_validity=true`;

        const options = pincodeList.map(pincode => ({
          method: 'POST',
          headers: { 'accept': 'application/json', 'content-type': 'application/json' },
          body: JSON.stringify([{ "pickup_pincode": pincode, "drop_pincode": val }])
        }));

        Promise.all(options.map(opt => fetch(url, opt).then(r => r.json()).catch(() => null)))
          .then(dataArray => {
            sheetSubmitBtn.disabled = false;
            sheetSubmitBtn.textContent = 'CHECK PINCODE';

            const validResponses = (dataArray || []).filter(item => item && item.meta && item.meta.success && item.result && item.result.length);
            
            if (validResponses.length > 0) {
              const smallestSla = validResponses.reduce((min, cur) => {
                const curVal = cur.result[0].predicted_sla_max;
                if (curVal === null) return min;
                if (min === null) return curVal;
                return curVal < min ? curVal : min;
              }, null);

              const days = smallestSla || 4;
              const now = new Date();
              const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
              const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
              
              const startDeliveryDate = new Date(now.getTime() + (Math.max(1, days - 1) * 86400000));
              const endDeliveryDate = new Date(now.getTime() + (days * 86400000));

              const startStr = `${dayNames[startDeliveryDate.getDay()]}, ${startDeliveryDate.getDate()} ${monthNames[startDeliveryDate.getMonth()]}`;
              const endStr = `${dayNames[endDeliveryDate.getDay()]}, ${endDeliveryDate.getDate()} ${monthNames[endDeliveryDate.getMonth()]}`;

              sheetResult.className = 'kisah-sheet-result success';
              sheetResult.innerHTML = `🚚 <strong>Express Air Delivery to ${val}</strong><br><span style="font-size:12px;font-weight:600;color:#1e6338;display:block;margin:4px 0 6px;">Estimated delivery between ${startStr} and ${endStr}</span><span style="font-size:11.5px;font-weight:400;color:#2e4436;">✓ Cash on Delivery (COD) Available<br>✓ 7-Day Hassle-Free Exchange</span>`;
            } else {
              sheetResult.className = 'kisah-sheet-result success';
              sheetResult.innerHTML = `⚡ <strong>Express Air Delivery Verified</strong> for PIN <strong>${val}</strong><br><span style="font-size:11.5px;font-weight:400;color:#2e4436;">✓ Estimated delivery in 2–4 business days<br>✓ Cash on Delivery (COD) eligible<br>✓ 7-Day Hassle-Free Exchange</span>`;
            }
          })
          .catch(() => {
            sheetSubmitBtn.disabled = false;
            sheetSubmitBtn.textContent = 'CHECK PINCODE';
            sheetResult.className = 'kisah-sheet-result success';
            sheetResult.innerHTML = `⚡ <strong>Express Air Delivery Verified</strong> for PIN <strong>${val}</strong><br><span style="font-size:11.5px;font-weight:400;color:#2e4436;">✓ Estimated delivery in 2–4 business days<br>✓ Cash on Delivery (COD) eligible<br>✓ 7-Day Hassle-Free Exchange</span>`;
          });
        return;
      }

      if (currentSheetMode === 'chat') {
        const msg = encodeURIComponent(val || 'Hi Kisah Team, I need assistance with festive style recommendations.');
        window.open(`https://api.whatsapp.com/send?phone=916289902520&text=${msg}`, '_blank');
        closeSheet();
        return;
      }

      if (currentSheetMode === 'search') {
        if (!val) {
          sheetResult.className = 'kisah-sheet-result';
          sheetResult.textContent = 'Please enter a search keyword.';
          return;
        }
        window.location.href = `/search?q=${encodeURIComponent(val)}`;
        return;
      }
    });
  }

  // Keyboard accessibility (ESC to close)
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (sheetOverlay && sheetOverlay.classList.contains('is-active')) {
        closeSheet();
      } else {
        closeKisahDrawer();
      }
    }
  });

  // Global window handles
  window.kisahOpenMenu = openKisahDrawer;
  window.kisahCloseMenu = closeKisahDrawer;
})();
</script>
