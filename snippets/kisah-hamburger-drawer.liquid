{% comment %}
  ==========================================================================
  KISAH LUXURY MENU DRAWER (PRODUCTION SPEC)
  - Real Store Logo from official Kisah brand asset
  - Global Store Typography: var(--nav-font-family), var(--heading-font-family)
  - Native Mobile Smooth Scrolling: flex: 1, min-height: 0, touch-action: pan-y
  - Crisp Vector SVGs for all arrows, chevrons, close and search icons
  - Global Search: native {{ routes.search_url }} integration, instant chips & autocomplete
  - GoKwik KwikPass Account Trigger: 1-click OTP login / order history
  - Interactive Delivery Date & COD Pincode Checker tool
  - GA4 select_promotion & view_promotion dataLayer event tracking
  ==========================================================================
{% endcomment %}

<style>
  :root {
    --d-bg: #fbf4ef;
    --d-ink: #2b2222;
    --d-ink-2: #6b5a57;
    --d-line: #ead9cf;
    --d-head: #8a2b47;
    --d-chip: #ffffff;
    --navy: #201747;
    --teal: #201747;
    --teal-dark: #160f33;
    --f-ui: var(--nav-font-family, var(--base-font-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif));
    --f-head: var(--heading-font-family, "Lora", Georgia, serif);
    --f-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  /* CRITICAL: Suppress legacy default theme white mobile drawer */
  .mobile-navigation-drawer,
  body.reveal-mobile-nav .mobile-navigation-drawer,
  .pageheader .mobile-navigation-drawer,
  #pageheader .mobile-navigation-drawer,
  .navigation__mobile-header,
  .mobile-navigation-drawer-template,
  .header-shade,
  body.reveal-mobile-nav .header-shade {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateX(-100%) !important;
  }

  /* Background Page Lock when Drawer is Open */
  html.kisah-drawer-open,
  body.kisah-drawer-open {
    overflow: hidden !important;
    touch-action: none !important;
  }
  html.kisah-drawer-open .kisah-drawer-wrap,
  body.kisah-drawer-open .kisah-drawer-wrap,
  html.kisah-drawer-open .kisah-d-scroll,
  body.kisah-drawer-open .kisah-d-scroll {
    touch-action: pan-y !important;
    pointer-events: auto !important;
  }

  /* Drawer Backdrop Scrim */
  .kisah-scrim {
    position: fixed;
    inset: 0;
    background: rgba(15, 10, 20, 0.52);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.28s;
    z-index: 99990;
  }
  .kisah-scrim.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Drawer Wrap Container */
  .kisah-drawer-wrap {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    height: 100%;
    height: 100dvh;
    width: 360px;
    max-width: 88vw;
    background: var(--d-bg);
    color: var(--d-ink);
    font-family: var(--f-ui);
    transform: translateX(-102%);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 99995;
    display: flex;
    flex-direction: column;
    box-shadow: 6px 0 28px rgba(0, 0, 0, 0.22);
    box-sizing: border-box;
    overflow: hidden; /* Header fixed, scroll inside */
  }
  .kisah-drawer-wrap.is-open {
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .kisah-drawer-wrap, .kisah-scrim { transition: none !important; }
  }

  /* Drawer Top Bar with Real Logo */
  .kisah-d-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--d-line);
    background: var(--d-bg);
    flex-shrink: 0;
    z-index: 2;
  }
  .kisah-d-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }
  .kisah-d-logo-img {
    max-height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
  }
  .kisah-d-icon-btn {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    color: var(--d-ink);
    padding: 0;
    transition: background 0.15s ease;
  }
  .kisah-d-icon-btn:hover,
  .kisah-d-icon-btn:active {
    background: rgba(32, 23, 71, 0.08);
  }
  .kisah-d-icon-btn:focus-visible {
    outline: 2px solid #201747;
  }

  /* Drawer Scrollable Content Area: 100% functional scroll */
  .kisah-d-scroll {
    flex: 1 1 auto;
    min-height: 0 !important; /* CRITICAL for flexbox scrolling */
    overflow-y: scroll !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    touch-action: pan-y !important;
    overscroll-behavior-y: contain !important;
    padding: 8px 16px 110px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-sizing: border-box;
  }
  .kisah-d-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .kisah-d-scroll::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.16);
    border-radius: 4px;
  }

  /* Search Box */
  .kisah-d-sbox {
    position: relative;
    margin: 4px 0 8px;
  }
  .kisah-d-sform {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid var(--d-line);
    border-radius: 10px;
    padding: 0 10px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .kisah-d-sform:focus-within {
    border-color: #201747;
    box-shadow: 0 0 0 3px rgba(32, 23, 71, 0.15);
  }
  .kisah-d-sbtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: #776c69;
  }
  .kisah-d-sinput {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    flex: 1;
    font: 400 14px var(--f-ui) !important;
    padding: 10px 0 !important;
    background: transparent !important;
    color: var(--d-ink) !important;
    min-width: 0;
    margin: 0 !important;
  }
  .kisah-d-sinput::placeholder {
    color: #92837f;
  }
  .kisah-d-sclear {
    border: none;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: #555;
    padding: 0;
  }

  /* Search Suggestions & Chips */
  .kisah-d-sugg {
    background: #ffffff;
    border: 1px solid var(--d-line);
    border-radius: 10px;
    margin-top: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }
  .kisah-d-sugg h4 {
    margin: 0;
    font: 600 11px var(--f-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--d-ink-2);
  }
  .kisah-d-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .kisah-d-chip {
    border: 1px solid var(--d-line);
    background: var(--d-bg);
    border-radius: 99px;
    padding: 4px 11px;
    font: 500 12.5px var(--f-ui);
    color: var(--d-ink);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .kisah-d-chip:hover,
  .kisah-d-chip:active {
    background: #ffffff;
    border-color: #201747;
    color: #201747;
  }
  .kisah-d-slist {
    display: flex;
    flex-direction: column;
  }
  .kisah-d-slist a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 4px;
    color: var(--d-ink);
    text-decoration: none;
    font-size: 13.5px;
    border-radius: 6px;
    transition: background 0.15s ease;
  }
  .kisah-d-slist a:hover {
    background: var(--d-bg);
    color: var(--d-head);
  }
  .kisah-d-slist small {
    color: var(--d-ink-2);
    font-size: 11px;
    text-transform: uppercase;
  }

  /* Section Headings */
  .kisah-d-dh {
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 16px;
    color: var(--d-head);
    margin: 10px 0 4px;
  }
  .kisah-d-helph {
    font-family: var(--f-head);
    font-weight: 600;
    font-size: 15px;
    color: var(--d-head);
    margin: 18px 0 4px;
  }

  /* Category Tiles */
  .kisah-d-tile {
    display: grid;
    grid-template-columns: 46px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 6px 4px;
    border-radius: 8px;
    text-decoration: none !important;
    color: var(--d-ink) !important;
    font-size: 14.5px;
    font-weight: 500;
    transition: background 0.15s ease;
  }
  .kisah-d-tile img {
    width: 46px;
    height: 46px;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    background: #eee;
    display: block;
    flex-shrink: 0;
  }
  .kisah-d-tile:hover,
  .kisah-d-tile:active,
  .kisah-d-row:hover,
  .kisah-d-row:active {
    background: rgba(32, 23, 71, 0.08);
  }
  .kisah-d-tile:active,
  .kisah-d-row:active {
    color: #201747 !important;
  }

  /* Crisp SVG Arrow styling */
  .kisah-d-arrow {
    color: #b9a59d;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .kisah-d-chevron {
    color: #b9a59d;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [aria-expanded="true"] .kisah-d-chevron {
    transform: rotate(180deg);
  }
  .kisah-hero-arrow {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #201747;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .kisah-d-tile:hover .kisah-hero-arrow,
  .kisah-d-tile:active .kisah-hero-arrow {
    background: #160f33;
    transform: scale(1.05);
  }

  /* Festive Pills (2 columns) */
  .kisah-d-pills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 8px 0 6px;
  }
  .kisah-d-pill {
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    border: 1px solid #d9b9a8;
    border-radius: 8px;
    padding: 10px 6px;
    text-decoration: none !important;
    color: var(--d-head) !important;
    font-family: var(--f-head);
    font-weight: 600;
    font-size: 13.5px;
    background: rgba(255, 255, 255, 0.55);
    text-align: center;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .kisah-d-pill:hover {
    background: rgba(255, 255, 255, 0.95);
    border-color: #c9a896;
  }

  /* Navigation Rows & Accordions */
  .kisah-d-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 4px;
    border-bottom: 1px solid var(--d-line);
    text-decoration: none !important;
    color: var(--d-ink) !important;
    font-size: 14.5px;
    font-weight: 500;
    border-radius: 0;
    cursor: pointer;
    background: none;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    width: 100%;
    font-family: var(--f-ui);
    text-align: left;
    box-sizing: border-box;
    transition: background 0.15s ease;
  }
  .kisah-d-row.sub {
    padding-left: 14px;
    font-size: 14px;
    color: var(--d-ink-2) !important;
  }
  .kisah-d-row.help {
    font-size: 13.5px;
    color: var(--d-ink-2) !important;
  }
  .kisah-d-row small {
    display: block;
    margin-top: 2px;
    color: var(--d-ink-2);
    font-size: 12px;
    font-weight: 400;
  }
  .kisah-d-acc-panel {
    display: flex;
    flex-direction: column;
  }
  .kisah-d-acc-panel[hidden] {
    display: none !important;
  }

  /* Colour Swatch Dot */
  .kisah-color-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 8px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    vertical-align: middle;
    flex-shrink: 0;
  }

  /* Interactive Pincode Delivery Card */
  .kisah-d-pincode-card {
    background: #ffffff;
    border: 1px solid var(--d-line);
    border-radius: 10px;
    padding: 12px;
    margin: 6px 0 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .kisah-d-pincode-desc {
    font-size: 13px;
    color: var(--d-ink);
    font-weight: 500;
  }
  .kisah-d-pincode-form {
    display: flex;
    gap: 8px;
  }
  .kisah-d-pincode-input {
    flex: 1;
    border: 1px solid var(--d-line) !important;
    border-radius: 6px !important;
    padding: 8px 10px !important;
    font-size: 13.5px !important;
    font-family: var(--f-ui) !important;
    outline: none !important;
    background: var(--d-bg) !important;
    color: var(--d-ink) !important;
  }
  .kisah-d-pincode-input:focus {
    border-color: #201747 !important;
    box-shadow: 0 0 0 3px rgba(32, 23, 71, 0.15) !important;
    background: #ffffff !important;
  }
  .kisah-d-pincode-btn {
    background: #201747;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font: 600 13px var(--f-ui);
    cursor: pointer;
    transition: opacity 0.15s ease, background 0.15s ease;
  }
  .kisah-d-pincode-btn:hover,
  .kisah-d-pincode-btn:active {
    background: #160f33;
    opacity: 0.95;
  }
  .kisah-d-pincode-result {
    font-size: 12.5px;
    line-height: 1.45;
    padding: 8px 10px;
    border-radius: 6px;
    border-left: 3px solid #137a3a;
    background: #eef7f0;
    color: #137a3a;
  }
  .kisah-d-pincode-result.error {
    border-left-color: #c0302f;
    background: #fdf0f0;
    color: #c0302f;
  }
  .kisah-d-pincode-note {
    font-size: 11px;
    color: #888;
    line-height: 1.4;
  }
</style>

<!-- Backdrop Scrim -->
<div class="kisah-scrim" id="kisahMenuScrim" aria-hidden="true"></div>

<!-- Mobile Drawer Container -->
<nav class="kisah-drawer-wrap" id="kisahMenuDrawer" aria-label="Main menu" aria-hidden="true">
  <!-- Top Bar with Official Kisah Logo & Close Icon -->
  <div class="kisah-d-top">
    <a href="{{ routes.root_url }}" class="kisah-d-logo" aria-label="{{ shop.name }}">
      <img src="https://kisah.in/cdn/shop/files/Group_63_1.png?v=1715841265&width=300"
           alt="{{ shop.name }}"
           width="112"
           height="32"
           loading="eager"
           class="kisah-d-logo-img">
    </a>
    <button type="button" class="kisah-d-icon-btn" id="kisahMenuCloseBtn" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Scrollable Body with Native Momentum Scrolling -->
  <div class="kisah-d-scroll" id="kisahMenuScroll">
    <!-- Global Search Box -->
    <div class="kisah-d-sbox">
      <form class="kisah-d-sform" id="kisahMenuSearchForm" action="{{ routes.search_url }}" method="get" role="search">
        <button type="submit" class="kisah-d-sbtn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#776c69" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <input class="kisah-d-sinput" id="kisahMenuSearchInput" name="q" type="search" placeholder="Search kurtas, sets, colours" autocomplete="off" aria-label="Search Kisah">
        <button type="button" class="kisah-d-sclear" id="kisahMenuSearchClear" aria-label="Clear search" hidden>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </form>
      <div class="kisah-d-sugg" id="kisahMenuSearchSugg" hidden></div>
    </div>

    <!-- Shop by category Heading -->
    <div class="kisah-d-dh">Shop by category</div>
    <div id="kisahMenuCats">
      <!-- 1. Kurta Sets (Hero Tile) -->
      <a class="kisah-d-tile hero" href="/collections/kurta-sets" data-slot="1" data-list="shop_by_category" data-label="Kurta Sets">
        <img alt="Kurta Sets" src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Kurta_Set_beba450f-de96-4d49-b86f-72a76542b43c.png?v=1772186847" width="46" height="46" loading="lazy">
        <span>Kurta Sets</span>
        <span class="kisah-hero-arrow" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>

      <!-- 2. Kurtas & Short Kurtas -->
      <a class="kisah-d-tile" href="/collections/kurta-short-kurta" data-slot="2" data-list="shop_by_category" data-label="Kurtas & Short Kurtas">
        <img alt="Kurtas & Short Kurtas" src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Kurta_87d44b1a-b676-4f63-b4df-3f315b0cab3e.png?v=1772186846" width="46" height="46" loading="lazy">
        <span>Kurtas &amp; Short Kurtas</span>
        <span class="kisah-hero-arrow" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>

      <!-- 3. Nehru Jackets -->
      <a class="kisah-d-tile" href="/collections/nehru-jackets" data-slot="3" data-list="shop_by_category" data-label="Nehru Jackets">
        <img alt="Nehru Jackets" src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Nehru_Jacket_ed302a75-b311-409a-af38-fac220c5debd.png?v=1772186848" width="46" height="46" loading="lazy">
        <span>Nehru Jackets</span>
        <span class="kisah-hero-arrow" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>

      <!-- 4. Kurta Jacket Sets -->
      <a class="kisah-d-tile" href="/collections/kurtajacketset" data-slot="4" data-list="shop_by_category" data-label="Kurta Jacket Sets">
        <img alt="Kurta Jacket Sets" src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/Kurta_Jacket_Set.png?v=1772186847" width="46" height="46" loading="lazy">
        <span>Kurta Jacket Sets</span>
        <span class="kisah-hero-arrow" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>

    <!-- Festive Pills: Wedding & Diwali Parties -->
    <div class="kisah-d-pills">
      <a class="kisah-d-pill" href="/collections/wedding" data-slot="1" data-list="festive_pills" data-label="Wedding">
        <span aria-hidden="true">❖</span>Wedding
      </a>
      <a class="kisah-d-pill" href="/collections/diwali-party" data-slot="2" data-list="festive_pills" data-label="Diwali Party">
        <span aria-hidden="true">✧</span>Diwali Party
      </a>
    </div>

    <!-- Quick Links: Bestsellers & New arrivals -->
