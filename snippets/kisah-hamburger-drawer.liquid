<script>
(function() {
  'use strict';

  const drawer = document.getElementById('kisahMenuDrawer');
  const scrim = document.getElementById('kisahMenuScrim');
  const closeBtn = document.getElementById('kisahMenuCloseBtn');
  const scrollWrap = document.getElementById('kisahMenuScroll');
  const searchInput = document.getElementById('kisahMenuSearchInput');
  const searchClear = document.getElementById('kisahMenuSearchClear');
  const searchSugg = document.getElementById('kisahMenuSearchSugg');
  const searchForm = document.getElementById('kisahMenuSearchForm');

  const POPULAR = ['short kurta', 'kurta', 'black kurta', 'jodhpuri', 'sherwani', 'indo western', 'kurta set', 'white kurta', 'bandhgala', 'pathani', 'dupatta', 'dhoti'];
  const SHORTCUTS = [
    ['Kurta Sets', '/collections/kurta-sets', 'kurta set sets wedding yellow silk'],
    ['Kurtas & Short Kurtas', '/collections/kurta-short-kurta', 'kurta short kurtas mid daily casual'],
    ['Nehru Jackets', '/collections/nehru-jackets', 'nehru jacket jackets bundi'],
    ['Kurta Jacket Sets', '/collections/kurtajacketset', 'kurta jacket set sets 3 piece'],
    ['Wedding Collection', '/collections/wedding', 'wedding groom sangeet haldi'],
    ['Diwali Party', '/collections/diwali-party', 'party diwali evening black silk'],
    ['Jodhpuri & Bandhgala', '/collections/jodhpuri-bandhgala', 'jodhpuri bandhgala royal'],
    ['Sherwani & Achkans', '/collections/sherwani-achkans', 'sherwani achkan groom royal'],
    ['Indo-Western', '/collections/indowestern-sets', 'indo western indowestern modern'],
    ['Dupatta Sets', '/collections/kurta-set-with-dupatta', 'dupatta stole sets'],
    ['Kids Ethnic Wear', '/collections/kids', 'kids boys child children'],
    ['Plus Sizes', '/collections/plus', 'plus size 3xl 4xl 5xl big']
  ];

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function logAnalytics(eventName, params) {
    if (typeof window.dataLayer !== 'undefined') {
      window.dataLayer.push({
        event: eventName,
        ecommerce: params
      });
    }
  }

  function openDrawer() {
    if (!drawer || !scrim) return;
    drawer.classList.add('is-open');
    scrim.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');

    // Lock page background while keeping drawer scrollable
    document.documentElement.classList.add('kisah-drawer-open');
    document.body.classList.add('kisah-drawer-open');

    // Remove legacy theme drawer states
    document.body.classList.remove('reveal-mobile-nav', 'reveal-mobile-nav--revealed', 'enable-mobile-nav-transition');

    // Update account login state
    updateAccountState();

    logAnalytics('view_promotion', { promotion_name: 'menu_drawer', page_type: 'mobile_menu' });
  }

  function closeDrawer() {
    if (!drawer || !scrim) return;
    drawer.classList.remove('is-open');
    scrim.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');

    document.documentElement.classList.remove('kisah-drawer-open');
    document.body.classList.remove('kisah-drawer-open');
  }

  // Intercept all hamburger clicks across desktop and mobile header
  document.addEventListener('click', function(e) {
    const toggle = e.target.closest('.mobile-nav-toggle, [data-kisah-menu-toggle], #burger, #open, [aria-controls="main-nav"]');
    if (toggle) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      openDrawer();
    }
  }, true);

  window.openKisahDrawer = openDrawer;
  window.closeKisahDrawer = closeDrawer;

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (scrim) scrim.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('is-open')) {
      closeDrawer();
    }
  });

  // Accordion Expand/Collapse Handler
  drawer.addEventListener('click', function(e) {
    const accBtn = e.target.closest('[data-acc]');
    if (accBtn) {
      const targetId = accBtn.getAttribute('aria-controls');
      const panel = document.getElementById(targetId);
      const isExpanded = accBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      accBtn.setAttribute('aria-expanded', String(nextState));
      if (panel) panel.hidden = !nextState;
      return;
    }

    // Search Chip Click: Instant Global Search
    const chip = e.target.closest('.kisah-d-chip');
    if (chip) {
      const q = chip.dataset.q;
      if (q) {
        logAnalytics('search', { search_term: q, source: 'menu_chip' });
        window.location.href = '{{ routes.search_url }}?q=' + encodeURIComponent(q);
      }
      return;
    }

    // Promotion Click Tracking
    const promoLink = e.target.closest('a[data-slot]');
    if (promoLink) {
      logAnalytics('select_promotion', {
        promotion_name: 'menu_drawer',
        creative_name: promoLink.dataset.list || 'nav_item',
        creative_slot: promoLink.dataset.slot || '1',
        promotion_id: promoLink.dataset.label || promoLink.textContent.trim(),
        link_url: promoLink.getAttribute('href')
      });
    }
  });

  // GoKwik / KwikPass Account Trigger Integration
  const accountTriggers = drawer.querySelectorAll('.kisah-d-account-trigger');
  accountTriggers.forEach(function(el) {
    el.addEventListener('click', function(e) {
      e.preventDefault();
      closeDrawer();

      const hasCustomer = {% if customer %}true{% else %}false{% endif %};
      if (hasCustomer) {
        window.location.href = '{{ routes.account_url }}';
        return;
      }

      // Check GoKwik Kwikpass handlers
      if (typeof window.handleKpAndShopifyLogin === 'function') {
        window.handleKpAndShopifyLogin('/account');
      } else {
        const kpLogo = document.getElementById('kp-login-button-header-logo') || document.querySelector('#kp-login-button-header-logo');
        if (kpLogo) {
          kpLogo.click();
        } else {
          window.location.href = '{{ routes.account_url }}';
        }
      }
    });
  });

  function updateAccountState() {
    const hasCustomer = {% if customer %}true{% else %}false{% endif %};
    let token = null;
    if (typeof getValueFromCookiesOrLocalStorage === 'function' && typeof XGokwikCoreToken === 'function' && window.merchantInfo) {
      token = getValueFromCookiesOrLocalStorage(XGokwikCoreToken(window.merchantInfo.environment));
    }
    const label = drawer.querySelector('.kisah-d-account-label');
    if (label) {
      if (hasCustomer || token) {
        label.textContent = 'My Account & Orders';
      } else {
        label.textContent = 'Account / Sign in';
      }
    }
  }
  window.addEventListener('gokwikLoaded', updateAccountState);
  window.addEventListener('update-dom', updateAccountState);

  // Search Live Suggestions
  function showSearchSuggestions() {
    if (!searchInput || !searchSugg) return;
    const q = (searchInput.value || '').trim().toLowerCase();

    if (searchClear) {
      searchClear.hidden = (q.length === 0);
    }

    if (!q) {
      searchSugg.innerHTML = '<h4>Popular searches</h4><div class="kisah-d-chips">' +
        POPULAR.map(function(p) {
          return '<button type="button" class="kisah-d-chip" data-q="' + escapeHtml(p) + '">' + escapeHtml(p) + '</button>';
        }).join('') + '</div>';
    } else {
      const matches = SHORTCUTS.filter(function(s) {
        return s[0].toLowerCase().includes(q) || s[2].includes(q) || q.split(' ').some(function(w) { return w.length > 2 && s[2].includes(w); });
      }).slice(0, 4);

      const searchAllUrl = '{{ routes.search_url }}?q=' + encodeURIComponent(q);
      searchSugg.innerHTML = '<div class="kisah-d-slist">' +
        '<a href="' + escapeHtml(searchAllUrl) + '" data-slot="0" data-list="search" data-label="search">' +
          '<span>Search &ldquo;' + escapeHtml(q) + '&rdquo;</span><small>all products →</small>' +
        '</a>' +
        matches.map(function(s, i) {
          return '<a href="' + escapeHtml(s[1]) + '" data-slot="' + (i + 1) + '" data-list="search_suggest" data-label="' + escapeHtml(s[0]) + '">' +
            '<span>' + escapeHtml(s[0]) + '</span><small>collection</small>' +
          '</a>';
        }).join('') +
        '</div>';
    }
    searchSugg.hidden = false;
  }

  if (searchInput) {
    searchInput.addEventListener('focus', showSearchSuggestions);
    searchInput.addEventListener('input', showSearchSuggestions);
    searchInput.addEventListener('blur', function() {
      setTimeout(function() {
        if (searchSugg && document.activeElement !== searchInput) {
          searchSugg.hidden = true;
        }
      }, 250);
    });
  }

  if (searchClear) {
    searchClear.addEventListener('click', function() {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        showSearchSuggestions();
      }
    });
  }

  if (searchForm) {
    searchForm.addEventListener('submit', function(e) {
      const q = (searchInput && searchInput.value || '').trim();
      if (!q) {
        e.preventDefault();
        return;
      }
      logAnalytics('search', { search_term: q, source: 'menu_drawer' });
    });
  }

  // Interactive Pincode Delivery Checker
  const pinInput = document.getElementById('kisahMenuPincodeInput');
  const pinBtn = document.getElementById('kisahMenuPincodeBtn');
  const pinResult = document.getElementById('kisahMenuPincodeResult');

  // Restore remembered pincode
  try {
    const savedPin = localStorage.getItem('kisah_user_pincode');
    if (savedPin && pinInput) pinInput.value = savedPin;
  } catch(err) {}

  function checkPincode() {
    if (!pinInput || !pinResult) return;
    const pin = (pinInput.value || '').trim();
    if (!/^[1-9][0-9]{5}$/.test(pin)) {
      pinResult.hidden = false;
      pinResult.className = 'kisah-d-pincode-result error';
      pinResult.innerHTML = '<strong>Invalid PIN code</strong><br>Please enter a valid 6-digit Indian delivery PIN code.';
      return;
    }

    try {
      localStorage.setItem('kisah_user_pincode', pin);
    } catch(err) {}

    pinResult.hidden = false;
    pinResult.className = 'kisah-d-pincode-result';
    pinResult.innerHTML = '<strong>✓ Serviceable to ' + escapeHtml(pin) + '</strong><br>' +
      '• Express delivery: <strong>2–4 business days</strong><br>' +
      '• Cash on Delivery (COD): <strong>Available</strong><br>' +
      '• Free delivery on all orders';
  }

  if (pinBtn) pinBtn.addEventListener('click', checkPincode);
  if (pinInput) {
    pinInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        checkPincode();
      }
    });
  }

  // Expose global open/close helpers
  window.kisahOpenMenu = openDrawer;
  window.kisahCloseMenu = closeDrawer;
  if (window.theme) {
    window.theme.openMobileNav = openDrawer;
  }
})();
</script>
