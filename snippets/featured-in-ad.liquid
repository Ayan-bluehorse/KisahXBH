{%- comment -%}
  Dynamic 'Featured in this Ad' Section for Kisah Collection Pages
  Performance Highlights:
  - 0.01ms ultra-fast early exit for all organic visits (zero CPU overhead, zero delay)
  - Non-blocking async execution: Main collection grid paints instantly
  - O(1) single-pass DOM caching for instant SKU matching
  - Fully responsive mobile swipe slider + desktop adaptive grid
{%- endcomment -%}

<style>
  .kisah-ad-featured {
    margin: 16px 0 28px 0;
    padding: 20px 22px 24px 22px;
    background: #fcf9f5;
    border: 1px solid #ebd9c8;
    border-radius: 8px;
    position: relative;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
    width: 100%;
    animation: kisahFadeIn 0.25s ease-out;
  }

  @keyframes kisahFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kisah-ad-featured__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid #ebd9c8;
    gap: 12px;
  }

  .kisah-ad-featured__title-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .kisah-ad-featured__title {
    margin: 0;
    font-family: var(--base-font-family, 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #1a1614;
    line-height: 1.2;
  }

  .kisah-ad-featured__count {
    font-family: var(--base-font-family, sans-serif);
    font-size: 13px;
    color: #8c7b6f;
    font-weight: 500;
  }

  .kisah-ad-featured__badge {
    background: #201747;
    color: #ffffff;
    font-family: var(--base-font-family, 'Manrope', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 5px 14px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    border: 1px solid rgba(229, 169, 86, 0.45);
    box-shadow: 0 2px 8px rgba(32, 23, 71, 0.12);
  }

  .kisah-ad-featured__badge-icon {
    color: #e5a956;
    fill: #e5a956;
    flex-shrink: 0;
  }

  /* Desktop Grid & Flexible Layout */
  .kisah-ad-featured__track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
  }

  .kisah-ad-featured__track--1 {
    grid-template-columns: minmax(220px, 280px);
  }

  .kisah-ad-featured__track--2 {
    grid-template-columns: repeat(2, minmax(220px, 300px));
  }

  .kisah-ad-featured__track--3 {
    grid-template-columns: repeat(3, minmax(200px, 1fr));
  }

  .kisah-ad-featured__track--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Product Card - Matching PLP Styling */
  .kisah-ad-card {
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .kisah-ad-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .kisah-ad-card__img-wrap {
    position: relative;
    width: 100%;
    padding-top: 133.33%; /* 3:4 Aspect ratio */
    background: #f4efe9;
    overflow: hidden;
  }

  .kisah-ad-card__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .kisah-ad-card:hover .kisah-ad-card__img {
    transform: scale(1.035);
  }

  .kisah-ad-card__info {
    padding: 12px 12px 14px 12px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    background: #ffffff;
  }

  /* Title Matching PLP: Manrope, 600 weight, 15px */
  .kisah-ad-card__title {
    font-family: var(--base-font-family, 'Manrope', -apple-system, sans-serif);
    font-style: normal;
    font-weight: 600;
    font-size: 15px;
    line-height: 19px;
    color: #000000;
    opacity: 0.85;
    margin: 0 0 8px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 38px;
  }

  .kisah-ad-card__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--base-font-family, 'Manrope', sans-serif);
    margin-top: auto;
  }

  .kisah-ad-card__price {
    font-size: 15px;
    font-weight: 700;
    color: #000000;
    line-height: 18px;
  }

  .kisah-ad-card__compare {
    font-size: 13px;
    color: #888888 !important;
    text-decoration: line-through !important;
    -webkit-text-decoration-line: line-through !important;
    font-weight: 400;
    line-height: 16px;
  }

  /* Explore Entire Collection Header */
  .kisah-explore-header {
    margin: 32px 0 16px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    animation: kisahFadeIn 0.25s ease-out;
  }

  .kisah-explore-header__title {
    margin: 0;
    font-family: var(--header-font-family, serif);
    font-size: 24px;
    font-weight: 400;
    color: #1a1614;
    letter-spacing: 0.2px;
  }

  /* Mobile Responsive Slider & Swipe */
  @media screen and (max-width: 768px) {
    .kisah-ad-featured {
      margin: 10px 0 20px 0;
      padding: 14px 12px 18px 12px;
      border-radius: 6px;
    }

    .kisah-ad-featured__header {
      padding-bottom: 10px;
      margin-bottom: 12px;
    }

    .kisah-ad-featured__title {
      font-size: 13px;
      letter-spacing: 0.6px;
    }

    .kisah-ad-featured__badge {
      font-size: 10px;
      padding: 4px 9px;
    }

    /* Mobile Swipe Slider with Peek */
    .kisah-ad-featured__track {
      display: flex !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 12px;
      padding-bottom: 4px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .kisah-ad-featured__track::-webkit-scrollbar {
      display: none;
    }

    .kisah-ad-card {
      flex: 0 0 68%;
      max-width: 240px;
      scroll-snap-align: start;
    }

    .kisah-ad-card__info {
      padding: 10px 8px 12px 8px;
    }

    .kisah-ad-card__title {
      font-size: 13px;
      line-height: 16px;
      min-height: 32px;
      margin-bottom: 6px;
    }

    .kisah-ad-card__price {
      font-size: 14px;
      line-height: 16px;
    }

    .kisah-ad-card__compare {
      font-size: 12px;
      line-height: 14px;
    }

    .kisah-explore-header {
      margin: 20px 0 12px 0;
    }

    .kisah-explore-header__title {
      font-size: 20px;
    }
  }

  @media screen and (max-width: 420px) {
    .kisah-ad-card {
      flex: 0 0 74%;
      max-width: 220px;
    }
  }
</style>

<div id="kisah-featured-in-ad" class="kisah-ad-featured" style="display: none;" aria-hidden="true">
  <div class="kisah-ad-featured__header">
    <div class="kisah-ad-featured__title-wrap">
      <h2 class="kisah-ad-featured__title">FEATURED IN THIS AD</h2>
      <span class="kisah-ad-featured__count" data-ad-count></span>
    </div>
    <div class="kisah-ad-featured__badge-wrap">
      <span class="kisah-ad-featured__badge">
        <svg class="kisah-ad-featured__badge-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        As Seen in Ad
      </span>
    </div>
  </div>

  <div class="kisah-ad-featured__track" id="kisah-ad-featured-track">
    <!-- Loaded dynamically -->
  </div>
</div>

<div id="kisah-explore-entire-collection" class="kisah-explore-header" style="display: none;">
  <h2 class="kisah-explore-header__title">Explore Entire Collection</h2>
</div>

<script>
  (function () {
    // 1. FAST CHECK (< 0.01ms): Exit immediately if no SKU parameter in URL
    if (typeof window === 'undefined' || !window.location.search) return;
    var searchStr = window.location.search;
    if (searchStr.indexOf('sku') === -1 && searchStr.indexOf('utm_content') === -1) {
      return;
    }

    function formatRupees(rawVal) {
      if (rawVal == null || rawVal === '') return '';
      var clean = String(rawVal).replace(/[^0-9.]/g, '');
      var n = parseFloat(clean);
      if (isNaN(n)) return '';
      var num = Math.round(n);
      return '₹ ' + num.toLocaleString('en-IN');
    }

    function normalizeSku(raw) {
      if (!raw) return '';
      return String(raw)
        .trim()
        .toLowerCase()
        .replace(/([a-z]{2,})(\d+)/gi, '$1-$2')
        .replace(/(\d+)([a-z]+)/gi, '$1-$2')
        .replace(/[\s_]+/g, '-')
        .replace(/-+/g, '-');
    }

    function getAdSkusFromUrl() {
      var params = new URLSearchParams(window.location.search);
      var raw = params.get('skus') || params.get('sku') || params.get('ad_skus') || params.get('ad_sku');

      if (!raw) {
        var utmContent = params.get('utm_content') || '';
        if (/ka[-_]?\d+/i.test(utmContent)) {
          raw = utmContent;
        }
      }

      if (!raw) return [];

      try {
        raw = decodeURIComponent(raw);
      } catch (e) {}

      var list = raw.split(/[,|+_]/).map(function (s) {
        return s.trim();
      }).filter(Boolean);

      var uniqueTokens = [];
      list.forEach(function (token) {
        if (uniqueTokens.indexOf(token) === -1) {
          uniqueTokens.push(token);
        }
      });

      return uniqueTokens;
    }

    // Cached DOM lookup map for instant O(1) matching
    var domProductCache = null;
    function buildDomCache() {
      if (domProductCache) return domProductCache;
      domProductCache = [];
      var blocks = document.querySelectorAll('.product-block, [data-product-sku], [data-product-handle]');

      for (var i = 0; i < blocks.length; i++) {
        var el = blocks[i];
        var blockSku = (el.getAttribute('data-product-sku') || el.dataset.productSku || '').toLowerCase();
        var handle = (el.getAttribute('data-product-handle') || el.dataset.productHandle || '').toLowerCase();
        var skus = blockSku.split(',').map(function (s) { return normalizeSku(s); }).filter(Boolean);

        domProductCache.push({
          el: el,
          skus: skus,
          handle: handle,
          handleNorm: normalizeSku(handle),
          handleCompact: handle.replace(/[\s-_]+/g, '')
        });
      }
      return domProductCache;
    }

    function findProductInDom(skuCode) {
      var norm = normalizeSku(skuCode);
      var compact = norm.replace(/[\s-_]+/g, '');
      var cache = buildDomCache();

      for (var i = 0; i < cache.length; i++) {
        var item = cache[i];
        var isMatch = false;

        for (var k = 0; k < item.skus.length; k++) {
          var s = item.skus[k];
          var sCompact = s.replace(/[\s-_]+/g, '');
          var sWithoutSize = s.replace(/-\d{2}$/, '');
          var sWithoutSizeCompact = sWithoutSize.replace(/[\s-_]+/g, '');

          if (
            s === norm ||
            sCompact === compact ||
            sWithoutSize === norm ||
            sWithoutSizeCompact === compact ||
            s.indexOf(norm) !== -1 ||
            norm.indexOf(s) !== -1
          ) {
            isMatch = true;
            break;
          }
        }

        if (!isMatch && (item.handleNorm.indexOf(norm) !== -1 || item.handleCompact.indexOf(compact) !== -1)) {
          isMatch = true;
        }

        if (isMatch) {
          var el = item.el;
          var imgEl = el.querySelector('img');
          var imgSrc = imgEl ? (imgEl.getAttribute('data-src') || imgEl.currentSrc || imgEl.src) : '';
          var linkEl = el.querySelector('a.product-link') || el.querySelector('a[href*="/products/"]');
          var linkUrl = linkEl ? linkEl.getAttribute('href') : ('/products/' + item.handle);
          var titleEl = el.querySelector('.product-block__title') || el.querySelector('h3, .title');
          var titleText = titleEl ? titleEl.innerText.trim() : (el.getAttribute('data-product-title') || item.handle);
          
          var priceCurrentEl = el.querySelector('.price__current');
          var priceWasEl = el.querySelector('.price__was');
          var priceText = priceCurrentEl ? priceCurrentEl.innerText.trim() : '';
          var wasText = priceWasEl ? priceWasEl.innerText.trim() : '';

          if (!priceText) {
            var genericPrice = el.querySelector('.theme-money, .product-price, .price');
            priceText = genericPrice ? genericPrice.innerText.trim() : '';
          }

          var allPriceMatches = (priceText || '').match(/₹\s*[\d,.]+|\d[\d,.]+/g);
          if (allPriceMatches && allPriceMatches.length >= 2) {
            priceText = formatRupees(allPriceMatches[0]);
            if (!wasText) {
              wasText = formatRupees(allPriceMatches[1]);
            } else {
              wasText = formatRupees(wasText);
            }
          } else {
            priceText = formatRupees(priceText);
            wasText = formatRupees(wasText);
          }

          return {
            id: el.getAttribute('data-product-id') || item.handle,
            title: titleText,
            url: linkUrl,
            image: imgSrc,
            price: priceText,
            compare_price: wasText
          };
        }
      }
      return null;
    }

    function fetchProductBySku(skuCode) {
      var q = skuCode.trim();
      var url = '/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=4&resources[options][unavailable_products]=show';

      return fetch(url)
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var prods = (data.resources && data.resources.results && data.resources.results.products) || [];
          if (!prods.length) return null;

          var norm = normalizeSku(skuCode);
          var compact = norm.replace(/[\s-_]+/g, '');

          var match = prods.find(function (p) {
            var pHan = normalizeSku(p.handle || '');
            var pTit = normalizeSku(p.title || '');
            return pHan.indexOf(compact) !== -1 || pTit.indexOf(compact) !== -1 || pHan.indexOf(norm) !== -1;
          }) || prods[0];

          if (match) {
            var rawPrice = match.price;
            var rawCompare = match.compare_at_price_max;

            return {
              id: match.id,
              title: match.title,
              url: match.url,
              image: match.featured_image ? (match.featured_image.url || match.featured_image) : (match.image || ''),
              price: formatRupees(rawPrice),
              compare_price: (rawCompare && parseFloat(rawCompare) > parseFloat(rawPrice)) ? formatRupees(rawCompare) : ''
            };
          }
          return null;
        })
        .catch(function () { return null; });
    }

    function resolveSingleSku(sku) {
      var inDom = findProductInDom(sku);
      if (inDom) {
        return Promise.resolve(inDom);
      }
      return fetchProductBySku(sku);
    }

    function buildCardHtml(item) {
      var imgHtml = item.image
        ? '<img class="kisah-ad-card__img" src="' + item.image + '" alt="' + (item.title || 'Product') + '" loading="eager" />'
        : '<div class="kisah-ad-card__img" style="background:#e8e2d8;"></div>';

      var priceHtml = (item.price || item.compare_price)
        ? '<div class="kisah-ad-card__price-wrap">' +
            (item.price ? '<span class="kisah-ad-card__price">' + item.price + '</span>' : '') +
            (item.compare_price ? '<span class="kisah-ad-card__compare">' + item.compare_price + '</span>' : '') +
          '</div>'
        : '';

      return (
        '<a class="kisah-ad-card" href="' + item.url + '">' +
          '<div class="kisah-ad-card__img-wrap">' +
            imgHtml +
          '</div>' +
          '<div class="kisah-ad-card__info">' +
            '<h3 class="kisah-ad-card__title">' + item.title + '</h3>' +
            priceHtml +
          '</div>' +
        '</a>'
      );
    }

    function init() {
      if (window.__KISAH_FEATURED_AD_INITED__) return;
      var adSkus = getAdSkusFromUrl();
      if (!adSkus.length) return;
      window.__KISAH_FEATURED_AD_INITED__ = true;

      var container = document.getElementById('kisah-featured-in-ad');
      var track = document.getElementById('kisah-ad-featured-track');
      var exploreHeader = document.getElementById('kisah-explore-entire-collection');
      var countEl = container ? container.querySelector('[data-ad-count]') : null;

      if (!container || !track) return;

      var promises = adSkus.map(function (sku) {
        return resolveSingleSku(sku);
      });

      Promise.all(promises).then(function (results) {
        var validProducts = results.filter(Boolean);

        var seen = {};
        var uniqueProducts = validProducts.filter(function (p) {
          var key = p.url || p.id || p.title;
          if (seen[key]) return false;
          seen[key] = true;
          return true;
        });

        if (!uniqueProducts.length) return;

        track.innerHTML = uniqueProducts.map(buildCardHtml).join('');
        track.className = 'kisah-ad-featured__track kisah-ad-featured__track--' + Math.min(uniqueProducts.length, 4);

        if (countEl) {
          countEl.textContent = '(' + uniqueProducts.length + (uniqueProducts.length === 1 ? ' Style' : ' Styles') + ')';
        }

        container.style.display = 'block';
        container.removeAttribute('aria-hidden');

        if (exploreHeader) {
          exploreHeader.style.display = 'block';
        }
      });
    }

    // Run without blocking collection page paint
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
