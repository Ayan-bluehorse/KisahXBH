{%- comment -%}
  Kisah High-Performance Cart Drawer Enhancement
  - Computes dynamic shipping, 5% online prepaid discount, and COD total
  - Populates #kisah-price-block and .kisah-cta-total
  - Dispatches GA4 telemetry (view_cart with ms_to_open, checkout_click, drawer_close, select_item)
  - Accessibility: sets aria-label on close button & backdrop
{%- endcomment -%}

<script>
(function() {
  var FREE_SHIPPING_THRESHOLD = {{ settings.cart_free_shipping_threshold | default: 2500 }};
  var SHIPPING_FEE = {{ settings.cart_shipping_fee | default: 99 }};
  var COD_FEE = {{ settings.cart_cod_fee | default: 99 }};
  var PREPAID_DISCOUNT_PERCENT = {{ settings.cart_prepaid_discount | default: 5 }};
  var DRAWER_VARIANT = 'variant_b';

  var drawerOpenTimestamp = 0;
  var addTapTimestamp = 0;
  var isDrawerOpen = false;

  // Track when Add to Bag is tapped
  document.addEventListener('click', function(e) {
    if (e.target.closest('button[name="add"], .js-add-to-cart, [data-add-to-cart]')) {
      addTapTimestamp = performance.now();
    }
  }, true);

  function formatMoney(amount) {
    return '₹' + Math.round(amount).toLocaleString('en-IN');
  }

  function findDrawerInsertionPoint(drawerRoot) {
    if (!drawerRoot) return null;

    // 1. Look for 'Great Choice! Grab these too' recommendations container (Rebuy or Helium)
    var heading = Array.from(drawerRoot.querySelectorAll('h3, h4, p, [class*="heading"]')).find(function(el) {
      var t = (el.textContent || '').trim();
      return el.tagName !== 'SCRIPT' && el.tagName !== 'STYLE' && (t === 'Great Choice! Grab these too' || t.indexOf('Great Choice') !== -1 || t.indexOf('Grab these too') !== -1);
    });

    if (heading) {
      // Find the recommendations section (in Helium drawer it has class bg-gray-50 / border-t)
      var recSection = heading.closest('.bg-gray-50, [class*="bg-gray"], .border-t');
      if (!recSection) {
        recSection = heading;
        while (recSection.parentElement && 
               recSection.parentElement !== drawerRoot && 
               recSection.parentElement.children.length === 1) {
          recSection = recSection.parentElement;
        }
      }
      if (recSection && recSection.parentNode) {
        return { parent: recSection.parentNode, referenceNode: recSection };
      }
    }

    // 2. Look for existing Rebuy recommendations widget
    var rebuy = drawerRoot.querySelector('.rebuy-widget, .rebuy-cart-recommendations');
    if (rebuy && rebuy.parentNode) {
      return { parent: rebuy.parentNode, referenceNode: rebuy };
    }

    // 3. Fallback: Inside the drawer scroll container
    var scroller = drawerRoot.querySelector('.overflow-y-auto, [class*="overflow-y-auto"], [class*="drawer-body"]');
    if (scroller) {
      return { parent: scroller, referenceNode: null };
    }

    // 4. Fallback: Place immediately before checkout / subtotal footer
    var checkoutBtn = Array.from(drawerRoot.querySelectorAll('button, a')).find(function(el) {
      var t = (el.textContent || '').toUpperCase();
      return t.indexOf('CHECKOUT') !== -1 || (el.className && typeof el.className === 'string' && el.className.indexOf('checkout') !== -1);
    });
    if (checkoutBtn) {
      var footerBox = checkoutBtn.closest('[class*="footer"], [class*="bottom"]') || checkoutBtn.parentElement;
      if (footerBox && footerBox.parentNode) {
        return { parent: footerBox.parentNode, referenceNode: footerBox };
      }
    }

    return null;
  }

  function ensurePriceBlockContainer() {
    // 1. If on Cart Page (/cart): Place inside .checkout-col above checkout buttons
    if (window.location.pathname.indexOf('/cart') !== -1) {
      var cartPageBlock = document.querySelector('.checkout-col #kisah-price-block') || document.getElementById('kisah-price-block');
      if (cartPageBlock) {
        cartPageBlock.style.display = 'block';
        return cartPageBlock;
      }
      var cartSummary = document.querySelector('.checkout-col, .cart-summary, cart-form .subtotal');
      if (cartSummary) {
        var newCartBlock = document.createElement('div');
        newCartBlock.id = 'kisah-price-block';
        var btns = cartSummary.querySelector('.checkout-buttons');
        if (btns) {
          cartSummary.insertBefore(newCartBlock, btns);
        } else {
          cartSummary.appendChild(newCartBlock);
        }
        return newCartBlock;
      }
      return null;
    }

    // 2. If in Cart Drawer: ONLY place inside drawer above recommendations or below cart items
    var drawerRoot = document.getElementById('helium-cart-drawer-root');
    if (!drawerRoot) return null;

    var insertion = findDrawerInsertionPoint(drawerRoot);
    if (!insertion || !insertion.parent) return null;

    var block = document.getElementById('kisah-price-block');
    if (!block) {
      block = document.createElement('div');
      block.id = 'kisah-price-block';
    }

    // Insert or move to the exact insertion point (above recommendations)
    if (insertion.referenceNode) {
      if (block.nextSibling !== insertion.referenceNode || block.parentNode !== insertion.parent) {
        insertion.parent.insertBefore(block, insertion.referenceNode);
      }
    } else {
      if (block.parentNode !== insertion.parent) {
        insertion.parent.appendChild(block);
      }
    }
    block.style.display = 'block';
    return block;
  }

  function ensureCtaTotal() {
    var checkoutBtn = document.querySelector('#helium-cart-drawer-root a[href*="/checkout"], #helium-cart-drawer-root button[class*="checkout"], [data-helium-name="checkout-button"], .cart-drawer__checkout');
    if (checkoutBtn && !checkoutBtn.querySelector('.kisah-cta-total')) {
      var span = document.createElement('span');
      span.className = 'kisah-cta-total';
      span.style.marginLeft = '4px';
      checkoutBtn.appendChild(span);
    }
  }

  function updatePriceBlock(cartData) {
    if (!cartData) return;

    var rawSubtotal = cartData.items_subtotal_price || cartData.total_price || 0;
    if (rawSubtotal <= 0 && Array.isArray(cartData.items) && cartData.items.length > 0) {
      rawSubtotal = cartData.items.reduce(function(acc, item) {
        return acc + (item.final_line_price || (item.price * item.quantity));
      }, 0);
    }

    // If subtotal is 0 or cart has no items, hide price block and remove CTA total
    if (rawSubtotal <= 0) {
      var existing = document.getElementById('kisah-price-block');
      if (existing) existing.style.display = 'none';
      var ctaTotals = document.querySelectorAll('.kisah-cta-total');
      ctaTotals.forEach(function(el) { el.remove(); });
      return;
    }

    // Shopify /cart.js and /cart/add.js return prices in paise (e.g. 599700 = ₹5,997).
    var subtotal = rawSubtotal >= 100 ? (rawSubtotal / 100) : rawSubtotal;

    var isFreeShipping = subtotal >= FREE_SHIPPING_THRESHOLD;
    var shipping = isFreeShipping ? 0 : SHIPPING_FEE;
    var prepaidDiscount = Math.round(subtotal * (PREPAID_DISCOUNT_PERCENT / 100));
    var onlineTotal = Math.max(0, subtotal - prepaidDiscount + shipping);
    var codTotal = subtotal + shipping + COD_FEE;

    // Ensure CTA total element exists in checkout button
    ensureCtaTotal();
    var ctaTotals = document.querySelectorAll('.kisah-cta-total');
    ctaTotals.forEach(function(el) {
      el.textContent = ' • ' + formatMoney(onlineTotal);
    });

    // Populate Price Block (ONLY inside cart page or drawer dialog)
    var container = ensurePriceBlockContainer();
    if (!container) return;
    container.style.display = 'block';

    var html = `
      <div class="kisah-price-summary" style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:12px 14px; margin:12px 0; font-size:13px; line-height:1.5;">
        <div style="display:flex; justify-content:space-between; margin-bottom:4px; color:#4b5563;">
          <span>Subtotal</span>
          <span>${formatMoney(subtotal)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:4px; color:#4b5563;">
          <span>Shipping</span>
          <span style="${isFreeShipping ? 'color:#15803d; font-weight:600;' : ''}">${isFreeShipping ? 'FREE' : formatMoney(shipping)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:6px; color:#15803d;">
          <span>Extra ${PREPAID_DISCOUNT_PERCENT}% Prepaid Saving</span>
          <span style="font-weight:600;">-${formatMoney(prepaidDiscount)}</span>
        </div>
        <div style="border-top:1px dashed #d1d5db; padding-top:6px; margin-top:4px;">
          <div style="display:flex; justify-content:space-between; font-weight:700; color:#111827; font-size:14px;">
            <span>Online Payment Total</span>
            <span>${formatMoney(onlineTotal)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; font-size:11px; color:#6b7280; margin-top:2px;">
            <span>COD Total (incl. ₹${COD_FEE} COD fee)</span>
            <span>${formatMoney(codTotal)}</span>
          </div>
        </div>
      </div>
    `;
    container.innerHTML = html;
  }

  window.updateHeaderCartCount = window.updateHeaderCartCount || function(count, isIncrement) {
    var badges = document.querySelectorAll('.cart-link__count, [data-cart-count], .cart-count, .cart-count-bubble span');
    if (badges.length === 0) {
      var cartIcons = document.querySelectorAll('.cart-link__icon, .cart-link');
      cartIcons.forEach(function(icon) {
        var badge = icon.querySelector('.cart-link__count');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'cart-link__count';
          icon.appendChild(badge);
        }
      });
      badges = document.querySelectorAll('.cart-link__count');
    }
    badges.forEach(function(badge) {
      var current = parseInt(badge.textContent.trim(), 10);
      if (isNaN(current)) current = 0;
      var next = isIncrement ? (current + count) : count;
      if (next < 0) next = 0;
      badge.textContent = next;
      badge.setAttribute('data-cart-count', next);
      if (next > 0) {
        badge.style.display = 'inline-block';
        badge.style.visibility = 'visible';
      } else {
        badge.style.display = 'none';
      }
      if (badge.animate) {
        badge.animate([
          { transform: 'scale(1.4)' },
          { transform: 'scale(1)' }
        ], { duration: 250, easing: 'ease-out' });
      }
    });
  };

  function syncCartBadge(cart) {
    if (!cart) return;
    var count = typeof cart.item_count === 'number' ? cart.item_count : null;
    if (count === null && Array.isArray(cart.items)) {
      count = cart.items.reduce(function(acc, it) { return acc + (it.quantity || 1); }, 0);
    }
    if (typeof count === 'number') {
      window.updateHeaderCartCount(count, false);
    }
  }

  function fetchFreshCart(callback) {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        window._h_initial_cart = cart;
        updatePriceBlock(cart);
        syncCartBadge(cart);
        if (typeof callback === 'function') callback(cart);
      })
      .catch(function() {});
  }

  // Intercept all Shopify cart network calls in real time
  if (!window._kisah_fetch_intercepted) {
    window._kisah_fetch_intercepted = true;
    var origFetch = window.fetch;
    window.fetch = function() {
      var args = arguments;
      var url = (args[0] && typeof args[0] === 'string') ? args[0] : (args[0] && args[0].url ? args[0].url : '');
      var isCartOp = url && (
        url.indexOf('/cart/change') !== -1 ||
        url.indexOf('/cart/update') !== -1 ||
        url.indexOf('/cart/add') !== -1 ||
        url.indexOf('/cart/clear') !== -1
      );

      return origFetch.apply(this, args).then(function(response) {
        if (isCartOp && response.ok) {
          response.clone().json().then(function(cartData) {
            if (cartData && (cartData.items || typeof cartData.item_count === 'number')) {
              window._h_initial_cart = cartData;
              updatePriceBlock(cartData);
              syncCartBadge(cartData);
            } else {
              fetchFreshCart();
            }
          }).catch(function() {
            fetchFreshCart();
          });
          // Also schedule follow-ups to catch delayed Preact DOM reconciliations
          setTimeout(fetchFreshCart, 150);
          setTimeout(fetchFreshCart, 400);
        }
        return response;
      });
    };
  }

  // Intercept XMLHttpRequest
  if (!window._kisah_xhr_intercepted) {
    window._kisah_xhr_intercepted = true;
    var origXhrOpen = XMLHttpRequest.prototype.open;
    var origXhrSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function(method, url) {
      this._kisah_url = url;
      return origXhrOpen.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function() {
      var self = this;
      if (this._kisah_url && (
        this._kisah_url.indexOf('/cart/change') !== -1 ||
        this._kisah_url.indexOf('/cart/update') !== -1 ||
        this._kisah_url.indexOf('/cart/add') !== -1 ||
        this._kisah_url.indexOf('/cart/clear') !== -1
      )) {
        this.addEventListener('load', function() {
          if (self.status >= 200 && self.status < 300) {
            fetchFreshCart();
            setTimeout(fetchFreshCart, 200);
          }
        });
      }
      return origXhrSend.apply(this, arguments);
    };
  }

  function handleDrawerOpen(e) {
    isDrawerOpen = true;
    drawerOpenTimestamp = performance.now();

    var msToOpen = addTapTimestamp > 0 ? Math.round(drawerOpenTimestamp - addTapTimestamp) : 0;
    addTapTimestamp = 0;

    // Accessibility label on close button and backdrop
    setTimeout(function() {
      var closeBtns = document.querySelectorAll('#helium-cart-drawer-root button, [data-helium-name="close-button"], .cart-drawer__close');
      closeBtns.forEach(function(btn) {
        if (!btn.getAttribute('aria-label') || btn.getAttribute('aria-label') === '') {
          btn.setAttribute('aria-label', 'Close cart');
        }
      });
    }, 150);

    fetchFreshCart();
    setTimeout(fetchFreshCart, 150);
    setTimeout(fetchFreshCart, 400);
    setTimeout(fetchFreshCart, 800);

    // GA4 view_cart event
    if (typeof window.gtag === 'function') {
      var cart = window._h_initial_cart || {};
      window.gtag('event', 'view_cart', {
        drawer_variant: DRAWER_VARIANT,
        ms_to_open: msToOpen,
        value: (cart.total_price ? cart.total_price / 100 : 0),
        currency: 'INR',
        items: (cart.items || []).map(function(item) {
          return {
            item_id: item.id || item.variant_id,
            item_name: item.title || item.product_title,
            price: item.price ? item.price / 100 : 0,
            quantity: item.quantity
          };
        })
      });
    }
  }

  function handleDrawerClose(method) {
    isDrawerOpen = false;
    var msOpen = drawerOpenTimestamp > 0 ? Math.round(performance.now() - drawerOpenTimestamp) : 0;
    drawerOpenTimestamp = 0;

    if (typeof window.gtag === 'function') {
      window.gtag('event', 'drawer_close', {
        method: method || 'close icon',
        ms_open: msOpen,
        drawer_variant: DRAWER_VARIANT
      });
    }
  }

  // Listeners for Helium Drawer & Cart Events
  window.addEventListener('helium:cart-drawer:open', handleDrawerOpen);
  window.addEventListener('helium:cart:updated', function(e) {
    if (e.detail) {
      updatePriceBlock(e.detail);
      syncCartBadge(e.detail);
    } else {
      fetchFreshCart();
    }
  });
  document.addEventListener('cart:updated', function(e) {
    if (e.detail) {
      updatePriceBlock(e.detail);
      syncCartBadge(e.detail);
    } else {
      fetchFreshCart();
    }
  });

  // Helium pubsub subscription
  function initHeliumPubsub() {
    if (window._h_pubsub && typeof window._h_pubsub.subscribe === 'function') {
      window._h_pubsub.subscribe('helium:cart:updated', function(cart) {
        if (cart) {
          updatePriceBlock(cart);
          syncCartBadge(cart);
        } else {
          fetchFreshCart();
        }
      });
      window._h_pubsub.subscribe('helium:cart:open', handleDrawerOpen);
      window._h_pubsub.subscribe('helium:cart:close', function() {
        handleDrawerClose('helium event');
      });
    } else {
      setTimeout(initHeliumPubsub, 300);
    }
  }
  initHeliumPubsub();

  // Escape key and click listener to reliably detect drawer close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') handleDrawerClose('escape');
  });

  // Open cart drawer when clicking header cart link
  document.addEventListener('click', function(e) {
    var cartLink = e.target.closest('.cart-link, a[href*="/cart"]');
    if (cartLink && window.location.pathname.indexOf('/cart') === -1) {
      if (window._h_pubsub && typeof window._h_pubsub.publish === 'function') {
        e.preventDefault();
        window._h_pubsub.publish('helium:cart:open');
        window.dispatchEvent(new CustomEvent('helium:cart-drawer:open'));
      }
    }
  });

  // Real-time quantity clicks inside the drawer (+, -, trash)
  document.addEventListener('click', function(e) {
    var drawerRoot = document.getElementById('helium-cart-drawer-root');
    if (!drawerRoot) return;

    var btn = e.target.closest('#helium-cart-drawer-root button, [data-helium-name="quantity-increment"], [data-helium-name="quantity-decrement"]');
    if (btn) {
      var t = (btn.textContent || '').trim();
      var aria = (btn.getAttribute('aria-label') || '').toLowerCase();
      if (t === '+' || t === '-' || aria.indexOf('increase') !== -1 || aria.indexOf('decrease') !== -1 || aria.indexOf('remove') !== -1) {
        setTimeout(fetchFreshCart, 150);
        setTimeout(fetchFreshCart, 400);
        setTimeout(fetchFreshCart, 800);
      }
    }

    var isClose = e.target.closest('#helium-cart-drawer-root button, [data-helium-name="close-button"], [aria-label*="close" i], .cart-drawer__close, .close');
    var isNotAction = !e.target.closest('a[href*="/checkout"], button[class*="checkout"], [data-action="add"], [data-helium-name="product-item"], [data-helium-name="quantity-increment"], [data-helium-name="quantity-decrement"]');
    if (isClose && isNotAction) {
      handleDrawerClose('close button');
    }
    if (e.target.closest('#helium-cart-drawer-root .backdrop, [class*="backdrop"], [class*="overlay"]')) {
      handleDrawerClose('backdrop');
    }
  }, true);

  // Self-healing MutationObserver to ensure price block is always in the drawer whenever drawer is open
  (function() {
    var timer = null;
    var observer = new MutationObserver(function() {
      if (window.location.pathname.indexOf('/cart') !== -1) return;
      var drawerRoot = document.getElementById('helium-cart-drawer-root');
      if (!drawerRoot) return;

      var dialog = drawerRoot.querySelector('[role="dialog"], [class*="dialog"], [class*="drawer-content"], [class*="overflow-y-auto"]');
      if (!dialog) return;

      var block = document.getElementById('kisah-price-block');
      var isMountedInDrawer = block && drawerRoot.contains(block) && block.offsetParent !== null;

      if (!isMountedInDrawer) {
        clearTimeout(timer);
        timer = setTimeout(function() {
          fetchFreshCart();
        }, 80);
      }
    });

    function startObserving() {
      var root = document.getElementById('helium-cart-drawer-root') || document.body;
      if (root) {
        observer.observe(root, { childList: true, subtree: true });
      }
    }
    startObserving();
  })();

  // Delegated Clicks inside Drawer
  document.addEventListener('click', function(e) {
    // 1. Checkout Click
    var checkoutBtn = e.target.closest('#helium-cart-drawer-root a[href*="/checkout"], #helium-cart-drawer-root button[class*="checkout"], [data-helium-name="checkout-button"], .kisah-checkout-trigger');
    if (checkoutBtn) {
      var msSinceOpen = drawerOpenTimestamp > 0 ? Math.round(performance.now() - drawerOpenTimestamp) : 0;
      var cart = window._h_initial_cart || {};
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'checkout_click', {
          value: cart.total_price ? cart.total_price / 100 : 0,
          currency: 'INR',
          drawer_variant: DRAWER_VARIANT,
          ms_since_drawer_open: msSinceOpen
        });
      }
    }

    // 2. Drawer Close Click
    var closeBtn = e.target.closest('#helium-cart-drawer-root [data-helium-name="close-button"], #helium-cart-drawer-root .close, .cart-drawer__close');
    if (closeBtn) {
      handleDrawerClose('close icon');
    }
    var backdrop = e.target.closest('#helium-cart-drawer-root .backdrop, .cart-drawer__backdrop');
    if (backdrop) {
      handleDrawerClose('backdrop');
    }

    // 3. Recommendation Card / ADD Click
    var recItem = e.target.closest('.helium-recommendations-item, [data-helium-recommendation], #helium-cart-drawer-root .recommendation-item');
    if (recItem) {
      var isAdd = !!e.target.closest('button, .btn, [data-action="add"]');
      var itemId = recItem.dataset.variantId || recItem.dataset.productId || '';
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'select_item', {
          item_id: itemId,
          item_list_name: 'drawer_recs',
          action: isAdd ? 'add' : 'open',
          drawer_variant: DRAWER_VARIANT
        });
      }
    }
  }, true);

  // On /cart page, fetch fresh /cart.js to populate #kisah-price-block in checkout-col
  if (window.location.pathname.indexOf('/cart') !== -1) {
    function initCartPage() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(c) {
          updatePriceBlock(c);
          syncCartBadge(c);
        })
        .catch(function() {});
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCartPage);
    } else {
      initCartPage();
    }
  }

})();
</script>
