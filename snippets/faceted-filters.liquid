{%- comment -%}
  Kisah Faceted Filters Bottom Sheet Snippet
  Parameters:
  - filter_context {Collection|Search} - Object containing filters.
  - clear_url {String} - The URL to clear all filters.
  - current_sort {SortOption} - The sort option the current product grid is sorted by.
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'collection-filter-sheet.css' | asset_url }}">
<script src="{{ 'collection-filter-sheet.js' | asset_url }}" defer></script>

{%- liquid
  assign is_single_category = false
  assign coll_handle = collection.handle | downcase
  if collection.all_types.size == 1 or coll_handle contains 'kurta' or coll_handle contains 'nehru' or coll_handle contains 'jacket' or coll_handle contains 'indowestern' or coll_handle contains 'bandhgala' or coll_handle contains 'sherwani'
    assign is_single_category = true
  endif

  assign total_active_count = 0
  for filter in filter_context.filters
    if filter.param_name == 'filter.v.availability'
      continue
    endif
    assign total_active_count = total_active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign total_active_count = total_active_count | plus: 1
      endif
    endif
  endfor
-%}

<!-- Background Scrim -->
<div class="kisah-scrim" id="kisahScrim"></div>

<!-- Bottom Sheet Filter Drawer -->
<aside class="kisah-sheet" id="kisahSheet" role="dialog" aria-modal="true" aria-label="Filter" data-open="0">
  <div class="kisah-sheet__grab" id="kisahGrab"><i></i></div>
  <div class="kisah-sheet__head">
    <div class="kisah-sheet__title">FILTER</div>
    <button class="kisah-sheet__close" id="kisahCloseFilter" type="button" aria-label="Close filters">&times;</button>
  </div>

  <div class="kisah-sheet__body" id="kisahSheetBody">
    <form id="CollectionFilterForm" method="get" action="{{ filter_context.url | default: collection.url | default: routes.search_url }}">
      <input type="hidden" name="filter.v.availability" value="1">
      {%- if filter_context.current_vendor or filter_context.current_type -%}
        <input type="hidden" name="q" value="{{ filter_context.current_vendor }}{{ filter_context.current_type }}">
      {%- endif -%}
      {%- if filter_context.terms -%}
        <input type="hidden" name="q" value="{{ filter_context.terms | escape }}">
      {%- endif -%}
      {%- if current_sort -%}
        <input type="hidden" name="sort_by" value="{{ current_sort }}">
      {%- endif -%}

      {%- if section.settings.enable_filtering and filter_context.filters != empty -%}
        {%- for filter in filter_context.filters -%}
          {%- liquid
            assign f_label = filter.label | downcase
            assign f_param = filter.param_name | downcase
            # Skip Availability filter from drawer as it is automatic
            if filter.param_name == 'filter.v.availability'
              continue
            endif

            # Skip Product Type filter on specific category collections
            if is_single_category and f_param contains 'product_type' or is_single_category and f_label contains 'product type'
              continue
            endif

            # Determine facet type & key
            assign facet_key = 'list'
            if f_label contains 'size' or f_param contains 'size'
              assign facet_key = 'size'
            elsif f_label contains 'color' or f_label contains 'colour' or f_param contains 'colour' or f_param contains 'color'
              assign facet_key = 'colour'
            elsif filter.type == 'price_range' or f_label contains 'price'
              assign facet_key = 'price'
            elsif f_label contains 'type'
              assign facet_key = 'type'
            elsif f_label contains 'occasion'
              assign facet_key = 'occasion'
            elsif f_label contains 'fabric'
              assign facet_key = 'fabric'
            elsif f_label contains 'pattern'
              assign facet_key = 'pattern'
            endif

            assign active_summary = ''
            for val in filter.active_values
              if active_summary == ''
                assign active_summary = val.label
              else
                assign active_summary = active_summary | append: ', ' | append: val.label
              endif
            endfor
            if filter.type == 'price_range'
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign min_m = filter.min_value.value | default: 0 | money
                assign max_m = filter.max_value.value | default: filter.range_max | money
                assign active_summary = min_m | append: ' - ' | append: max_m
              endif
            endif

            assign is_open = false
            if filter.active_values.size > 0
              assign is_open = true
            elsif filter.type == 'price_range'
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign is_open = true
              endif
            elsif facet_key == 'size'
              assign is_open = true
            endif
          -%}

          <section class="kisah-sec" data-key="{{ facet_key }}" data-open="{% if is_open %}1{% else %}0{% endif %}">
            <button class="kisah-sec__hd" type="button" aria-expanded="{% if is_open %}true{% else %}false{% endif %}">
              <span class="kisah-sec__name">{{ filter.label }}</span>
              <span class="kisah-sec__sum">{{ active_summary }}</span>
              <svg class="kisah-sec__chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </button>

            <div class="kisah-sec__body">
              {%- if facet_key == 'size' -%}
                <!-- Size Chips -->
                <div class="kisah-chiprow">
                  {%- for value in filter.values -%}
                    {%- liquid
                      assign is_disabled = false
                      if value.count == 0 and value.active == false
                        assign is_disabled = true
                      endif
                    -%}
                    <label class="kisah-chip{% if is_disabled %} is-disabled{% endif %}" data-on="{% if value.active %}1{% else %}0{% endif %}">
                      <input type="checkbox"
                             name="{{ value.param_name }}"
                             value="{{ value.value | escape }}"
                             data-label="{{ value.label | escape }}"
                             data-count="{{ value.count }}"
                             data-initial-count="{{ value.count }}"
                             data-initial-disabled="{% if is_disabled %}1{% else %}0{% endif %}"
                             {% if value.active %}checked{% endif %}
                             {% if is_disabled %}disabled{% endif %}>
                      <span>{{ value.label }}</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- elsif facet_key == 'colour' -%}
                <!-- Colour Swatches -->
                <div class="kisah-swrow">
                  {%- for value in filter.values -%}
                    {%- liquid
                      assign is_disabled = false
                      if value.count == 0 and value.active == false
                        assign is_disabled = true
                      endif

                      assign val_down = value.label | downcase
                      assign swatch_color = '#ccc'
                      if val_down contains 'black'
                        assign swatch_color = '#181721'
                      elsif val_down contains 'blue' or val_down contains 'blie' or val_down contains 'navy'
                        assign swatch_color = '#2b3f73'
                      elsif val_down contains 'maroon' or val_down contains 'wine'
                        assign swatch_color = '#6b2231'
                      elsif val_down contains 'pink'
                        assign swatch_color = '#d99aad'
                      elsif val_down contains 'multi'
                        assign swatch_color = 'linear-gradient(135deg,#c16452 0%,#d3b25e 34%,#4a7a5e 67%,#3b3f78 100%)'
                      elsif val_down contains 'cream' or val_down contains 'beige' or val_down contains 'fawn'
                        assign swatch_color = '#e6dbc6'
                      elsif val_down contains 'purple' or val_down contains 'lilac' or val_down contains 'violet' or val_down contains 'mauve'
                        assign swatch_color = '#6f5a92'
                      elsif val_down contains 'green' or val_down contains 'olive' or val_down contains 'mint' or val_down contains 'sage'
                        assign swatch_color = '#3f6b52'
                      elsif val_down contains 'yellow' or val_down contains 'gold' or val_down contains 'mustard'
                        assign swatch_color = '#d6ac48'
                      elsif val_down contains 'grey' or val_down contains 'gray'
                        assign swatch_color = '#8c8b93'
                      elsif val_down contains 'white' or val_down contains 'off white' or val_down contains 'ivory'
                        assign swatch_color = '#f6f4ef'
                      elsif val_down contains 'orange' or val_down contains 'rust' or val_down contains 'peach'
                        assign swatch_color = '#d46c43'
                      elsif val_down contains 'red'
                        assign swatch_color = '#a82c2c'
                      elsif val_down contains 'brown'
                        assign swatch_color = '#593e2b'
                      endif
                    -%}
                    <label class="kisah-sw{% if is_disabled %} is-disabled{% endif %}" data-on="{% if value.active %}1{% else %}0{% endif %}">
                      <input type="checkbox"
                             name="{{ value.param_name }}"
                             value="{{ value.value | escape }}"
                             data-label="{{ value.label | escape }}"
                             data-count="{{ value.count }}"
                             data-initial-count="{{ value.count }}"
                             data-initial-disabled="{% if is_disabled %}1{% else %}0{% endif %}"
                             {% if value.active %}checked{% endif %}
                             {% if is_disabled %}disabled{% endif %}>
                      <i style="background: {{ swatch_color }};"></i>
                      <em>{{ value.label | replace: ' & ', '<br>& ' }}<b class="kisah-sw-count"> {{ value.count }}</b></em>
                    </label>
                  {%- endfor -%}
                </div>

              {%- elsif filter.type == 'price_range' or facet_key == 'price' -%}
                <!-- Dual Handle Price Range Slider -->
                {%- liquid
                  assign raw_max = filter.range_max | money_without_currency | remove: ' ' | remove: "'" | remove: ',' | split: '.' | first | plus: 0
                  assign p_max = raw_max | divided_by: 100 | plus: 1 | times: 100
                  if p_max <= 0
                    assign p_max = 15000
                  endif

                  # Calculate minimum price from products in collection/search
                  assign min_cents = filter.range_max
                  for product in filter_context.products
                    if product.price_min and product.price_min > 0 and product.price_min < min_cents
                      assign min_cents = product.price_min
                    elsif product.price and product.price > 0 and product.price < min_cents
                      assign min_cents = product.price
                    endif
                  endfor

                  if min_cents == filter.range_max or min_cents == nil or min_cents <= 0
                    assign p_min = 0
                  else
                    assign raw_min = min_cents | money_without_currency | remove: ' ' | remove: "'" | remove: ',' | split: '.' | first | plus: 0
                    assign p_min = raw_min | divided_by: 100 | times: 100
                  endif

                  if filter.min_value.value
                    assign cur_lo = filter.min_value.value | money_without_currency | remove: ' ' | remove: "'" | remove: ',' | split: '.' | first | plus: 0
                  else
                    assign cur_lo = p_min
                  endif
                  if filter.max_value.value
                    assign cur_hi = filter.max_value.value | money_without_currency | remove: ' ' | remove: "'" | remove: ',' | split: '.' | first | plus: 0
                  else
                    assign cur_hi = p_max
                  endif
                -%}
                <div class="kisah-rng">
                  <div class="kisah-rng__vals">
                    <div class="kisah-rng__val" id="kisahRngLoV">₹{{ cur_lo }}</div>
                    <div class="kisah-rng__to">to</div>
                    <div class="kisah-rng__val" id="kisahRngHiV">₹{{ cur_hi }}</div>
                  </div>
                  <div class="kisah-rng__track">
                    <div class="kisah-rng__rail"></div>
                    <div class="kisah-rng__fill" id="kisahRngFill"></div>
                    <input type="range" id="kisahRngLo"
                           {% if filter.min_value.value %}name="{{ filter.min_value.param_name }}"{% endif %}
                           data-name="{{ filter.min_value.param_name }}"
                           min="{{ p_min }}" max="{{ p_max }}" step="100"
                           value="{{ cur_lo }}" aria-label="Minimum price">
                    <input type="range" id="kisahRngHi"
                           {% if filter.max_value.value %}name="{{ filter.max_value.param_name }}"{% endif %}
                           data-name="{{ filter.max_value.param_name }}"
                           min="{{ p_min }}" max="{{ p_max }}" step="100"
                           value="{{ cur_hi }}" aria-label="Maximum price">
                  </div>
                  <div class="kisah-rng__ends">
                    <span>₹{{ p_min }}</span>
                    <span>₹{{ p_max }}</span>
                  </div>
                </div>

              {%- else -%}
                <!-- Standard List Checkboxes (Product Type, Occasion, Fabric, Pattern) -->
                <div class="kisah-list">
                  {%- for value in filter.values -%}
                    {%- liquid
                      assign is_disabled = false
                      if value.count == 0 and value.active == false
                        assign is_disabled = true
                      endif
                    -%}
                    <label class="kisah-row{% if is_disabled %} is-disabled{% endif %}" data-on="{% if value.active %}1{% else %}0{% endif %}">
                      <input type="checkbox"
                             name="{{ value.param_name }}"
                             value="{{ value.value | escape }}"
                             data-label="{{ value.label | escape }}"
                             data-count="{{ value.count }}"
                             data-initial-count="{{ value.count }}"
                             data-initial-disabled="{% if is_disabled %}1{% else %}0{% endif %}"
                             {% if value.active %}checked{% endif %}
                             {% if is_disabled %}disabled{% endif %}>
                      <span class="kisah-box">
                        <svg viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg>
                      </span>
                      <span class="kisah-row__l">{{ value.label }}</span>
                      <span class="kisah-row__c">{{ value.count }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </section>
        {%- endfor -%}
      {%- endif -%}
    </form>
  </div>

  <div class="kisah-sheet__foot">
    {%- liquid
      assign clean_clear_url = clear_url | default: collection.url
      if clean_clear_url contains '?'
        unless clean_clear_url contains 'filter.v.availability=1'
          assign clean_clear_url = clean_clear_url | append: '&filter.v.availability=1'
        endunless
      else
        assign clean_clear_url = clean_clear_url | append: '?filter.v.availability=1'
      endif
    -%}
    <button class="kisah-btn kisah-btn--ghost" id="kisahClearAll" type="button" data-clear-url="{{ clean_clear_url }}">Clear all</button>
    {% liquid
      assign display_count = total_count | default: filter_context.results_count | default: filter_context.products_count | default: collection.products_count
    %}
    <button class="kisah-btn kisah-btn--solid" id="kisahApplyBtn" type="button" data-initial-count="{{ display_count }}">
      Show {{ display_count }} styles
    </button>
  </div>
</aside>

<!-- Sort Modal Drawer for Mobile -->
<div class="kisah-sort-modal" id="kisahSortModal" data-open="0" role="dialog" aria-label="Sort By">
  <div class="kisah-sheet__head">
    <div class="kisah-sheet__title">SORT BY</div>
    <button class="kisah-sheet__close" id="kisahCloseSort" type="button" aria-label="Close sort">&times;</button>
  </div>
  <div class="kisah-sheet__body">
    <div class="kisah-list">
      {%- for option in filter_context.sort_options -%}
        <a href="{{ request.path | sort_by: option.value | escape }}"
           class="kisah-row"
           data-on="{% if current_sort == option.value %}1{% else %}0{% endif %}"
           style="text-decoration: none;">
          <span class="kisah-row__l">
            {% if option.name == 'Date, new to old' %}New Arrivals{% else %}{{ option.name | escape }}{% endif %}
          </span>
          {% if current_sort == option.value %}
            <span class="kisah-box" style="background: var(--kisah-ink); border-color: var(--kisah-ink);">
              <svg viewBox="0 0 24 24" style="opacity: 1;"><path d="m5 13 4 4L19 7"/></svg>
            </span>
          {% endif %}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>