{% if template.name == 'collection' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | json }},
    "url": {{ request.origin | append: collection.url | json }},
    "numberOfItems": {{ collection.products.size | json }},
    "itemListElement": [
      {%- for product in collection.products -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ product.title | json }},
          "url": {{ request.origin | append: product.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
    ]
  }
  </script>
{% endif %}



{% if template.name == 'article' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 160 | json }},
  "image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }},
  "url": {{ request.origin | append: article.url | json }},
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }},
    "url": {{ request.origin | append: blog.url | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "Kisah",
    "url": "https://kisah.in/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://kisah.in/cdn/shop/files/Group_63_1.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "url": {{ request.origin | append: article.url | json }}
  }
}
</script>
{% endif %}

{%- assign is_howto = false -%}
{%- if article.tags contains 'how-to' -%}{%- assign is_howto = true -%}{%- endif -%}
{%- if article.title contains 'How to' -%}{%- assign is_howto = true -%}{%- endif -%}
{%- if article.title contains 'How To' -%}{%- assign is_howto = true -%}{%- endif -%}
{%- if article.title contains 'Guide' -%}{%- assign is_howto = true -%}{%- endif -%}

{% if template.name == 'article' and is_howto %}
{%- assign steps = article.content | split: '<h2' -%}
{%- assign step_position = 0 -%}
{%- assign steps_json = '' -%}

{%- for step in steps -%}
  {%- if forloop.first -%}{%- continue -%}{%- endif -%}

  {%- assign h2_full = step | split: '</h2>' | first -%}
  {%- assign h2_parts = h2_full | split: '>' -%}
  {%- assign h2_content = '' -%}
  {%- for part in h2_parts -%}
    {%- unless forloop.first -%}
      {%- if h2_content != '' -%}{%- assign h2_content = h2_content | append: '>' -%}{%- endif -%}
      {%- assign h2_content = h2_content | append: part -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign step_name = h2_content | strip_html | strip -%}
  {%- assign step_text = step | split: '</h2>' | last | strip_html | truncate: 300 | strip -%}

  {%- if step_name != blank and step_text != blank -%}
    {%- assign step_position = step_position | plus: 1 -%}
    {%- capture step_obj -%}{"@type":"HowToStep","position":{{ step_position }},"name":{{ step_name | json }},"text":{{ step_text | json }}}{%- endcapture -%}
    {%- if steps_json != '' -%}{%- assign steps_json = steps_json | append: ',' -%}{%- endif -%}
    {%- assign steps_json = steps_json | append: step_obj -%}
  {%- endif -%}
{%- endfor -%}

{%- if steps_json != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 160 | json }},
  "image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }},
  "totalTime": "PT10M",
  "step": [{{ steps_json }}]
}
</script>
{%- endif -%}

{% endif %}

