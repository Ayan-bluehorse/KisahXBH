<div class="delivery-date-check">
  {%- if block.settings.title != blank -%}<h2 class="title">{{ block.settings.title }}</h2>{%- endif -%}
  {%- if block.settings.sub_title != blank -%}<div class="sub_title">{{ block.settings.sub_title }}</div>{%- endif -%}
  <div class="delivery-form">
    <input type="text" class="zipcode_input" id="zipcode" placeholder="{{ block.settings.input_text }}" name="zip_code">
    <input id="pincode-btn" class="zipcode_btn check_btn" type="button" value="{{ block.settings.button_text }}">
  </div>
  <div class="alert-msg"></div>
  <div class="delivery-form-result">
   {%- comment -%} <div class="delivery-form-item">
      <span class="result_title">Delivery Status:</span>
      <span class="delivery_status"></span>
    </div>
     <div class="delivery-form-item">
      <span class="result_title">Expected Date:</span>
      <span class="delivery_date"></span>
    </div> {%- endcomment -%}
  </div>
  
  {%- if block.settings.notes != blank -%}
    <div class="delivery-notes">
      <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21">
        <g id="Group_18891" data-name="Group 18891" transform="translate(0.5 0.5)">
          <path id="Path_7906" data-name="Path 7906" d="M12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm0,18a8,8,0,1,1,8-8A8,8,0,0,1,12,20Z" transform="translate(-2 -2)" stroke="#fff" stroke-width="1"></path>
          <rect id="Rectangle_6083" data-name="Rectangle 6083" width="2.5" height="8" transform="translate(9 8)" stroke="#fff" stroke-width="1"></rect>
          <rect id="Rectangle_6084" data-name="Rectangle 6084" width="2.5" height="2.5" transform="translate(9 4)" stroke="#fff" stroke-width="1"></rect>
        </g>
      </svg>
      {{ block.settings.notes }}
    </div>
  {% endif %}
</div>


