  window.kisahWhenJQueryReady(function($) {
  function checkBtn() {
    $(document).on('click', '.check_btn', function(e) {
      e.preventDefault();
      let dropPincode = $(this).siblings('#zipcode').val();

      if (validatePincode(dropPincode)) {
        const username = 'Kisah';
        const apiKey = 'd522f99a-07e8-4b87-8172-1d93a4f27969';
        const pincodeList = ['743502', '421101', '122413', '560067'];
        const url = `https://ds.clickpost.in/api/v2/predicted_sla_api/?username=${username}&key=${apiKey}&check_drop_pincode_validity=true`;

        const headers = {
          'accept': 'application/json',
          'content-type': 'application/json'
        };

        const options = pincodeList.map(pincode => ({
          method: 'POST',
          headers: headers,
          body: JSON.stringify([{ "pickup_pincode": pincode, "drop_pincode": dropPincode }])
        }));
        

        fetchMultipleData(url, options)
          .then(dataArray => {
            if (dataArray.some(obj => !obj.meta.success)) {
              updateUIForInvalidPincode();
              return;
            }

            const smallestSlaMaxObject = getSmallestPredictedSlaMax(dataArray);
            const expectedDate = addDaysToDate(smallestSlaMaxObject.result[0].predicted_sla_max);
        
            if (smallestSlaMaxObject.meta.success) {
              updateUIForValidPincode(expectedDate);
              toggleButton();
            }
          })
          .catch(error => {
            console.error('Error fetching data:', error);
            updateUIForFetchError();
          });
      } else {
        updateUIForInvalidPincode();
      }
    });
  }

  function validatePincode(pincode) {
    const pincodePattern = /^[0-9]{6}$/;
    return pincodePattern.test(pincode);
  }

  function addDaysToDate(days) {
    const currentDate = new Date();
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    const curdayName = dayNames[currentDate.getDay()];
    const deldayName = dayNames[(currentDate.getDay() + days) % 7];
    const curDate = currentDate.getDate();

    currentDate.setDate(currentDate.getDate() + days);
    const day = currentDate.getDate();
    const month = monthNames[currentDate.getMonth()];
    const year = currentDate.getFullYear();

    return { day, month, year, curdayName, deldayName, curDate };
  }

  async function fetchData(url, option) {
    const response = await fetch(url, option);
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    return response.json();
  }

  async function fetchMultipleData(url, options) {
    try {
      const fetchPromises = options.map(option => fetchData(url, option));
      console.log(fetchPromises, 'fetchPromises');
      return await Promise.all(fetchPromises);
    } catch (error) {
      console.error('Error fetching data:', error);
      throw error;
    }
  }

  function getSmallestPredictedSlaMax(data) {
    return data.reduce((minObj, currentObj) => {
      const currentSlaMax = currentObj.result[0].predicted_sla_max;
      const minSlaMax = minObj.result[0].predicted_sla_max;

      if (currentSlaMax === null) return minObj; // Ignore null values
      if (minSlaMax === null) return currentObj; // If minSlaMax is null, use currentObj

      return currentSlaMax < minSlaMax ? currentObj : minObj;
    });
  }

  function updateUIForInvalidPincode() {
    $('.delivery-form-result').html('Not Available');
    $('.delivery_date').html('');
    $('.alert-msg').html('<p class="error-msg">Invalid drop pincode.</p>');
  }

  function updateUIForValidPincode(expectedDate) {
    $('.delivery-form-result').html(`<div class="delvery-date-details"><img src="https://cdn.shopify.com/s/files/1/0496/1003/1256/files/delivery-truck_1.png?v=1721130179" width="30px" height="auto"><p>Estimated delivery between ${expectedDate.curdayName}, ${expectedDate.curDate} ${expectedDate.month} to ${expectedDate.deldayName}, ${expectedDate.day} ${expectedDate.month}</p></div>`);
    $('.alert-msg').html('');
  }

  function updateUIForFetchError() {
    $('.delivery-form-result').html('Error fetching data');
    $('.alert-msg').html('<p class="error-msg">Unable to fetch delivery details. Please try again later.</p>');
  }

  function clearValue() {
    $('#zipcode').val("");
  }

  function toggleButton() {
    const button = $('#pincode-btn');
    if (button.hasClass('check_btn')) {
      button.removeClass('check_btn').addClass('clear_btn').val('change');
    } else {
      button.removeClass('clear_btn').addClass('check_btn').val('Check');
      clearValue();
    }
  }

  $(document).on('click', '.clear_btn', function(e) {
    e.preventDefault();
    toggleButton();
  });

  checkBtn();
});

</script>