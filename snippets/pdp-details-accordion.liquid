{%- assign m = product.metafields.custom -%}

{%- assign has_specs = false -%}
{%- if m.product_type != blank
   or m.product_specification_ocassion != blank
   or m.fabric != blank
   or m.length != blank
   or m.colour != blank
   or m.pattern != blank
   or m.fit != blank
   or m.work_details != blank
   or m.sleeve_length != blank
   or m.specifications_top != blank
   or m.specifications_bottom != blank
   or m.specifications_dupatta != blank
   or m.specifications_jacket != blank
   or m.specifications_sleeve_length != blank
   or m.specifications_fabric != blank
   or m.specifications_closure != blank
   or m.specifications_fit != blank
   or m.specifications_pattern != blank
   or m.specifications_occasion != blank
   or m.specifications_collar != blank
   or m.specifications_lining != blank
   or m.specifications_hemline != blank
   or m.specifications_print_pattern != blank
   or m.specifications_neck != blank
   or m.specifications_type != blank
   or m.specifications_color != blank
   or m.specifications_waistband != blank
   or m.specifications_pocket != blank -%}
  {%- assign has_specs = true -%}
{%- endif -%}

{%- assign has_desc = false -%}
{%- if product.description != blank -%}
  {%- assign has_desc = true -%}
{%- endif -%}

<div class="pdp-accordion-group" id="pdp-accordion-group">
  {%- if has_specs -%}
    <details class="pdp-accordion-item" id="pdp-acc-specs" open>
      <summary class="pdp-accordion-summary">
        <span class="pdp-accordion-title">Specifications</span>
        <span class="pdp-accordion-icon" aria-hidden="true"></span>
      </summary>
      <div class="pdp-accordion-content">
        <div class="pdp-specs-table">
          {%- if m.product_type != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Product Type</span><span class="pdp-spec-val">{{ m.product_type }}</span></div>{%- elsif m.specifications_type != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Product Type</span><span class="pdp-spec-val">{{ m.specifications_type }}</span></div>{%- endif -%}
          {%- if m.specifications_top != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Top</span><span class="pdp-spec-val">{{ m.specifications_top }}</span></div>{%- endif -%}
          {%- if m.specifications_bottom != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Bottom</span><span class="pdp-spec-val">{{ m.specifications_bottom }}</span></div>{%- endif -%}
          {%- if m.specifications_dupatta != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Dupatta</span><span class="pdp-spec-val">{{ m.specifications_dupatta }}</span></div>{%- endif -%}
          {%- if m.specifications_jacket != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Jacket</span><span class="pdp-spec-val">{{ m.specifications_jacket }}</span></div>{%- endif -%}
          {%- if m.fabric != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Fabric</span><span class="pdp-spec-val">{{ m.fabric }}</span></div>{%- elsif m.specifications_fabric != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Fabric</span><span class="pdp-spec-val">{{ m.specifications_fabric }}</span></div>{%- endif -%}
          {%- if m.product_specification_ocassion != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Occasion</span><span class="pdp-spec-val">{{ m.product_specification_ocassion }}</span></div>{%- elsif m.specifications_occasion != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Occasion</span><span class="pdp-spec-val">{{ m.specifications_occasion }}</span></div>{%- endif -%}
          {%- if m.colour != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Colour</span><span class="pdp-spec-val">{{ m.colour }}</span></div>{%- elsif m.specifications_color != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Colour</span><span class="pdp-spec-val">{{ m.specifications_color }}</span></div>{%- endif -%}
          {%- if m.pattern != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Pattern</span><span class="pdp-spec-val">{{ m.pattern }}</span></div>{%- elsif m.specifications_pattern != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Pattern</span><span class="pdp-spec-val">{{ m.specifications_pattern }}</span></div>{%- endif -%}
          {%- if m.specifications_print_pattern != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Print Or Pattern Type</span><span class="pdp-spec-val">{{ m.specifications_print_pattern }}</span></div>{%- endif -%}
          {%- if m.fit != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Fit</span><span class="pdp-spec-val">{{ m.fit }}</span></div>{%- elsif m.specifications_fit != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Fit</span><span class="pdp-spec-val">{{ m.specifications_fit }}</span></div>{%- endif -%}
          {%- if m.length != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Length</span><span class="pdp-spec-val">{{ m.length }}</span></div>{%- endif -%}
          {%- if m.sleeve_length != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Sleeve Length</span><span class="pdp-spec-val">{{ m.sleeve_length }}</span></div>{%- elsif m.specifications_sleeve_length != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Sleeve Length</span><span class="pdp-spec-val">{{ m.specifications_sleeve_length }}</span></div>{%- endif -%}
          {%- if m.specifications_collar != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Collar</span><span class="pdp-spec-val">{{ m.specifications_collar }}</span></div>{%- endif -%}
          {%- if m.specifications_neck != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Neck</span><span class="pdp-spec-val">{{ m.specifications_neck }}</span></div>{%- endif -%}
          {%- if m.specifications_closure != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Closure</span><span class="pdp-spec-val">{{ m.specifications_closure }}</span></div>{%- endif -%}
          {%- if m.specifications_lining != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Lining</span><span class="pdp-spec-val">{{ m.specifications_lining }}</span></div>{%- endif -%}
          {%- if m.specifications_hemline != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Hemline</span><span class="pdp-spec-val">{{ m.specifications_hemline }}</span></div>{%- endif -%}
          {%- if m.specifications_waistband != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Waistband</span><span class="pdp-spec-val">{{ m.specifications_waistband }}</span></div>{%- endif -%}
          {%- if m.specifications_pocket != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Pocket</span><span class="pdp-spec-val">{{ m.specifications_pocket }}</span></div>{%- endif -%}
          {%- if m.work_details != blank -%}<div class="pdp-spec-row"><span class="pdp-spec-key">Work Details</span><span class="pdp-spec-val">{{ m.work_details }}</span></div>{%- endif -%}
        </div>
      </div>
    </details>
  {%- endif -%}

  {%- if has_desc -%}
    <details class="pdp-accordion-item" id="pdp-acc-desc"{% unless has_specs %} open{% endunless %}>
      <summary class="pdp-accordion-summary">
        <span class="pdp-accordion-title">Description</span>
        <span class="pdp-accordion-icon" aria-hidden="true"></span>
      </summary>
      <div class="pdp-accordion-content">
        <div class="pdp-desc-body rte cf">{{ product.description }}</div>
      </div>
    </details>
  {%- endif -%}

  {%- if m.product_highlights != blank -%}
    <details class="pdp-accordion-item" id="pdp-acc-highlights">
      <summary class="pdp-accordion-summary">
        <span class="pdp-accordion-title">Product Highlights</span>
        <span class="pdp-accordion-icon" aria-hidden="true"></span>
      </summary>
      <div class="pdp-accordion-content">
        <div class="pdp-desc-body rte cf">{{ m.product_highlights }}</div>
      </div>
    </details>
  {%- endif -%}

  {%- if m.wash_care_instructions != blank -%}
    <details class="pdp-accordion-item" id="pdp-acc-washcare">
      <summary class="pdp-accordion-summary">
        <span class="pdp-accordion-title">Wash &amp; Care Instructions</span>
        <span class="pdp-accordion-icon" aria-hidden="true"></span>
      </summary>
      <div class="pdp-accordion-content">
        <div class="pdp-desc-body rte cf">{{ m.wash_care_instructions }}</div>
      </div>
    </details>
  {%- endif -%}

  <details class="pdp-accordion-item" id="pdp-acc-ship"{% unless has_specs or has_desc %} open{% endunless %}>
    <summary class="pdp-accordion-summary">
      <span class="pdp-accordion-title">Shipping &amp; Returns</span>
      <span class="pdp-accordion-icon" aria-hidden="true"></span>
    </summary>
    <div class="pdp-accordion-content">
      <div class="pdp-ship-body rte cf">
        {%- if m._shipping_return_details != blank -%}
          {{ m._shipping_return_details }}
        {%- else -%}
          <p><b>Express delivery</b> is available for your convenience.<br>
          <b>Cash on delivery</b> is available for hassle-free shopping.<br>
          This item is eligible for return or exchange <b>within 7 days</b> of delivery.</p>
          <p>For more information, review our <b>return policy</b> and <b>shipping policy</b></p>
          <p><strong>Manufacturer Detail:</strong><br>
          <strong>KISAH APPAREL PRIVATE LIMITED</strong><br>
          P62, 3rd Lane, Sector B, Metropolitan Housing Society, Kolkata 700105</p>
        {%- endif -%}
      </div>
    </div>
  </details>

  {%- assign metaobject_list = m.product_seller_information.value -%}
  {%- for metaobject_item in metaobject_list -%}
    {%- if metaobject_item.title != blank -%}
      <details class="pdp-accordion-item">
        <summary class="pdp-accordion-summary">
          <span class="pdp-accordion-title">{{ metaobject_item.title }}</span>
          <span class="pdp-accordion-icon" aria-hidden="true"></span>
        </summary>
        <div class="pdp-accordion-content">
          <div class="rte cf">{{ metaobject_item.seller_information }}</div>
        </div>
      </details>
    {%- endif -%}
  {%- endfor -%}
</div>

<style>
  .pdp-accordion-group {
    margin-top: 15px;
    border-top: 1px solid #E8E8E8;
  }
  .pdp-accordion-item {
    border-bottom: 1px solid #E8E8E8;
  }
  details.pdp-accordion-item > summary.pdp-accordion-summary {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 14px 0 !important;
    cursor: pointer !important;
    list-style: none !important;
    user-select: none !important;
  }
  details.pdp-accordion-item > summary.pdp-accordion-summary::-webkit-details-marker,
  details.pdp-accordion-item > summary.pdp-accordion-summary::marker {
    display: none !important;
    content: "" !important;
  }
  .pdp-accordion-title {
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    color: #1E1E1E;
    letter-spacing: 0.2px;
  }
  /* Plus / Minus icon */
  .pdp-accordion-icon {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pdp-accordion-icon::before,
  .pdp-accordion-icon::after {
    content: '';
    position: absolute;
    background-color: #333333;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  /* Horizontal bar of plus */
  .pdp-accordion-icon::before {
    width: 12px;
    height: 1.5px;
  }
  /* Vertical bar of plus */
  .pdp-accordion-icon::after {
    width: 1.5px;
    height: 12px;
  }
  /* When open, vertical bar rotates and fades to form minus (-) */
  .pdp-accordion-item[open] .pdp-accordion-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }
  .pdp-accordion-content {
    padding: 0 0 16px 0;
    font-size: 14px;
    line-height: 1.6;
    color: #4A4A4A;
  }
  .pdp-specs-table {
    display: flex;
    flex-direction: column;
  }
  .pdp-spec-row {
    display: flex;
    padding: 7px 0;
    border-bottom: 1px solid #F2F2F4;
    font-size: 13.5px;
    align-items: baseline;
  }
  .pdp-spec-row:last-child {
    border-bottom: none;
  }
  .pdp-spec-key {
    width: 35%;
    min-width: 110px;
    color: #888888;
  }
  .pdp-spec-val {
    width: 65%;
    color: #1E1E1E;
    font-weight: 400;
  }
  .pdp-desc-body,
  .pdp-ship-body {
    font-size: 14px;
    line-height: 1.6;
    color: #4A4A4A;
  }
</style>

<script>
  (function() {
    function initPdpAccordion() {
      var group = document.getElementById('pdp-accordion-group');
      if (!group) return;
      var items = group.querySelectorAll('.pdp-accordion-item');
      items.forEach(function(item) {
        item.addEventListener('toggle', function() {
          if (item.open) {
            items.forEach(function(other) {
              if (other !== item) other.removeAttribute('open');
            });
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPdpAccordion);
    } else {
      initPdpAccordion();
    }
  })();
</script>
